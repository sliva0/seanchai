; Type: Enumerated AVP
; Name: CC-Request-Type
; Section: 8.3
; Page: 62
CC-Request-Type ::= < Enumerated AVP header: 416 >
        INITIAL_REQUEST     = 1
        UPDATE_REQUEST      = 2
        TERMINATION_REQUEST = 3
        EVENT_REQUEST       = 4


; Type: Enumerated AVP
; Name: CC-Session-Failover
; Section: 8.4
; Page: 63
CC-Session-Failover ::= < Enumerated AVP header: 418 >
        FAILOVER_NOT_SUPPORTED = 0
        FAILOVER_SUPPORTED     = 1


; Type: Enumerated AVP
; Name: Check-Balance-Result
; Section: 8.6
; Page: 64
Check-Balance-Result ::= < Enumerated AVP header: 422 >
        ENOUGH_CREDIT = 0
        NO_CREDIT     = 1


; Type: Grouped AVP
; Name: Cost-Information
; Section: 8.7
; Page: 64
Cost-Information ::= < AVP header: 423 >
        { Unit-Value }
        { Currency-Code }
        [ Cost-Unit ]


; Type: Grouped AVP
; Name: Unit-Value
; Section: 8.8
; Page: 65
Unit-Value ::= < AVP header: 445 >
        { Value-Digits }
        [ Exponent ]


; Type: Enumerated AVP
; Name: Credit-Control
; Section: 8.13
; Page: 66
Credit-Control ::= < Enumerated AVP header: 426 >
        CREDIT_AUTHORIZATION = 0
        RE_AUTHORIZATION     = 1


; Type: Enumerated AVP
; Name: Credit-Control-Failure-Handling
; Section: 8.14
; Page: 67
Credit-Control-Failure-Handling ::= < Enumerated AVP header: 427 >
        TERMINATE           = 0
        CONTINUE            = 1
        RETRY_AND_TERMINATE = 2


; Type: Enumerated AVP
; Name: Direct-Debiting-Failure-Handling
; Section: 8.15
; Page: 68
Direct-Debiting-Failure-Handling ::= < Enumerated AVP header: 428 >
        TERMINATE_OR_BUFFER = 0
        CONTINUE            = 1


; Type: Grouped AVP
; Name: Multiple-Services-Credit-Control
; Section: 8.16
; Page: 68
Multiple-Services-Credit-Control ::= < AVP header: 456 >
        [ Granted-Service-Unit ]
        [ Requested-Service-Unit ]
      * [ Used-Service-Unit ]
        [ Tariff-Change-Usage ]
      * [ Service-Identifier ]
        [ Rating-Group ]
      * [ G-S-U-Pool-Reference ]
        [ Validity-Time ]
        [ Result-Code ]
        [ Final-Unit-Indication ]
        [ QoS-Final-Unit-Indication ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Granted-Service-Unit
; Section: 8.17
; Page: 70
Granted-Service-Unit ::= < AVP header: 431 >
        [ Tariff-Time-Change ]
        [ CC-Time ]
        [ CC-Money ]
        [ CC-Total-Octets ]
        [ CC-Input-Octets ]
        [ CC-Output-Octets ]
        [ CC-Service-Specific-Units ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Requested-Service-Unit
; Section: 8.18
; Page: 71
Requested-Service-Unit ::= < AVP header: 437 >
        [ CC-Time ]
        [ CC-Money ]
        [ CC-Total-Octets ]
        [ CC-Input-Octets ]
        [ CC-Output-Octets ]
        [ CC-Service-Specific-Units ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Used-Service-Unit
; Section: 8.19
; Page: 71
Used-Service-Unit ::= < AVP header: 446 >
        [ Tariff-Change-Usage ]
        [ CC-Time ]
        [ CC-Money ]
        [ CC-Total-Octets ]
        [ CC-Input-Octets ]
        [ CC-Output-Octets ]
        [ CC-Service-Specific-Units ]
      * [ AVP ]


; Type: Grouped AVP
; Name: CC-Money
; Section: 8.22
; Page: 72
CC-Money ::= < AVP header: 413 >
        { Unit-Value }
        [ Currency-Code ]


; Type: Enumerated AVP
; Name: Tariff-Change-Usage
; Section: 8.27
; Page: 73
Tariff-Change-Usage ::= < Enumerated AVP header: 452 >
        UNIT_BEFORE_TARIFF_CHANGE = 0
        UNIT_AFTER_TARIFF_CHANGE  = 1
        UNIT_INDETERMINATE        = 2


; Type: Grouped AVP
; Name: G-S-U-Pool-Reference
; Section: 8.30
; Page: 74
G-S-U-Pool-Reference ::= < AVP header: 457 >
        { G-S-U-Pool-Identifier }
        { CC-Unit-Type }
        { Unit-Value }


; Type: Enumerated AVP
; Name: CC-Unit-Type
; Section: 8.32
; Page: 75
CC-Unit-Type ::= < Enumerated AVP header: 454 >
        TIME                   = 0
        MONEY                  = 1
        TOTAL-OCTETS           = 2
        INPUT-OCTETS           = 3
        OUTPUT-OCTETS          = 4
        SERVICE-SPECIFIC-UNITS = 5


; Type: Grouped AVP
; Name: Final-Unit-Indication
; Section: 8.34
; Page: 76
Final-Unit-Indication ::= < AVP header: 430 >
        { Final-Unit-Action }
      * [ Restriction-Filter-Rule ]
      * [ Filter-Id ]
        [ Redirect-Server ]


; Type: Enumerated AVP
; Name: Final-Unit-Action
; Section: 8.35
; Page: 77
Final-Unit-Action ::= < Enumerated AVP header: 449 >
        TERMINATE       = 0
        REDIRECT        = 1
        RESTRICT_ACCESS = 2


; Type: Grouped AVP
; Name: Redirect-Server
; Section: 8.37
; Page: 78
Redirect-Server ::= < AVP header: 434 >
        { Redirect-Address-Type }
        { Redirect-Server-Address }


; Type: Enumerated AVP
; Name: Redirect-Address-Type
; Section: 8.38
; Page: 79
Redirect-Address-Type ::= < Enumerated AVP header: 433 >
        URL = 2


; Type: Enumerated AVP
; Name: Multiple-Services-Indicator
; Section: 8.40
; Page: 80
Multiple-Services-Indicator ::= < Enumerated AVP header: 455 >
        MULTIPLE_SERVICES_NOT_SUPPORTED = 0
        MULTIPLE_SERVICES_SUPPORTED     = 1


; Type: Enumerated AVP
; Name: Requested-Action
; Section: 8.41
; Page: 80
Requested-Action ::= < Enumerated AVP header: 436 >
        DIRECT_DEBITING = 0
        REFUND_ACCOUNT  = 1
        CHECK_BALANCE   = 2
        PRICE_ENQUIRY   = 3


; Type: Grouped AVP
; Name: Service-Parameter-Info
; Section: 8.43
; Page: 82
Service-Parameter-Info ::= < AVP header: 440 >
        { Service-Parameter-Type }
        { Service-Parameter-Value }


; Type: Grouped AVP
; Name: Subscription-Id
; Section: 8.46
; Page: 83
Subscription-Id ::= < AVP header: 443 >
        { Subscription-Id-Type }
        { Subscription-Id-Data }


; Type: Enumerated AVP
; Name: Subscription-Id-Type
; Section: 8.47
; Page: 83
Subscription-Id-Type ::= < Enumerated AVP header: 450 >
        END_USER_E164    = 0
        END_USER_IMSI    = 1
        END_USER_SIP_URI = 2
        END_USER_NAI     = 3
        END_USER_PRIVATE = 4


; Type: Grouped AVP
; Name: User-Equipment-Info
; Section: 8.49
; Page: 84
User-Equipment-Info ::= < AVP header: 458 >
        { User-Equipment-Info-Type }
        { User-Equipment-Info-Value }


; Type: Enumerated AVP
; Name: User-Equipment-Info-Type
; Section: 8.50
; Page: 84
User-Equipment-Info-Type ::= < Enumerated AVP header: 459 >
        IMEISV         = 0
        MAC            = 1
        EUI64          = 2
        MODIFIED_EUI64 = 3


; Type: Grouped AVP
; Name: User-Equipment-Info-Extension
; Section: 8.52
; Page: 85
User-Equipment-Info-Extension ::= < AVP header: 653 >
        [ User-Equipment-Info-IMEISV ]
        [ User-Equipment-Info-MAC ]
        [ User-Equipment-Info-EUI64 ]
        [ User-Equipment-Info-ModifiedEUI64 ]
        [ User-Equipment-Info-IMEI ]
        [ AVP ]


; Type: Grouped AVP
; Name: Subscription-Id-Extension
; Section: 8.58
; Page: 87
Subscription-Id-Extension ::= < AVP header: 659 >
        [ Subscription-Id-E164 ]
        [ Subscription-Id-IMSI ]
        [ Subscription-Id-SIP-URI ]
        [ Subscription-Id-NAI ]
        [ Subscription-Id-Private ]
        [ AVP ]


; Type: Grouped AVP
; Name: Redirect-Server-Extension
; Section: 8.64
; Page: 88
Redirect-Server-Extension ::= < AVP header: 665 >
        [ Redirect-Address-IPAddress ]
        [ Redirect-Address-URL ]
        [ Redirect-Address-SIP-URI ]
        [ AVP ]


; Type: Grouped AVP
; Name: QoS-Final-Unit-Indication
; Section: 8.68
; Page: 89
QoS-Final-Unit-Indication ::= < AVP header: 669 >
        { Final-Unit-Action }
      * [ Filter-Rule ]
      * [ Filter-Id ]
        [ Redirect-Server-Extension ]
      * [ AVP ]
