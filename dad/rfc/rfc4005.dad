; Type: Enumerated AVP
; Name: NAS-Port-Type
; Section: 4.4
; Page: 22
; Values: [RADIUSTypes]
NAS-Port-Type ::= < Enumerated AVP header: 61 >
        Async                                                               = 0
        Sync                                                                = 1
        "ISDN Sync"                                                         = 2
        "ISDN Async V.120"                                                  = 3
        "ISDN Async V.110"                                                  = 4
        Virtual                                                             = 5
        PIAFS                                                               = 6
        "HDLC Clear Channel"                                                = 7
        "X.25"                                                              = 8
        "X.75"                                                              = 9
        "G.3 Fax"                                                           = 10
        "SDSL - Symmetric DSL"                                              = 11
        "ADSL-CAP - Asymmetric DSL, Carrierless Amplitude Phase Modulation" = 12
        "ADSL-DMT - Asymmetric DSL, Discrete Multi-Tone"                    = 13
        "IDSL - ISDN Digital Subscriber Line"                               = 14
        Ethernet                                                            = 15
        "xDSL - Digital Subscriber Line of unknown type"                    = 16
        Cable                                                               = 17
        "Wireless - Other"                                                  = 18
        "Wireless - IEEE 802.11"                                            = 19
        Token-Ring                                                          = 20
        FDDI                                                                = 21
        "Wireless - CDMA2000"                                               = 22
        "Wireless - UMTS"                                                   = 23
        "Wireless - 1X-EV"                                                  = 24
        IAPP                                                                = 25


; Type: Enumerated AVP
; Name: Prompt
; Section: 5.3
; Page: 27
; Values: [RADIUSTypes]
Prompt ::= < Enumerated AVP header: 76 >
        "No Echo" = 0
        Echo      = 1


; Type: Grouped AVP
; Name: CHAP-Auth
; Section: 5.4
; Page: 27
CHAP-Auth ::= < AVP header: 402 >
        { CHAP-Algorithm }
        { CHAP-Ident }
        [ CHAP-Response ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: CHAP-Algorithm
; Section: 5.5
; Page: 28
CHAP-Algorithm ::= < Enumerated AVP header: 403 >
        "CHAP with MD5" = 5


; Type: Enumerated AVP
; Name: Service-Type
; Section: 6.1
; Page: 30
; Values: [RADIUS] and [RADIUSTypes]
Service-Type ::= < Enumerated AVP header: 6 >
        Login                     = 1
        Framed                    = 2
        "Callback Login"          = 3
        "Callback Framed"         = 4
        Outbound                  = 5
        Administrative            = 6
        "NAS Prompt"              = 7
        "Authenticate Only"       = 8
        "Callback NAS Prompt"     = 9
        "Call Check"              = 10
        "Callback Administrative" = 11
        Voice                     = 12
        Fax                       = 13
        "Modem Relay"             = 14
        IAPP-Register             = 15
        IAPP-AP-Check             = 16
        "Authorize Only"          = 17
        ;; deleted: value 'Callback Login' (= 3) (occurrence 2) (RFC4005.py#service-type-callback-login-requalified)
        ;; deleted: value 'Callback Framed' (= 4) (occurrence 2) (RFC4005.py#service-type-callback-framed-requalified)


; Type: Enumerated AVP
; Name: Framed-Protocol
; Section: 6.10.1
; Page: 35
; Values: [RADIUSTypes]
Framed-Protocol ::= < Enumerated AVP header: 7 >
        PPP                                                 = 1
        SLIP                                                = 2
        "AppleTalk Remote Access Protocol (ARAP)"           = 3
        "Gandalf proprietary SingleLink/MultiLink protocol" = 4
        "Xylogics proprietary IPX/SLIP"                     = 5
        "X.75 Synchronous"                                  = 6


; Type: Enumerated AVP
; Name: Framed-Routing
; Section: 6.10.2
; Page: 35
; Values: [RADIUSTypes]
Framed-Routing ::= < Enumerated AVP header: 10 >
        None                         = 0
        "Send routing packets"       = 1
        "Listen for routing packets" = 2
        "Send and Listen"            = 3


; Type: Enumerated AVP
; Name: Framed-Compression
; Section: 6.10.4
; Page: 36
; Values: [RADIUSTypes]
Framed-Compression ::= < Enumerated AVP header: 13 >
        None                           = 0
        "VJ TCP/IP header compression" = 1
        "IPX header compression"       = 2
        "Stac-LZS compression"         = 3


; Type: Enumerated AVP
; Name: ARAP-Zone-Access
; Section: 6.14.2
; Page: 40
; Values: [RADIUSTypes] and defined in [RADIUSExt]
ARAP-Zone-Access ::= < Enumerated AVP header: 72 >


; Type: Enumerated AVP
; Name: Login-Service
; Section: 6.15.3
; Page: 41
; Values: [RADIUSTypes]
Login-Service ::= < Enumerated AVP header: 15 >
        Telnet                                                          = 0
        Rlogin                                                          = 1
        "TCP Clear"                                                     = 2
        "PortMaster (proprietary)"                                      = 3
        LAT                                                             = 4
        X25-PAD                                                         = 5
        X25-T3POS                                                       = 6
        "TCP Clear Quiet (suppresses any NAS-generated connect string)" = 8


; Type: Grouped AVP
; Name: Tunneling
; Section: 7.1
; Page: 44
Tunneling ::= < AVP header: 401 >
        { Tunnel-Type }
        { Tunnel-Medium-Type }
        { Tunnel-Client-Endpoint }
        { Tunnel-Server-Endpoint }
        [ Tunnel-Preference ]
        [ Tunnel-Client-Auth-Id ]
        [ Tunnel-Server-Auth-Id ]
        [ Tunnel-Assignment-Id ]
        [ Tunnel-Password ]
        [ Tunnel-Private-Group-Id ]


; Type: Enumerated AVP
; Name: Tunnel-Type
; Section: 7.2
; Page: 45
; Values: [RADIUSTypes]
Tunnel-Type ::= < Enumerated AVP header: 64 >
        "Point-to-Point Tunneling Protocol (PPTP)"                   = 1
        "Layer Two Forwarding (L2F)"                                 = 2
        "Layer Two Tunneling Protocol (L2TP)"                        = 3
        "Ascend Tunnel Management Protocol (ATMP)"                   = 4
        "Virtual Tunneling Protocol (VTP)"                           = 5
        "IP Authentication Header in the Tunnel-mode (AH)"           = 6
        "IP-in-IP Encapsulation (IP-IP)"                             = 7
        "Minimal IP-in-IP Encapsulation (MIN-IP-IP)"                 = 8
        "IP Encapsulating Security Payload in the Tunnel-mode (ESP)" = 9
        "Generic Route Encapsulation (GRE)"                          = 10
        "Bay Dial Virtual Services (DVS)"                            = 11
        "IP-in-IP Tunneling"                                         = 12
        "Virtual LANs (VLAN)"                                        = 13


; Type: Enumerated AVP
; Name: Tunnel-Medium-Type
; Section: 7.3
; Page: 46
; Values: [RADIUSTypes]
Tunnel-Medium-Type ::= < Enumerated AVP header: 65 >
        "IPv4 (IP version 4)"                                             = 1
        "IPv6 (IP version 6)"                                             = 2
        NSAP                                                              = 3
        "HDLC (8-bit multidrop)"                                          = 4
        "BBN 1822"                                                        = 5
        "802 (includes all 802 media plus Ethernet \"canonical format\")" = 6
        "E.163 (POTS)"                                                    = 7
        "E.164 (SMDS, Frame Relay, ATM)"                                  = 8
        "F.69 (Telex)"                                                    = 9
        "X.121 (X.25, Frame Relay)"                                       = 10
        IPX                                                               = 11
        Appletalk                                                         = 12
        "Decnet IV"                                                       = 13
        "Banyan Vines"                                                    = 14
        "E.164 with NSAP format subaddress"                               = 15


