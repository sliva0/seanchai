; Specification: 3GPP TS 29.368
; Version: 18.0.0
; Vendor-ID: 10415
; Bases: RFC6733
; Link: https://www.etsi.org/deliver/etsi_ts/129300_129399/129368/18.00.00_60/ts_129368v180000p.pdf


; Type: Application Scope
; Name: Tsp
; Section: 6.1.3
; Page: 14
; Application-ID: 16777309
; Applies-To: 6.*


; Type: Message
; Name: DA-Request, DAR
; Section: 6.6.2
; Page: 23
<DA-Request> ::= < Diameter Header: 8388639, REQ, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        [ Destination-Host ]
        [ Origin-State-Id ]
        [ Device-Action ]       ; bold
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ Supported-Features ]
      * [ AVP ]


; Type: Message
; Name: DA-Answer, DAA
; Section: 6.6.3
; Page: 23
<DA-Answer> ::= < Diameter Header: 8388639, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Auth-Session-State }                ; bold
        { Origin-Host }
        { Origin-Realm }
        [ Result-Code ]
        [ Experimental-Result ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
        [ Failed-AVP ]
        [ Origin-State-Id ]
        { Device-Notification }               ; bold
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Proxy-Info ]
      * [ Supported-Features ]                ; bold
        [ Feature-Supported-In-Final-Target ]
      * [ Load ]
      * [ AVP ]


; Type: Message
; Name: DN-Request, DNR
; Section: 6.6.4
; Page: 24
<DN-Request> ::= < Diameter Header: 8388640, REQ, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Destination-Host }
        [ Origin-State-Id ]
        [ Device-Notification ] ; bold
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: DN-Answer, DNA
; Section: 6.6.5
; Page: 24
<DN-Answer> ::= < Diameter Header: 8388640, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Result-Code ]
        [ Experimental-Result ]
        [ Origin-State-Id ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
        [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ AVP ]


; Type: AVP Table
; Section: 6.4.1
; Table: 6.4.1.1
; Page: 16
; Columns: Name                     Code   Section   Type          Must   May   S.not   M.not   Applicability
Device-Action                       3001   6.4.2     Grouped       M,V    P     -       -       ""
Device-Notification                 3002   6.4.3     Grouped       M,V    P     -       -       ""
Trigger-Data                        3003   6.4.4     Grouped       M,V    P     -       -       ""
Payload                             3004   6.4.5     OctetString   M,V    P     -       -       ""
Action-Type                         3005   6.4.6     Enumerated    M,V    P     -       -       ""
Priority-Indication                 3006   6.4.7     Enumerated    M,V    P     -       -       ""
Reference-Number                    3007   6.4.8     Unsigned32    M,V    P     -       -       ""
Request-Status                      3008   6.4.9     Enumerated    M,V    P     -       -       ""
Delivery-Outcome                    3009   6.4.10    Enumerated    M,V    P     -       -       ""
Application-Port-Identifier         3010   6.4.11    Unsigned32    M,V    P     -       -       ""
Old-Reference-Number                3011   6.4.12    Unsigned32    V      P     -       M       Device-Trigger-Recall-Replace
Feature-Supported-In-Final-Target   3012   6.4.13    Unsigned32    V      P     -       M       Device-Trigger-Recall-Replace


; Type: Reused AVPs
; Section: 6.5.1
; Table: 6.5.1.1
; Page: 21
; Columns: Name        From       Applicability
MSISDN                 TS29.329   ""
External-Identifier    TS29.336   "" ;; corrected: (TS29.368.py#external-identifier-row-name)
SCS-Identity           TS29.336   ""
Validity-Time          RFC4006    ""
Supported-Features     TS29.229   ""
MTC-Error-Diagnostic   TS29.337   ""
Load                   RFC8583    ""
SM-RP-UI               TS29.338   "MSISDN-less MO-SMS Delivery"


; Type: Grouped AVP
; Name: Device-Action
; Section: 6.4.2
; Page: 16
Device-Action ::= < AVP header: 3001 10415 > ;; corrected: (TS29.368.py#vendor-id-device-action)
        [ External-Identifier ] ;; corrected: (TS29.368.py#external-identifier-in-device-action)
        [ MSISDN ]
        [ SCS-Identity ]
        { Reference-Number }
        [ Old-Reference-Number ]
        { Action-Type }
        [ Trigger-Data ]
        [ Validity-Time ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Device-Notification
; Section: 6.4.3
; Page: 17
Device-Notification ::= < AVP header: 3002 10415 > ;; corrected: (TS29.368.py#vendor-id-device-notification)
        [ External-Identifier ] ;; corrected: (TS29.368.py#external-identifier-in-device-notification)
        [ MSISDN ]
        [ SCS-Identity ]
        { Reference-Number }
        { Action-Type }
        [ Request-Status ]
        [ MTC-Error-Diagnostic ]
        [ Delivery-Outcome ]
        [ SM-RP-UI ]
        [ Application-Port-Identifier ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Trigger-Data
; Section: 6.4.4
; Page: 17
Trigger-Data ::= < AVP header: 3003 10415 > ;; corrected: (TS29.368.py#vendor-id-trigger-data)
        { Payload }
        [ Priority-Indication ]
        [ Application-Port-Identifier ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Action-Type
; Section: 6.4.6
; Page: 17
Action-Type ::= < Enumerated AVP header: 3005 10415 >
        "Device Trigger Request"      = 1
        "Delivery Report"             = 2
        "Device Trigger Recall"       = 3
        "Device Trigger Replace"      = 4
        "MSISDN-less MO-SMS Delivery" = 5


; Type: Enumerated AVP
; Name: Priority-Indication
; Section: 6.4.7
; Page: 18
Priority-Indication ::= < Enumerated AVP header: 3006 10415 >
        Non-Priority = 0
        Priority     = 1


; Type: Enumerated AVP
; Name: Request-Status
; Section: 6.4.9
; Page: 18
Request-Status ::= < Enumerated AVP header: 3008 10415 >
        SUCCESS             = 0
        INVPAYLOAD          = 101
        INVEXTID            = 102
        INVSCSID            = 103
        INVPERIOD           = 104
        NOTAUTHORIZED       = 105
        SERVICEUNAVAILABLE  = 106
        PERMANENTERROR      = 107
        QUOTAEXCEEDED       = 108
        RATEEXCEEDED        = 109
        REPLACEFAIL         = 110
        RECALLFAIL          = 111
        ORIGINALMESSAGESENT = 112
        TEMPORARYERROR      = 201


; Type: Enumerated AVP
; Name: Delivery-Outcome
; Section: 6.4.10
; Page: 19
Delivery-Outcome ::= < Enumerated AVP header: 3009 10415 >
        SUCCESS        = 0
        EXPIRED        = 1
        TEMPORARYERROR = 2
        UNDELIVERABLE  = 3
        UNCONFIRMED    = 4
