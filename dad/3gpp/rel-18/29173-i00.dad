; Type: Grouped AVP
; Name: Serving-Node
; Section: 6.4.3
Serving-Node ::= < AVP header: 2401 10415 >
        [ SGSN-Number ]
        [ SGSN-Name ]
        [ SGSN-Realm ]
        [ MME-Name ]
        [ MME-Realm ]
        [ MSC-Number ]
        [ 3GPP-AAA-Server-Name ]
        [ LCS-Capabilities-Sets ]
        [ GMLC-Address ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Additional-Serving-Node
; Section: 6.4.8
Additional-Serving-Node ::= < AVP header: 2406 10415 >
