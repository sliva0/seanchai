        [ PCRF-Address ]
        [ Origin-State-Id ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Proxy-Info ]
      * [ Supported-Features ]
      * [ Load ]
      * [ AVP ]


