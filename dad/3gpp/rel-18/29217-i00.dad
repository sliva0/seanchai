; Type: Grouped AVP
; Name: Aggregated-Congestion-Info
; Section: 5.3.2
; Page: 14
Aggregated-Congestion-Info ::= < AVP header: 4000 10415 > ;; corrected: (TS29.217.py#vendor-id-aggregated-congestion-info)
        [ Congestion-Location-Id ]
        [ IMSI-List ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Aggregated-RUCI-Report
; Section: 5.3.3
; Page: 14
Aggregated-RUCI-Report ::= < AVP header: 4001 10415 > ;; corrected: (TS29.217.py#vendor-id-aggregated-ruci-report)
     1* { Aggregated-Congestion-Info }
        [ Called-Station-Id ]
        [ Congestion-Level-Value ]
        [ Congestion-Level-Set-Id ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Congestion-Level-Definition
; Section: 5.3.4
; Page: 15
Congestion-Level-Definition ::= < AVP header: 4002 10415 > ;; corrected: (TS29.217.py#vendor-id-congestion-level-definition)
        { Congestion-Level-Set-Id }
        { Congestion-Level-Range }
      * [ AVP ]


; Type: Grouped AVP
; Name: Congestion-Location-Id
; Section: 5.3.8
; Page: 16
Congestion-Location-Id ::= < AVP header: 4006 10415 > ;; corrected: (TS29.217.py#vendor-id-congestion-location-id)
        [ 3GPP-User-Location-Info ]
        [ eNodeB-Id ]
        [ Extended-eNodeB-Id ]
      * [ AVP ]
