<CC-Request> ::= < Diameter Header: 272, REQ, PXY >
        < Session-Id >
        [ DRMP ]
        { Auth-Application-Id }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { CC-Request-Type }
        { CC-Request-Number }
        [ OC-Supported-Features ]             ; bold
        [ CS-Service-QoS-Request-Identifier ] ; bold
        [ CS-Service-QoS-Request-Operation ]  ; bold
        [ Destination-Host ]
        [ HeNB-Local-IP-Address ]             ; bold
        [ Origin-State-Id ]
        [ QoS-Information ]
        [ UDP-Source-Port ]                   ; bold
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: CC-Answer, CCA
; Section: E.6.6.3
<CC-Answer> ::= < Diameter Header: 272, PXY >
        < Session-Id >
        [ DRMP ]
        { Auth-Application-Id }
        { Origin-Host }
        { Origin-Realm }
        [ Result-Code ]
        [ Experimental-Result ]
        { CC-Request-Type }
        { CC-Request-Number }
        [ Origin-State-Id ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
        [ OC-Supported-Features ]
        [ OC-OLR ]
        [ Error-Message ]           ; bold
        [ Error-Reporting-Host ]    ; bold
        [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ Load ]
      * [ AVP ]


; Type: Message
; Name: RA-Request, RAR
; Section: E.6.6.4
<RA-Request> ::= < Diameter Header: 258, REQ, PXY >
        < Session-Id >
        [ DRMP ]
        { Auth-Application-Id }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Destination-Host }
        { Re-Auth-Request-Type }
        [ Origin-State-Id ]
        [ OC-Supported-Features ]      ; bold
      * [ CS-Service-Resource-Report ] ; bold
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: RA-Answer, RAA
; Section: E.6.6.5
<RA-Answer> ::= < Diameter Header: 258, PXY >
        < Session-Id >
        [ DRMP ]
        { Origin-Host }
        { Origin-Realm }
