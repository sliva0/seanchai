; Type: Grouped AVP
; Name: User-Identity
; Section: 6.3.1
; Page: 18
User-Identity ::= < AVP header: 700 10415 >
        [ Public-Identity ]
        [ MSISDN ]
        [ External-Identifier ]
      * [ AVP ]


