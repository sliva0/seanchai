; Page: 55
IMS-Content-Type ::= < Enumerated AVP header: 564 10415 >
        NO_CONTENT_DETAIL = 0
        CAT               = 1
        CONFERENCE        = 2


; Type: Grouped AVP
; Name: Callee-Information
; Section: 5.3.62
; Page: 55
Callee-Information ::= < AVP header: 565 10415 > ;; corrected: (TS29.214.py#vendor-id-callee-information)
        [ Called-Party-Address ]
      * [ Requested-Party-Address ]
      * [ Called-Asserted-Identity ]
      * [ AVP ]


; Type: Grouped AVP
