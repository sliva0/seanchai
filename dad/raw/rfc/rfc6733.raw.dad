; Type: Enumerated AVP
; Name: Disconnect-Cause
; Section: 5.4.3
; Page: 66
Disconnect-Cause ::= < Enumerated AVP header: 273 >
        REBOOTING                  = 0
        BUSY                       = 1
        DO_NOT_WANT_TO_TALK_TO_YOU = 2


; Type: Grouped AVP
; Name: Proxy-Info
; Section: 6.7.2
; Page: 83
Proxy-Info ::= < AVP header: 284 >
        { Proxy-Host }
        { Proxy-State }
      * [ AVP ]


; Type: Grouped AVP
; Name: Vendor-Specific-Application-Id
; Section: 6.11
; Page: 84
Vendor-Specific-Application-Id ::= < AVP header: 260 >
        { Vendor-Id }
        [ Auth-Application-Id ]
        [ Acct-Application-Id ]


; Type: Enumerated AVP
; Name: Redirect-Host-Usage
; Section: 6.13
; Page: 85
Redirect-Host-Usage ::= < Enumerated AVP header: 261 >
        DONT_CACHE            = 0
        ALL_SESSION           = 1
        ALL_REALM             = 2
        REALM_AND_APPLICATION = 3
        ALL_APPLICATION       = 4
        ALL_HOST              = 5
        ALL_USER              = 6


; Type: Grouped AVP
; Name: Failed-AVP
; Section: 7.5
; Page: 96
Failed-AVP ::= < AVP header: 279 >
     1* { AVP }


; Type: Grouped AVP
; Name: Experimental-Result
; Section: 7.6
; Page: 97
Experimental-Result ::= < AVP header: 297 >
        { Vendor-Id }
        { Experimental-Result-Code }


; Type: Enumerated AVP
; Name: Auth-Request-Type
; Section: 8.7
; Page: 116
Auth-Request-Type ::= < Enumerated AVP header: 274 >
        AUTHENTICATE_ONLY      = 1
        AUTHORIZE_ONLY         = 2
        AUTHORIZE_AUTHENTICATE = 3


; Type: Enumerated AVP
; Name: Auth-Session-State
; Section: 8.11
; Page: 118
Auth-Session-State ::= < Enumerated AVP header: 277 >
        STATE_MAINTAINED    = 0
        NO_STATE_MAINTAINED = 1


; Type: Enumerated AVP
; Name: Re-Auth-Request-Type
; Section: 8.12
; Page: 118
Re-Auth-Request-Type ::= < Enumerated AVP header: 285 >
        AUTHORIZE_ONLY         = 0
        AUTHORIZE_AUTHENTICATE = 1


; Type: Enumerated AVP
; Name: Termination-Cause
; Section: 8.15
