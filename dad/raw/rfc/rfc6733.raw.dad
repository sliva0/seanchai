; Type: Message
; Name: Capabilities-Exchange-Request, CER
; Section: 5.3.1
; Page: 62
<Capabilities-Exchange-Request> ::= < Diameter Header: 257, REQ >
        { Origin-Host }
        { Origin-Realm }
     1* { Host-IP-Address }
        { Vendor-Id }
        { Product-Name }
        [ Origin-State-Id ]
      * [ Supported-Vendor-Id ]
      * [ Auth-Application-Id ]
      * [ Inband-Security-Id ]
      * [ Acct-Application-Id ]
      * [ Vendor-Specific-Application-Id ]
        [ Firmware-Revision ]
      * [ AVP ]


; Type: Message
; Name: Capabilities-Exchange-Answer, CEA
; Section: 5.3.2
; Page: 63
<Capabilities-Exchange-Answer> ::= < Diameter Header: 257 >
        { Result-Code }
        { Origin-Host }
        { Origin-Realm }
     1* { Host-IP-Address }
        { Vendor-Id }
        { Product-Name }
        [ Origin-State-Id ]
        [ Error-Message ]
        [ Failed-AVP ]
      * [ Supported-Vendor-Id ]
      * [ Auth-Application-Id ]
      * [ Inband-Security-Id ]
      * [ Acct-Application-Id ]
      * [ Vendor-Specific-Application-Id ]
        [ Firmware-Revision ]
      * [ AVP ]


; Type: Message
; Name: Disconnect-Peer-Request, DPR
; Section: 5.4.1
; Page: 65
<Disconnect-Peer-Request> ::= < Diameter Header: 282, REQ >
        { Origin-Host }
        { Origin-Realm }
        { Disconnect-Cause }
      * [ AVP ]


; Type: Message
; Name: Disconnect-Peer-Answer, DPA
; Section: 5.4.2
; Page: 65
<Disconnect-Peer-Answer> ::= < Diameter Header: 282 >
        { Result-Code }
        { Origin-Host }
        { Origin-Realm }
        [ Error-Message ]
        [ Failed-AVP ]
      * [ AVP ]


; Type: Message
; Name: Device-Watchdog-Request, DWR
; Section: 5.5.1
; Page: 67
<Device-Watchdog-Request> ::= < Diameter Header: 280, REQ >
        { Origin-Host }
        { Origin-Realm }
        [ Origin-State-Id ]
      * [ AVP ]


; Type: Message
; Name: Device-Watchdog-Answer, DWA
; Section: 5.5.2
; Page: 67
<Device-Watchdog-Answer> ::= < Diameter Header: 280 >
        { Result-Code }
        { Origin-Host }
        { Origin-Realm }
        [ Error-Message ]
        [ Failed-AVP ]
        [ Origin-State-Id ]
      * [ AVP ]


; Type: Message
; Name: Re-Auth-Request, RAR
; Section: 8.3.1
; Page: 110
<Re-Auth-Request> ::= < Diameter Header: 258, REQ, PXY >
        < Session-Id >
