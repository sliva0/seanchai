; Values: the IANA registry for Termination-Cause AVP Values [IANATCV]
Termination-Cause ::= < Enumerated AVP header: 295 >


; Type: Enumerated AVP
; Name: Session-Server-Failover
; Section: 8.18
; Page: 121
Session-Server-Failover ::= < Enumerated AVP header: 271 >
        REFUSE_SERVICE          = 0
