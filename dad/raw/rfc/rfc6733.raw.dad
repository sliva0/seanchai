        ALLOW_SERVICE           = 2
        TRY_AGAIN_ALLOW_SERVICE = 3


; Type: Enumerated AVP
; Name: Accounting-Record-Type
; Section: 9.8.1
; Page: 129
Accounting-Record-Type ::= < Enumerated AVP header: 480 >
        EVENT_RECORD   = 1
        START_RECORD   = 2
