        { Origin-Realm }
        { Destination-Realm }
        { Destination-Host }
        { Auth-Application-Id }
        { Re-Auth-Request-Type }
        [ User-Name ]
        [ Origin-State-Id ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: Re-Auth-Answer, RAA
; Section: 8.3.2
; Page: 110
<Re-Auth-Answer> ::= < Diameter Header: 258, PXY >
