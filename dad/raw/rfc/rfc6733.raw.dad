        [ Error-Message ]
        [ Error-Reporting-Host ]
        [ Failed-AVP ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Proxy-Info ]
      * [ AVP ]


; Type: Message
