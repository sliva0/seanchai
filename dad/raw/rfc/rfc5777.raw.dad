      * [ EUI64-Address ]
      * [ EUI64-Address-Mask ]
      * [ Port ]
      * [ Port-Range ]
        [ Negated ]
        [ Use-Assigned-Address ]
      * [ AVP ]


; Type: Grouped AVP
; Name: To-Spec
; Section: 4.1.6
; Page: 10
To-Spec ::= < AVP header: 516 >
      * [ IP-Address ]
      * [ IP-Address-Range ]
      * [ IP-Address-Mask ]
