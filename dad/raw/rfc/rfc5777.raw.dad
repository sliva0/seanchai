      * [ MAC-Address-Mask ]
      * [ EUI64-Address ]
      * [ EUI64-Address-Mask ]
      * [ Port ]
      * [ Port-Range ]
        [ Negated ]
        [ Use-Assigned-Address ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Negated
; Section: 4.1.7.1
