; Type: Enumerated AVP
; Name: QoS-Semantics
; Section: 5.4
; Page: 28
QoS-Semantics ::= < Enumerated AVP header: 575 >
        QoS-Desired    = 0
        QoS-Available  = 1
        QoS-Delivered  = 2
        Minimum-QoS    = 3
        QoS-Authorized = 4


; Type: Grouped AVP
; Name: QoS-Parameters
; Section: 5.5
; Page: 29
QoS-Parameters ::= < AVP header: 576 >
      * [ AVP ]


; Type: Grouped AVP
; Name: Excess-Treatment
; Section: 5.6
; Page: 29
Excess-Treatment ::= < AVP header: 577 >
        { Treatment-Action }
        [ QoS-Profile-Template ]
        [ QoS-Parameters ]
      * [ AVP ]
