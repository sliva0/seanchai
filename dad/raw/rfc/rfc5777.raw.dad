; Values: IANA under the Protocol Numbers registry as defined in [RFC2780]
Protocol ::= < Enumerated AVP header: 513 >


; Type: Enumerated AVP
; Name: Direction
; Section: 4.1.4
; Page: 9
Direction ::= < Enumerated AVP header: 514 >
        IN   = 0
        OUT  = 1
        BOTH = 2


