        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Accounting-Record-Type }
        { Accounting-Record-Number }
        [ Acct-Application-Id ]
        [ User-Name ]
        [ Destination-Host ]
        [ Acct-Interim-Interval ]
