        [ ISUP-Cause ]
        [ Start-Time ]
        [ Start-of-Charging ]
        [ Stop-Time ]
        [ PS-Free-Format-Data ]


; Type: Grouped AVP
; Name: VoLTE-Information
; Section: 7.2.242C
; Page: 200
VoLTE-Information ::= < AVP header: 1323 >
        [ Calling-Party-Address ]
        [ Callee-Information ]


; Type: Grouped AVP
; Name: Variable-Part
; Section: 7.2.242aA
; Page: 199
Variable-Part ::= < AVP header: 3907 >
        [ Variable-Part-Order ]
        { Variable-Part-Type }
        { Variable-Part-Value }


; Type: Grouped AVP
; Name: UWAN-User-Location-Info
; Section: 7.2.242aaA
; Page: 198
UWAN-User-Location-Info ::= < AVP header: 3918 >
        { UE-Local-IP-Address }
        [ UDP-Source-Port ]
        [ SSID ]
        [ BSSID ]
        [ TCP-Source-Port ]
        [ Civic-Address-Information ]
        [ WLAN-Operator-Id ]
        [ Logical-Access-ID ]


; Type: Grouped AVP
; Name: WLAN-Operator-Id
; Section: 7.2.251
; Page: 201
WLAN-Operator-Id ::= < AVP header: 1306 >
        [ WLAN-PLMN-Id ]
        [ WLAN-Operator-Name ]


; Type: Grouped AVP
; Name: PSCell-Info
; Section: 7.2.255
; Page: 201
PSCell-Info ::= < AVP header: 1324 >
        [ Nr-Cgi ]


; Type: Enumerated AVP
; Name: 3GPP-OC-Request-Type
; Section: B.2.2
3GPP-OC-Request-Type ::= < Enumerated AVP header: 1322 10415 >
        INITIAL_REQUEST     = 1
        UPDATE_REQUEST      = 2
        TERMINATION_REQUEST = 3
        EVENT_REQUEST       = 4


; Type: Grouped AVP
; Name: 3GPP-OC-Specific-Reduction
; Section: B.2.3
3GPP-OC-Specific-Reduction ::= < AVP header: 1320 >
      * [ 3GPP-OC-Rating-Group ]
      * [ 3GPP-OC-Request-Type ]
        [ OC-Reduction-Percentage ]
      * [ AVP ]


; Type: Grouped AVP
; Name: OC-OLR
; Section: B.2.4
OC-OLR ::= < AVP header: 623 >
        < OC-Sequence-Number >
        < OC-Report-Type >
        [ OC-Reduction-Percentage ]
        [ OC-Validity-Duration ]
      * [ 3GPP-OC-Specific-Reduction ]
      * [ AVP ]
