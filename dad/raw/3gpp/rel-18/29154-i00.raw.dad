; Type: Message
; Name: BT-Request, BTR
; Section: 5.6.2
; Page: 15
<BT-Request> ::= < Diameter Header: 8388723, REQ, PXY >
        < Session-Id >
        [ DRMP ]
        { Vendor-Specific-Application-Id }
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Transfer-Request-Type }
        [ Destination-Host ]
        [ OC-Supported-Features ]                 ; bold
        [ Application-Service-Provider-Identity ]
        [ CC-Output-Octets ]
        [ CC-Input-Octets ]
        [ CC-Total-Octets ]
        [ Number-Of-UEs ]
        [ Time-Window ]
        [ Network-Area-Info-List ]
        [ Reference-Id ]
        [ Transfer-Policy-Id ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ Supported-Features ]
      * [ AVP ]


