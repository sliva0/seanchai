; Type: Enumerated AVP
; Name: GBA_U-Awareness-Indicator
; Section: 6.3.1.8
; Page: 40
GBA_U-Awareness-Indicator ::= < Enumerated AVP header: 407 10415 >
        NO  = 0 ; The sending node is not GBA_U aware
        YES = 1 ; The sending node is GBA_U aware


; Type: Enumerated AVP
; Name: GBA-Type
; Section: 6.3.1.11
; Page: 41
GBA-Type ::= < Enumerated AVP header: 410 10415 >
        "3G GBA"     = 0 ; The 3G GBA has been performed as defined in TS 33.220 [5].
        "2G GBA"     = 1 ; The 2G GBA has been performed as defined in TS 33.220 [5] , Annex I.
        "GBA Digest" = 2 ; The GBA Digest has been performed as defined in TS 33.220 [5], Annex M.


; Type: Enumerated AVP
; Name: UE-Id-Type
; Section: 6.3.1.13
; Page: 41
UE-Id-Type ::= < Enumerated AVP header: 412 10415 >
        "Private user identity" = 0
        "Public user identity"  = 1


; Type: Enumerated AVP
; Name: UICC-ME
; Section: 6.3.1.15
; Page: 41
UICC-ME ::= < Enumerated AVP header: 414 10415 >
        GBA_ME = 0 ; GBA_ME shall be run.
        GBA_U  = 1 ; GBA_U shall be run.


; Type: Enumerated AVP
; Name: Private-Identity-Request
; Section: 6.3.1.17
; Page: 42
Private-Identity-Request ::= < Enumerated AVP header: 416 10415 >
        "Private identity requested"     = 0
        "Private identity not requested" = 1


; Type: Enumerated AVP
; Name: SHA-256-Indication
; Section: 6.3.1.22
; Page: 42
SHA-256-Indication ::= < Enumerated AVP header: 421 10415 >
        UICC_NOT_SUPPORT_SHA256 = 0 ; UICC does not support SHA-256
        UICC_SUPPORT_SHA256     = 1 ; UICC supports SHA-256
