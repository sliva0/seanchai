; Type: AVP
; Name: User-Identity
; Section: 6.3.1
; Page: 18
User-Identity ::= < AVP header: 700 10415 >
        [ Public-Identity ]
        [ MSISDN ]
        [ External-Identifier ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Data-Reference
; Section: 6.3.4
; Page: 18
Data-Reference ::= < Enumerated AVP header: 703 10415 >
        RepositoryData                    = 0
        IMSPublicIdentity                 = 10
        IMSUserState                      = 11
        S-CSCFName                        = 12
        InitialFilterCriteria             = 13
        LocationInformation               = 14
        UserState                         = 15
        ChargingInformation               = 16
        MSISDN                            = 17
        PSIActivation                     = 18
        DSAI                              = 19
        ServiceLevelTraceInfo             = 21
        IPAddressSecureBindingInformation = 22
        ServicePriorityLevel              = 23
        SMSRegistrationInfo               = 24
        UEReachabilityForIP               = 25
        TADSinformation                   = 26
        STN-SR                            = 27
        UE-SRVCC-Capability               = 28
        ExtendedPriority                  = 29
        CSRN                              = 30
        ReferenceLocationInformation      = 31
        IMSI                              = 32
        IMSPrivateUserIdentity            = 33
        IMEISV                            = 34
        UE-5G-SRVCC-Capability            = 35


; Type: Enumerated AVP
; Name: Subs-Req-Type
; Section: 6.3.6
; Page: 19
Subs-Req-Type ::= < Enumerated AVP header: 705 10415 >
        Subscribe   = 0 ; This value is used by an AS to subscribe to notifications of changes in data.
        Unsubscribe = 1 ; This value is used by an AS to unsubscribe to notifications of changes in data.


; Type: Enumerated AVP
; Name: Subs-Req-Type
; Section: 6.3.7
; Page: 20
Requested-Domain ::= < Enumerated AVP header: 706 10415 >
        CS-Domain = 0 ; The requested data apply to the CS domain.
        PS-Domain = 1 ; The requested data apply to the PS domain


; Type: AVP
; AVP Name: Repository-Data-ID
; Section: 6.3.24
; Page: 22
Repository-Data-ID ::= < AVP header: 715 10415 >
        { Service-Indication }
        { Sequence-Number }
      * [ AVP ]


; Type: AVP
; Name: Call-Reference-Info
; Section: 6.3.29
; Page: 23
Call-Reference-Info ::= < AVP header: 720 10415 >
        { Call-Reference-Number }
        { AS-Number }
      * [ AVP ]

