; Section: 7.3.21
; Page: 119
Network-Access-Mode ::= < Enumerated AVP header: 1417 10415 >
        PACKET_AND_CIRCUIT = 0
        Reserved           = 1
        ONLY_PACKET        = 2


; Type: Enumerated AVP
; Name: Cancellation-Type
; Section: 7.3.24
; Page: 119
Cancellation-Type ::= < Enumerated AVP header: 1420 10415 >
        MME_UPDATE_PROCEDURE     = 0
        SGSN_UPDATE_PROCEDURE    = 1
        SUBSCRIPTION_WITHDRAWAL  = 2 ; - when the Cancel Location is sent by the HSS to the current MME or SGSN due to withdrawal of the user's subscription by the HSS operator; - when the Cancel VCSG Location is sent by the CSS to the current MME or SGSN due to withdrawal of the user's VPLMN CSG subscription by the CSS operator.
        UPDATE_PROCEDURE_IWF     = 3
        INITIAL_ATTACH_PROCEDURE = 4


; Type: Enumerated AVP
; Name: Subscriber-Status
; Section: 7.3.29
; Page: 124
Subscriber-Status ::= < Enumerated AVP header: 1424 10415 >
        SERVICE_GRANTED             = 0
        OPERATOR_DETERMINED_BARRING = 1


