{
  "name": "dad-syntax",
  "displayName": "Diameter AVP Dictionary (.dad)",
  "description": "Syntax highlighting for Seanchaí .dad files",
  "version": "0.1.0",
  "publisher": "seanchai",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:dad"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dad",
        "aliases": [
          "Diameter AVP Dictionary",
          "dad"
        ],
        "extensions": [
          ".dad"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dad",
        "scopeName": "source.dad",
        "path": "./syntaxes/dad.tmLanguage.json"
      }
    ]
  }
}
