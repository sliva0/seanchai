Codec-Data        524    TS29.214   OctetString


; Type: Grouped AVP
; Name: Binding-information
; Section: 7.3.1
; Page: 23
Binding-information ::= < AVP header: 450 13019 >
        { Binding-Input-List }
        [ Binding-Output-List ]


; Type: Grouped AVP
; Name: Binding-Input-List
; Section: 7.3.2
; Page: 23
Binding-Input-List ::= < AVP header: 451 13019 >
      * [ V6-Transport-Address ]
      * [ V4-Transport-Address ]


; Type: Grouped AVP
; Name: Binding-Output-List
; Section: 7.3.3
; Page: 23
Binding-Output-List ::= < AVP header: 452 13019 >
      * [ V6-Transport-Address ]
      * [ V4-Transport-Address ]


; Type: Grouped AVP
; Name: Transport-Address
; Section: 7.3.4
; Page: 23
Transport-Address ::= < AVP header: 453 13019 >
        { Framed-IPv6-Prefix }
        { Port-Number }


; Type: Grouped AVP
; Name: Transport-Address
; Section: 7.3.5
; Page: 24
Transport-Address ::= < AVP header: 454 13019 >
        { Framed-IP-Address }
        { Port-Number }


; Type: Enumerated AVP
; Name: Latching-Indication
; Section: 7.3.8
; Page: 24
Latching-Indication ::= < Enumerated AVP header: 457 13019 >
        LATCH   = 0
        RELATCH = 1


; Type: Enumerated AVP
; Name: Reservation-Priority
; Section: 7.3.9
; Page: 24
Reservation-Priority ::= < Enumerated AVP header: 458 13019 >
        DEFAULT           = 0
        PRIORITY-ONE      = 1
        PRIORITY-TWO      = 2
        PRIORITY-THREE    = 3
        PRIORITY-FOUR     = 4
        PRIORITY-FIVE     = 5
        PRIORITY-SIX      = 6
        PRIORITY-SEVEN    = 7
        PRIORITY-EIGHT    = 8
        PRIORITY-NINE     = 9
        PRIORITY-TEN      = 10
        PRIORITY-ELEVEN   = 11
        PRIORITY-TWELVE   = 12
        PRIORITY-THIRTEEN = 13
        PRIORITY-FOURTEEN = 14
        PRIORITY-FIFTEEN  = 15


; Type: Grouped AVP
; Name: Globally-Unique-Address
; Section: 7.3.10
; Page: 25
Globally-Unique-Address ::= < AVP header: 300 13019 >
        [ Framed-IP-Address ]
        [ Framed-IPv6-Prefix ]
        [ Address-Realm ]


; Type: Enumerated AVP
; Name: Session-Abort-Cause
; Section: 7.3.14
; Page: 25
Session-Abort-Cause ::= < Enumerated AVP header: 500 10415 >
        BEARER_RELEASED               = 0
        INSUFFICIENT_SERVER_RESOURCES = 1
        INSUFFICIENT_BEARER_RESOURCES = 2


; Type: Grouped AVP
; Name: Flow-Grouping
; Section: 7.3.18
; Page: 26
Flow-Grouping ::= < AVP header: 508 >
      * [ Flows ]


; Type: Grouped AVP
; Name: Flows
; Section: 7.3.20
; Page: 27
Flows ::= < AVP header: x >
        { Media-Component-Number }
      * [ Flow-Number ]


; Type: Enumerated AVP
; Name: Flow-Status
; Section: 7.3.21
; Page: 27
Flow-Status ::= < Enumerated AVP header: 511 10415 >
        ENABLED-UPLINK   = 0
        ENABLED-DOWNLINK = 1
        ENABLED          = 2
        DISABLED         = 3
        REMOVED          = 4


; Type: Enumerated AVP
; Name: Flow-Usage
; Section: 7.3.22
; Page: 27
Flow-Usage ::= < Enumerated AVP header: 512 10415 >
        NO_INFORMATION = 0
        RTCP           = 1


; Type: Enumerated AVP
; Name: Specific-Action
; Section: 7.3.23
; Page: 28
Specific-Action ::= < Enumerated AVP header: 513 10415 >
        INDICATION_OF_LOSS_OF_BEARER         = 2
        INDICATION_OF_RECOVERY_OF_BEARER     = 3
        INDICATION_OF_RELEASE_OF_BEARER      = 4
        INDICATION_OF_SUBSCRIBER_DETACHMENT  = 6
        INDICATION_OF_RESERVATION_EXPIRATION = 7


; Type: Grouped AVP
; Name: Media-Component-Description
; Section: 7.3.26
; Page: 29
Media-Component-Description ::= < AVP header: 517 >
        { Media-Component-Number } ;; Ordinal number of the media comp.
      * [ Media-Sub-Component ] ;; Set of flows for one flow identifier
        [ AF-Application-Identifier ]
        [ Media-Type ]
        [ Max-Requested-Bandwidth-UL ]
        [ Max-Requested-Bandwidth-DL ]
        [ Flow-Status ]
        [ RS-Bandwidth ]
        [ RR-Bandwidth ]
        [ Reservation-Class ]
        [ Reservation-Priority ]
        [ Transport-Class ]
      * [ Codec-Data ]
      * [ Media-Authorization-Context-Id ]


; Type: Grouped AVP
; Name: Media-Sub-Component
; Section: 7.3.28
; Page: 30
Media-Sub-Component ::= < AVP header: 519 >
        { Flow-Number } ;; Ordinal number of the IP flow
     *2 [ Flow-Description ] ;; UL and/or DL
        [ Flow-Status ]
        [ Flow-Usage ]
        [ Max-Requested-Bandwidth-UL ]
        [ Max-Requested-Bandwidth-DL ]


; Type: Enumerated AVP
; Name: Media-Type
; Section: 7.3.29
; Page: 30
Media-Type ::= < Enumerated AVP header: 520 10415 >
        AUDIO       = 0
        VIDEO       = 1
        DATA        = 2
        APPLICATION = 3
        CONTROL     = 4
        TEXT        = 5
        MESSAGE     = 6
        OTHER       = 4294967295


; Type: Enumerated AVP
; Name: SIP_Forking
; Section: 7.3.32
; Page: 31
SIP_Forking ::= < Enumerated AVP header: 523 10415 >
        SINGLE_DIALOGUE   = 0
        SEVERAL_DIALOGUES = 1


; Type: Enumerated AVP
; Name: Overbooking-indicator
; Section: 7.3.35
; Page: 31
Overbooking-indicator ::= < Enumerated AVP header: 460 13019 >
        Overbooking-indicator = 0 ; means that no overbooking mode is required
        Overbooking-indicator = 1 ; means that overbooking is mode required
