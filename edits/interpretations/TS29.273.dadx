;; S6b, clause 9: the tables of clause 9.1.2, describing the commands of
;; clause 9.2.2 under 16777272. The authorization requests and answers of
;; PMIPv6 or GTPv2 (clause 9.1.2.2) and of DSMIPv6 (clause 9.1.2.5) share
;; the AA-Request and -Answer of clause 9.2.2.2; MIPv4's are clause 9.2.2.5's.
;; The PGW identity is the request's MIP6-Agent-Info, its FQDN
;; MIP-Home-Agent-Host's Destination-Host; so in each S6b request below.
; Type: Interpreted Constraints
; Id: s6b-der-auth-request-type
; AVP: Auth-Request-Type
; Command: Diameter-EAP-Request
; Application-ID: 16777272
; Section: 9.1.2.1.1
; Table: 9.1.2.1/1
; Versions: 18.6.0..19.2.0
"AUTHORIZE_AUTHENTICATE shall be used in this case."
    range 3


; Type: Interpreted Constraints
; Id: s6b-der-visited-network-identifier
; AVP: Visited-Network-Identifier
; Command: Diameter-EAP-Request
; Application-ID: 16777272
; Section: 9.1.2.1.1
; Table: 9.1.2.1/1
; Versions: 18.6.0..19.2.0
"It shall be present when the PGW Identity does not contain an FQDN."
    present-if MIP6-Agent-Info and not MIP6-Agent-Info/MIP-Home-Agent-Host


; Type: Interpreted Constraints
; Id: s6b-der-rat-type
; AVP: RAT-Type
; Command: Diameter-EAP-Request
; Application-ID: 16777272
; Section: 9.1.2.1.1
; Table: 9.1.2.1/1
; Versions: 18.6.0..19.2.0
"This IE shall be present if it is available when the PDN GW sends the request."
    text-only


; Type: Interpreted Constraints
; Id: s6b-dea-auth-request-type
; AVP: Auth-Request-Type
; Command: Diameter-EAP-Answer
; Application-ID: 16777272
; Section: 9.1.2.1.1
; Table: 9.1.2.1/2
; Versions: 18.6.0..19.2.0
"It shall contain the value AUTHORIZE_AUTHENTICATE."
    range 3


; Type: Interpreted Constraints
; Id: s6b-dea-eap-master-session-key
; AVP: EAP-Master-Session-Key
; Command: Diameter-EAP-Answer
; Application-ID: 16777272
; Section: 9.1.2.1.1
; Table: 9.1.2.1/2
; Versions: 18.6.0..19.2.0
"It shall be present only if the result code is set to success."
    requires Result-Code = DIAMETER_SUCCESS


;; Clause 5.2.3.3 lists the flags in prose, which the file holds as no
;; bit table: a bits rule names only bits a table holds.
; Type: Interpreted Constraints
; Id: s6b-dea-mip6-feature-vector
; AVP: MIP6-Feature-Vector
; Command: Diameter-EAP-Answer
; Application-ID: 16777272
; Section: 9.1.2.1.1
; Table: 9.1.2.1/2
; Versions: 18.6.0..19.2.0
"This AVP shall be present if the authorization was successful."
    present-if Result-Code = DIAMETER_SUCCESS
"None of the PMIP6_SUPPORTED or MIP4_SUPPORTED flags shall be set, since DSMIPv6 is used in this case."
    text-only


; Type: Interpreted Constraints
; Id: s6b-dea-mobile-node-identifier
; AVP: Mobile-Node-Identifier
; Command: Diameter-EAP-Answer
; Application-ID: 16777272
; Section: 9.1.2.1.1
; Table: 9.1.2.1/2
; Versions: 18.6.0..19.2.0
"This information element shall only be sent if the Result-Code AVP is set to DIAMETER_SUCCESS."
    requires Result-Code = DIAMETER_SUCCESS
"This IE shall not include the leading digit prepended in front of the IMSI used to differentiate between authentication schemes."
    text-only


; Type: Interpreted Constraints
; Id: s6b-dea-apn-configuration
; AVP: APN-Configuration
; Command: Diameter-EAP-Answer
; Application-ID: 16777272
; Section: 9.1.2.1.1
; Table: 9.1.2.1/2
; Versions: 18.6.0..19.2.0
"This information element shall only be sent if the Result-Code AVP is set to DIAMETER_SUCCESS."
    requires Result-Code = DIAMETER_SUCCESS


;; DIAMETER_SUCCESS_RELOCATE_HA is IETF RFC 5778's 2009 (clause 7.1),
;; a document this file does not name as a base.
; Type: Interpreted Constraints
; Id: s6b-dea-mip6-agent-info
; AVP: MIP6-Agent-Info
; Command: Diameter-EAP-Answer
; Application-ID: 16777272
; Section: 9.1.2.1.1
; Table: 9.1.2.1/2
; Versions: 18.6.0..19.2.0
"This information element shall only be sent if the Result-Code AVP is set to DIAMETER_SUCCESS_RELOCATE_HA indicating to the PDN GW that it shall initiate a HA switch procedure towards the UE."
    requires Result-Code = 2009


; Type: Interpreted Constraints
; Id: s6b-dea-qos-resources
; AVP: QoS-Resources
; Command: Diameter-EAP-Answer
; Application-ID: 16777272
; Section: 9.1.2.1.1
; Table: 9.1.2.1/2
; Versions: 18.6.0..19.2.0
"This AVP shall be included only if the QoS-Capability AVP was received in the authorization request and the authorization succeeded."
    requires request/QoS-Capability
    requires Result-Code in 2000..2999
"The QoS profile template value in this IE shall be set to 0."
    text-only


; Type: Interpreted Constraints
; Id: s6b-dea-redirect-host
; AVP: Redirect-Host
; Command: Diameter-EAP-Answer
; Application-ID: 16777272
; Section: 9.1.2.1.1
; Table: 9.1.2.1/2
; Versions: 18.6.0..19.2.0
"This information element shall be sent if the Result-Code value is set to DIAMETER_REDIRECT_INDICATION."
    present-if Result-Code = DIAMETER_REDIRECT_INDICATION


;; The command's body prints no AN-Trusted: the row describes an AVP the
;; ABNF carries only as *[ AVP ], so no scope names the command.
; Type: Interpreted Constraints
; Id: s6b-dea-an-trusted
; AVP: AN-Trusted
; Section: 9.1.2.1.1
; Table: 9.1.2.1/2
; Versions: 18.6.0..19.2.0
"This AVP shall be present if the 3GPP AAA Server is able to make decision on whether the access network is Trusted or Untrusted."
    text-only


; Type: Interpreted Constraints
; Id: s6b-dea-trace-info
; AVP: Trace-Info
; Command: Diameter-EAP-Answer
; Application-ID: 16777272
; Section: 9.1.2.1.1
; Table: 9.1.2.1/2
; Versions: 18.6.0..19.2.0
"This AVP shall be included if the subscriber and equipment trace has been activated for the user in the HSS and signalling based activation is to be used to download the trace activation from the HSS to the PDN GW."
    text-only
"Only the Trace-Data AVP shall be included to the Trace-Info AVP"
    members only Trace-Data


;; The AAA server's detailed behaviour: the answer relocating the HA
;; names the new PDN GW.
; Type: Interpreted Constraints
; Id: s6b-dea-relocate-ha-mip6-agent-info
; AVP: MIP6-Agent-Info
; Command: Diameter-EAP-Answer
; Application-ID: 16777272
; Section: 9.1.2.1.3
; Versions: 18.6.0..19.2.0
"If the HSS indicates that the user is currently being served by a different PDN GW, the 3GPP AAA Server shall respond to to the PDN GW with the Result-Code set to DIAMETER_SUCCESS_RELOCATE_HA and include the new assigned PDN GW identity in the MIP6-Agent-Info AVP."
    present-if Result-Code = 2009
    members at-least-one MIP-Home-Agent-Address MIP-Home-Agent-Host


;; Both procedures sharing the print, PMIPv6's or GTPv2's (clause
;; 9.1.2.2) and DSMIPv6's (clause 9.1.2.5), set it so.
; Type: Interpreted Constraints
; Id: s6b-aar-auth-request-type
; AVP: Auth-Request-Type
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.2.1
; Section: 9.1.2.2.1
; Table: 9.1.2.2.1/1
; Versions: 18.6.0..19.2.0
"AUTHORIZE_ONLY shall be used in this case."
    range 2


; Type: Interpreted Constraints
; Id: s6b-aar-mip6-agent-info
; AVP: MIP6-Agent-Info
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.2.1
; Section: 9.1.2.2.1
; Table: 9.1.2.2.1/1
; Versions: 18.6.0..19.2.0
"It shall be present on the first authorization request sent by the PGW to the 3GPP AAA Server for a given APN."
    text-only
"Also, it shall be present to communicate to the 3GPP AAA Server the identity of the PDN GW used for the establishment of emergency PDN connections."
    present-if Emergency-Services bit Emergency-Indication
    members at-least-one MIP-Home-Agent-Address MIP-Home-Agent-Host


; Type: Interpreted Constraints
; Id: s6b-aar-visited-network-identifier
; AVP: Visited-Network-Identifier
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.2.1
; Section: 9.1.2.2.1
; Table: 9.1.2.2.1/1
; Versions: 18.6.0..19.2.0
"It shall be present when the PGW Identity is present and does not contain an FQDN."
    present-if MIP6-Agent-Info and not MIP6-Agent-Info/MIP-Home-Agent-Host


; Type: Interpreted Constraints
; Id: s6b-aar-qos-capability
; AVP: QoS-Capability
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.2.1
; Section: 9.1.2.2.1
; Table: 9.1.2.2.1/1
; Versions: 18.6.0..19.2.0
"The PDN GW shall not include this IE if the Emergency-Indication bit of the Emergency-Services AVP is set in the message."
    absent-if Emergency-Services bit Emergency-Indication


; Type: Interpreted Constraints
; Id: s6b-aar-origination-time-stamp
; AVP: Origination-Time-Stamp
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.2.1
; Section: 9.1.2.2.1
; Table: 9.1.2.2.1/1
; Versions: 18.6.0..19.2.0
"The PGW shall include this IE if it received the Origination Time Stamp from the MME/SGSN or TWAN/ePDG and if the PGW supports the procedure specified in clause 13.2"
    text-only


; Type: Interpreted Constraints
; Id: s6b-aar-maximum-wait-time
; AVP: Maximum-Wait-Time
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.2.1
; Section: 9.1.2.2.1
; Table: 9.1.2.2.1/1
; Versions: 18.6.0..19.2.0
"The PGW shall include this IE if it received the Maximum Wait Time from the MME/SGSN or TWAN/ePDG, and the PGW supports the procedure specified in clause 13.3"
"and the 3GPP AAA Server pertains to the same PLMN as the PGW or if the 3GPP AAA Server pertains to a different PLMN and operator policy in the PGW allows to use this procedure towards this PLMN."
    text-only


; Type: Interpreted Constraints
; Id: s6b-aar-emergency-services
; AVP: Emergency-Services
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.2.1
; Section: 9.1.2.2.1
; Table: 9.1.2.2.1/1
; Versions: 18.6.0..19.2.0
"The PGW shall include this information element, with the Emergency-Indication bit set, during the establishment of an emergency PDN connection."
    text-only


; Type: Interpreted Constraints
; Id: s6b-aaa-auth-request-type
; AVP: Auth-Request-Type
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.2.2
; Section: 9.1.2.2.1
; Table: 9.1.2.2.1/2
; Versions: 18.6.0..19.2.0
"It shall contain the value AUTHORIZE_ONLY."
    range 2


;; PMIPv6's and GTPv2's request carries MIP6-Feature-Vector (table
;; 9.1.2.2.1/1), DSMIPv6's, sharing the print, none (table
;; 9.1.2.5.1/3): the request's tells the procedures apart.
; Type: Interpreted Constraints
; Id: s6b-aaa-mip6-feature-vector
; AVP: MIP6-Feature-Vector
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.2.2
; Request-Section: 9.2.2.2.1
; Section: 9.1.2.2.1
; Table: 9.1.2.2.1/2
; Versions: 18.6.0..19.2.0
"The 3GPP AAA Server shall insert this AVP if the authorization was successful."
    present-if Result-Code = DIAMETER_SUCCESS and request/MIP6-Feature-Vector
"The PMIP6_SUPPORTED or the GTPv2_SUPPORTED flag shall be set according to the value received in the Authorization request."
    text-only


; Type: Interpreted Constraints
; Id: s6b-aaa-apn-configuration
; AVP: APN-Configuration
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.2.2
; Request-Section: 9.2.2.2.1
; Section: 9.1.2.2.1
; Table: 9.1.2.2.1/2
; Versions: 18.6.0..19.2.0
"This information element shall only be sent if the Result-Code AVP is set to DIAMETER_SUCCESS."
    requires Result-Code = DIAMETER_SUCCESS
"This information element shall not be included in the Authorization Answer if the Emergency-Indication bit of the Emergency-Services AVP is set in the Authorization Request."
    absent-if request/Emergency-Services bit Emergency-Indication


;; PMIPv6's and GTPv2's table: DSMIPv6's service authorization update,
;; sharing the print, sends the authorized QoS profile without a
;; QoS-Capability (table 9.1.2.5.1/4), and its request carries no
;; MIP6-Feature-Vector, which PMIPv6's and GTPv2's does.
; Type: Interpreted Constraints
; Id: s6b-aaa-qos-resources
; AVP: QoS-Resources
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.2.2
; Request-Section: 9.2.2.2.1
; Section: 9.1.2.2.1
; Table: 9.1.2.2.1/2
; Versions: 18.6.0..19.2.0
"This AVP shall be included only if the QoS-Capability AVP was received in the authorization request and the authorization succeeded."
    requires request/QoS-Capability and Result-Code = DIAMETER_SUCCESS or not request/MIP6-Feature-Vector
"The QoS profile template value in this IE shall be set to 0."
    text-only


; Type: Interpreted Constraints
; Id: s6b-aaa-redirect-host
; AVP: Redirect-Host
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.2.2
; Section: 9.1.2.2.1
; Table: 9.1.2.2.1/2
; Versions: 18.6.0..19.2.0
"This information element shall be sent if the Result-Code value is set to DIAMETER_REDIRECT_INDICATION."
    present-if Result-Code = DIAMETER_REDIRECT_INDICATION


; Type: Interpreted Constraints
; Id: s6b-aaa-trace-info
; AVP: Trace-Info
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.2.2
; Section: 9.1.2.2.1
; Table: 9.1.2.2.1/2
; Versions: 18.6.0..19.2.0
"In an authorization response sent during the authorization procedure at PDN connection setup, the Trace-Data AVP shall be included."
"In an authorization response sent during the service authorization information update procedure, - the Trace-data AVP shall be included if trace activation is requested - the Trace-Reference AVP shall be included, if trace deactivation is requested."
    text-only


; Type: Interpreted Constraints
; Id: s6b-rar-re-auth-request-type
; AVP: Re-Auth-Request-Type
; Command: Re-Auth-Request
; Application-ID: 16777272
; Section: 9.1.2.5.1
; Table: 9.1.2.5.1/1
; Versions: 18.6.0..19.2.0
"AUTHORIZE_ONLY shall be used in this case."
    range 0


;; RAR-Flags' bits are Trust-Relationship-Update-indication (0) and
;; P-CSCF Restoration Request (1) (table 9.2.3.1.5/1).
; Type: Interpreted Constraints
; Id: s6b-rar-flags-p-cscf-restoration
; AVP: RAR-Flags
; Command: Re-Auth-Request
; Application-ID: 16777272
; Section: 9.1.2.5.1
; Versions: 18.6.0..19.2.0
"If the re-authorization request is used for the purpose of the P-CSCF restoration for WLAN, only the P-CSCF Restoration Request bit shall be set in the RAR Flags."
    bits at-most-one 0 1


; Type: Interpreted Constraints
; Id: s6b-dsmip-aar-visited-network-identifier
; AVP: Visited-Network-Identifier
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.2.1
; Section: 9.1.2.5.1
; Table: 9.1.2.5.1/3
; Versions: 18.6.0..19.2.0
"It shall be present when the PGW Identity does not contain an FQDN."
    present-if MIP6-Agent-Info and not MIP6-Agent-Info/MIP-Home-Agent-Host


; Type: Interpreted Constraints
; Id: s6b-dsmip-aar-qos-capability
; AVP: QoS-Capability
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.2.1
; Section: 9.1.2.5.1
; Table: 9.1.2.5.1/3
; Versions: 18.6.0..19.2.0
"The PGW shall include this IE only during UE the initial attach."
    text-only


; Type: Interpreted Constraints
; Id: s6b-dsmip-aaa-apn-configuration
; AVP: APN-Configuration
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.2.2
; Section: 9.1.2.5.1
; Table: 9.1.2.5.1/4
; Versions: 18.6.0..19.2.0
"This information element shall only be sent if the Result-Code AVP is set to DIAMETER_SUCCESS."
    requires Result-Code = DIAMETER_SUCCESS


; Type: Interpreted Constraints
; Id: s6b-dsmip-aaa-trace-info
; AVP: Trace-Info
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.2.2
; Section: 9.1.2.5.1
; Table: 9.1.2.5.1/4
; Versions: 18.6.0..19.2.0
"Trace-data AVP shall be included (directly under the Trace-Info) if trace activation is requested"
"Trace-Reference AVP shall be included, if trace deactivation is requested."
    text-only


; Type: Interpreted Constraints
; Id: s6b-dsmip-aaa-an-trusted
; AVP: AN-Trusted
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.2.2
; Section: 9.1.2.5.1
; Table: 9.1.2.5.1/4
; Versions: 18.6.0..19.2.0
"This AVP shall be sent if this re-authorization procedure is triggered by the authentication and authorization via STa or SWm, when the 3GPP AAA Server detects that an S6b session already exists for the UE and the S6b session was established as a result of an authentication request for DSMIPv6."
    text-only


;; The PDN GW's answer to an RAR asking AUTHORIZE_AUTHENTICATE: an
;; earlier error may pre-empt DIAMETER_INVALID_AVP_VALUE, so the rule
;; says no success.
; Type: Interpreted Constraints
; Id: s6b-raa-result-code-authorize-authenticate
; AVP: Result-Code
; Command: Re-Auth-Answer
; Application-ID: 16777272
; Section: 9.1.2.5.2
; Versions: 18.6.0..19.2.0
"If it indicates AUTHORIZE_AUTHENTICATE, Result-Code shall be set to DIAMETER_INVALID_AVP_VALUE."
    excludes Result-Code = DIAMETER_SUCCESS and request/Re-Auth-Request-Type = AUTHORIZE_AUTHENTICATE


; Type: Interpreted Constraints
; Id: s6b-mip4-aar-auth-request-type
; AVP: Auth-Request-Type
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.5.1
; Section: 9.1.2.6.1
; Table: 9.1.2.6.1/1
; Versions: 18.6.0..19.2.0
"AUTHORIZE_ONLY shall be used in this case."
    range 2


; Type: Interpreted Constraints
; Id: s6b-mip4-aar-visited-network-identifier
; AVP: Visited-Network-Identifier
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.5.1
; Section: 9.1.2.6.1
; Table: 9.1.2.6.1/1
; Versions: 18.6.0..19.2.0
"It shall be present when the PGW Identity is present and does not contain an FQDN."
    present-if MIP6-Agent-Info and not MIP6-Agent-Info/MIP-Home-Agent-Host


; Type: Interpreted Constraints
; Id: s6b-mip4-aar-mip-mn-ha-spi
; AVP: MIP-MN-HA-SPI
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.5.1
; Section: 9.1.2.6.1
; Table: 9.1.2.6.1/1
; Versions: 18.6.0..19.2.0
"It shall be included when the PDN-GW does not have the MN-HA shared key required to verify the MIPv4 RRQ message."
    text-only


; Type: Interpreted Constraints
; Id: s6b-mip4-aaa-auth-request-type
; AVP: Auth-Request-Type
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.5.2
; Section: 9.1.2.6.1
; Table: 9.1.2.6.1/2
; Versions: 18.6.0..19.2.0
"It shall contain the value AUTHORIZE_ONLY."
    range 2


;; Clause 5.2.3.3 lists the flags in prose, which the file holds as no
;; bit table: a bits rule names only bits a table holds.
; Type: Interpreted Constraints
; Id: s6b-mip4-aaa-mip6-feature-vector
; AVP: MIP6-Feature-Vector
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.5.2
; Section: 9.1.2.6.1
; Table: 9.1.2.6.1/2
; Versions: 18.6.0..19.2.0
"The 3GPP AAA Server shall insert this AVP if the authorization was successful."
    present-if Result-Code = DIAMETER_SUCCESS
"The MIP4_SUPPORTED flag shall be set."
    text-only


; Type: Interpreted Constraints
; Id: s6b-mip4-aaa-qos-resources
; AVP: QoS-Resources
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.5.2
; Request-Section: 9.2.2.5.1
; Section: 9.1.2.6.1
; Table: 9.1.2.6.1/2
; Versions: 18.6.0..19.2.0
"This AVP shall be included only if the QoS-Capability AVP was received in the authorization request and the authorization succeeded."
    requires request/QoS-Capability
    requires Result-Code = DIAMETER_SUCCESS
"The QoS profile template value in this IE shall be set to 0."
    text-only


; Type: Interpreted Constraints
; Id: s6b-mip4-aaa-redirect-host
; AVP: Redirect-Host
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.5.2
; Section: 9.1.2.6.1
; Table: 9.1.2.6.1/2
; Versions: 18.6.0..19.2.0
"This information element shall be sent if the Result-Code value is set to DIAMETER_REDIRECT_INDICATION."
    present-if Result-Code = DIAMETER_REDIRECT_INDICATION


; Type: Interpreted Constraints
; Id: s6b-mip4-aaa-mip-session-key
; AVP: MIP-Session-Key
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.5.2
; Request-Section: 9.2.2.5.1
; Section: 9.1.2.6.1
; Table: 9.1.2.6.1/2
; Versions: 18.6.0..19.2.0
"it shall be included if the Result-Code value is set to DIAMETER_SUCCESS and the MIP-MN-HA-SPI was sent in the authorization request."
    present-if Result-Code = DIAMETER_SUCCESS and request/MIP-MN-HA-SPI


; Type: Interpreted Constraints
; Id: s6b-mip4-aaa-apn-configuration
; AVP: APN-Configuration
; Command: AA-Answer
; Application-ID: 16777272
; Command-Section: 9.2.2.5.2
; Section: 9.1.2.6.1
; Table: 9.1.2.6.1/2
; Versions: 18.6.0..19.2.0
"This information element shall only be sent if the Result-Code AVP is set to DIAMETER_SUCCESS."
    requires Result-Code = DIAMETER_SUCCESS


;; S6b's clause: SWx's and SWd's requests carry the identifier other
;; nodes insert (TS 29.229 clause 6.3.1), so the encoding is read in
;; S6b's requests below.
;; The AVP clauses of 9.2.3.
; Type: Interpreted Constraints
; Id: visited-network-identifier-domain
; AVP: Visited-Network-Identifier
; Section: 9.2.3.1.2
; Versions: 18.6.0..19.2.0
"The AVP shall be encoded as:"
"mnc<MNC>.mcc<MCC>.3gppnetwork.org"
    text-only


;; A three-digit MNC makes the name 29 octets.
; Type: Interpreted Constraints
; Id: s6b-der-visited-network-identifier-domain
; AVP: Visited-Network-Identifier
; Command: Diameter-EAP-Request
; Application-ID: 16777272
; Section: 9.2.3.1.2
; Versions: 18.6.0..19.2.0
"The AVP shall be encoded as:"
"mnc<MNC>.mcc<MCC>.3gppnetwork.org"
"If MNC consists of only 2 digits, a leading digit \"0\" shall be added to the MNC value (e.g., if MNC=15 and MCC=234, the value of Visited-Network-Identifier shall be \"mnc015.mcc234.3gppnetwork.org\")."
    encoding plmn-domain
    length 29 octets


; Type: Interpreted Constraints
; Id: s6b-aar-visited-network-identifier-domain
; AVP: Visited-Network-Identifier
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.2.1
; Section: 9.2.3.1.2
; Versions: 18.6.0..19.2.0
"The AVP shall be encoded as:"
"mnc<MNC>.mcc<MCC>.3gppnetwork.org"
"If MNC consists of only 2 digits, a leading digit \"0\" shall be added to the MNC value (e.g., if MNC=15 and MCC=234, the value of Visited-Network-Identifier shall be \"mnc015.mcc234.3gppnetwork.org\")."
    encoding plmn-domain
    length 29 octets


; Type: Interpreted Constraints
; Id: s6b-mip4-aar-visited-network-identifier-domain
; AVP: Visited-Network-Identifier
; Command: AA-Request
; Application-ID: 16777272
; Command-Section: 9.2.2.5.1
; Section: 9.2.3.1.2
; Versions: 18.6.0..19.2.0
"The AVP shall be encoded as:"
"mnc<MNC>.mcc<MCC>.3gppnetwork.org"
"If MNC consists of only 2 digits, a leading digit \"0\" shall be added to the MNC value (e.g., if MNC=15 and MCC=234, the value of Visited-Network-Identifier shall be \"mnc015.mcc234.3gppnetwork.org\")."
    encoding plmn-domain
    length 29 octets


; Type: Interpreted Constraints
; Id: rar-flags-undefined-bits
; AVP: RAR-Flags
; Section: 9.2.3.1.5
; Table: 9.2.3.1.5/1
; Versions: 18.6.0..19.2.0
"NOTE: Bits not defined in this table shall be cleared by the sender and discarded by the recever of the command."
    bits only 0 1


; Type: Interpreted Constraints
; Id: s6b-pmip-mip6-agent-info-fqdn
; AVP: MIP-Home-Agent-Host
; Within: MIP6-Agent-Info
