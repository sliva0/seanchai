;; SWx, clause 8: the tables of clause 8.1.2, describing the commands of
;; clause 8.2.2.
;; An IMSI is 6 to 15 digits (TS 23.003 clause 2.2): the reference
;; Release 18 prints "3GPP TS", so the quote ends before it.
; Type: Interpreted Constraints
; Id: swx-mar-user-name-imsi
; AVP: User-Name
; Command: Multimedia-Auth-Request
; Section: 8.1.2.1.1
; Table: 8.1.2.1.1/1
; Versions: 18.6.0..19.2.0
"This information element shall contain the user IMSI, formatted according to"
    encoding digits
    length 6..15 digits


; Type: Interpreted Constraints
; Id: swx-mar-visited-network-identifier
; AVP: Visited-Network-Identifier
; Command: Multimedia-Auth-Request
; Section: 8.1.2.1.1
; Table: 8.1.2.1.1/1
; Versions: 18.6.0..19.2.0
"The 3GPP AAA Server shall include this information element when received from signalling across the SWd."
    text-only


; Type: Interpreted Constraints
; Id: swx-mar-destination-host
; AVP: Destination-Host
; Command: Multimedia-Auth-Request
; Section: 8.1.2.1.1
; Table: 8.1.2.1.1/1
; Versions: 18.6.0..19.2.0
"If the 3GPP AAA Server knows the HSS name, this AVP shall be present."
    text-only


;; The method is the SIP-Authentication-Scheme inside SIP-Auth-Data-Item,
;; a text: a condition tests a number, a name of one, or presence.
; Type: Interpreted Constraints
; Id: swx-mar-anid
; AVP: ANID
; Command: Multimedia-Auth-Request
; Section: 8.1.2.1.1
; Table: 8.1.2.1.1/1
; Versions: 18.6.0..19.2.0
"This IE shall be present if the Authentication Method is EAP-AKA'."
    text-only


; Type: Interpreted Constraints
; Id: swx-maa-user-name-imsi
; AVP: User-Name
; Command: Multimedia-Auth-Answer
; Section: 8.1.2.1.1
; Table: 8.1.2.1.1/4
; Versions: 18.6.0..19.2.0
"This information element shall contain the user IMSI, formatted according to"
    encoding digits
    length 6..15 digits


; Type: Interpreted Constraints
; Id: swx-maa-sip-number-auth-items
; AVP: SIP-Number-Auth-Items
; Command: Multimedia-Auth-Answer
; Section: 8.1.2.1.1
; Table: 8.1.2.1.1/4
; Versions: 18.6.0..19.2.0
"It shall be present when the result is DIAMETER_SUCCESS."
    present-if Result-Code = DIAMETER_SUCCESS
"This AVP shall indicate the number of authentication vectors delivered in the Authentication Data information element."
    text-only


; Type: Interpreted Constraints
; Id: swx-maa-sip-auth-data-item
; AVP: SIP-Auth-Data-Item
; Command: Multimedia-Auth-Answer
; Section: 8.1.2.1.1
; Table: 8.1.2.1.1/4
; Versions: 18.6.0..19.2.0
"If the SIP-Number-Auth-Items AVP is equal to zero or it is not present, then this AVP shall not be present."
    requires SIP-Number-Auth-Items
    absent-if SIP-Number-Auth-Items = 0


; Type: Interpreted Constraints
; Id: swx-maa-3gpp-aaa-server-name
; AVP: 3GPP-AAA-Server-Name
; Command: Multimedia-Auth-Answer
; Section: 8.1.2.1.1
; Table: 8.1.2.1.1/4
; Versions: 18.6.0..19.2.0
"This AVP shall be sent when the user has been previously authenticated by another 3GPP AAA Server and therefore there is another 3GPP AAA Server serving the user."
    text-only


; Type: Interpreted Constraints
; Id: swx-sip-auth-data-item-sip-item-number
; AVP: SIP-Item-Number
; Within: SIP-Auth-Data-Item
; Section: 8.1.2.1.1
; Table: 8.1.2.1.1/5
; Versions: 18.6.0..19.2.0
"This information element shall be present in a SIP-Auth-Data-Item grouped AVP in circumstances where there are multiple occurrences of SIP-Auth-Data-Item AVPs, and the order in which they should be processed is significant."
    text-only


;; A text value: a condition tests a number, or a name of one.
; Type: Interpreted Constraints
; Id: swx-sip-auth-data-item-sip-authentication-scheme
; AVP: SIP-Authentication-Scheme
; Within: SIP-Auth-Data-Item
; Application-ID: 16777265
; Section: 8.1.2.1.1
; Table: 8.1.2.1.1/2
; Versions: 18.6.0..19.2.0
"It shall contain one of the values EAP-AKA or EAP-AKA'."
    text-only


;; RAND and AUTN are 16 octets each (TS 33.102 clause 6.3.7). Only
;; the answer's SIP-Auth-Data-Item carries SIP-Authenticate (tables
;; 8.1.2.1.1/2, /3 and /5); Cx's, which TS 29.229 reads, is not SWx's.
; Type: Interpreted Constraints
; Id: swx-sip-auth-data-item-sip-authenticate
; AVP: SIP-Authenticate
; Within: SIP-Auth-Data-Item
; Application-ID: 16777265
; Section: 8.1.2.1.1
; Table: 8.1.2.1.1/5
; Versions: 18.6.0..19.2.0
"This IE shall contain, binary encoded, the concatenation of the authentication challenge RAND and the token AUTN."
    length 32 octets


;; The answer's XRES (4 to 16 octets) and the synchronization failure
;; request's RAND and AUTS (table 8.1.2.1.1/3) share the grouped AVP,
;; whose scope does not tell a request's from an answer's.
; Type: Interpreted Constraints
; Id: swx-sip-auth-data-item-sip-authorization
; AVP: SIP-Authorization
; Within: SIP-Auth-Data-Item
; Application-ID: 16777265
; Section: 8.1.2.1.1
; Table: 8.1.2.1.1/5
; Versions: 18.6.0..19.2.0
"This IE shall contain binary encoded, the expected response XRES."
    text-only


; Type: Interpreted Constraints
; Id: swx-sar-user-name-imsi
; AVP: User-Name
; Command: Server-Assignment-Request
; Section: 8.1.2.2.2.1
; Table: 8.1.2.2.2.1/1
; Versions: 18.6.0..19.2.0
"This information element shall contain the user IMSI and shall be formatted according to"
    encoding digits
    length 6..15 digits


;; The row names REGISTRATION (1), USER_DEREGISTRATION (5),
;; ADMINISTRATIVE_DEREGISTRATION (8), AUTHENTICATION_FAILURE (9),
;; AUTHENTICATION_TIMEOUT (10), AAA_USER_DATA_REQUEST (12) and
;; PGW_UPDATE (13) (TS 29.229 clause 6.3.15); the HSS restoration
;; request, the same command, takes RESTORATION (14) (table
;; 8.1.2.4.2.1/1).
; Type: Interpreted Constraints
; Id: swx-sar-server-assignment-type
; AVP: Server-Assignment-Type
; Command: Server-Assignment-Request
; Section: 8.1.2.2.2.1
; Table: 8.1.2.2.2.1/1
; Versions: 18.6.0..19.2.0
"Any other value shall be considered as an error case."
    range 1..14
    exclude 2, 3, 4, 6, 7, 11


; Type: Interpreted Constraints
; Id: swx-sar-destination-host
; AVP: Destination-Host
; Command: Server-Assignment-Request
; Section: 8.1.2.2.2.1
; Table: 8.1.2.2.2.1/1
; Versions: 18.6.0..19.2.0
"If the 3GPP AAA Server knows the HSS name this AVP shall be present."
    text-only


;; PGW_UPDATE is 13 (clause 8.2.3.12).
; Type: Interpreted Constraints
; Id: swx-sar-mip6-agent-info
; AVP: MIP6-Agent-Info
; Command: Server-Assignment-Request
; Section: 8.1.2.2.2.1
; Table: 8.1.2.2.2.1/1
; Versions: 18.6.0..19.2.0
"This IE shall contain, either the identity of the dynamically allocated PDN GW, or the identity of a dynamically allocated PDN GW selected for the establishment of emergency PDN connections, and is included if the Server-Assignment-Type is set to PGW_UPDATE."
    present-if Server-Assignment-Type = 13
    members at-least-one MIP-Home-Agent-Address MIP-Home-Agent-Host


; Type: Interpreted Constraints
; Id: swx-sar-context-identifier
; AVP: Context-Identifier
; Command: Server-Assignment-Request
; Section: 8.1.2.2.2.1
; Table: 8.1.2.2.2.1/1
; Versions: 18.6.0..19.2.0
"For emergency PDN connection establishment, this information element shall be left absent."
    absent-if Emergency-Services bit Emergency-Indication


;; The PGW Identity is MIP6-Agent-Info, its FQDN MIP-Home-Agent-Host's
;; Destination-Host.
; Type: Interpreted Constraints
; Id: swx-sar-visited-network-identifier
; AVP: Visited-Network-Identifier
; Command: Server-Assignment-Request
; Section: 8.1.2.2.2.1
; Table: 8.1.2.2.2.1/1
; Versions: 18.6.0..19.2.0
"It shall be present when the PGW Identity is present and does not contain an FQDN."
    present-if MIP6-Agent-Info and not MIP6-Agent-Info/MIP-Home-Agent-Host


;; The AAA server sets Emergency-Services' Emergency-Indication bit for
;; an emergency PDN connection (the Emergency Services row).
; Type: Interpreted Constraints
; Id: swx-sar-service-selection
; AVP: Service-Selection
; Command: Server-Assignment-Request
; Section: 8.1.2.2.2.1
; Table: 8.1.2.2.2.1/1
; Versions: 18.6.0..19.2.0
"For non-emergency PDN connection establishment, this information element shall contain the Network Identifier part of the APN, and it shall be included if the Server-Assignment-Type is set to PGW_UPDATE."
    present-if Server-Assignment-Type = PGW_UPDATE and not Emergency-Services bit Emergency-Indication
"For emergency PDN connection establishment, this information element shall be left absent."
    absent-if Emergency-Services bit Emergency-Indication


; Type: Interpreted Constraints
; Id: swx-sar-terminal-information
; AVP: Terminal-Information
; Command: Server-Assignment-Request
; Section: 8.1.2.2.2.1
; Table: 8.1.2.2.2.1/1
; Versions: 18.6.0..19.2.0
"The 3GPP AAA Server shall include this IE and set it to the user's Mobile Equipment Identity, if this information is available, and if the Server-Assignment-Type is set to REGISTRATION."
"This IE shall also be present, independently of the value of the Server-Assignment-Type, if the Terminal-Information has changed from the last value previously reported to the HSS."
"This grouped AVP shall contain the IMEI AVP and, if available, the Software-Version AVP, for a trusted or untrusted WLAN access."
    text-only


; Type: Interpreted Constraints
; Id: swx-sar-emergency-services
; AVP: Emergency-Services
; Command: Server-Assignment-Request
; Section: 8.1.2.2.2.1
; Table: 8.1.2.2.2.1/1
; Versions: 18.6.0..19.2.0
"The 3GPP AAA Server shall include this information element, and set the Emergency-Indication bit, to notify the HSS that a new PDN-GW has been selected for the establishment of an emergency PDN connection"
    bits set 0
"This IE shall only be included when the Server-Assignment-Type is set to PGW_UPDATE."
    requires Server-Assignment-Type = 13


; Type: Interpreted Constraints
; Id: swx-saa-user-name-imsi
; AVP: User-Name
; Command: Server-Assignment-Answer
; Section: 8.1.2.2.2.1
; Table: 8.1.2.2.2.1/2
; Versions: 18.6.0..19.2.0
"This information element shall contain the user IMSI and shall be formatted according to"
    encoding digits
    length 6..15 digits


; Type: Interpreted Constraints
; Id: swx-saa-non-3gpp-user-data
; AVP: Non-3GPP-User-Data
; Command: Server-Assignment-Answer
; Section: 8.1.2.2.2.1
; Table: 8.1.2.2.2.1/2
; Versions: 18.6.0..19.2.0
"It shall be present when Server-Assignment-Type in the request is equal to AAA_USER_DATA_REQUEST or REGISTRATION and the Result-Code is equal to DIAMETER_SUCCESS."
    present-if request/Server-Assignment-Type = AAA_USER_DATA_REQUEST and Result-Code = DIAMETER_SUCCESS or request/Server-Assignment-Type = REGISTRATION and Result-Code = DIAMETER_SUCCESS


; Type: Interpreted Constraints
; Id: swx-saa-3gpp-aaa-server-name
; AVP: 3GPP-AAA-Server-Name
; Command: Server-Assignment-Answer
; Section: 8.1.2.2.2.1
; Table: 8.1.2.2.2.1/2
; Versions: 18.6.0..19.2.0
"This AVP shall be present when the user has been previously authenticated by another 3GPP AAA Server and therefore there is another 3GPP AAA Server serving the user."
    text-only


; Type: Interpreted Constraints
; Id: swx-rtr-user-name-imsi
; AVP: User-Name
; Command: Registration-Termination-Request
; Section: 8.1.2.2.3.1
; Table: 8.3.2.3
; Versions: 18.6.0..19.2.0
"This information element shall contain the user IMSI and shall be formatted according to"
    encoding digits
    length 6..15 digits


;; The HSS reset's Push-Profile-Request, the same command, holds "*" or
;; an IMSI's leading digits (table 8.1.2.4.1.1/1): no codec takes
;; either, and none reads only where PPR-Flags' Reset-Indication is
;; clear.
; Type: Interpreted Constraints
; Id: swx-ppr-user-name-imsi
; AVP: User-Name
; Command: Push-Profile-Request
; Section: 8.1.2.3.1
; Table: 8.1.2.3.1/1
; Versions: 18.6.0..19.2.0
"This information element shall contain the user IMSI and shall be formatted according to"
    text-only


;; That it holds no AVP no kind says.
; Type: Interpreted Constraints
; Id: swx-ppr-non-3gpp-user-data
; AVP: Non-3GPP-User-Data
; Command: Push-Profile-Request
; Section: 8.1.2.3.2
; Versions: 18.6.0..19.2.0
"In this case, the HSS shall set the \"P-CSCF Restoration Request\" bit in the PPR Flags and the procedure shall only be used for the purpose of the P-CSCF restoration for WLAN; then, the Non-3GPP-User-Data AVP shall be included as an empty AVP."
    present-if PPR-Flags bit "P-CSCF Restoration Request"


; Type: Interpreted Constraints
; Id: swx-ppr-reset-user-name
; AVP: User-Name
; Command: Push-Profile-Request
; Section: 8.1.2.4.1.1
; Table: 8.1.2.4.1.1/1
; Versions: 18.6.0..19.2.0
"It shall contain either: - The string \"*\", if all users are affected by the restart - The leading digits of the IMSI series of the set of users affected by the restart."
    text-only


;; TS 29.272's readings of the same rows within Active-APN hold where
;; this document re-uses the grouped AVP (docs/constraints.md,
;; Precedence): an Active-APN without Specific-APN-Info carries
;; Service-Selection, MIP6-Agent-Info and Visited-Network-Identifier.
; Type: Interpreted Constraints
; Id: swx-restoration-sar-active-apn
; AVP: Active-APN
; Command: Server-Assignment-Request
; Section: 8.1.2.4.2.1
; Table: 8.1.2.4.2.1/1
; Versions: 18.6.0..19.2.0
"For the explicitly subscribed APNs, the following information shall be present:"
"For the Wildcard APN, the following information shall be present:"
    text-only


;; The AVP clauses of 8.2.3.
; Type: Interpreted Constraints
; Id: non-3gpp-user-data-subscription-id
; AVP: Subscription-Id
; Within: Non-3GPP-User-Data
; Section: 8.2.3.1
; Versions: 18.6.0..19.2.0
"The Subscription-ID, if present in this grouped AVP, shall contain either an MSISDN (if this identity is present in the subscription), or an External Identifier (if the subscriber does not have an MSISDN identity but has an External Identifier in the subscription)."
    text-only


; Type: Interpreted Constraints
; Id: non-3gpp-user-data-ambr
; AVP: AMBR
; Within: Non-3GPP-User-Data
; Section: 8.2.3.1
; Versions: 18.6.0..19.2.0
"The AMBR included in this grouped AVP shall include the AMBR associated to the user's subscription (UE-AMBR)."
    text-only


; Type: Interpreted Constraints
; Id: non-3gpp-user-data-apn-oi-replacement
; AVP: APN-OI-Replacement
; Within: Non-3GPP-User-Data
; Section: 8.2.3.1
; Versions: 18.6.0..19.2.0
"The APN-OI-Replacement included in this grouped AVP shall include the UE level APN-OI-Replacement associated to the user's subscription."
    text-only


;; An APN-Configuration's PDN type is IP unless its Non-IP or Ethernet
;; indicator is TRUE (TS 29.272 clauses 7.3.204 and 7.3.232); whether it
;; is configured in the subscription no message shows.
; Type: Interpreted Constraints
; Id: non-3gpp-user-data-apn-configuration
; AVP: APN-Configuration
; Within: Non-3GPP-User-Data
; Section: 8.2.3.1
; Versions: 18.6.0..19.2.0
"The Non-3GPP-User-Data AVP shall only contain APN-Configuration AVP(s) configured in the user subscription with an IP PDN type."
    excludes APN-Configuration/Non-IP-PDN-Type-Indicator = TRUE or APN-Configuration/Ethernet-PDN-Type-Indicator = TRUE
"If the Non-3GPP-User-Data AVP is not empty, the Non-3GPP-IP-Acess AVP, the Non-3GPP-IP-Access-APN AVP, the Context-Identifier AVP and at least one item of the APN-Configuration AVP shall always be included, except when the Non-3GPP-User-Data AVP is used for downloading trace activation or deactivation information on the SWx interface, for an already registered user, or when the Non-3GPP-User-Data is used for downloading the Emergency-Info."
    present-if Non-3GPP-IP-Access and not Trace-Info and not Emergency-Info or Non-3GPP-IP-Access-APN and not Trace-Info and not Emergency-Info or Context-Identifier and not Trace-Info and not Emergency-Info or Subscription-Id and not Trace-Info and not Emergency-Info or RAT-Type and not Trace-Info and not Emergency-Info or Session-Timeout and not Trace-Info and not Emergency-Info or MIP6-Feature-Vector and not Trace-Info and not Emergency-Info or AMBR and not Trace-Info and not Emergency-Info or 3GPP-Charging-Characteristics and not Trace-Info and not Emergency-Info or APN-OI-Replacement and not Trace-Info and not Emergency-Info or TWAN-Default-APN-Context-Id and not Trace-Info and not Emergency-Info or TWAN-Access-Info and not Trace-Info and not Emergency-Info or UE-Usage-Type and not Trace-Info and not Emergency-Info or ERP-Authorization and not Trace-Info and not Emergency-Info or Core-Network-Restrictions and not Trace-Info and not Emergency-Info or MPS-Priority and not Trace-Info and not Emergency-Info


; Type: Interpreted Constraints
; Id: non-3gpp-user-data-context-identifier
; AVP: Context-Identifier
; Within: Non-3GPP-User-Data
; Section: 8.2.3.1
; Versions: 18.6.0..19.2.0
"The Context-Identifier in this grouped AVP shall identify the user's default APN configuration."
    text-only
"If the Non-3GPP-User-Data AVP is not empty, the Non-3GPP-IP-Acess AVP, the Non-3GPP-IP-Access-APN AVP, the Context-Identifier AVP and at least one item of the APN-Configuration AVP shall always be included, except when the Non-3GPP-User-Data AVP is used for downloading trace activation or deactivation information on the SWx interface, for an already registered user, or when the Non-3GPP-User-Data is used for downloading the Emergency-Info."
    present-if Non-3GPP-IP-Access and not Trace-Info and not Emergency-Info or Non-3GPP-IP-Access-APN and not Trace-Info and not Emergency-Info or APN-Configuration and not Trace-Info and not Emergency-Info or Subscription-Id and not Trace-Info and not Emergency-Info or RAT-Type and not Trace-Info and not Emergency-Info or Session-Timeout and not Trace-Info and not Emergency-Info or MIP6-Feature-Vector and not Trace-Info and not Emergency-Info or AMBR and not Trace-Info and not Emergency-Info or 3GPP-Charging-Characteristics and not Trace-Info and not Emergency-Info or APN-OI-Replacement and not Trace-Info and not Emergency-Info or TWAN-Default-APN-Context-Id and not Trace-Info and not Emergency-Info or TWAN-Access-Info and not Trace-Info and not Emergency-Info or UE-Usage-Type and not Trace-Info and not Emergency-Info or ERP-Authorization and not Trace-Info and not Emergency-Info or Core-Network-Restrictions and not Trace-Info and not Emergency-Info or MPS-Priority and not Trace-Info and not Emergency-Info


; Type: Interpreted Constraints
; Id: non-3gpp-user-data-twan-default-apn-context-id
; AVP: TWAN-Default-APN-Context-Id
; Within: Non-3GPP-User-Data
; Section: 8.2.3.1
; Versions: 18.6.0..19.2.0
"This AVP shall be present if the default APN configuration for EPC access over Trusted WLAN differs from the default APN configuration for 3GPP access and other non-3GPP accesses."
    text-only


; Type: Interpreted Constraints
; Id: non-3gpp-user-data-rat-type
; AVP: RAT-Type
; Within: Non-3GPP-User-Data
; Section: 8.2.3.1
; Versions: 18.6.0..19.2.0
"The RAT-Type AVP(s) shall include the access technology type(s) not allowed for the user"
    text-only


; Type: Interpreted Constraints
; Id: non-3gpp-user-data-emergency-info
; AVP: Emergency-Info
; Within: Non-3GPP-User-Data
; Section: 8.2.3.1
; Versions: 18.6.0..19.2.0
"The Emergency-Info AVP shall contain the identity of the PDN-GW used for the establishment of emergency PDN connections."
    text-only


; Type: Interpreted Constraints
; Id: non-3gpp-user-data-mps-priority
; AVP: MPS-Priority
; Within: Non-3GPP-User-Data
; Section: 8.2.3.1
; Versions: 18.6.0..19.2.0
"The MPS-Priority AVP shall be present if an MPS subscription exists in the HSS for the UE."
    text-only


;; Which conditions of clause 8.1.2.3.2 empty it, the procedure's;
;; the members it then holds are read below.
; Type: Interpreted Constraints
; Id: non-3gpp-user-data-content
; AVP: Non-3GPP-User-Data
; Section: 8.2.3.1
; Versions: 18.6.0..19.2.0
"For the conditions specified in clause 8.1.2.3.2, the Non-3GPP-User-Data AVP shall be empty, i.e. not include any AVP."
"If the Non-3GPP-User-Data AVP is not empty, the Non-3GPP-IP-Acess AVP, the Non-3GPP-IP-Access-APN AVP, the Context-Identifier AVP and at least one item of the APN-Configuration AVP shall always be included, except when the Non-3GPP-User-Data AVP is used for downloading trace activation or deactivation information on the SWx interface, for an already registered user, or when the Non-3GPP-User-Data is used for downloading the Emergency-Info."
    text-only


;; Not empty: a member the body prints holds; neither Trace-Info nor
;; Emergency-Info, either of which may be what it downloads. A member
;; only * [ AVP ] admits no condition names.
; Type: Interpreted Constraints
; Id: non-3gpp-user-data-non-3gpp-ip-access-when-not-empty
; AVP: Non-3GPP-IP-Access
; Within: Non-3GPP-User-Data
; Section: 8.2.3.1
; Versions: 18.6.0..19.2.0
"If the Non-3GPP-User-Data AVP is not empty, the Non-3GPP-IP-Acess AVP, the Non-3GPP-IP-Access-APN AVP, the Context-Identifier AVP and at least one item of the APN-Configuration AVP shall always be included, except when the Non-3GPP-User-Data AVP is used for downloading trace activation or deactivation information on the SWx interface, for an already registered user, or when the Non-3GPP-User-Data is used for downloading the Emergency-Info."
    present-if Non-3GPP-IP-Access-APN and not Trace-Info and not Emergency-Info or Context-Identifier and not Trace-Info and not Emergency-Info or APN-Configuration and not Trace-Info and not Emergency-Info or Subscription-Id and not Trace-Info and not Emergency-Info or RAT-Type and not Trace-Info and not Emergency-Info or Session-Timeout and not Trace-Info and not Emergency-Info or MIP6-Feature-Vector and not Trace-Info and not Emergency-Info or AMBR and not Trace-Info and not Emergency-Info or 3GPP-Charging-Characteristics and not Trace-Info and not Emergency-Info or APN-OI-Replacement and not Trace-Info and not Emergency-Info or TWAN-Default-APN-Context-Id and not Trace-Info and not Emergency-Info or TWAN-Access-Info and not Trace-Info and not Emergency-Info or UE-Usage-Type and not Trace-Info and not Emergency-Info or ERP-Authorization and not Trace-Info and not Emergency-Info or Core-Network-Restrictions and not Trace-Info and not Emergency-Info or MPS-Priority and not Trace-Info and not Emergency-Info


; Type: Interpreted Constraints
; Id: non-3gpp-user-data-non-3gpp-ip-access-apn-when-not-empty
; AVP: Non-3GPP-IP-Access-APN
; Within: Non-3GPP-User-Data
; Section: 8.2.3.1
; Versions: 18.6.0..19.2.0
"If the Non-3GPP-User-Data AVP is not empty, the Non-3GPP-IP-Acess AVP, the Non-3GPP-IP-Access-APN AVP, the Context-Identifier AVP and at least one item of the APN-Configuration AVP shall always be included, except when the Non-3GPP-User-Data AVP is used for downloading trace activation or deactivation information on the SWx interface, for an already registered user, or when the Non-3GPP-User-Data is used for downloading the Emergency-Info."
    present-if Non-3GPP-IP-Access and not Trace-Info and not Emergency-Info or Context-Identifier and not Trace-Info and not Emergency-Info or APN-Configuration and not Trace-Info and not Emergency-Info or Subscription-Id and not Trace-Info and not Emergency-Info or RAT-Type and not Trace-Info and not Emergency-Info or Session-Timeout and not Trace-Info and not Emergency-Info or MIP6-Feature-Vector and not Trace-Info and not Emergency-Info or AMBR and not Trace-Info and not Emergency-Info or 3GPP-Charging-Characteristics and not Trace-Info and not Emergency-Info or APN-OI-Replacement and not Trace-Info and not Emergency-Info or TWAN-Default-APN-Context-Id and not Trace-Info and not Emergency-Info or TWAN-Access-Info and not Trace-Info and not Emergency-Info or UE-Usage-Type and not Trace-Info and not Emergency-Info or ERP-Authorization and not Trace-Info and not Emergency-Info or Core-Network-Restrictions and not Trace-Info and not Emergency-Info or MPS-Priority and not Trace-Info and not Emergency-Info


;; Of RFC 4006's END_USER_E164 (0), END_USER_IMSI (1), END_USER_SIP_URI
;; (2), END_USER_NAI (3) and END_USER_PRIVATE (4), the next sentences
;; name END_USER_E164 and END_USER_NAI.
; Type: Interpreted Constraints
; Id: subscription-id-type-values
; AVP: Subscription-Id-Type
; Within: Subscription-Id
; Section: 8.2.3.2
; Versions: 18.6.0..19.2.0
"EPC shall make use only of the MSISDN and External Identifier values."
    exclude 1, 2, 4


;; "Either ... or" is one of the two: at least one, and a
;; Trace-Reference not beside a Trace-Data (below).
; Type: Interpreted Constraints
; Id: trace-info-either
; AVP: Trace-Info
; Section: 8.2.3.13
; Versions: 18.6.0..19.2.0
"Either the Trace-Data or the Trace-Reference AVP shall be included."
    members at-least-one Trace-Data Trace-Reference


; Type: Interpreted Constraints
; Id: trace-info-trace-reference-or-trace-data
; AVP: Trace-Reference
; Within: Trace-Info
; Section: 8.2.3.13
; Versions: 18.6.0..19.2.0
"Either the Trace-Data or the Trace-Reference AVP shall be included."
    excludes Trace-Data


; Type: Interpreted Constraints
; Id: swx-feature-list-id
; AVP: Feature-List-ID
; Within: Supported-Features
; Application-ID: 16777265
; Section: 8.2.3.15
; Versions: 18.6.0..19.2.0
"For this release, the Feature-List-ID AVP value shall be set to 1 for the SWx application."
    values 1 if Vendor-Id = 10415


;; SWx's feature list 1 names Dedicated Core Networks (table
;; 8.2.3.16/1). Of the request's Supported-Features, any naming the bit
;; is read as support, whatever its Vendor-Id and Feature-List-ID: a
;; condition cannot hold the three to one group, so the rule holds only
;; where no list of the SAR names it. The later PPRs are another
;; exchange's.
; Type: Interpreted Constraints
; Id: swx-saa-dcn-ue-usage-type
; AVP: Non-3GPP-User-Data
; Command: Server-Assignment-Answer
; Section: 8.2.3.16
; Table: 8.2.3.16/1
; Versions: 18.6.0..19.2.0
"If the 3GPP AAA Server does not indicate support of this feature in the SAR command, the HSS shall not send DCN-related subscription data (e.g., UE Usage Type) in SAA, and shall not send subsequent PPR commands when such subscription data are updated."
    excludes Non-3GPP-User-Data/UE-Usage-Type and not request/Supported-Features/Feature-List bit "Dedicated Core Networks"


; Type: Interpreted Constraints
; Id: ppr-flags-undefined-bits
; AVP: PPR-Flags
; Section: 8.2.3.17
; Table: 8.2.3.17/1
; Versions: 18.6.0..19.2.0
"NOTE: Bits not defined in this table shall be cleared by the sending HSS and discarded by the receiving 3GPP AAA Server."
    bits only 0 1 2 3


; Type: Interpreted Constraints
; Id: twan-access-info-wlan-identifier
; AVP: WLAN-Identifier
; Within: TWAN-Access-Info
; Section: 8.2.3.19
; Versions: 18.6.0..19.2.0
"If no WLAN-Identifier AVP is included in the TWAN-Access-Info AVP, the allowed access methods shall apply to any arbitrary Trusted WLAN."
    text-only
"A specific Trusted-WLAN shall appear in at most one TWAN-Access-Info AVP."
    unique
"There shall be at most one TWAN-Access-Info AVP not including any WLAN-Identifier."
    text-only


;; Neither EPC-Access-Authorization (bit 0) nor NSWO-Access-Authorization
;; (bit 1) set (clause 8.2.3.20).
; Type: Interpreted Constraints
; Id: twan-access-info-access-authorization-flags-default
; AVP: Access-Authorization-Flags
; Within: TWAN-Access-Info
; Section: 8.2.3.19
; Versions: 18.6.0..19.2.0
"If the Access-Authorization-Flags AVP is not present in the TWAN-Access-Info AVP, EPC access and Non-Seamless WLAN Offload shall be considered to be not allowed."
    default 0


; Type: Interpreted Constraints
; Id: access-authorization-flags-undefined-bits
; AVP: Access-Authorization-Flags
; Section: 8.2.3.20
; Table: 8.2.3.20/1
; Versions: 18.6.0..19.2.0
"NOTE: Bits not defined in this table shall be cleared by the sending HSS and discarded by the receiving 3GPP AAA Server."
    bits only 0 1


; Type: Interpreted Constraints
; Id: aaa-failure-indication-undefined-bits
; AVP: AAA-Failure-Indication
; Section: 8.2.3.21
; Table: 8.2.3.21/1
; Versions: 18.6.0..19.2.0
"NOTE: Bits not defined in this table shall be cleared by the sender and discarded by the receiver."
    bits only 0


