; Id: s6b-feature-list-id
; AVP: Feature-List-ID
; Within: Supported-Features
; Application-ID: 16777272
; Section: 9.2.3.4
; Versions: 18.6.0..19.2.0
"For this release, the Feature-List-ID AVP value shall be set to 1 for the S6b application."
    values 1 if Vendor-Id = 10415


; Type: Interpreted Constraints
