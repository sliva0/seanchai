        DIAMETER_ERROR_UNKNOWN_EPS_SUBSCRIPTION, DIAMETER_ERROR_RAT_NOT_ALLOWED,
        DIAMETER_ERROR_ROAMING_NOT_ALLOWED, DIAMETER_ERROR_EQUIPMENT_UNKNOWN,
        DIAMETER_ERROR_UNKNOWN_SERVING_NODE
    exclude 5420, 5421, 5422, 5423


