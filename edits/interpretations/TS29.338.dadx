    encoding element TS23.040 3.3.2 "Reason for absence"


; Type: Interpreted Constraints
; Id: smsf-3gpp-number-tbcd
; AVP: SMSF-3GPP-Number
; Section: 5.3.3.29
; Versions: 18.2.0..19.3.0
"This AVP contains an SMSF-3GPP-Number in international number format as described in ITU-T Rec E.164 [13] and shall be encoded as a TBCD-string."
"This AVP shall not include leading indicators for the nature of address and the numbering plan; it shall contain only the TBCD-encoded digits of the address."
    encoding e164-tbcd


; Type: Interpreted Constraints
; Id: smsf-non-3gpp-number-tbcd
; AVP: SMSF-Non-3GPP-Number
; Section: 5.3.3.30
; Versions: 18.2.0..19.3.0
"This AVP contains an SMSF-Non-3GPP-Number in international number format as described in ITU-T Rec E.164 [13] and shall be encoded as a TBCD-string."
"This AVP shall not include leading indicators for the nature of address and the numbering plan; it shall contain only the TBCD-encoded digits of the address."
    encoding e164-tbcd


;; Clause 6.2.1.1's tables.
; Type: Interpreted Constraints
; Id: ofr-smsmi-correlation-id
; AVP: SMSMI-Correlation-ID
; Command: MO-Forward-Short-Message-Request
; Section: 6.2.1.1
; Table: 6.2.1.1/1
; Versions: 18.2.0..19.3.0
"When present, this information element shall contain an HSS-ID identifying the destination user's HSS, a Destination SIP-URI identifying the MSISDN-less destination user, and an Originating SIP-URI identifying the MSISDN-less originating user."
    requires SMSMI-Correlation-ID/HSS-ID and SMSMI-Correlation-ID/Destination-SIP-URI and SMSMI-Correlation-ID/Originating-SIP-URI


; Type: Interpreted Constraints
; Id: ofr-sm-delivery-outcome
; AVP: SM-Delivery-Outcome
; Command: MO-Forward-Short-Message-Request
; Section: 6.2.1.1
; Table: 6.2.1.1/1
; Versions: 18.2.0..19.3.0
"This information element shall be present if the SMSMI Correlation ID is present and shall contain the IP-SM-GW SM Delivery Outcome with the causes for setting the message waiting data in the HSS."
    present-if SMSMI-Correlation-ID
    requires SM-Delivery-Outcome/IP-SM-GW-SM-Delivery-Outcome


; Type: Interpreted Constraints
; Id: ofa-experimental-result-vendor
; AVP: Experimental-Result
; Command: MO-Forward-Short-Message-Answer
; Section: 6.2.1.1
; Table: 6.2.1.1/2
; Versions: 18.2.0..19.3.0
"This is a grouped AVP which shall contain the 3GPP Vendor ID in the Vendor-Id AVP, and the error code in the Experimental-Result-Code AVP."
    requires Experimental-Result/Vendor-Id = 10415


;; The four causes are clause 6.3.3.6's UNKNOWN_SERVICE_CENTRE (3),
;; SC-CONGESTION (4), INVALID_SME-ADDRESS (5) and USER_NOT_SC-USER (6), read
;; through a path from the command.
; Type: Interpreted Constraints
; Id: ofa-sm-delivery-failure-cause
; AVP: SM-Delivery-Failure-Cause
; Command: MO-Forward-Short-Message-Answer
; Section: 6.2.1.1
; Table: 6.2.1.1/2
; Versions: 18.2.0..19.3.0
"If the Experimental-Result-Code is set to DIAMETER_ERROR_SM_DELIVERY_FAILURE, this information element shall be present and indicate one of the following:"
"unknown Service Centre/MTC-IWF address"
"Service Centre/MTC-IWF congestion"
"invalid Short Message Entity address"
"user not Service Centre/SCS-AS user"
    present-if Experimental-Result/Experimental-Result-Code = DIAMETER_ERROR_SM_DELIVERY_FAILURE
    requires SM-Delivery-Failure-Cause/SM-Enumerated-Delivery-Failure-Cause in UNKNOWN_SERVICE_CENTRE,
        SC-CONGESTION, INVALID_SME-ADDRESS, USER_NOT_SC-USER


;; The interface the answer crosses, which it does not carry.
; Type: Interpreted Constraints
; Id: ofa-external-identifier
; AVP: External-Identifier
; Command: MO-Forward-Short-Message-Answer
; Section: 6.2.1.1
; Table: 6.2.1.1/2
; Versions: 18.2.0..19.3.0
"Shall be present when the answer is sent over T4 to the SMS-IWMSC for charging."
    text-only


;; Clause 6.2.2.1's tables.
; Type: Interpreted Constraints
; Id: tfr-smsmi-correlation-id
; AVP: SMSMI-Correlation-ID
; Command: MT-Forward-Short-Message-Request
; Section: 6.2.2.1
; Table: 6.2.2.1/1
; Versions: 18.2.0..19.3.0
"When present, this information element shall contain the Destination SIP-URI identifying the (MSISDN-less) destination user and the Originating SIP-URI identifying the (MSISDN-less) originating user. The HSS-ID shall be absent from this information element."
    requires SMSMI-Correlation-ID/Destination-SIP-URI and SMSMI-Correlation-ID/Originating-SIP-URI
    absent-if SMSMI-Correlation-ID/HSS-ID


;; The node the request is sent to, which it does not carry.
; Type: Interpreted Constraints
; Id: tfr-mme-number-for-mt-sms
; AVP: MME-Number-for-MT-SMS
; Command: MT-Forward-Short-Message-Request
; Section: 6.2.2.1
; Table: 6.2.2.1/1
; Versions: 18.2.0..19.3.0
"This Information Element contains the ISDN number of the MME (see 3GPP TS 23.003 [3]) and shall be present when the request is sent to a MME."
    text-only


; Type: Interpreted Constraints
; Id: tfr-sgsn-number
; AVP: SGSN-Number
; Command: MT-Forward-Short-Message-Request
; Section: 6.2.2.1
; Table: 6.2.2.1/1
; Versions: 18.2.0..19.3.0
"This Information Element contains the ISDN number of the SGSN (see 3GPP TS 23.003 [3]) and shall be present when the request is sent to a SGSN."
    text-only


;; A presence with no condition, of an AVP the ABNF prints optional: no
;; predicate states it.
; Type: Interpreted Constraints
; Id: tfr-sm-delivery-timer
; AVP: SM-Delivery-Timer
; Command: MT-Forward-Short-Message-Request
; Section: 6.2.2.1
; Table: 6.2.2.1/1
; Versions: 18.2.0..19.3.0
"This information element should be included."
    text-only


; Type: Interpreted Constraints
; Id: tfr-sm-delivery-start-time
; AVP: SM-Delivery-Start-Time
; Command: MT-Forward-Short-Message-Request
; Section: 6.2.2.1
; Table: 6.2.2.1/1
; Versions: 18.2.0..19.3.0
"This information element should be included."
    text-only


; Type: Interpreted Constraints
; Id: tfr-sms-gmsc-address
; AVP: SMS-GMSC-Address
; Command: MT-Forward-Short-Message-Request
; Section: 6.2.2.1
; Table: 6.2.2.1/1
; Versions: 18.2.0..19.3.0
"This IE shall be present if the Maximum Retransmission Time IE is present in the message."
    present-if Maximum-Retransmission-Time


; Type: Interpreted Constraints
; Id: tfa-experimental-result-vendor
; AVP: Experimental-Result
; Command: MT-Forward-Short-Message-Answer
; Section: 6.2.2.1
; Table: 6.2.2.1/2
; Versions: 18.2.0..19.3.0
"This is a grouped AVP which shall contain the 3GPP Vendor ID in the Vendor-Id AVP, and the error code in the Experimental-Result-Code AVP."
    requires Experimental-Result/Vendor-Id = 10415


;; The three causes are clause 6.3.3.6's MEMORY_CAPACITY_EXCEEDED (0),
;; EQUIPMENT_PROTOCOL_ERROR (1), MAP's equipmentProtocolError the UE error is
;; (clause 6.3.3.6's NOTE), and EQUIPMENT_NOT_SM-EQUIPPED (2).
; Type: Interpreted Constraints
; Id: tfa-sm-delivery-failure-cause
; AVP: SM-Delivery-Failure-Cause
; Command: MT-Forward-Short-Message-Answer
; Section: 6.2.2.1
; Table: 6.2.2.1/2
; Versions: 18.2.0..19.3.0
"If Experimental-Result-Code is set to DIAMETER_ERROR_SM_DELIVERY_FAILURE, this information element shall be present and indicate one of the following:"
"memory capacity exceeded in the mobile equipment"
"UE error"
"mobile equipment not equipped to support the mobile terminated short message service"
    present-if Experimental-Result/Experimental-Result-Code = DIAMETER_ERROR_SM_DELIVERY_FAILURE
    requires SM-Delivery-Failure-Cause/SM-Enumerated-Delivery-Failure-Cause in MEMORY_CAPACITY_EXCEEDED,
        EQUIPMENT_PROTOCOL_ERROR, EQUIPMENT_NOT_SM-EQUIPPED


;; Two times compared: no kind says it.
; Type: Interpreted Constraints
; Id: tfa-requested-retransmission-time
; AVP: Requested-Retransmission-Time
; Command: MT-Forward-Short-Message-Answer
; Section: 6.2.2.1
; Table: 6.2.2.1/2
; Versions: 18.2.0..19.3.0
"This information element may only be present if the Experimental-Result-Code is set to DIAMETER_ERROR_ABSENT_USER and if the Maximum Retransmission Time information element is present in the MT Forward Short Message Request."
    requires Experimental-Result/Experimental-Result-Code = DIAMETER_ERROR_ABSENT_USER and request/Maximum-Retransmission-Time
"The Requested Retransmission Time shall not exceed the Maximum Retransmission Time received from the SMS-GMSC."
    text-only


;; Whether the SMS Router sends the answer it does not carry; TS 29.336's
;; grouped AVP's User-Name read through a path from the command.
; Type: Interpreted Constraints
; Id: tfa-user-identifier
; AVP: User-Identifier
; Command: MT-Forward-Short-Message-Answer
; Section: 6.2.2.1
; Table: 6.2.2.1/2
; Versions: 18.2.0..19.3.0
"This IE shall be present in the message from the SMS Router to the SMS-GMSC, if the Requested Retransmission Time IE is present in the message."
    text-only
"When present, this information shall contain an MT Correlation ID (encoded in the User-Name AVP)."
    requires User-Identifier/User-Name


;; Clause 6.2.3.1's tables. What the node has available.
; Type: Interpreted Constraints
; Id: alr-new-serving-node
; AVP: Serving-Node
; Command: Alert-Service-Centre-Request
; Section: 6.2.3.1
; Table: 6.2.3.1-1
; Versions: 18.2.0..19.3.0
"This IE shall be present if available and if the SMS-GMSC Alert Event indicates that the UE has moved under the coverage of another MME or SGSN."
    text-only


;; Clause 6.3.2.2, in each SGd command; ALR and ALA are S6c's (5.3.2.2).
; Type: Interpreted Constraints
; Id: ofr-no-vendor-specific-application-id
; AVP: Vendor-Specific-Application-Id
; Command: MO-Forward-Short-Message-Request
; Section: 6.3.2.2
; Versions: 18.2.0..19.3.0
"The Vendor-Specific-Application-Id AVP shall not be included in any command sent by Diameter nodes supporting applications defined in this specification."
    absent


; Type: Interpreted Constraints
; Id: ofa-no-vendor-specific-application-id
; AVP: Vendor-Specific-Application-Id
; Command: MO-Forward-Short-Message-Answer
; Section: 6.3.2.2
; Versions: 18.2.0..19.3.0
"The Vendor-Specific-Application-Id AVP shall not be included in any command sent by Diameter nodes supporting applications defined in this specification."
    absent


; Type: Interpreted Constraints
; Id: tfr-no-vendor-specific-application-id
; AVP: Vendor-Specific-Application-Id
; Command: MT-Forward-Short-Message-Request
; Section: 6.3.2.2
; Versions: 18.2.0..19.3.0
"The Vendor-Specific-Application-Id AVP shall not be included in any command sent by Diameter nodes supporting applications defined in this specification."
    absent


; Type: Interpreted Constraints
; Id: tfa-no-vendor-specific-application-id
; AVP: Vendor-Specific-Application-Id
; Command: MT-Forward-Short-Message-Answer
; Section: 6.3.2.2
; Versions: 18.2.0..19.3.0
"The Vendor-Specific-Application-Id AVP shall not be included in any command sent by Diameter nodes supporting applications defined in this specification."
    absent


; Type: Interpreted Constraints
; Id: sc-address-tbcd
; AVP: SC-Address
; Section: 6.3.3.2
; Versions: 18.2.0..19.3.0
"The SC-Address AVP is of type OctetString and it shall contain the E.164 number of the SMS-SC or MTC-IWF, in international number format as described in ITU-T Recommendation E.164 [13] and encoded as a TBCD-string."
"This AVP shall not include leading indicators for the nature of address and the numbering plan; it shall contain only the TBCD-encoded digits of the address."
    encoding e164-tbcd


; Type: Interpreted Constraints
; Id: sm-rp-ui-tpdu
; AVP: SM-RP-UI
; Section: 6.3.3.3
; Versions: 18.2.0..19.3.0
"The SM-RP-UI is of type OctetString and it shall contain a short message transfer protocol data unit (TPDU) which is defined in 3GPP TS 23.040 [3] and represents the user data field carried by the short message service relay sub-layer protocol."
    encoding element TS23.040 9.2.2 "TPDU"
"Its maximum length is of 200 octets."
    length *..200 octets


; Type: Interpreted Constraints
; Id: tfr-flags-undefined-bits
; AVP: TFR-Flags
; Section: 6.3.3.4
; Table: 6.3.3.4/1
; Versions: 18.2.0..19.3.0
"NOTE 1: Bits not defined in this table shall be cleared by the sending entity and discarded by the receiving entity."
    bits only 0


; Type: Interpreted Constraints
; Id: sgd-feature-list-id
; AVP: Feature-List-ID
; Section: 6.3.3.8
; Versions: 18.2.0..19.3.0
"For this release, the Feature-List-ID AVP value shall be set to 1."
    range 1


; Type: Interpreted Constraints
; Id: hss-id-composition
; AVP: HSS-ID
; Section: 6.3.3.14
; Versions: 18.2.0..19.3.0
"The definition and the composition of the HSS-ID are specified in 3GPP TS 23.003 [16]."
    encoding element TS23.003 5.3 "HSS-ID"


; Type: Interpreted Constraints
; Id: sms-gmsc-address-tbcd
; AVP: SMS-GMSC-Address
; Section: 6.3.3.19
; Versions: 18.2.0..19.3.0
"The SMS-GMSC-Address AVP is of type OctetString and it shall contain the E.164 number of the SMS-GMSC or SMS Router, in international number format as described in ITU-T Recommendation E.164 [13] and encoded as a TBCD-string."
"This AVP shall not include leading indicators for the nature of address and the numbering plan; it shall contain only the TBCD-encoded digits of the address."
    encoding e164-tbcd


;; Clause 7.3.1, in each answer, the ten codes clause 7.3 defines.
; Type: Interpreted Constraints
; Id: sra-result-code-absent-with-experimental-result
; AVP: Result-Code
; Command: Send-Routing-info-for-SM-Answer
; Section: 7.3.1
; Versions: 18.2.0..19.3.0
"When one of the result codes defined here is included in a response, it shall be inside an Experimental-Result AVP and the Result-Code AVP shall be absent."
    absent-if Experimental-Result/Experimental-Result-Code in DIAMETER_ERROR_USER_UNKNOWN,
        DIAMETER_ERROR_ABSENT_USER, DIAMETER_ERROR_USER_BUSY_FOR_MT_SMS,
        DIAMETER_ERROR_FACILITY_NOT_SUPPORTED, DIAMETER_ERROR_ILLEGAL_USER,
        DIAMETER_ERROR_ILLEGAL_EQUIPMENT, DIAMETER_ERROR_SM_DELIVERY_FAILURE,
        DIAMETER_ERROR_SERVICE_NOT_SUBSCRIBED, DIAMETER_ERROR_SERVICE_BARRED,
        DIAMETER_ERROR_MWD_LIST_FULL


; Type: Interpreted Constraints
; Id: ala-result-code-absent-with-experimental-result
; AVP: Result-Code
; Command: Alert-Service-Centre-Answer
; Section: 7.3.1
; Versions: 18.2.0..19.3.0
"When one of the result codes defined here is included in a response, it shall be inside an Experimental-Result AVP and the Result-Code AVP shall be absent."
    absent-if Experimental-Result/Experimental-Result-Code in DIAMETER_ERROR_USER_UNKNOWN,
        DIAMETER_ERROR_ABSENT_USER, DIAMETER_ERROR_USER_BUSY_FOR_MT_SMS,
        DIAMETER_ERROR_FACILITY_NOT_SUPPORTED, DIAMETER_ERROR_ILLEGAL_USER,
        DIAMETER_ERROR_ILLEGAL_EQUIPMENT, DIAMETER_ERROR_SM_DELIVERY_FAILURE,
        DIAMETER_ERROR_SERVICE_NOT_SUBSCRIBED, DIAMETER_ERROR_SERVICE_BARRED,
        DIAMETER_ERROR_MWD_LIST_FULL


; Type: Interpreted Constraints
