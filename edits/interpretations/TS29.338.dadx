;; Clause 5.2.1.1's tables. Whether the user has an MSISDN the request does
;; not say; without the MSISDN it carries the IMSI or the HSS-ID.
; Type: Interpreted Constraints
; Id: srr-msisdn
; AVP: MSISDN
; Command: Send-Routing-Info-for-SM-Request
; Section: 5.2.1.1
; Table: 5.2.1.1-1
; Versions: 18.2.0..19.3.0
"This information element shall be present when the MSISDN exists and shall contain the MSISDN of the user."
    text-only


; Type: Interpreted Constraints
; Id: srr-user-name
; AVP: User-Name
; Command: Send-Routing-Info-for-SM-Request
; Section: 5.2.1.1
; Table: 5.2.1.1-1
; Versions: 18.2.0..19.3.0
"This information element shall be present when the MSISDN does not exist"
    present-if not MSISDN


;; The grouped AVP's members, read through paths from the command, whose
;; SMSMI-Correlation-ID other commands fill otherwise.
; Type: Interpreted Constraints
; Id: srr-smsmi-correlation-id
; AVP: SMSMI-Correlation-ID
; Command: Send-Routing-Info-for-SM-Request
; Section: 5.2.1.1
; Table: 5.2.1.1-1
; Versions: 18.2.0..19.3.0
"This information element shall contain the SIP-URI of the (MSISDN-less) destination user. The SIP-URI of the originating user and the HSS-ID shall be absent from this information element."
    requires SMSMI-Correlation-ID/Destination-SIP-URI
    absent-if SMSMI-Correlation-ID/Originating-SIP-URI or SMSMI-Correlation-ID/HSS-ID


;; The SMS-GMSC's capability.
; Type: Interpreted Constraints
; Id: srr-sm-rp-smea
; AVP: SM-RP-SMEA
; Command: Send-Routing-Info-for-SM-Request
; Section: 5.2.1.1
; Table: 5.2.1.1-1
; Versions: 18.2.0..19.3.0
"This information element shall be present if the SMS-GMSC supports receiving of the two numbers from the HSS."
    text-only


;; Each answer's Result row: the S6c and SGd errors are 3GPP's.
; Type: Interpreted Constraints
; Id: sra-experimental-result-vendor
; AVP: Experimental-Result
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.1
; Table: 5.2.1.1-2
; Versions: 18.2.0..19.3.0
"Experimental-Result AVP shall be used for S6c errors. This is a grouped AVP which contains the 3GPP Vendor ID in the Vendor-Id AVP, and the error code in the Experimental-Result-Code AVP."
    requires Experimental-Result/Vendor-Id = 10415


;; The UNRI is the HSS's, and which node the answer goes to it does not say.
; Type: Interpreted Constraints
; Id: sra-user-name
; AVP: User-Name
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.1
; Table: 5.2.1.1-2
; Versions: 18.2.0..19.3.0
"This information element shall be present in a successful answer."
    present-if Result-Code = DIAMETER_SUCCESS
"This information element shall be present in an answer from the HSS to the IP-SM-GW, if an Absent User result is returned and the UNRI is not set."
    text-only


;; Held to a request without SM-Delivery-Not-Intended, whose answer "may" lack it.
; Type: Interpreted Constraints
; Id: sra-serving-node
; AVP: Serving-Node
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.1
; Table: 5.2.1.1-2
; Versions: 18.2.0..19.3.0
"If the \"SM-Delivery-Not-Intended\" Information Element was present in the request, this information element may be absent. This information element shall be present in a successful answer."
    present-if Result-Code = DIAMETER_SUCCESS and not request/SM-Delivery-Not-Intended


;; Whether the VLR used an LMSI the answer does not show.
; Type: Interpreted Constraints
; Id: sra-lmsi
; AVP: LMSI
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.1
; Table: 5.2.1.1-2
; Versions: 18.2.0..19.3.0
"The HSS shall include the LMSI in a successful response, if the VLR has used the LMSI and if there is the ISDN number of an MSC in the answer."
    text-only


;; Two AVPs' contents differing: no kind says it.
; Type: Interpreted Constraints
; Id: sra-additional-serving-node
; AVP: Additional-Serving-Node
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.1
; Table: 5.2.1.1-2
; Versions: 18.2.0..19.3.0
"It shall not contain information delivered in the Serving Node information element."
    text-only


;; What the HSS stores.
; Type: Interpreted Constraints
; Id: sra-user-identifier
; AVP: User-Identifier
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.1
; Table: 5.2.1.1-2
; Versions: 18.2.0..19.3.0
"This information element shall contain the MSISDN stored in the HSS, when available."
    text-only


;; What the HSS stores.
; Type: Interpreted Constraints
; Id: sra-mme-absent-user-diagnostic-sm
; AVP: MME-Absent-User-Diagnostic-SM
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.1
; Table: 5.2.1.1-2
; Versions: 18.2.0..19.3.0
"This information element shall contain the reason of the absence of the user when given by the MME and stored in the HSS"
    text-only


; Type: Interpreted Constraints
; Id: sra-msc-absent-user-diagnostic-sm
; AVP: MSC-Absent-User-Diagnostic-SM
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.1
; Table: 5.2.1.1-2
; Versions: 18.2.0..19.3.0
"This information element shall contain the reason of the absence of the user when given by the MSC and stored in the HSS"
    text-only


; Type: Interpreted Constraints
; Id: sra-sgsn-absent-user-diagnostic-sm
; AVP: SGSN-Absent-User-Diagnostic-SM
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.1
; Table: 5.2.1.1-2
; Versions: 18.2.0..19.3.0
"This information element shall contain the reason of the absence of the user when given by the SGSN and stored in the HSS"
    text-only


;; Whether an SMSF is registered, and the SMS-GMSC's support of a feature,
;; neither message shows.
; Type: Interpreted Constraints
; Id: sra-smsf-3gpp-address
; AVP: SMSF-3GPP-Address
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.1
; Table: 5.2.1.1-2
; Versions: 18.2.0..19.3.0
"If the \"SM-Delivery-Not-Intended\" Information Element was not present in the request, this information element shall contain the identity of the registered SMSF for 3GPP access."
    text-only
"NOTE: If the feature \"SMSF-Support\" is not supported by the SMS-GMSC, IP-SM-GW, or SMS Router, the AVPs SMSF-3GPP-Address, SMSF-Non-3GPP-Address, SMSF-3GPP-Absent-User-Diagnostic and SMSF-Non-3GPP-Absent-User-Diagnostic shall not be present."
    text-only


; Type: Interpreted Constraints
; Id: sra-smsf-non-3gpp-address
; AVP: SMSF-Non-3GPP-Address
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.1
; Table: 5.2.1.1-2
; Versions: 18.2.0..19.3.0
"If the \"SM-Delivery-Not-Intended\" Information Element was not present in the request, this information element shall contain the identity of the registered SMSF or Non-3GPP access."
    text-only
"NOTE: If the feature \"SMSF-Support\" is not supported by the SMS-GMSC, IP-SM-GW, or SMS Router, the AVPs SMSF-3GPP-Address, SMSF-Non-3GPP-Address, SMSF-3GPP-Absent-User-Diagnostic and SMSF-Non-3GPP-Absent-User-Diagnostic shall not be present."
    text-only


; Type: Interpreted Constraints
; Id: sra-smsf-3gpp-absent-user-diagnostic-sm
; AVP: SMSF-3GPP-Absent-User-Diagnostic-SM
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.1
; Table: 5.2.1.1-2
; Versions: 18.2.0..19.3.0
"This information element shall contain the reason of the absence of the user when given by the SMSF registered for 3GPP access."
    text-only
"NOTE: If the feature \"SMSF-Support\" is not supported by the SMS-GMSC, IP-SM-GW, or SMS Router, the AVPs SMSF-3GPP-Address, SMSF-Non-3GPP-Address, SMSF-3GPP-Absent-User-Diagnostic and SMSF-Non-3GPP-Absent-User-Diagnostic shall not be present."
    text-only


; Type: Interpreted Constraints
; Id: sra-smsf-non-3gpp-absent-user-diagnostic-sm
; AVP: SMSF-Non-3GPP-Absent-User-Diagnostic-SM
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.1
; Table: 5.2.1.1-2
; Versions: 18.2.0..19.3.0
"This information element shall contain the reason of the absence of the user when given by the SMSF registered for Non-3GPP access."
    text-only
"NOTE: If the feature \"SMSF-Support\" is not supported by the SMS-GMSC, IP-SM-GW, or SMS Router, the AVPs SMSF-3GPP-Address, SMSF-Non-3GPP-Address, SMSF-3GPP-Absent-User-Diagnostic and SMSF-Non-3GPP-Absent-User-Diagnostic shall not be present."
    text-only


;; Clause 5.2.1.3, the HSS's answer: the IP-SM-GW number is Serving-Node's,
;; read where the answer carries one.
; Type: Interpreted Constraints
; Id: sra-smsmi-ip-sm-gw-number
; AVP: Serving-Node
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.3
; Versions: 18.2.0..19.3.0
"In the context of MSISDN-less SMS delivery in IMS (see 3GPP TS 23.204 [17]), if the HSS receives an SMSMI correlation ID, the HSS shall return the IP-SM-GW number and shall not forward the request to an IP-SM-GW."
    excludes request/SMSMI-Correlation-ID and not Serving-Node/IP-SM-GW-Number


;; The HSS may carry an SMSF's address in Additional-Serving-Node for an
;; SMS-GMSC without SMSF-Support (clause 5.3.3.13), whatever the GPRS indicator.
; Type: Interpreted Constraints
; Id: sra-only-one-serving-node
; AVP: Additional-Serving-Node
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.3
; Versions: 18.2.0..19.3.0
"if the GPRS indicator is not set, only one serving node address shall be returned according to the SM transfer option where MME is considered as a MSC."
    text-only


;; The local policy and the subscription.
; Type: Interpreted Constraints
; Id: sra-mps-priority
; AVP: MPS-Priority
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.2.1.3
; Versions: 19.3.0
"If allowed by local policy, the HSS shall handle the request with priority, shall include the MPS-Priority AVP in the Send Routing Info for SM answer"
    text-only


; Type: Interpreted Constraints
; Id: alr-smsmi-correlation-id
; AVP: SMSMI-Correlation-ID
; Command: Alert-Service-Centre-Request
; Section: 5.2.2.1
; Table: 5.2.2.1-1
; Versions: 18.2.0..19.3.0
"This information shall contain the SIP-URI of the destination user which is stored in the Message Waiting Data list in a retry context of SMS for IMS UE to IMS UE without MSISDN (see 3GPP TS 23.204 [17]). The HSS-ID and the Originating SIP-URI shall be absent."
    requires SMSMI-Correlation-ID/Destination-SIP-URI
    absent-if SMSMI-Correlation-ID/HSS-ID or SMSMI-Correlation-ID/Originating-SIP-URI


;; What the HSS has available.
; Type: Interpreted Constraints
; Id: alr-maximum-ue-availability-time
; AVP: Maximum-UE-Availability-Time
; Command: Alert-Service-Centre-Request
; Section: 5.2.2.1
; Table: 5.2.2.1-1
; Versions: 18.2.0..19.3.0
"This information element shall be included, if available."
    text-only


; Type: Interpreted Constraints
; Id: ala-experimental-result-vendor
; AVP: Experimental-Result
; Command: Alert-Service-Centre-Answer
; Section: 5.2.2.1
; Table: 5.2.2.1-2
; Versions: 18.2.0..19.3.0
"The Experimental-Result AVP shall be used for S6c errors. This is a grouped AVP which contains the 3GPP Vendor ID in the Vendor-Id AVP, and the error code in the Experimental-Result-Code AVP."
    requires Experimental-Result/Vendor-Id = 10415


; Type: Interpreted Constraints
; Id: rdr-smsmi-correlation-id
; AVP: SMSMI-Correlation-ID
; Command: Report-SM-Delivery-Status-Request
; Section: 5.2.3.1
; Table: 5.2.3.1-1
; Versions: 18.2.0..19.3.0
"In a retry context of SMS for IMS UE to IMS UE without MSISDN (see 3GPP TS 23.204 [17]), this information element shall contain the SIP-URI of the (MSISDN-less) destination user. The originating SIP-URI and the HSS-ID shall be absent from this information element."
    requires SMSMI-Correlation-ID/Destination-SIP-URI
    absent-if SMSMI-Correlation-ID/Originating-SIP-URI or SMSMI-Correlation-ID/HSS-ID


;; The grouped AVP's members, read through paths from the command; the
;; diagnostic is the SMS-GMSC's when it has one.
; Type: Interpreted Constraints
; Id: rdr-sm-delivery-outcome
; AVP: SM-Delivery-Outcome
; Command: Report-SM-Delivery-Status-Request
; Section: 5.2.3.1
; Table: 5.2.3.1-1
; Versions: 18.2.0..19.3.0
"At least one cause shall be present."
    requires SM-Delivery-Outcome/MSC-SM-Delivery-Outcome or SM-Delivery-Outcome/MME-SM-Delivery-Outcome or SM-Delivery-Outcome/SGSN-SM-Delivery-Outcome or SM-Delivery-Outcome/IP-SM-GW-SM-Delivery-Outcome or SM-Delivery-Outcome/SMSF-3GPP-SM-Delivery-Outcome or SM-Delivery-Outcome/SMSF-Non-3GPP-SM-Delivery-Outcome
"A cause originated from a MSC and a cause originated from a MME shall not be both present."
    excludes SM-Delivery-Outcome/MSC-SM-Delivery-Outcome and SM-Delivery-Outcome/MME-SM-Delivery-Outcome
"When the cause is Absent User, the Absent User Diagnostic, if available, shall be associated to the cause."
    text-only


; Type: Interpreted Constraints
; Id: rda-experimental-result-vendor
; AVP: Experimental-Result
; Command: Report-SM-Delivery-Status-Answer
; Section: 5.2.3.1
; Table: 5.2.3.1-2
; Versions: 18.2.0..19.3.0
"The Experimental-Result AVP shall be used for S6c errors. This is a grouped AVP which contains the 3GPP Vendor ID in the Vendor-Id AVP, and the error code in the Experimental-Result-Code AVP."
    requires Experimental-Result/Vendor-Id = 10415


;; The MSISDN the HSS stores, and two values differing, which no kind says.
; Type: Interpreted Constraints
; Id: rda-user-identifier
; AVP: User-Identifier
; Command: Report-SM-Delivery-Status-Answer
; Section: 5.2.3.1
; Table: 5.2.3.1-2
; Versions: 18.2.0..19.3.0
"This information element shall contain the Alert MSISDN of the user if it is different from the MSISDN received in the request."
    text-only


;; Two AVPs' contents differing: no kind says it.
; Type: Interpreted Constraints
; Id: rda-additional-serving-node
; AVP: Additional-Serving-Node
; Command: Report-SM-Delivery-Status-Answer
; Section: 5.2.3.1
; Table: 5.2.3.1-2
; Versions: 19.3.0
"It shall not contain information delivered in the Serving Node Alert information element."
    text-only


;; The SMS-GMSC's support of a feature.
; Type: Interpreted Constraints
; Id: rda-smsf-3gpp-address
; AVP: SMSF-3GPP-Address
; Command: Report-SM-Delivery-Status-Answer
; Section: 5.2.3.1
; Table: 5.2.3.1-2
; Versions: 19.3.0
"NOTE: If the feature \"SMSF-Support\" is not supported by the SMS-GMSC, IP-SM-GW, or SMS Router, the AVPs SMSF-3GPP-Address and SMSF-Non-3GPP-Address shall not be present."
    text-only


; Type: Interpreted Constraints
; Id: rda-smsf-non-3gpp-address
; AVP: SMSF-Non-3GPP-Address
; Command: Report-SM-Delivery-Status-Answer
; Section: 5.2.3.1
; Table: 5.2.3.1-2
; Versions: 19.3.0
"NOTE: If the feature \"SMSF-Support\" is not supported by the SMS-GMSC, IP-SM-GW, or SMS Router, the AVPs SMSF-3GPP-Address and SMSF-Non-3GPP-Address shall not be present."
    text-only


;; Clause 5.3.2.2, in each S6c command, whose ABNF prints the AVP only, its
;; NOTE says, for agents not complying with RFC 6733.
; Type: Interpreted Constraints
; Id: srr-no-vendor-specific-application-id
; AVP: Vendor-Specific-Application-Id
; Command: Send-Routing-Info-for-SM-Request
; Section: 5.3.2.2
; Versions: 18.2.0..19.3.0
"The Vendor-Specific-Application-Id AVP shall not be included in any command sent by Diameter nodes supporting applications defined in this specification."
    absent


; Type: Interpreted Constraints
; Id: sra-no-vendor-specific-application-id
; AVP: Vendor-Specific-Application-Id
; Command: Send-Routing-info-for-SM-Answer
; Section: 5.3.2.2
; Versions: 18.2.0..19.3.0
"The Vendor-Specific-Application-Id AVP shall not be included in any command sent by Diameter nodes supporting applications defined in this specification."
    absent


; Type: Interpreted Constraints
; Id: alr-no-vendor-specific-application-id
; AVP: Vendor-Specific-Application-Id
; Command: Alert-Service-Centre-Request
; Section: 5.3.2.2
; Versions: 18.2.0..19.3.0
"The Vendor-Specific-Application-Id AVP shall not be included in any command sent by Diameter nodes supporting applications defined in this specification."
    absent


; Type: Interpreted Constraints
; Id: ala-no-vendor-specific-application-id
; AVP: Vendor-Specific-Application-Id
; Command: Alert-Service-Centre-Answer
; Section: 5.3.2.2
; Versions: 18.2.0..19.3.0
"The Vendor-Specific-Application-Id AVP shall not be included in any command sent by Diameter nodes supporting applications defined in this specification."
    absent


; Type: Interpreted Constraints
; Id: rdr-no-vendor-specific-application-id
; AVP: Vendor-Specific-Application-Id
; Command: Report-SM-Delivery-Status-Request
; Section: 5.3.2.2
; Versions: 18.2.0..19.3.0
"The Vendor-Specific-Application-Id AVP shall not be included in any command sent by Diameter nodes supporting applications defined in this specification."
    absent


; Type: Interpreted Constraints
; Id: rda-no-vendor-specific-application-id
; AVP: Vendor-Specific-Application-Id
; Command: Report-SM-Delivery-Status-Answer
; Section: 5.3.2.2
; Versions: 18.2.0..19.3.0
"The Vendor-Specific-Application-Id AVP shall not be included in any command sent by Diameter nodes supporting applications defined in this specification."
    absent


; Type: Interpreted Constraints
; Id: sm-rp-smea-address
; AVP: SM-RP-SMEA
; Section: 5.3.3.3
; Versions: 18.2.0..19.3.0
"It shall be formatted according to the formatting rules of the address fields described in 3GPP TS 23.040 [3]."
    encoding element TS23.040 9.1.2.5 "Address fields"


; Type: Interpreted Constraints
; Id: srr-flags-undefined-bits
; AVP: SRR-Flags
; Section: 5.3.3.4
; Table: 5.3.3.4/1
; Versions: 18.2.0..19.3.0
"NOTE 1: Bits not defined in this table shall be cleared by the sending entity and discarded by the receiving entity."
    bits only 0 1 2


;; The combinations clause 5.3.3.6 allows, read member by member: every one
;; holds one of the four numbers, and each member only beside the others of
;; its combination. Combination b's condition is the HSS's, which the AVP
;; does not show, so its members are allowed whatever it.
; Type: Interpreted Constraints
; Id: serving-node-number
; AVP: Serving-Node
; Section: 5.3.3.6
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"a) SGSN-Number"
"c) MME-Name & MME-Realm & MME-Number-for-MT-SMS"
"d) MSC-Number"
"f) IP-SM-GW-Number"
    members at-least-one SGSN-Number MME-Number-for-MT-SMS MSC-Number IP-SM-GW-Number


; Type: Interpreted Constraints
; Id: serving-node-sgsn-number
; AVP: SGSN-Number
; Within: Serving-Node
; Section: 5.3.3.6
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"a) SGSN-Number"
"b) SGSN-Name & SGSN-Realm & SGSN-Number if the HSS supports the \"Gdd in SGSN\" feature and has received the \"Gdd in SGSN\" indication over S6a or Gr interface from the SGSN (cf. 3GPP TS 29.272 [4] and 3GPP TS 29.002 [9])"
    excludes MME-Name or MME-Realm or MME-Number-for-MT-SMS or MSC-Number or IP-SM-GW-Number or IP-SM-GW-Name or IP-SM-GW-Realm or IP-SM-GW-SBI-Support-Indicator


; Type: Interpreted Constraints
; Id: serving-node-sgsn-name
; AVP: SGSN-Name
; Within: Serving-Node
; Section: 5.3.3.6
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"b) SGSN-Name & SGSN-Realm & SGSN-Number if the HSS supports the \"Gdd in SGSN\" feature and has received the \"Gdd in SGSN\" indication over S6a or Gr interface from the SGSN (cf. 3GPP TS 29.272 [4] and 3GPP TS 29.002 [9])"
    requires SGSN-Realm and SGSN-Number


; Type: Interpreted Constraints
; Id: serving-node-sgsn-realm
; AVP: SGSN-Realm
; Within: Serving-Node
; Section: 5.3.3.6
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"b) SGSN-Name & SGSN-Realm & SGSN-Number if the HSS supports the \"Gdd in SGSN\" feature and has received the \"Gdd in SGSN\" indication over S6a or Gr interface from the SGSN (cf. 3GPP TS 29.272 [4] and 3GPP TS 29.002 [9])"
    requires SGSN-Name and SGSN-Number


; Type: Interpreted Constraints
; Id: serving-node-mme-name
; AVP: MME-Name
; Within: Serving-Node
; Section: 5.3.3.6
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"c) MME-Name & MME-Realm & MME-Number-for-MT-SMS"
"e) MSC-Number & MME-Name & MME-Realm"
    requires MME-Realm and MME-Number-for-MT-SMS or MME-Realm and MSC-Number


; Type: Interpreted Constraints
; Id: serving-node-mme-realm
; AVP: MME-Realm
; Within: Serving-Node
; Section: 5.3.3.6
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"c) MME-Name & MME-Realm & MME-Number-for-MT-SMS"
"e) MSC-Number & MME-Name & MME-Realm"
    requires MME-Name


; Type: Interpreted Constraints
; Id: serving-node-mme-number
; AVP: MME-Number-for-MT-SMS
; Within: Serving-Node
; Section: 5.3.3.6
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"c) MME-Name & MME-Realm & MME-Number-for-MT-SMS"
    requires MME-Name and MME-Realm
    excludes MSC-Number or IP-SM-GW-Number


; Type: Interpreted Constraints
; Id: serving-node-msc-number
; AVP: MSC-Number
; Within: Serving-Node
; Section: 5.3.3.6
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"d) MSC-Number"
"e) MSC-Number & MME-Name & MME-Realm"
    excludes IP-SM-GW-Number


; Type: Interpreted Constraints
; Id: serving-node-ip-sm-gw-name
; AVP: IP-SM-GW-Name
; Within: Serving-Node
; Section: 5.3.3.6
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"g) IP-SM-GW-Number & IP-SM-GW-Name"
"i) IP-SM-GW-Number & IP-SM-GW-Name & IP-SM-GW-SBI-Support-Indicator"
    requires IP-SM-GW-Number


; Type: Interpreted Constraints
; Id: serving-node-ip-sm-gw-sbi
; AVP: IP-SM-GW-SBI-Support-Indicator
; Within: Serving-Node
; Section: 5.3.3.6
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"h) IP-SM-GW-Number & IP-SM-GW-SBI-Support-Indicator"
"i) IP-SM-GW-Number & IP-SM-GW-Name & IP-SM-GW-SBI-Support-Indicator"
    requires IP-SM-GW-Number


;; The body prints IP-SM-GW-Realm, which no combination names: whether the
;; list leaves it out or the body adds it the clause does not say.
; Type: Interpreted Constraints
; Id: serving-node-ip-sm-gw-realm
; AVP: IP-SM-GW-Realm
; Within: Serving-Node
; Section: 5.3.3.6
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"f) IP-SM-GW-Number"
"g) IP-SM-GW-Number & IP-SM-GW-Name"
"h) IP-SM-GW-Number & IP-SM-GW-SBI-Support-Indicator"
"i) IP-SM-GW-Number & IP-SM-GW-Name & IP-SM-GW-SBI-Support-Indicator"
    text-only


;; As Serving-Node's, its five combinations.
; Type: Interpreted Constraints
; Id: additional-serving-node-number
; AVP: Additional-Serving-Node
; Section: 5.3.3.7
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"a) SGSN-Number"
"c) MME-Name & MME-Realm & MME-Number-for-MT-SMS"
"d) MSC-Number"
    members at-least-one SGSN-Number MME-Number-for-MT-SMS MSC-Number


; Type: Interpreted Constraints
; Id: additional-serving-node-sgsn-number
; AVP: SGSN-Number
; Within: Additional-Serving-Node
; Section: 5.3.3.7
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"a) SGSN-Number"
"b) SGSN-Name & SGSN-Realm & SGSN-Number if the HSS supports the \"Gdd in SGSN\" feature and has received the \"Gdd in SGSN\" indication over S6a or Gr interface from the SGSN (cf. 3GPP TS 29.272 [4] and 3GPP TS 29.002 [9]"
    excludes MME-Name or MME-Realm or MME-Number-for-MT-SMS or MSC-Number


; Type: Interpreted Constraints
; Id: additional-serving-node-sgsn-name
; AVP: SGSN-Name
; Within: Additional-Serving-Node
; Section: 5.3.3.7
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"b) SGSN-Name & SGSN-Realm & SGSN-Number if the HSS supports the \"Gdd in SGSN\" feature and has received the \"Gdd in SGSN\" indication over S6a or Gr interface from the SGSN (cf. 3GPP TS 29.272 [4] and 3GPP TS 29.002 [9]"
    requires SGSN-Realm and SGSN-Number


; Type: Interpreted Constraints
; Id: additional-serving-node-sgsn-realm
; AVP: SGSN-Realm
; Within: Additional-Serving-Node
; Section: 5.3.3.7
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"b) SGSN-Name & SGSN-Realm & SGSN-Number if the HSS supports the \"Gdd in SGSN\" feature and has received the \"Gdd in SGSN\" indication over S6a or Gr interface from the SGSN (cf. 3GPP TS 29.272 [4] and 3GPP TS 29.002 [9]"
    requires SGSN-Name and SGSN-Number


; Type: Interpreted Constraints
; Id: additional-serving-node-mme-name
; AVP: MME-Name
; Within: Additional-Serving-Node
; Section: 5.3.3.7
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"c) MME-Name & MME-Realm & MME-Number-for-MT-SMS"
"e) MSC-Number & MME-Name & MME-Realm"
    requires MME-Realm and MME-Number-for-MT-SMS or MME-Realm and MSC-Number


; Type: Interpreted Constraints
; Id: additional-serving-node-mme-realm
; AVP: MME-Realm
; Within: Additional-Serving-Node
; Section: 5.3.3.7
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"c) MME-Name & MME-Realm & MME-Number-for-MT-SMS"
"e) MSC-Number & MME-Name & MME-Realm"
    requires MME-Name


; Type: Interpreted Constraints
; Id: additional-serving-node-mme-number
; AVP: MME-Number-for-MT-SMS
; Within: Additional-Serving-Node
; Section: 5.3.3.7
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"c) MME-Name & MME-Realm & MME-Number-for-MT-SMS"
    requires MME-Name and MME-Realm
    excludes MSC-Number


;; Release 19's table, bits 0 to 5, its bit 5 MNR5GN3G-Set's row quoted.
; Type: Interpreted Constraints
; Id: mwd-status-undefined-bits
; AVP: MWD-Status
; Section: 5.3.3.8
; Table: 5.3.3.8/1
; Versions: 19.3.0
"This bit, when set, shall indicate that the HSS/UDM is waiting for a reachability notification / registration from 5G non-3GPP serving nodes"
"NOTE: Bits not defined in this table shall be cleared by the sending HSS and discarded by the receiving MME."
    bits only 0 1 2 3 4 5


;; Release 18's table, V18.2.0, bits 0 to 4, its bit 4 MNR5G-Set waiting for
;; every 5G serving node.
; Type: Interpreted Constraints
; Id: mwd-status-undefined-bits-rel18
; AVP: MWD-Status
; Section: 5.3.3.8
; Table: 5.3.3.8/1
; Versions: 18.2.0
"This bit, when set, shall indicate that the HSS/UDM is waiting for a reachability notification / registration from 5G serving nodes."
"NOTE: Bits not defined in this table shall be cleared by the sending HSS and discarded by the receiving MME."
    bits only 0 1 2 3 4


