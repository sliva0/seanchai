; AVP: MIP-MSA-Lifetime
; Command: Diameter-EAP-Request
; Section: 8.1
"0:"
"The AVP MUST NOT be present in the message."
"MIP-MSA-Lifetime | 0 | 0 | 0 | 1 |"
    absent


; Type: Interpreted Constraints
; Id: der-mip-mn-ha-msa-table-absent
; AVP: MIP-MN-HA-MSA
; Command: Diameter-EAP-Request
; Section: 8.1
"0:"
"The AVP MUST NOT be present in the message."
"MIP-MN-HA-MSA | 0 | 0 | 0 | 0-1 |"
    absent


; Type: Interpreted Constraints
; Id: der-mip-timestamp-table-absent
; AVP: MIP-Timestamp
; Command: Diameter-EAP-Request
; Section: 8.1
"0:"
"The AVP MUST NOT be present in the message."
"MIP-Timestamp | 0 | 0 | 0-1 | 0-1 |"
    absent


; Type: Interpreted Constraints
; Id: der-mip6-auth-mode-table-absent
; AVP: MIP6-Auth-Mode
; Command: Diameter-EAP-Request
; Section: 8.1
"0:"
"The AVP MUST NOT be present in the message."
"MIP6-Auth-Mode | 0 | 0 | 1 | 0 |"
    absent


