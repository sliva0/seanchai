{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Diameter AVP Dictionary",
  "scopeName": "source.dad",
  "patterns": [
    { "include": "#comment" },
    { "include": "#registry-reserved" },
    { "include": "#reserved" },
    { "include": "#void" },
    { "include": "#vendor-specific" },
    { "include": "#information-elements" },
    { "include": "#command-result-codes" },
    { "include": "#directive-text" },
    { "include": "#directive" },
    { "include": "#message-rule" },
    { "include": "#avp-header-rule" },
    { "include": "#avp-rule" },
    { "include": "#constraint-quote" },
    { "include": "#constraint-element" },
    { "include": "#constraint-rule" },
    { "include": "#constraint-continued" },
    { "include": "#enum-value" },
    { "include": "#table-row" }
  ],
  "repository": {
    "comment": {
      "comment": "A note the corrections layer or the extractor writes names its kind and the declaration: `;; corrected: (TS29.272.py#area-scope-code)`, `;; interpreted: (TS29.272.dadx#imei-digits)`, `;; excluded: clause 8 (Sh-ee), see TS29.329.toml`.",
      "name": "comment.line.double-semicolon.dad",
      "match": ";;.*$",
      "captures": {
        "0": {
          "patterns": [
            {
              "match": "(?<=;; )(corrected|deleted|excluded|foreword|inserted|interpreted|patched|supplied)(?=:)",
              "name": "keyword.other.note.dad"
            },
            {
              "match": "(?<=\\()[A-Za-z0-9_.+-]+\\.(?:py|dadx)#[A-Za-z0-9_.-]+(?=\\))|(?<=see )[A-Za-z0-9_.+-]+\\.toml\\b",
              "name": "markup.underline.link.declaration.dad"
            }
          ]
        }
      }
    },
    "registry-reserved": {
      "match": "^(; RESERVED) (\\d+)(\\.\\.)(\\d+)(?: ([^\\s\"]+))?(?: (\"(?:[^\"\\\\]|\\\\[\"\\\\])*\"))?",
      "captures": {
        "1": { "name": "keyword.other.reserved.dad" },
        "2": { "name": "constant.numeric.dad" },
        "3": { "name": "keyword.operator.range.dad" },
        "4": { "name": "constant.numeric.dad" },
        "5": {
          "patterns": [
            { "match": "(?:TS\\d{2}\\.\\d{3}|RFC\\d+|ETSI-(?:TS|ES)\\d{3}\\.\\d{3}(?:-\\d+)?|3GPP2-[A-Z]\\.[A-Z]\\d{4}(?:-\\d{3})?|OMA(?:-[A-Za-z0-9_]+)+|oneM2M-TS-\\d{4}|Private-[A-Za-z0-9][A-Za-z0-9_.-]*)", "name": "entity.name.tag.spec-ref.dad" },
            { "match": ",", "name": "punctuation.separator.comma.dad" }
          ]
        },
        "6": { "name": "string.quoted.double.mark.dad" }
      }
    },
    "reserved": {
      "match": "^(\\s*)(; RESERVED)(\\s*)(=)\\s*(\\d+)(?:(-)(\\d+))?",
      "captures": {
        "2": { "name": "keyword.other.reserved.dad" },
        "4": { "name": "keyword.operator.assignment.dad" },
        "5": { "name": "constant.numeric.dad" },
        "6": { "name": "keyword.operator.range.dad" },
        "7": { "name": "constant.numeric.dad" }
      }
    },
    "void": {
      "match": "^(\\s*)(; VOID)(\\s*)(=)\\s*(\\d+)(?:(-)(\\d+))?",
      "captures": {
        "2": { "name": "keyword.other.void.dad" },
        "4": { "name": "keyword.operator.assignment.dad" },
        "5": { "name": "constant.numeric.dad" },
        "6": { "name": "keyword.operator.range.dad" },
        "7": { "name": "constant.numeric.dad" }
      }
    },
    "vendor-specific": {
      "match": "^(\\s*)(; VENDOR-SPECIFIC)(\\s*)(=)\\s*(\\d+)(?:(-)(\\d+))?(\\s+; [^;].*?)?(\\s*;;.*)?$",
      "captures": {
        "2": { "name": "keyword.other.vendor-specific.dad" },
        "4": { "name": "keyword.operator.assignment.dad" },
        "5": { "name": "constant.numeric.dad" },
        "6": { "name": "keyword.operator.range.dad" },
        "7": { "name": "constant.numeric.dad" },
        "8": { "name": "string.unquoted.enum-note.dad" },
        "9": { "patterns": [{ "include": "#comment" }] }
      }
    },
    "directive-text": {
      "match": "^(; )(Specification|Interprets|Name|Table|Values|Note)(: )(.*?)(?=;;|$)",
      "captures": {
        "2": { "name": "keyword.other.directive.dad" },
        "4": { "name": "string.unquoted.directive-value.dad" }
      }
    },
    "directive": {
      "match": "^(; )([A-Za-z][A-Za-z-]*)(: )(.*?)(?=;;|$)",
      "captures": {
        "2": { "name": "keyword.other.directive.dad" },
        "4": {
          "patterns": [
            {
              "comment": "A block's `; Type:`, a registry's kind: the whole value.",
              "match": "(?<=: )(Application Scope|Message|Answer Message|Grouped AVP|Enumerated AVP|AVP Table|Reused AVPs|Registry|Undefined AVP|Value Table|Information Elements|Command Result Codes|Interpreted Constraints|Application IDs|Command Codes|AVP Codes|Result Codes)(?=\\s*$)",
              "name": "storage.type.section.dad"
            },
            {
              "comment": "A value table's `; Kind:`.",
              "match": "(?<=: )(result-codes|bits|features|values)(?=\\s*$)",
              "name": "constant.language.value-kind.dad"
            },
            {
              "match": "\\b(?:TS\\d{2}\\.\\d{3}|RFC\\d+|ETSI-(?:TS|ES)\\d{3}\\.\\d{3}(?:-\\d+)?|3GPP2-[A-Z]\\.[A-Z]\\d{4}(?:-\\d{3})?|OMA(?:-[A-Za-z0-9_]+)+|oneM2M-TS-\\d{4}|Private-[A-Za-z0-9][A-Za-z0-9_.-]*)\\b",
              "name": "entity.name.tag.spec-ref.dad"
            },
            {
              "match": "https?://\\S+",
              "name": "markup.underline.link.dad"
            },
            {
              "comment": "A `; Versions:` range, `18.7.0..19.6.0`, either bound `*` where it is open.",
              "match": "(?<=^|[ ,])(?:(\\d+(?:\\.\\d+)+)|(\\*))(\\.\\.)(?:(\\d+(?:\\.\\d+)+)|(\\*))(?=[ ,]|$)",
              "captures": {
                "1": { "name": "constant.other.section.dad" },
                "2": { "name": "keyword.operator.dad" },
                "3": { "name": "keyword.operator.range.dad" },
                "4": { "name": "constant.other.section.dad" },
                "5": { "name": "keyword.operator.dad" }
              }
            },
            {
              "match": "(?<=^|[ ,])(?:\\d+[A-Za-z]*|[A-Za-z])(?:\\.\\d+[A-Za-z]*)+(?=[ ,]|$)",
              "name": "constant.other.section.dad"
            },
            {
              "match": "(?<=^|[ ,])(?:\\d+[A-Za-z]*|[A-Za-z]+)(?:\\.\\d+[A-Za-z]*)*\\.\\*(?=[ ,]|$)",
              "name": "constant.other.section.wildcard.dad"
            },
            {
              "match": "(?<=^|[ ,])\\d+(?=[ ,]|$)",
              "name": "constant.numeric.dad"
            },
            {
              "comment": "The comma between a list's entries, `; Bases: RFC6733, TS29.229`.",
              "match": ",",
              "name": "punctuation.separator.comma.dad"
            },
            {
              "comment": "Any other word, one at a time: a run past a space or a comma would take the entries after it from the rules above.",
              "match": "[^\\s,]+",
              "name": "string.unquoted.directive-value.dad"
            }
          ]
        }
      }
    },
    "message-rule": {
      "match": "^(<)([A-Za-z0-9][A-Za-z0-9_-]*)(>) (::=) (<) (Diameter Header)(:) ([^>]*)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.bracket.fixed.dad" },
        "2": { "name": "entity.name.function.message.dad" },
        "3": { "name": "punctuation.definition.bracket.fixed.dad" },
        "4": { "name": "keyword.operator.definition.dad" },
        "5": { "name": "punctuation.definition.bracket.fixed.dad" },
        "6": { "name": "keyword.other.header.dad" },
        "7": { "name": "punctuation.separator.dad" },
        "8": {
          "patterns": [
            {
              "match": "\\b(REQ|PXY|ERR)\\b",
              "name": "constant.language.command-flag.dad"
            },
            {
              "match": "\\b\\d+\\b",
              "name": "constant.numeric.dad"
            }
          ]
        },
        "9": { "name": "punctuation.definition.bracket.fixed.dad" }
      }
    },
    "avp-header-rule": {
      "match": "^([A-Za-z0-9][A-Za-z0-9_-]*) (::=) (<) ((?:Enumerated )?AVP header)(:) ([^>]*)(>)",
      "captures": {
        "1": { "name": "entity.name.function.avp.dad" },
        "2": { "name": "keyword.operator.definition.dad" },
        "3": { "name": "punctuation.definition.bracket.fixed.dad" },
        "4": { "name": "keyword.other.header.dad" },
        "5": { "name": "punctuation.separator.dad" },
        "6": {
          "patterns": [
            {
              "match": "\\b\\d+\\b",
              "name": "constant.numeric.dad"
            }
          ]
        },
        "7": { "name": "punctuation.definition.bracket.fixed.dad" }
      }
    },
    "avp-rule": {
      "match": "^(\\s*)(\\d*\\*\\d*)?(\\s*)(?:(<) ([A-Za-z0-9][A-Za-z0-9_-]*) (>)|(\\{) ([A-Za-z0-9][A-Za-z0-9_-]*) (\\})|(\\[) ([A-Za-z0-9][A-Za-z0-9_-]*) (\\]))(\\s*; bold)?(\\s*; strikethrough)?\\s*(;;.*)?$",
      "captures": {
        "2": { "name": "keyword.operator.occurrences.dad" },
        "4": { "name": "punctuation.definition.bracket.fixed.dad" },
        "5": { "name": "support.class.avp.fixed.dad" },
        "6": { "name": "punctuation.definition.bracket.fixed.dad" },
        "7": { "name": "punctuation.definition.bracket.required.dad" },
        "8": { "name": "support.function.avp.required.dad" },
        "9": { "name": "punctuation.definition.bracket.required.dad" },
        "10": { "name": "punctuation.definition.bracket.optional.dad" },
        "11": { "name": "variable.other.avp.optional.dad" },
        "12": { "name": "punctuation.definition.bracket.optional.dad" },
        "13": { "name": "storage.modifier.bold.dad" },
        "14": { "name": "storage.modifier.strikethrough.dad" },
        "15": { "patterns": [{ "include": "#comment" }] }
      }
    },
    "constraint-quote": {
      "match": "^(\"(?:[^\"\\\\]|\\\\[\"\\\\])*\")\\s*(;;.*)?$",
      "captures": {
        "1": { "name": "string.quoted.double.quote.dad" },
        "2": { "patterns": [{ "include": "#comment" }] }
      }
    },
    "constraint-element": {
      "comment": "Another document's information element, with the clause and name the clause gives: `encoding element 3GPP2-A.S0022 A \"Mobile Identity (MEID)\"`, the clause an annex's letter alone.",
      "match": "^(    )(encoding) (element)(?: ((?:TS\\d{2}\\.\\d{3}|RFC\\d+|ETSI-(?:TS|ES)\\d{3}\\.\\d{3}(?:-\\d+)?|3GPP2-[A-Z]\\.[A-Z]\\d{4}(?:-\\d{3})?|OMA(?:-[A-Za-z0-9_]+)+|oneM2M-TS-\\d{4}|Private-[A-Za-z0-9][A-Za-z0-9_.-]*)))?(?: ((?:\\d+[A-Za-z]*|[A-Za-z]+)(?:\\.\\d+[A-Za-z]*)*))?(?: (\"(?:[^\"\\\\]|\\\\[\"\\\\])*\"))?(\\s*;;.*)?$",
      "captures": {
        "2": { "name": "keyword.control.constraint.dad" },
        "3": { "name": "support.type.codec.dad" },
        "4": { "name": "entity.name.tag.spec-ref.dad" },
        "5": { "name": "constant.other.section.dad" },
        "6": { "name": "string.quoted.double.mark.dad" },
        "7": { "patterns": [{ "include": "#comment" }] }
      }
    },
    "constraint-rule": {
      "match": "^(    )(length|range|exclude|encoding|present-if|absent-if|requires|excludes|default|bits|members|unique|values|equals|absent|text-only)\\b(.*?)(\\s*;;.*)?$",
      "captures": {
        "2": { "name": "keyword.control.constraint.dad" },
        "3": { "patterns": [{ "include": "#constraint-terms" }] },
        "4": { "patterns": [{ "include": "#comment" }] }
      }
    },
    "constraint-continued": {
      "comment": "A rule line the formatter wraps goes on in lines indented eight spaces, after a comma of an `in` list: no AVP rule, which opens with a bracket, no enum value, which reads `NAME = n`, and no comment.",
      "match": "^(        )(?![0-9*]*\\s*[\\[{<;])(?!(?:\"(?:[^\"\\\\]|\\\\[\"\\\\])*\"|[A-Za-z0-9][A-Za-z0-9_-]*)\\s*=\\s)(\\S.*?)(\\s*;;.*)?$",
      "captures": {
        "2": { "patterns": [{ "include": "#constraint-terms" }] },
        "3": { "patterns": [{ "include": "#comment" }] }
      }
    },
    "constraint-terms": {
      "patterns": [
        {
          "match": "\"(?:[^\"\\\\]|\\\\[\"\\\\])*\"",
          "name": "string.quoted.double.mark.dad"
        },
        {
          "comment": "A length's unit, after its bounds.",
          "match": "(?<=\\d |\\* )(octets|digits|characters)$",
          "name": "constant.language.unit.dad"
        },
        {
          "match": "(?<=encoding )(e164-tbcd|plmn-id-prefix|plmn-id|digits|labels|apn|epc-plmn-domain|plmn-domain|ip-filter-out|ip-filter-flow|ip-filter|ip-address|time-zone|mac-address|element)(?=\\s|$)",
          "name": "support.type.codec.dad"
        },
        {
          "match": "(?<=\\s)(or|and|not|if|bit|in|at-most-one|at-least-one|set|clear|only)(?=\\s)",
          "name": "keyword.operator.condition.dad"
        },
        {
          "comment": "A condition's `=`, a bounds' `..` and an open bound's `*`.",
          "match": "(?<=\\s)=(?=\\s)|\\.\\.|(?<=\\s|\\.\\.)\\*(?=\\s|\\.\\.|$)",
          "name": "keyword.operator.dad"
        },
        {
          "match": "(?<=\\s)(?:TS\\d{2}\\.\\d{3}|RFC\\d+|ETSI-(?:TS|ES)\\d{3}\\.\\d{3}(?:-\\d+)?|3GPP2-[A-Z]\\.[A-Z]\\d{4}(?:-\\d{3})?|OMA(?:-[A-Za-z0-9_]+)+|oneM2M-TS-\\d{4}|Private-[A-Za-z0-9][A-Za-z0-9_.-]*)(?=\\s|$)",
          "name": "entity.name.tag.spec-ref.dad"
        },
        {
          "match": "(?<=\\s)(?:\\d+[A-Za-z]*|[A-Za-z])(?:\\.\\d+[A-Za-z]*)+(?=\\s|$)",
          "name": "constant.other.section.dad"
        },
        {
          "match": "-?\\b\\d+\\b",
          "name": "constant.numeric.dad"
        },
        {
          "comment": "Between the values of `exclude`, `values` and an `in` list.",
          "match": ",",
          "name": "punctuation.separator.comma.dad"
        },
        {
          "comment": "A path's root: the request an answer answers.",
          "match": "(?<=\\s)request(?=/)",
          "name": "keyword.other.root.dad"
        },
        {
          "comment": "Between the names of a path.",
          "match": "/",
          "name": "punctuation.separator.path.dad"
        },
        {
          "comment": "A member or a sibling, a value's or a bit's name.",
          "match": "[A-Za-z0-9][A-Za-z0-9_-]*",
          "name": "variable.other.avp.dad"
        }
      ]
    },
    "enum-value": {
      "match": "^(\\s*)([A-Za-z0-9][A-Za-z0-9_-]*|\"(?:[^\"\\\\]|\\\\[\"\\\\])*\")(\\s*)(=)\\s*(\\d+)(\\s+; [^;].*?)?(\\s*;;.*)?$",
      "captures": {
        "2": { "name": "variable.other.enum.dad" },
        "4": { "name": "keyword.operator.assignment.dad" },
        "5": { "name": "constant.numeric.dad" },
        "6": {
          "name": "string.unquoted.enum-note.dad",
          "patterns": [
            {
              "match": "(?<=\\s)(from) (TS\\d{2}\\.\\d{3}|RFC\\d+|ETSI-(?:TS|ES)\\d{3}\\.\\d{3}(?:-\\d+)?|3GPP2-[A-Z]\\.[A-Z]\\d{4}(?:-\\d{3})?|OMA(?:-[A-Za-z0-9_]+)+|oneM2M-TS-\\d{4}|Private-[A-Za-z0-9][A-Za-z0-9_.-]*)(?=\\s|$)",
              "captures": {
                "1": { "name": "keyword.other.from.dad" },
                "2": { "name": "entity.name.tag.spec-ref.dad" }
              }
            }
          ]
        },
        "7": { "patterns": [{ "include": "#comment" }] }
      }
    },
    "information-elements": {
      "comment": "A block whose rows end in a category, M, C, O, TS 32.299's OM and OC, a dash or a blank, and no flag.",
      "begin": "^(?=; Type: Information Elements\\b)",
      "end": "^(?=; Type: (?!Information Elements\\b))",
      "patterns": [
        { "include": "#comment" },
        { "include": "#directive-text" },
        { "include": "#directive" },
        { "include": "#element-row" },
        { "include": "#element-avp-row" },
        { "include": "#table-row" }
      ]
    },
    "command-result-codes": {
      "comment": "A block whose rows are the result codes a command's answer may carry, a name a line, bare or quoted.",
      "begin": "^(?=; Type: Command Result Codes\\b)",
      "end": "^(?=; Type: (?!Command Result Codes\\b))",
      "patterns": [
        { "include": "#comment" },
        { "include": "#directive-text" },
        { "include": "#directive" },
        {
          "match": "^(\"(?:[^\"\\\\]|\\\\[\"\\\\])*\"|[A-Za-z0-9][A-Za-z0-9_-]*)(\\s*;;.*)?$",
          "captures": {
            "1": { "name": "variable.other.enum.dad" },
            "2": { "patterns": [{ "include": "#comment" }] }
          }
        }
      ]
    },
    "element-row": {
      "comment": "The element's name as printed, the AVPs it maps to (`A,B` carried together, `A/B` one of them, a quoted cell naming none) and its category, set off four spaces a level under a grouped AVP's row.",
      "match": "^\\s*(\"(?:[^\"\\\\]|\\\\[\"\\\\])*\"|[^;\\s\"]\\S*)\\s+(\"(?:[^\"\\\\]|\\\\[\"\\\\])*\"|\\S+)\\s+(OM|OC|[MCO]|-|\"\")(\\s*;;.*)?$",
      "captures": {
        "1": { "patterns": [{ "include": "#quoted-cell" }] },
        "2": {
          "patterns": [
            { "include": "#quoted-cell" },
            {
              "match": "^-$|(?<=\\s)-$",
              "name": "punctuation.definition.empty-cell.dad"
            },
            {
              "match": "[,/]",
              "name": "punctuation.separator.avp.dad"
            },
            {
              "match": "[A-Za-z0-9][A-Za-z0-9_-]*",
              "name": "variable.other.avp.dad"
            }
          ]
        },
        "3": { "name": "constant.language.category.dad" },
        "4": { "patterns": [{ "include": "#comment" }] }
      }
    },
    "element-avp-row": {
      "comment": "A row of a table naming its elements by their AVPs alone (`; Columns: AVP Cat`, TS 32.299's): the AVP cell and its category, set off four spaces a level under a grouped AVP's row.",
      "match": "^\\s*(\"(?:[^\"\\\\]|\\\\[\"\\\\])*\"|[^;\\s\"]\\S*)\\s+(OM|OC|[MCO]|-|\"\")(\\s*;;.*)?$",
      "captures": {
        "1": {
          "patterns": [
            { "include": "#quoted-cell" },
            {
              "match": "^-$|(?<=\\s)-$",
              "name": "punctuation.definition.empty-cell.dad"
            },
            {
              "match": "[,/]",
              "name": "punctuation.separator.avp.dad"
            },
            {
              "match": "[A-Za-z0-9][A-Za-z0-9_-]*",
              "name": "variable.other.avp.dad"
            }
          ]
        },
        "2": { "name": "constant.language.category.dad" },
        "3": { "patterns": [{ "include": "#comment" }] }
      }
    },
    "quoted-cell": {
      "match": "\"(?:[^\"\\\\]|\\\\[\"\\\\])*\"",
      "name": "string.quoted.double.mark.dad"
    },
    "table-row": {
      "match": "^(?!;)(\\S.*?)(\\s*;;.*)?$",
      "captures": {
        "1": { "patterns": [{ "include": "#table-cells" }] },
        "2": { "patterns": [{ "include": "#comment" }] }
      }
    },
    "table-cells": {
      "patterns": [
        { "include": "#quoted-cell" },
        {
          "match": "(?<=\\s|^)(OctetString|Integer32|Integer64|Unsigned32|Unsigned64|Float32|Float64|Grouped|Address|Time|UTF8String|DiameterIdentity|DiameterURI|Enumerated|IPFilterRule|QoSFilterRule)(?=\\s|$)",
          "name": "storage.type.data-type.dad"
        },
        {
          "match": "(?<=\\s|^)(MUST-NOT|MUST|Yes|No)(?=\\s|$)",
          "name": "constant.language.dad"
        },
        {
          "match": "(?<=\\s|^|,)(?:TS\\d{2}\\.\\d{3}|RFC\\d+|ETSI-(?:TS|ES)\\d{3}\\.\\d{3}(?:-\\d+)?|3GPP2-[A-Z]\\.[A-Z]\\d{4}(?:-\\d{3})?|OMA(?:-[A-Za-z0-9_]+)+|oneM2M-TS-\\d{4}|Private-[A-Za-z0-9][A-Za-z0-9_.-]*)(?=\\s|$|,)",
          "name": "entity.name.tag.spec-ref.dad"
        },
        {
          "match": "(?<=\\s|^)[MVP](?:,\\s?[MVP])*(?=\\s|$)",
          "name": "constant.language.avp-flag.dad"
        },
        {
          "match": "(?<=\\s|^)(?:\\d+[A-Za-z]*|[A-Za-z])(?:\\.\\d+[A-Za-z]*)+(?=\\s|$)",
          "name": "constant.other.section.dad"
        },
        {
          "match": "(?<=\\s|^)\\d+(?=\\s|$)",
          "name": "constant.numeric.dad"
        },
        {
          "match": "(?<=\\s|^)-(?=\\s|$)",
          "name": "punctuation.definition.empty-cell.dad"
        }
      ]
    }
  }
}
