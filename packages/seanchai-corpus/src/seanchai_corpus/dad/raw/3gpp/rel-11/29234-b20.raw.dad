; Section: 10.1.10
; Page: 74
Charging-Data ::= < AVP header: 304 >
        { Charging-Characteristics }
        { Charging-Nodes }
      * [ AVP ]


; Type: Enumerated AVP
; Name: WLAN-Access
; Section: 10.1.11
; Page: 74
WLAN-Access ::= < Enumerated AVP header: 305 10415 >
        WLAN_SUBSCRIPTION_ALLOWED = 0
        WLAN_SUBSCRIPTION_BARRED  = 1


; Type: Enumerated AVP
; Name: WLAN-3GPP-IP-Access
; Section: 10.1.12
; Page: 74
WLAN-3GPP-IP-Access ::= < Enumerated AVP header: 306 10415 >
        WLAN_APNS_ENABLE  = 0
        WLAN_APNS_DISABLE = 1


; Type: Grouped AVP
; Name: APN-Authorized
; Section: 10.1.14
; Page: 74
APN-Authorized ::= < AVP header: 307 >
        { 3GPP-WLAN-APN-Id }
        { APN-Barring-Type }
        [ Framed-IP-Address ]
      * [ Framed-IPv6-Prefix ]
        [ Max-Requested-Bandwidth ]
        [ QoS-Resources ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: APN-Barring-Type
; Section: 10.1.16
; Page: 75
APN-Barring-Type ::= < Enumerated AVP header: 309 10415 >
        WLAN_APN_NO_BARRING               = 0
        WLAN_APN_HOME_BARRED_WHEN_ROAMING = 1
        WLAN_APN_VISITED_BARRED           = 2
        WLAN_APN_HOME_BARRED              = 3
        WLAN_APN_INTERNET_ACCESS_BARRED   = 4


; Type: Enumerated AVP
; Name: WLAN-Direct-IP-Access
; Section: 10.1.17
; Page: 75
WLAN-Direct-IP-Access ::= < Enumerated AVP header: 310 10415 >
        WLAN_DIRECT_IP_ACCESS    = 0
        WLAN_NO_DIRECT_IP_ACCESS = 1


; Type: Enumerated AVP
; Name: Session-Request-Type
; Section: 10.1.23
; Page: 76
Session-Request-Type ::= < Enumerated AVP header: 311 10415 >
        "AUTHORIZATION REQUEST" = 0
        "ROUTING POLICY"        = 1


; Type: Grouped AVP
; Name: Charging-Nodes
; Section: 10.1.28
; Page: 77
Charging-Nodes ::= < AVP header: 315 >
        [ Primary-OCS-Charging-Function-Name ]
        [ Secondary-OCS-Charging-Function-Name ]
        [ Primary-Charging-Collection-Function-Name ]
        [ Secondary-Charging-Collection-Function-Name ]
      * [ AVP ]


; Type: Value Table
; AVP: Experimental-Result-Code
; Kind: result-codes
; Section: 10.3
; Page: 80
DIAMETER_ERROR_USER_NO_WLAN_SUBSCRIPTON           = 5041 ; 10.3.1.1
DIAMETER_ERROR_W-APN_UNUSED_BY_USER               = 5042 ; 10.3.1.2
DIAMETER_ERROR_NO_ACCESS_INDEPENDENT_SUBSCRIPTION = 5043 ; 10.3.1.3
DIAMETER_ERROR_USER_NO_W-APN_SUBSCRIPTION         = 5044 ; 10.3.1.4


