Charging-Rule-Report ::= < AVP header: 1018 >
      * [ Charging-Rule-Name ]
      * [ Charging-Rule-Base-Name ]
        [ Bearer-Identifier ]
        [ PCC-Rule-Status ]
        [ Rule-Failure-Code ]
        [ Final-Unit-Indication ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: PCC-Rule-Status
; Section: 5.3.19
; Page: 103
PCC-Rule-Status ::= < Enumerated AVP header: 1019 10415 >
        ACTIVE                 = 0
        INACTIVE               = 1
        "TEMPORARILY INACTIVE" = 2


; Type: Enumerated AVP
; Name: Bearer-Operation
; Section: 5.3.21
; Page: 104
Bearer-Operation ::= < Enumerated AVP header: 1021 10415 >
        TERMINATION   = 0
        ESTABLISHMENT = 1
        MODIFICATION  = 2


; Type: Grouped AVP
; Name: Access-Network-Charging-Identifier-Gx
; Section: 5.3.22
; Page: 104
Access-Network-Charging-Identifier-Gx ::= < AVP header: 1022 >
        { Access-Network-Charging-Identifier-Value }
      * [ Charging-Rule-Base-Name ]
      * [ Charging-Rule-Name ]


; Type: Enumerated AVP
; Name: Bearer-Control-Mode
; Section: 5.3.23
; Page: 105
Bearer-Control-Mode ::= < Enumerated AVP header: 1023 10415 >
        UE_ONLY  = 0
        RESERVED = 1
        UE_NW    = 2


; Type: Enumerated AVP
; Name: Network-Request-Support
; Section: 5.3.24
; Page: 105
Network-Request-Support ::= < Enumerated AVP header: 1024 10415 >
        "NETWORK_REQUEST NOT SUPPORTED" = 0
        "NETWORK_REQUEST SUPPORTED"     = 1


; Type: Enumerated AVP
; Name: IP-CAN-Type
; Section: 5.3.27
; Page: 105
IP-CAN-Type ::= < Enumerated AVP header: 1027 10415 >
        3GPP-GPRS    = 0
        DOCSIS       = 1
        xDSL         = 2
        WiMAX        = 3
        3GPP2        = 4
        3GPP-EPS     = 5
        Non-3GPP-EPS = 6


; Type: Enumerated AVP
; Name: QoS-Negotiation
; Section: 5.3.28
; Page: 106
QoS-Negotiation ::= < Enumerated AVP header: 1029 10415 >
        NO_QoS_NEGOTIATION        = 0
        QoS_NEGOTIATION_SUPPORTED = 1


; Type: Enumerated AVP
; Name: QoS-Upgrade
; Section: 5.3.29
; Page: 106
QoS-Upgrade ::= < Enumerated AVP header: 1030 10415 >
        QoS_UPGRADE_NOT_SUPPORTED = 0
        QoS_UPGRADE_SUPPORTED     = 1


; Type: Grouped AVP
; Name: Event-Report-Indication
; Section: 5.3.30
; Page: 107
Event-Report-Indication ::= < AVP header: 1033 >
      * [ Event-Trigger ]
        [ User-CSG-Information ]
        [ IP-CAN-Type ]             ; bold
     *2 [ AN-GW-Address ]           ; bold
        [ 3GPP-SGSN-Address ]       ; bold
        [ 3GPP-SGSN-Ipv6-Address ]  ; bold
        [ 3GPP-SGSN-MCC-MNC ]       ; bold
        [ Framed-IP-Address ]       ; bold
        [ RAT-Type ]
        [ RAI ]
        [ 3GPP-User-Location-Info ]
        [ Trace-Data ]
        [ Trace-Reference ]
        [ 3GPP2-BSID ]
        [ 3GPP-MS-TimeZone ]
        [ Routing-IP-Address ]
        [ UE-Local-IP-Address ]
        [ HeNB-Local-IP-Address ]
        [ UDP-Source-Port ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: RAT-Type
; Section: 5.3.31
; Page: 108
RAT-Type ::= < Enumerated AVP header: 1032 10415 >
        WLAN           = 0
        VIRTUAL        = 1
        UTRAN          = 1000
        GERAN          = 1001
        GAN            = 1002
        HSPA_EVOLUTION = 1003
        EUTRAN         = 1004
        CDMA2000_1X    = 2000
        HRPD           = 2001
        UMB            = 2002
        EHRPD          = 2003


; Type: Grouped AVP
; Name: Allocation-Retention-Priority
; Section: 5.3.32
; Page: 109
Allocation-Retention-Priority ::= < AVP header: 1034 >
        { Priority-Level }
        [ Pre-emption-Capability ]
        [ Pre-emption-Vulnerability ]


; Type: Grouped AVP
; Name: Tunnel-Information
; Section: 5.3.36
; Page: 110
Tunnel-Information ::= < AVP header: 1038 >
        [ Tunnel-Header-Length ]
    2*2 [ Tunnel-Header-Filter ]
      * [ AVP ]


; Type: Grouped AVP
; Name: CoA-Information
; Section: 5.3.37
; Page: 110
CoA-Information ::= < AVP header: 1039 >
        { Tunnel-Information }
        { CoA-IP-Address }
      * [ AVP ]


; Type: Enumerated AVP
; Name: Rule-Failure-Code
; Section: 5.3.38
; Page: 110
Rule-Failure-Code ::= < Enumerated AVP header: 1031 10415 >
        UNKNOWN_RULE_NAME                = 1
        RATING_GROUP_ERROR               = 2
        SERVICE_IDENTIFIER_ERROR         = 3
        RESOURCES_LIMITATION             = 5
        MAX_NR_BEARERS_REACHED           = 6
        UNKNOWN_BEARER_ID                = 7
        MISSING_BEARER_ID                = 8
        MISSING_FLOW_INFORMATION         = 9
        RESOURCE_ALLOCATION_FAILURE      = 10
        UNSUCCESSFUL_QOS_VALIDATION      = 11
        INCORRECT_FLOW_INFORMATION       = 12
        PS_TO_CS_HANDOVER                = 13
        TDF_APPLICATION_IDENTIFIER_ERROR = 14
        NO_BEARER_BOUND                  = 15
        FILTER_RESTRICTIONS              = 16
        AN_GW_FAILED                     = 17
        MISSING_REDIRECT_SERVER_ADDRESS  = 18


; Type: Enumerated AVP
; Name: Session-Release-Cause
; Section: 5.3.44
; Page: 112
Session-Release-Cause ::= < Enumerated AVP header: 1045 10415 >
        UNSPECIFIED_REASON            = 0
        UE_SUBSCRIPTION_REASON        = 1
        INSUFFICIENT_SERVER_RESOURCES = 2
        IP_CAN_SESSION_TERMINATION    = 3
        UE_IP_ADDRESS_RELEASE         = 4


; Type: Enumerated AVP
; Name: Pre-emption-Capability
; Section: 5.3.46
; Page: 113
Pre-emption-Capability ::= < Enumerated AVP header: 1047 10415 >
        PRE-EMPTION_CAPABILITY_ENABLED  = 0
        PRE-EMPTION_CAPABILITY_DISABLED = 1


; Type: Enumerated AVP
; Name: Pre-emption-Vulnerability
; Section: 5.3.47
; Page: 114
Pre-emption-Vulnerability ::= < Enumerated AVP header: 1048 10415 >
        PRE-EMPTION_VULNERABILITY_ENABLED  = 0
        PRE-EMPTION_VULNERABILITY_DISABLED = 1


; Type: Grouped AVP
; Name: Default-EPS-Bearer-QoS
; Section: 5.3.48
; Page: 114
Default-EPS-Bearer-QoS ::= < AVP header: 1049 >
        [ QoS-Class-Identifier ]
        [ Allocation-Retention-Priority ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Resource-Allocation-Notification
; Section: 5.3.50
; Page: 114
Resource-Allocation-Notification ::= < Enumerated AVP header: 1063 10415 >
        ENABLE_NOTIFICATION = 0


; Type: Grouped AVP
; Name: Flow-Information
; Section: 5.3.53
; Page: 115
Flow-Information ::= < AVP header: 1058 >
        [ Flow-Description ]
        [ Packet-Filter-Identifier ]
        [ Packet-Filter-Usage ]
        [ ToS-Traffic-Class ]
        [ Security-Parameter-Index ]
        [ Flow-Label ]
        [ Flow-Direction ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Packet-Filter-Information
; Section: 5.3.56
; Page: 116
Packet-Filter-Information ::= < AVP header: 1061 >
        [ Packet-Filter-Identifier ]
        [ Precedence ]
        [ Packet-Filter-Content ]
        [ ToS-Traffic-Class ]
        [ Security-Parameter-Index ]
        [ Flow-Label ]
        [ Flow-Direction ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Packet-Filter-Operation
; Section: 5.3.57
; Page: 116
Packet-Filter-Operation ::= < Enumerated AVP header: 1062 10415 >
        DELETION     = 0
        ADDITION     = 1
        MODIFICATION = 2


; Type: Grouped AVP
; Name: Usage-Monitoring-Information
; Section: 5.3.60
; Page: 117
Usage-Monitoring-Information ::= < AVP header: 1067 >
        [ Monitoring-Key ]
     *2 [ Granted-Service-Unit ]
     *2 [ Used-Service-Unit ]
        [ Usage-Monitoring-Level ]
        [ Usage-Monitoring-Report ]
        [ Usage-Monitoring-Support ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Usage-Monitoring-Level
; Section: 5.3.61
; Page: 117
Usage-Monitoring-Level ::= < Enumerated AVP header: 1068 10415 >
        SESSION_LEVEL  = 0
        PCC_RULE_LEVEL = 1
        ADC_RULE_LEVEL = 2


; Type: Enumerated AVP
; Name: Usage-Monitoring-Report
; Section: 5.3.62
; Page: 118
Usage-Monitoring-Report ::= < Enumerated AVP header: 1069 10415 >
        USAGE_MONITORING_REPORT_REQUIRED = 0


; Type: Enumerated AVP
; Name: Usage-Monitoring-Support
; Section: 5.3.63
; Page: 118
Usage-Monitoring-Support ::= < Enumerated AVP header: 1070 10415 >
        USAGE_MONITORING_DISABLED = 0


; Type: Enumerated AVP
; Name: CSG-Information-Reporting
; Section: 5.3.64
; Page: 118
CSG-Information-Reporting ::= < Enumerated AVP header: 1071 10415 >
        CHANGE_CSG_CELL                     = 0
        CHANGE_CSG_SUBSCRIBED_HYBRID_CELL   = 1
        CHANGE_CSG_UNSUBSCRIBED_HYBRID_CELL = 2


; Type: Enumerated AVP
; Name: Flow-Direction
; Section: 5.3.65
; Page: 119
Flow-Direction ::= < Enumerated AVP header: 1080 10415 >
        UNSPECIFIED   = 0
        DOWNLINK      = 1
        UPLINK        = 2
        BIDIRECTIONAL = 3


; Type: Enumerated AVP
; Name: Packet-Filter-Usage
; Section: 5.3.66
; Page: 119
Packet-Filter-Usage ::= < Enumerated AVP header: 1072 10415 >
        SEND_TO_UE = 1


; Type: Enumerated AVP
; Name: Charging-Correlation-Indicator
; Section: 5.3.67
; Page: 119
Charging-Correlation-Indicator ::= < Enumerated AVP header: 1073 10415 >
        CHARGING_IDENTIFIER_REQUIRED = 0


; Type: Grouped AVP
; Name: Routing-Rule-Install
; Section: 5.3.68
; Page: 119
Routing-Rule-Install ::= < AVP header: 1081 >
      * [ Routing-Rule-Definition ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Routing-Rule-Remove
; Section: 5.3.69
; Page: 120
Routing-Rule-Remove ::= < AVP header: 1075 >
      * [ Routing-Rule-Identifier ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Routing-Rule-Definition
; Section: 5.3.70
; Page: 120
Routing-Rule-Definition ::= < AVP header: 1076 >
        { Routing-Rule-Identifier }
      * [ Routing-Filter ]
        [ Precedence ]
        [ Routing-IP-Address ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Routing-Filter
; Section: 5.3.72
; Page: 120
Routing-Filter ::= < AVP header: 1078 >
        { Flow-Description }
        { Flow-Direction }
        [ ToS-Traffic-Class ]
        [ Security-Parameter-Index ]
        [ Flow-Label ]
      * [ AVP ]


; Type: Grouped AVP
; Name: TDF-Information
; Section: 5.3.78
; Page: 121
TDF-Information ::= < AVP header: 1087 >
        [ TDF-Destination-Realm ]
        [ TDF-Destination-Host ]
        [ TDF-IP-Address ]


; Type: Grouped AVP
; Name: Redirect-Information
; Section: 5.3.82
; Page: 122
Redirect-Information ::= < AVP header: 1085 >
        [ Redirect-Support ]
        [ Redirect-Address-Type ]
        [ Redirect-Server-Address ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Redirect-Support
; Section: 5.3.83
; Page: 122
Redirect-Support ::= < Enumerated AVP header: 1086 10415 >
        REDIRECTION_DISABLED = 0
        REDIRECTION_ENABLED  = 1


; Type: Enumerated AVP
; Name: PS-to-CS-Session-Continuity
; Section: 5.3.84
; Page: 122
PS-to-CS-Session-Continuity ::= < Enumerated AVP header: 1099 10415 >
        VIDEO_PS2CS_CONT_CANDIDATE = 0


; Type: Grouped AVP
; Name: Application-Detection-Information
; Section: 5.3.91
; Page: 123
Application-Detection-Information ::= < AVP header: 1098 >
        { TDF-Application-Identifier }
        [ TDF-Application-Instance-Identifier ]
      * [ Flow-Information ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Mute-Notification
; Section: 5.3.98
; Page: 124
Mute-Notification ::= < Enumerated AVP header: 2809 10415 >
        MUTE_REQUIRED = 0


; Type: Enumerated AVP
; Name: AN-GW-Status
; Section: 5.3.100
; Page: 124
AN-GW-Status ::= < Enumerated AVP header: 2811 10415 >
        AN_GW_FAILED = 0


