; Type: Grouped AVP
; Name: QoS-Rule-Install
; Section: 5a.3.1
; Page: 138
QoS-Rule-Install ::= < AVP header: 1051 >
      * [ QoS-Rule-Definition ]
      * [ QoS-Rule-Name ]
      * [ QoS-Rule-Base-Name ]
        [ Tunnel-Information ]
        [ Access-Network-Charging-Identifier-Value ]
        [ Resource-Allocation-Notification ]
        [ Rule-Activation-Time ]
        [ Rule-Deactivation-Time ]
        [ 3GPP-GGSN-Address ]
        [ 3GPP-GGSN-Ipv6-Address ]
     *2 [ AN-GW-Address ]
        [ UDP-Source-Port ]
      * [ AVP ]


; Type: Grouped AVP
; Name: QoS-Rule-Remove
; Section: 5a.3.2
; Page: 139
QoS-Rule-Remove ::= < AVP header: 1052 >
      * [ QoS-Rule-Name ]
      * [ QoS-Rule-Base-Name ]
      * [ Required-Access-Info ]
      * [ AVP ]


; Type: Grouped AVP
; Name: QoS-Rule-Definition
; Section: 5a.3.3
; Page: 139
QoS-Rule-Definition ::= < AVP header: 1053 >
        { QoS-Rule-Name }
      * [ Flow-Information ]
        [ QoS-Information ]
        [ Precedence ]
      * [ Required-Access-Info ]
      * [ AVP ]


; Type: Grouped AVP
; Name: QoS-Rule-Report
; Section: 5a.3.5
; Page: 140
QoS-Rule-Report ::= < AVP header: 1055 >
      * [ QoS-Rule-Name ]
      * [ QoS-Rule-Base-Name ]
        [ PCC-Rule-Status ]
        [ Rule-Failure-Code ]
      * [ AVP ]


