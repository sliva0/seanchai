; Section: 8.3.10
; Page: 33
Event-List ::= < AVP header: 732 10415 >
        { Ims-Event }
        [ Request-Current-Status ]
      * [ Ims-Event-Filter ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Ims-Event
; Section: 8.3.11
; Page: 33
Ims-Event ::= < Enumerated AVP header: 733 10415 >
        ADC_ESTABLISHMENT     = 0
        ADC_RELEASE           = 1
        BDC_ESTABLISHMENT     = 2
        BDC_RELEASE           = 3
        ADC_IWK_ESTABLISHMENT = 4


; Type: Grouped AVP
; Name: Ims-Event-Filter
; Section: 8.3.12
; Page: 33
Ims-Event-Filter ::= < AVP header: 734 10415 >
        [ Calling-Identity ]
        [ Called-Identity ]
        [ App-Bind-Information ]
        [ Session-Identity ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Ims-Event-Report
; Section: 8.3.13
; Page: 34
Ims-Event-Report ::= < AVP header: 735 10415 >
        { Ims-Event }
        [ Ims-Event-Report-Information ]
        [ Session-Identity ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Ims-Event-Report-Information
; Section: 8.3.14
; Page: 34
Ims-Event-Report-Information ::= < AVP header: 736 10415 >
        [ Adc-Report ]
        [ Bdc-Report ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Adc-Report
; Section: 8.3.15
; Page: 34
Adc-Report ::= < Enumerated AVP header: 737 10415 >
        ADC_ESTABLISHMENT     = 0
        ADC_RELEASE           = 1
        ADC_IWK_ESTABLISHMENT = 2


; Type: Enumerated AVP
; Name: Bdc-Report
; Section: 8.3.16
; Page: 34
Bdc-Report ::= < Enumerated AVP header: 738 10415 >
        BDC_ESTABLISHMENT = 0
        BDC_RELEASE       = 1


; Type: Grouped AVP
; Name: App-Bind-Information
; Section: 8.3.19
; Page: 35
App-Bind-Information ::= < AVP header: 741 10415 >
        { Application-Identity }
      * [ App-Dc-Information ]
      * [ AVP ]


; Type: Grouped AVP
; Name: App-Dc-Information
; Section: 8.3.20
; Page: 35
App-Dc-Information ::= < AVP header: 742 10415 >
        { Stream-Identity }
        [ Adc-Endpoint-Type ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Adc-Endpoint-Type
; Section: 8.3.23
; Page: 35
Adc-Endpoint-Type ::= < Enumerated AVP header: 745 10415 >
        UE     = 0
        SERVER = 1
