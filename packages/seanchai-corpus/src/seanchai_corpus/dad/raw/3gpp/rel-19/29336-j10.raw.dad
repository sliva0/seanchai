; Kind: bits
; Section: 8.4.41
; Table: 8.4.41-1
; Page: 67
"UE and UICC and/or new IMSI-IMEI-SV association" = 0
UE-reachability                                   = 1
Location-of-the-UE                                = 2
Loss-of-connectivity                              = 3
Communication-failure                             = 4
Roaming-status                                    = 5
"Availability after DDN failure"                  = 6
"Idle Status Indication"                          = 7
"PDN Connectivity Status"                         = 8
SAT-SF-Operation                                  = 9


