        [ Service-Area-Identity ]
        [ Routing-Area-Identity ]
        [ Current-Location-Retrieved ]
        [ Age-Of-Location-Information ]
        [ User-CSG-Information ]
      * [ AVP ]


; Type: Grouped AVP
; Name: User-Identifier
; Section: 8.4.36
; Page: 65
User-Identifier ::= < AVP header: 3102 10415 >
        [ User-Name ]
        [ MSISDN ]
        [ External-Identifier ]
        [ Type-Of-External-Identifier ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Service-Result
; Section: 8.4.37
; Page: 66
Service-Result ::= < AVP header: 3146 10415 >
        [ Vendor-Id ]
        [ Service-Result-Code ]
      * [ AVP ]


; Type: Value Table
; AVP: CIR-Flags
; Kind: bits
; Section: 8.4.39
; Table: 8.4.39-1
; Page: 66
"Delete all Monitoring events"                = 0
"Enhanced Coverage Query"                     = 1
"IMSI Group Id retrieval"                     = 2
"Delete all Communication Pattern"            = 3
"Delete all Network Parameter Configurations" = 4


