        [ Current-Location-Retrieved ]
        [ Age-Of-Location-Information ]
        [ User-CSG-Information ]
        [ eNodeB-ID ]
        [ Extended-eNodeB-ID ]
      * [ AVP ]


; Type: Grouped AVP
; Name: SGSN-Location-Information
