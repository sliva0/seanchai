        [ Periodic-Time ]
      * [ AVP ]


; Type: Grouped AVP
; Name: EPS-Location-Information
; Section: 8.4.21
; Page: 59
EPS-Location-Information ::= < AVP header: 1496 10415 >
        [ MME-Location-Information ]
        [ SGSN-Location-Information ]
      * [ AVP ]


; Type: Value Table
; AVP: IMEI-Change
; Kind: bits
; Section: 8.4.22
; Table: 8.4.22-1
; Page: 59
IMEI   = 0
IMEISV = 1


; Type: Value Table
; AVP: Feature-List
; Kind: features
; Application: S6t
; Section: 8.4.23.1
; Table: 8.4.23-1
; Page: 59
MONTE                                 = 0  ; O
AESE-Communication-Pattern            = 1  ; O
NIDD-Authorization                    = 2  ; O
Enhanced-Coverage-Restriction-Control = 3  ; O
"NIDD Authorization Update"           = 4  ; O
Report-Eff-MONTE                      = 5  ; O
"Event Cancellation Report"           = 6  ; O
Config-Eff-CP                         = 7  ; O
Config-Eff-NP                         = 8  ; O
"Extended Reference IDs"              = 9  ; O
Dynamic-Group-Event-Monitoring        = 10


; Type: Grouped AVP
; Name: Monitoring-Event-Config-Status
; Section: 8.4.24
; Page: 62
Monitoring-Event-Config-Status ::= < AVP header: 3142 10415 >
      * [ Service-Report ]
        { SCEF-Reference-ID }
        [ SCEF-Reference-ID-Ext ]
        [ SCEF-ID ]
      * [ AVP ]


; Type: Grouped AVP
; Name: AESE-Communication-Pattern
; Section: 8.4.25
; Page: 62
AESE-Communication-Pattern ::= < AVP header: 3113 10415 >
        [ SCEF-Reference-ID ]
        [ SCEF-Reference-ID-Ext ]
        { SCEF-ID }
      * [ SCEF-Reference-ID-for-Deletion ]
      * [ SCEF-Reference-ID-for-Deletion-Ext ]
      * [ Communication-Pattern-Set ]
        [ MTC-Provider-Info ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Communication-Pattern-Set
; Section: 8.4.26
; Page: 63
Communication-Pattern-Set ::= < AVP header: 3114 10415 >
        [ Periodic-Communication-Indicator ]
        [ Communication-Duration-Time ]
        [ Periodic-Time ]
      * [ Scheduled-Communication-Time ]
        [ Stationary-Indication ]
        [ Reference-ID-Validity-Time ]
        [ Traffic-Profile ]
        [ Battery-Indicator ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Scheduled-communication-time
; Section: 8.4.30
; Page: 64
Scheduled-communication-time ::= < AVP header: 3118 10415 >
        [ Day-Of-Week-Mask ]
        [ Time-Of-Day-Start ]
        [ Time-Of-Day-End ]
      * [ AVP ]


; Type: Grouped AVP
; Name: AESE-Communication-Pattern-Config-Status
; Section: 8.4.32
; Page: 64
AESE-Communication-Pattern-Config-Status ::= < AVP header: 3120 10415 >
