; Type: Grouped AVP
; Name: Service-Report
; Section: 8.4.47
; Page: 69
Service-Report ::= < AVP header: 3152 10415 >
        [ Service-Result ]
        [ Node-Type ]
      * [ AVP ]


; Type: Value Table
; AVP: S6t-HSS-Cause
; Kind: bits
; Section: 8.4.50
; Table: 8.4.50-1
; Page: 70
"Absent Subscriber"                       = 0
"Group Event Monitoring Partially Cancel" = 1


; Type: Grouped AVP
