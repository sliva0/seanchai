; Page: 73
Group-Configuration-In-Progress               = 0
All-Monitoring-Events-Cancelled               = 1
Change-Of-Authorized-Monitoring-Events        = 2
All-Communication-Pattern-Cancelled           = 3
All-Suggested-Network-Configuration-Cancelled = 4


; Type: Grouped AVP
