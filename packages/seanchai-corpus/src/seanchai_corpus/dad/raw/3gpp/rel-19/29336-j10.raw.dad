; Type: Value Table
; AVP: Battery-Indicator
; Kind: bits
; Section: 8.4.81
; Table: 8.4.81-1
; Page: 79
NO_BATTERY                      = 0
BATTERY_REPLACEABLE_INDICATION  = 1
BATTERY_RECHARGEABLE_INDICATION = 2


; Type: Grouped AVP
