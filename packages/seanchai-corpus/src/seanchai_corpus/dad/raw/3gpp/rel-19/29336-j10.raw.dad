        [ Monitoring-Type ]
      * [ Service-Report ]
        [ S6t-HSS-Cause ]
        [ Idle-Status-Indication ]
        [ Reporting-Time-Stamp ]
        [ Updated-Network-Configuration ]
      * [ SCEF-Reference-ID-for-Deletion ]
      * [ SCEF-Reference-ID-for-Deletion-Ext ]
        [ Event-Handling ]
        [ Loss-Of-Connectivity-Reason ]
      * [ PDN-Connectivity-Status-Report ]
      * [ AVP ]


