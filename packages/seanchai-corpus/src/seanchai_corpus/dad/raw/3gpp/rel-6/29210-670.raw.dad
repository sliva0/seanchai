; Type: Enumerated AVP
; Name: Bearer-Usage
; Section: 5.2.1
; Page: 12
Bearer-Usage ::= < Enumerated AVP header: 1000 10415 >
        GENERAL        = 0
        IMS_SIGNALLING = 1


; Type: Grouped AVP
; Name: Charging-Rule-Install
; Section: 5.2.2
; Page: 12
Charging-Rule-Install ::= < AVP header: 1001 >
      * [ Charging-Rule-Definition ]
      * [ Charging-Rule-Name ]
      * [ Charging-Rule-Base-Name ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Charging-Rule-Remove
; Section: 5.2.3
; Page: 12
Charging-Rule-Remove ::= < AVP header: 1002 >
      * [ Charging-Rule-Name ]
      * [ Charging-Rule-Base-Name ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Charging-Rule-Definition
; Section: 5.2.4
; Page: 13
Charging-Rule-Definition ::= < AVP header: 1003 >
        { Charging-Rule-Name }
        [ Service-Identifier ]
        [ Rating-Group ]
      * [ Flow-Description ]
        [ Reporting-Level ]
        [ Online ]
        [ Offline ]
        [ Metering-Method ]
        [ Precedence ]
        [ AF-Charging-Identifier ]
      * [ Flows ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Event-Trigger
; Section: 5.2.7
; Page: 13
Event-Trigger ::= < Enumerated AVP header: 1006 10415 >
        SGSN_CHANGE = 0
        QOS_CHANGE  = 1
        RAT_CHANGE  = 2
        TFT_CHANGE  = 3
        PLMN_CHANGE = 4


; Type: Enumerated AVP
; Name: Metering-Method
; Section: 5.2.8
; Page: 14
Metering-Method ::= < Enumerated AVP header: 1007 10415 >
        DURATION        = 0
        VOLUME          = 1
        DURATION_VOLUME = 2


; Type: Enumerated AVP
; Name: Offline
; Section: 5.2.9
; Page: 14
Offline ::= < Enumerated AVP header: 1008 10415 >
        DISABLE_OFFLINE = 0
        ENABLE_OFFLINE  = 1


; Type: Enumerated AVP
; Name: Online
; Section: 5.2.10
; Page: 14
Online ::= < Enumerated AVP header: 1009 10415 >
        DISABLE_ONLINE = 0
        ENABLE_ONLINE  = 1


; Type: Enumerated AVP
; Name: Reporting-Level
; Section: 5.2.15
; Page: 15
Reporting-Level ::= < Enumerated AVP header: 1011 10415 >
        CHARGING_RULE_LEVEL = 0
        RATING_GROUP_LEVEL  = 1


; Type: Grouped AVP
; Name: TFT-Packet-Filter-Information
; Section: 5.2.19
; Page: 15
TFT-Packet-Filter-Information ::= < AVP header: 1013 >
        [ Precedence ]
        [ TFT-Filter ]
        [ ToS-Traffic-Class ]


; Type: Enumerated AVP
; Name: PDP-Session-Operation
; Section: 5.2.21
; Page: 16
PDP-Session-Operation ::= < Enumerated AVP header: 1015 10415 >
        PDP-SESSION-TERMINATION = 0


; Type: Value Table
; AVP: Experimental-Result-Code
; Kind: result-codes
; Section: 5.4
; Page: 18
DIAMETER_ERROR_INITIAL_PARAMETERS = 5140 ; 5.4.2
DIAMETER_ERROR_TRIGGER_EVENT      = 5141 ; 5.4.2
