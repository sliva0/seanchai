      * [ AVP ]


; Type: Message
; Name: PX-Answer, PXA
; Section: 6.6.3
; Page: 25
<PX-Answer> ::= < Diameter Header: 8388676, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Result-Code ]
        [ Experimental-Result ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
        [ Failed-AVP ]
        [ Origin-State-Id ]
