; Type: Grouped AVP
; Name: Monitor-Target
; Section: 6.4.9
; Page: 22
Monitor-Target ::= < AVP header: 3607 >
        { Target-RPAUID }
        { PDUID }
        [ Metadata-Indicator ]
      * [ ProSe-Code-Suffix-Mask ]
      * [ AVP ]


; Type: Grouped AVP
; Name: ProSe-Code-Suffix-Mask
; Section: 6.4.10
; Page: 22
ProSe-Code-Suffix-Mask ::= < AVP header: 3608 >
        { Suffix-Code }
     1* { Suffix-Mask }
      * [ AVP ]


; Type: Grouped AVP
; Name: Banned-User-Target
; Section: 6.4.17
; Page: 22
Banned-User-Target ::= < AVP header: 3611 >
        { Target-RPAUID }
        { Target-PDUID }
      * [ AVP ]


