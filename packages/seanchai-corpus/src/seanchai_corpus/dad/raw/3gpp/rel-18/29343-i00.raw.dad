        [ Target-App-Layer-User-Id ]
        [ Requesting-EPUID ]
        [ ProSe-Function-ID ]
        [ Requesting-RPAUID ]
        [ ProSe-App-Id ]
        [ Application-Data ]
        [ Allowed-Suffix-Number ]
        [ Target-RPAUID ]
