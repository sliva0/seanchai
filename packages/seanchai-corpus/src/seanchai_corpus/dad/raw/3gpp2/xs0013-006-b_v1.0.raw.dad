;; The cover prints "3GPP2 X.S0013-006-B Version 1.0", dated December 2007: part
;; 006 of the series X.S0013, revision B, which the rendering's name keeps. The
;; foreword: "This document contains portions of material copied from 3GPP
;; document number TS 29.229 6.a.0." Clause 6.1 prints the id in every command,
;; and clause 6.4.4 repeats it. Clause 7.3.1 prints an <answer-message> "based
;; on [6], section 7.2", for any command code, which is no command of this
;; application; it adds [ Supported-Applications ] after [ Proxy-Info ].
; Type: Application Scope
; Name: Cx
; Section: 6
; Page: 7
; Application-ID: 16777216
; Applies-To: 6.*


; Type: Message
; Name: User-Authorization-Request, UAR
; Section: 6.1.1
; Page: 8
<User-Authorization-Request> ::= < Diameter Header: 300, REQ, PXY, 16777216 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Destination-Host ]
        { Destination-Realm }
        { User-Name }
      * [ Supported-Features ]             ; bold
        { Public-Identity }                ; bold
        { Visited-Network-Identifier }     ; bold
        [ User-Authorization-Type ]        ; bold
      * [ AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


; Type: Message
; Name: User-Authorization-Answer, UAA
; Section: 6.1.2
; Page: 8
<User-Authorization-Answer> ::= < Diameter Header: 300, PXY, 16777216 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        [ Result-Code ] ;; Required if Experimental-Result not present - Otherwise not present.
        [ Experimental-Result ] ;; Required if Result-Code not present - Otherwise not present.
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
      * [ Supported-Features ]             ; bold
        [ Server-Name ]                    ; bold
        [ Server-Capabilities ]            ; bold
      * [ AVP ]
      * [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


