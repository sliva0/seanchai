      * [ Route-Record ]


; Type: Message
; Name: Server-Assignment-Answer, SAA
; Section: 6.1.4
; Page: 9
<Server-Assignment-Answer> ::= < Diameter Header: 301, PXY, 16777216 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        [ Result-Code ] ;; Required if Experimental-Result not present - Otherwise not present.
        [ Experimental-Result ] ;; Required if Result-Code not present - Otherwise not present
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ User-Name ]
      * [ Supported-Features ]             ; bold
        [ User-Data ]                      ; bold
        [ Charging-Information ]           ; bold
        [ Associated-Identities ]          ; bold
      * [ AVP ]
      * [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


