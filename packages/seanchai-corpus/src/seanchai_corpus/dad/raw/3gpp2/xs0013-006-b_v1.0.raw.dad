;; NOTE 1: The AVP header bit denoted as 'M', indicates whether support of the AVP is required. The AVP header bit denoted as 'V', indicates whether the optional Vendor-ID field is present in the AVP header. For further details, see [6].
;; NOTE 2: Depending on the concrete command.


; Type: Grouped AVP
; Name: Server-Capabilities
; Section: 6.3.4
; Page: 16
Server-Capabilities ::= < AVP header: 603 10415 >
      * [ Mandatory-Capability ]
      * [ Optional-Capability ]
      * [ Server-Name ]
      * [ AVP ]


; Type: Grouped AVP
; Name: SIP-Auth-Data-Item
; Section: 6.3.13
; Page: 18
SIP-Auth-Data-Item ::= < AVP header: 612 10415 >
        [ SIP-Item-Number ]
        [ SIP-Authentication-Scheme ]
        [ SIP-Authenticate ]
        [ SIP-Authorization ]
        [ SIP-Authentication-Context ]
        [ Confidentiality-Key ]
        [ Integrity-Key ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Server-Assignment-Type
; Section: 6.3.15
; Page: 18
Server-Assignment-Type ::= < Enumerated AVP header: 614 10415 >
        NO_ASSIGNMENT                            = 0
        REGISTRATION                             = 1
        RE_REGISTRATION                          = 2
        UNREGISTERED_USER                        = 3
        TIMEOUT_DEREGISTRATION                   = 4
        USER_DEREGISTRATION                      = 5
        TIMEOUT_DEREGISTRATION_STORE_SERVER_NAME = 6
        USER_DEREGISTRATION_STORE_SERVER_NAME    = 7
        ADMINISTRATIVE_DEREGISTRATION            = 8
        AUTHENTICATION_FAILURE                   = 9
        AUTHENTICATION_TIMEOUT                   = 10
        DEREGISTRATION_TOO_MUCH_DATA             = 11


; Type: Grouped AVP
; Name: Deregistration-Reason
; Section: 6.3.16
; Page: 19
Deregistration-Reason ::= < AVP header: 615 10415 >
        { Reason-Code }
        [ Reason-Info ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Reason-Code
; Section: 6.3.17
; Page: 19
Reason-Code ::= < Enumerated AVP header: 616 10415 >
        PERMANENT_TERMINATION = 0
        NEW_SERVER_ASSIGNED   = 1
        SERVER_CHANGE         = 2
        REMOVE_S-CSCF         = 3


; Type: Grouped AVP
; Name: Charging-Information
; Section: 6.3.19
; Page: 19
Charging-Information ::= < AVP header: 618 10415 >
        [ Primary-Event-Charging-Function-Name ]
        [ Secondary-Event-Charging-Function-Name ]
        [ Primary-Charging-Collection-Function-Name ]
        [ Secondary-Charging-Collection-Function-Name ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: User-Authorization-Type
; Section: 6.3.24
; Page: 20
User-Authorization-Type ::= < Enumerated AVP header: 623 10415 >
        REGISTRATION                  = 0
        DE_REGISTRATION               = 1
        REGISTRATION_AND_CAPABILITIES = 2


; Type: Enumerated AVP
; Name: User-Data-Already-Available
; Section: 6.3.26
; Page: 20
User-Data-Already-Available ::= < Enumerated AVP header: 624 10415 >
        USER_DATA_NOT_AVAILABLE     = 0
        USER_DATA_ALREADY_AVAILABLE = 1


; Type: Grouped AVP
; Name: Supported-Features
; Section: 6.3.29
; Page: 21
Supported-Features ::= < AVP header: 628 10415 >
        { Vendor-Id }
        { Feature-List-ID }
        { Feature-List }
      * [ AVP ]


; Type: Grouped AVP
; Name: Supported-Applications
; Section: 6.3.32
; Page: 21
Supported-Applications ::= < AVP header: 631 10415 >
      * [ Auth-Application-Id ]
      * [ Acct-Application-Id ]
      * [ Vendor-Specific-Application-Id ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Associated-Identities
; Section: 6.3.33
; Page: 22
Associated-Identities ::= < AVP header: 632 10415 >
      * [ User-Name ]
      * [ AVP ]
