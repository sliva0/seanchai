; Specification: OMA-DDS-Charging_Data
; Version: 1.0
; Vendor-ID: 10415
; Bases: RFC6733
; Link: https://www.openmobilealliance.org/release/Charging_Data/V1_0-20110201-A/OMA-DDS-Charging_Data-V1_0-20110201-A.pdf
; Transcribed: by hand from https://www.openmobilealliance.org/release/Charging_Data/V1_0-20110201-A/OMA-DDS-Charging_Data-V1_0-20110201-A.pdf


;; The cover prints "Charging Data, Approved Version 1.0 - 01 Feb 2011" and
;; "OMA-DDS-Charging_Data-V1_0-20110201-A". The page is the number its header
;; prints, "Page 36 (46)". Clause 6 lists OMA Charging Data Elements, which
;; clause 8.3's table 10 maps to AVPs: a value list of clause 6.2 is held below
;; under the AVP table 10 maps its element to, where table 11 types that AVP
;; Enumerated.
;; Clause 6.2.44, table 7 "Role of User Values" (service context SIMPLE_IM):
;; NORMAL_PARTICIPANT 4, SESSION_OWNER 3. Table 10 maps Role of User to
;; PoC-User-Role, which table 11 types Grouped, so no Enumerated block holds
;; them.
;; Clause 6.2.46, table 9 "Service Identifier Values": BCAST SUBSCRIBE 100,
;; SUBSCRIPTION_UPDATE 101, UNSUBSCRIBE 102, TOKEN_PURCHASE 103,
;; SERVICE_INTERACTION 104; SIMPLE_IM PAGER_MODE 200, LARGE_MESSAGE_MODE 201,
;; SESSION_MODE 202, CONVERSATION_HISTORY 203. Table 11 types Service-Identifier
;; Unsigned32, from RFC 4006, so no Enumerated block holds them.


;; Table 5, service context SIMPLE_IM; table 11 gives the code and vendor.
; Type: Enumerated AVP
; Name: Application-Service-Type
; Section: 6.2.4
; Page: 26
Application-Service-Type ::= < Enumerated AVP header: 2102 10415 >
        SENDING   = 100
        RECEIVING = 101
        RETRIEVAL = 102
        INVITING  = 103
        LEAVING   = 104
        JOINING   = 105


;; Table 6, service context SIMPLE_IM, for the data element Role of Node, which
;; table 10 maps to PoC-Server-Role; table 11 gives the code and vendor.
; Type: Enumerated AVP
; Name: PoC-Server-Role
; Section: 6.2.43
; Page: 30
PoC-Server-Role ::= < Enumerated AVP header: 883 10415 >
        PARTICIPATING_FUNCTION = 0
        CONTROLING_FUNCTION    = 1


;; For the data element AoC Request Type, which table 10 maps to AoC-Request-Type;
;; table 11 gives the code and vendor.
; Type: Enumerated AVP
; Name: AoC-Request-Type
; Section: 6.2.74
; Page: 33
AoC-Request-Type ::= < Enumerated AVP header: 2055 10415 >
        AoC_NOT_REQUESTED = 0
        AoC_FULL          = 1
        AoC_COST_ONLY     = 2
        AoC_TARIFF_ONLY   = 3


; Type: Application Scope
; Name: CH-1
; Section: 8.5.1
; Page: 43
; Application-ID: 3
; Applies-To: 8.1.*


; Type: Application Scope
; Name: CH-2
; Section: 8.5.3
; Page: 44
; Application-ID: 4
; Applies-To: 8.2.*


; Type: Message
; Name: Accounting-Request, ACR
; Section: 8.1.1
; Page: 36
<Accounting-Request> ::= < Diameter Header: 271, REQ, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Accounting-Record-Type }
        { Accounting-Record-Number }
        [ Acct-Application-Id ]
        [ Vendor-Specific-Application-Id ]
        [ User-Name ]
        [ Accounting-Sub-Session-Id ]
        [ Acct-Session-Id ]
        [ Acct-Multi-Session-Id ]
        [ Acct-Interim-Interval ]
        [ Accounting-Realtime-Required ]
        [ Origin-State-Id ]
        [ Event-Timestamp ]
      * [ Proxy-Info ]
      * [ Route-Record ]
        [ Service-Context-Id ]
        [ Service-Information ]
      * [ AVP ]


; Type: Message
; Name: Accounting-Answer, ACA
; Section: 8.1.2
; Page: 36
<Accounting-Answer> ::= < Diameter Header: 271, PXY >
        < Session-Id >
        { Result-Code }
        { Origin-Host }
        { Origin-Realm }
        { Accounting-Record-Type }
        { Accounting-Record-Number }
        [ Acct-Application-Id ]
        [ Vendor-Specific-Application-Id ]
        [ User-Name ]
        [ Accounting-Sub-Session-Id ]
        [ Acct-Session-Id ]
        [ Acct-Multi-Session-Id ]
        [ Error-Reporting-Host ]
        [ Acct-Interim-Interval ]
        [ Accounting-Realtime-Required ]
        [ Origin-State-Id ]
        [ Event-Timestamp ]
      * [ Proxy-Info ]
      * [ AVP ]


; Type: Message
; Name: Credit-Control-Request, CCR
; Section: 8.2.1
; Page: 37
<Credit-Control-Request> ::= < Diameter Header: 272, REQ, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Auth-Application-Id }
        { Service-Context-Id }
        { CC-Request-Type }
        { CC-Request-Number }
        [ Destination-Host ]
        [ User-Name ]
        [ CC-Sub-Session-Id ]
        [ Acct-Multi-Session-Id ]
        [ Origin-State-Id ]
        [ Event-Timestamp ]
      * [ Subscription-Id ]
        [ Service-Identifier ]
        [ Termination-Cause ]
        [ Requested-Service-Unit ]
        [ Requested-Action ]
        [ AoC-Request-Type ]
      * [ Used-Service-Unit ]
        [ AoC-Request-Type ]
        [ Multiple-Services-Indicator ]
      * [ Multiple-Services-Credit-Control ]
      * [ Service-Parameter-Info ]
        [ CC-Correlation-Id ]
        [ User-Equipment-Info ]
      * [ Proxy-Info ]
      * [ Route-Record ]
        [ Service-Information ]
      * [ AVP ]


; Type: Message
; Name: Credit-Control-Answer, CCA
; Section: 8.2.2
; Page: 37
<Credit-Control-Answer> ::= < Diameter Header: 272, PXY >
        < Session-Id >
        { Result-Code }
        { Origin-Host }
        { Origin-Realm }
        { Auth-Application-Id }
        { CC-Request-Type }
        { CC-Request-Number }
        [ User-Name ]
        [ CC-Session-Failover ]
        [ CC-Sub-Session-Id ]
        [ Acct-Multi-Session-Id ]
        [ Origin-State-Id ]
        [ Event-Timestamp ]
        [ Granted-Service-Unit ]
      * [ Multiple-Services-Credit-Control ]
        [ Cost-Information ]
        [ Low-Balance-Indication ]
        [ Final-Unit-Indication ]
        [ Check-Balance-Result ]
        [ Credit-Control-Failure-Handling ]
        [ Direct-Debiting-Failure-Handling ]
        [ Validity-Time ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ Failed-AVP ]
        [ Service-Information ]
      * [ AVP ]


