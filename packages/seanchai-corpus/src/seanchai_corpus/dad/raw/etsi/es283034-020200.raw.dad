Globally-Unique-Address            300    7.3       Grouped       M,V    -     -       -       Yes
Address-Realm                      301    7.3       OctetString   M,V    -     -       -       Yes
Logical-Access-Id                  302    7.3       OctetString   V      M     -       -       Yes
Initial-Gate-Setting-Description   303    7.3       Grouped       V      M     -       -       Yes
QoS-Profile-Description            304    7.3       Grouped       V      M     -       -       Yes
IP-Connectivity-Status             305    7.3       Enumerated    V      M     -       -       Yes
Access-Network-Type                306    7.3       Grouped       V      M     -       -       Yes
Aggregation-Network-Type           307    7.3       Enumerated    V      M     -       -       Yes
Maximum-Allowed-Bandwidth-UL       308    7.3       Unsigned32    V      M     -       -       Yes
Maximum-Allowed-Bandwidth-DL       309    7.3       Unsigned32    V      M     -       -       Yes
Transport-Class                    311    7.3       Unsigned32    V      M     -       -       Yes
Application-Class-ID               312    7.3       UTF8String    V      M     -       -       Yes
Physical-Access-ID                 313    7.3       UTF8String    V      M     -       -       Yes
Initial-Gate-Setting-ID            314    7.3       Unsigned32    V      M     -       -       Yes
QoS-Profile-ID                     315    7.3       Unsigned32    V      M     -       -       Yes
;; NOTE: The AVP header bit denoted as "M", indicates whether support of the AVP is required. The AVP header bit denoted as "V", indicates whether the optional Vendor-ID field is present in the AVP header.


;; Table 11 prints "See TS 129 209 [5]" in its Clause column and flag
;; rules "in the context of the present document": Media-Type V in Must
;; and M in May, AF-Application-Identifier M,V in Must; May Encrypt Yes
;; for both.
; Type: Reused AVPs
; Section: 7.3
; Table: 11
; Page: 19
; Columns: Name             Code   From       Type
Media-Type                  520    TS29.209   Enumerated
AF-Application-Identifier   504    TS29.209   OctetString


;; Table 12 prints "See RFC 4005 [9]" in its Clause column and, for all
;; four rows, M in May and V in Must not; May Encrypt Yes.
; Type: Reused AVPs
; Section: 7.3
; Table: 12
; Page: 19
; Columns: Name      Code   From      Type
NAS-Port-Type        61     RFC4005   Enumerated
NAS-Filter-Rule      400    RFC4005   IPFilterRule
Framed-IP-Address    8      RFC4005   OctetString
Framed-IPv6-Prefix   97     RFC4005   OctetString


;; Table 13 prints "See TS 183 017 [12]" in its Clause column, V in Must
;; and M in Must not; May Encrypt Yes.
; Type: Reused AVPs
; Section: 7.3
; Table: 13
; Page: 19
; Columns: Name        Code   From             Type
Reservation-Priority   458    ETSI-TS183.017   Unsigned32


; Type: Grouped AVP
; Name: Globally-Unique-Address
; Section: 7.3.1
; Page: 21
Globally-Unique-Address ::= < AVP header: 300 13019 >
        [ Frame-IP-Address ]
        [ Frame-IPv6-Prefix ]
        [ Address-Realm ]


; Type: Grouped AVP
; Name: Initial-Gate-Setting-Description
; Section: 7.3.4
; Page: 21
Initial-Gate-Setting-Description ::= < AVP header: 303 13019 >
     1* { NAS-Filter-Rule }
        [ Maximum-Allowed-Bandwidth-UL ]
        [ Maximum-Allowed-Bandwidth-DL ]


; Type: Grouped AVP
; Name: QoS-Profile-Description
; Section: 7.3.5
; Page: 21
QoS-Profile-Description ::= < AVP header: 304 13019 >
      * [ Application-Class-ID ]
      * [ Media-Type ]
        [ Reservation-Priority ]
        [ Maximum-Allowed-Bandwidth-UL ]
        [ Maximum-Allowed-Bandwidth-DL ]
        [ Transport-Class ]


; Type: Enumerated AVP
; Name: IP-Connectivity-Status
; Section: 7.3.6
; Page: 22
IP-Connectivity-Status ::= < Enumerated AVP header: 305 13019 >
        IP-CONNECTIVITY-ON   = 0
        IP-CONNECTIVITY-LOST = 1


; Type: Grouped AVP
; Name: Access-Network-Type
; Section: 7.3.7
; Page: 22
Access-Network-Type ::= < AVP header: 306 13019 >
        { NAS-Port-Type }
        [ Aggregation-Network-Type ]


; Type: Enumerated AVP
; Name: Aggregation-Network-Type
; Section: 7.3.8
; Page: 22
Aggregation-Network-Type ::= < Enumerated AVP header: 307 13019 >
        UNKNOWN  = 0
        ATM      = 1
        ETHERNET = 2


; Type: Enumerated AVP
; Name: Reservation-Priority
; Section: 7.3.11
; Page: 22
Reservation-Priority ::= < Enumerated AVP header: 458 13019 >
        "PRIORITY 0" = 0
        "PRIORITY 1" = 1
        "PRIORITY 2" = 2
        "PRIORITY 3" = 3
        "PRIORITY 4" = 4
        "PRIORITY 5" = 5
        "PRIORITY 6" = 6
        "PRIORITY 7" = 7
        ;; NOTE: PRIORITY 0 is the lowest priority.
