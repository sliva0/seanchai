; Type: Message
; Name: User-Data-Request, UDR
; Section: 7.1.1
; Page: 17
<User-Data-Request> ::= < Diameter Header: 306, REQ, PXY, 16777231 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Destination-Host ]
        { Destination-Realm }
        [ Globally-Unique-Address ]        ; bold
        [ AF-Application-Identifier ]      ; bold
        [ User-Name ]                      ; bold
      * [ AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


; Type: Message
; Name: User-Data-Answer, UDA
; Section: 7.1.2
; Page: 17
<User-Data-Answer> ::= < Diameter Header: 306, PXY, 16777231 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        [ Result-Code ]
        [ Experimental-Result ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Globally-Unique-Address ]          ; bold
        [ User-Name ]                        ; bold
        [ Logical-Access-Id ]                ; bold
        [ Physical-Access-Id ]               ; bold
        [ Access-Network-Type ]              ; bold
        [ Initial-Gate-Setting-Description ] ; bold
      * [ Qos-Profile-Description ]          ; bold
        [ IP-Connectivity-Status ]           ; bold
        [ QoS-Profile-ID ]                   ; bold
        [ Initial-Gate-Setting-ID ]          ; bold
      * [ AVP ]
      * [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


; Type: Message
; Name: Push-Notification-Request, PNR
; Section: 7.1.3
; Page: 18
<Push-Notification-Request> ::= < Diameter Header: 309, REQ, PXY, 16777231 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Host }
        { Destination-Realm }
        [ Globally-Unique-Address ]          ; bold
        [ User-Name ]                        ; bold
        [ Logical-Access-Id ]                ; bold
        [ Physical-Access-Id ]               ; bold
        [ Access-Network-Type ]              ; bold
        [ Initial-Gate-Setting-Description ] ; bold
      * [ QoS-Profile-Description ]          ; bold
        [ IP-Connectivity-Status ]           ; bold
        [ QoS-Profile-ID ]                   ; bold
        [ Initial-Gate-Setting-ID ]          ; bold
      * [ AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


; Type: Message
; Name: Push-Notification-Answer, PNA
; Section: 7.1.4
; Page: 18
<Push-Notification-Answer> ::= < Diameter Header: 309, PXY, 16777231 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        [ Result-Code ]
        [ Experimental-Result ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
      * [ AVP ]
      * [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


