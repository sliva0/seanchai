; Type: Enumerated AVP
; Name: CC-Request-Type
; Section: 8.3
; Page: 58
CC-Request-Type ::= < Enumerated AVP header: 416 >
        INITIAL_REQUEST     = 1
        UPDATE_REQUEST      = 2
        TERMINATION_REQUEST = 3
        EVENT_REQUEST       = 4


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#ccr-event-request-requested-action)
; AVP: Requested-Action
; Command: Credit-Control-Request
; Section: 8.3
; Page: 58
"The Requested-Action AVP MUST be included in the Credit-Control-Request message when CC-Request-Type is set to EVENT_REQUEST."
    present-if CC-Request-Type = EVENT_REQUEST


; Type: Enumerated AVP
; Name: CC-Session-Failover
; Section: 8.4
; Page: 59
CC-Session-Failover ::= < Enumerated AVP header: 418 >
        FAILOVER_NOT_SUPPORTED = 0
        FAILOVER_SUPPORTED     = 1


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#cc-session-failover-default)
; AVP: CC-Session-Failover
; Section: 8.4
; Page: 59
"FAILOVER_NOT_SUPPORTED 0 When the CC-Session-Failover AVP is set to FAILOVER_NOT_SUPPORTED, the credit-control message stream MUST NOT to be moved to an alternative destination in the case of communication failure."
"This is the default behavior if the AVP isn't included in the reply from the authorization or credit-control server."
    default FAILOVER_NOT_SUPPORTED


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#cc-sub-session-id-increasing)
; AVP: CC-Sub-Session-Id
; Section: 8.5
; Page: 59
"The combination of the Session-Id and this AVP MUST be unique per sub-session, and the value of this AVP MUST be monotonically increased by one for all new sub-sessions."
    text-only
"The absence of this AVP implies that no sub-sessions are in use."
    text-only


; Type: Enumerated AVP
; Name: Check-Balance-Result
; Section: 8.6
; Page: 60
Check-Balance-Result ::= < Enumerated AVP header: 422 >
        ENOUGH_CREDIT = 0
        NO_CREDIT     = 1


; Type: Grouped AVP
; Name: Cost-Information
; Section: 8.7
; Page: 60
Cost-Information ::= < AVP header: 423 >
        { Unit-Value }
        { Currency-Code }
        [ Cost-Unit ]


; Type: Grouped AVP
; Name: Unit-Value
; Section: 8.8
; Page: 61
Unit-Value ::= < AVP header: 445 >
        { Value-Digits }
        [ Exponent ]


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#exponent-default)
; AVP: Exponent
; Within: Unit-Value
; Section: 8.8
; Page: 61
"The absence of the exponent part MUST be interpreted as an exponent equal to zero."
    default 0


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#currency-code-iso-4217)
; AVP: Currency-Code
; Section: 8.11
; Page: 62
"It is specified by using the numeric values defined in the ISO 4217 standard [ISO4217]."
    text-only


; Type: Enumerated AVP
; Name: Credit-Control
; Section: 8.13
; Page: 62
Credit-Control ::= < Enumerated AVP header: 426 >
        CREDIT_AUTHORIZATION = 0
        RE_AUTHORIZATION     = 1


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#credit-control-in-aa-requests)
; AVP: Credit-Control
; Section: 8.13
; Page: 62
"The Credit-Control AVP (AVP Code 426) is of type Enumerated and MUST be included in AA requests when the service element has credit-control capabilities."
    text-only
"The value of the Credit-Control AVP MUST always be set to 0 in an AA request sent to perform the first interrogation and to initiate a new credit-control session."
    text-only
"This value MUST NOT be used in an AA request sent to perform the first interrogation."
    text-only


; Type: Enumerated AVP
; Name: Credit-Control-Failure-Handling
; Section: 8.14
; Page: 62
Credit-Control-Failure-Handling ::= < Enumerated AVP header: 427 >
        TERMINATE           = 0
        CONTINUE            = 1
        RETRY_AND_TERMINATE = 2


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#credit-control-failure-handling-default)
; AVP: Credit-Control-Failure-Handling
; Section: 8.14
; Page: 62
"This is the default behavior if the AVP isn't included in the reply from the authorization or credit-control server."
    default TERMINATE


; Type: Enumerated AVP
; Name: Direct-Debiting-Failure-Handling
; Section: 8.15
; Page: 63
Direct-Debiting-Failure-Handling ::= < Enumerated AVP header: 428 >
        TERMINATE_OR_BUFFER = 0
        CONTINUE            = 1


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#direct-debiting-failure-handling-default)
; AVP: Direct-Debiting-Failure-Handling
; Section: 8.15
; Page: 63
"This is the default behavior if the AVP isn't included in the reply from the authorization server."
    default TERMINATE_OR_BUFFER


; Type: Grouped AVP
; Name: Multiple-Services-Credit-Control
; Section: 8.16
; Page: 64
Multiple-Services-Credit-Control ::= < AVP header: 456 >
        [ Granted-Service-Unit ]
        [ Requested-Service-Unit ]
      * [ Used-Service-Unit ]
        [ Tariff-Change-Usage ]
      * [ Service-Identifier ]
        [ Rating-Group ]
      * [ G-S-U-Pool-Reference ]
        [ Validity-Time ]
        [ Result-Code ]
        [ Final-Unit-Indication ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#g-s-u-pool-reference-granted-units)
; AVP: G-S-U-Pool-Reference
; Within: Multiple-Services-Credit-Control
; Section: 8.16
; Page: 64
"If a G-S-U-Pool-Reference AVP is present, then actual service units of the specified type MUST also be present. For example, if the G-S-U-Pool-Reference AVP specifies Unit-Type TIME, then the CC-Time AVP MUST be present."
    excludes G-S-U-Pool-Reference/CC-Unit-Type = TIME and not Granted-Service-Unit/CC-Time or G-S-U-Pool-Reference/CC-Unit-Type = MONEY and not Granted-Service-Unit/CC-Money or G-S-U-Pool-Reference/CC-Unit-Type = TOTAL-OCTETS and not Granted-Service-Unit/CC-Total-Octets or G-S-U-Pool-Reference/CC-Unit-Type = INPUT-OCTETS and not Granted-Service-Unit/CC-Input-Octets or G-S-U-Pool-Reference/CC-Unit-Type = OUTPUT-OCTETS and not Granted-Service-Unit/CC-Output-Octets or G-S-U-Pool-Reference/CC-Unit-Type = SERVICE-SPECIFIC-UNITS and not Granted-Service-Unit/CC-Service-Specific-Units


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#ccr-multiple-services-credit-control-members)
; AVP: Multiple-Services-Credit-Control
; Command: Credit-Control-Request
; Section: 8.16
; Page: 64
"It MUST be present in the initial interrogation and within the intermediate interrogations in which new quota is requested."
    absent-if CC-Request-Type = INITIAL_REQUEST and not Multiple-Services-Credit-Control/Requested-Service-Unit
"The Tariff-Change-Usage AVP MUST NOT be included in request commands to report used units before, and after tariff time change the Used-Service-Unit AVP MUST be used."
    absent-if Multiple-Services-Credit-Control/Tariff-Change-Usage


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#cca-tariff-change-two-quotas)
; AVP: Multiple-Services-Credit-Control
; Command: Credit-Control-Answer
; Section: 8.16
; Page: 64
"When both the Tariff-Time-Change and Tariff-Change-Usage AVPs are present, the server MUST include two separate instances of the Multiple-Services-Credit-Control AVP with the Granted-Service-Unit AVP associated to the same service-identifier and/or rating-group."
    text-only


; Type: Grouped AVP
; Name: Granted-Service-Unit
; Section: 8.17
; Page: 65
Granted-Service-Unit ::= < AVP header: 431 >
        [ Tariff-Time-Change ]
        [ CC-Time ]
        [ CC-Money ]
        [ CC-Total-Octets ]
        [ CC-Input-Octets ]
        [ CC-Output-Octets ]
        [ CC-Service-Specific-Units ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Requested-Service-Unit
; Section: 8.18
; Page: 66
Requested-Service-Unit ::= < AVP header: 437 >
        [ CC-Time ]
        [ CC-Money ]
        [ CC-Total-Octets ]
        [ CC-Input-Octets ]
        [ CC-Output-Octets ]
        [ CC-Service-Specific-Units ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Used-Service-Unit
; Section: 8.19
; Page: 66
Used-Service-Unit ::= < AVP header: 446 >
        [ Tariff-Change-Usage ]
        [ CC-Time ]
        [ CC-Money ]
        [ CC-Total-Octets ]
        [ CC-Input-Octets ]
        [ CC-Output-Octets ]
        [ CC-Service-Specific-Units ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#tariff-time-change-omitted)
; AVP: Tariff-Time-Change
; Section: 8.20
; Page: 67
"Omission of this AVP means that no tariff change is to be reported."
    text-only


; Type: Grouped AVP
; Name: CC-Money
; Section: 8.22
; Page: 67
CC-Money ::= < AVP header: 413 >
        { Unit-Value }
        [ Currency-Code ]


; Type: Enumerated AVP
; Name: Tariff-Change-Usage
; Section: 8.27
; Page: 68
Tariff-Change-Usage ::= < Enumerated AVP header: 452 >
        UNIT_BEFORE_TARIFF_CHANGE = 0
        UNIT_AFTER_TARIFF_CHANGE  = 1
        UNIT_INDETERMINATE        = 2


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#tariff-change-usage-omitted)
; AVP: Tariff-Change-Usage
; Section: 8.27
; Page: 68
"Omission of this AVP means that no tariff change has occurred."
    text-only


; Type: Grouped AVP
; Name: G-S-U-Pool-Reference
; Section: 8.30
; Page: 69
G-S-U-Pool-Reference ::= < AVP header: 457 >
        { G-S-U-Pool-Identifier }
        { CC-Unit-Type }
        { Unit-Value }


; Type: Enumerated AVP
; Name: CC-Unit-Type
; Section: 8.32
; Page: 70
CC-Unit-Type ::= < Enumerated AVP header: 454 >
        TIME                   = 0
        MONEY                  = 1
        TOTAL-OCTETS           = 2
        INPUT-OCTETS           = 3
        OUTPUT-OCTETS          = 4
        SERVICE-SPECIFIC-UNITS = 5


; Type: Grouped AVP
; Name: Final-Unit-Indication
; Section: 8.34
; Page: 71
Final-Unit-Indication ::= < AVP header: 430 >
        { Final-Unit-Action }
      * [ Restriction-Filter-Rule ]
      * [ Filter-Id ]
        [ Redirect-Server ]


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#final-unit-indication-terminate)
; AVP: Final-Unit-Indication
; Section: 8.34
; Page: 71
"If the Final-Unit-Action AVP is set to TERMINATE, no other AVPs MUST be present."
    excludes Final-Unit-Action = TERMINATE and Restriction-Filter-Rule or Final-Unit-Action = TERMINATE and Filter-Id or Final-Unit-Action = TERMINATE and Redirect-Server


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#final-unit-indication-redirect-server)
; AVP: Redirect-Server
; Within: Final-Unit-Indication
; Section: 8.34
; Page: 71
"If the Final-Unit-Action AVP is set to REDIRECT at least the Redirect-Server AVP MUST be present."
    present-if Final-Unit-Action = REDIRECT


; Type: Enumerated AVP
; Name: Final-Unit-Action
; Section: 8.35
; Page: 72
Final-Unit-Action ::= < Enumerated AVP header: 449 >
        TERMINATE       = 0
        REDIRECT        = 1
        RESTRICT_ACCESS = 2


; Type: Grouped AVP
; Name: Redirect-Server
; Section: 8.37
; Page: 73
Redirect-Server ::= < AVP header: 434 >
        { Redirect-Address-Type }
        { Redirect-Server-Address }


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#redirect-server-redirect)
; AVP: Redirect-Server
; Within: Final-Unit-Indication
; Section: 8.37
; Page: 73
"It MUST be present when the Final-Unit-Action AVP is set to REDIRECT."
    present-if Final-Unit-Action = REDIRECT


; Type: Enumerated AVP
; Name: Redirect-Address-Type
; Section: 8.38
; Page: 73
Redirect-Address-Type ::= < Enumerated AVP header: 433 >
        URL = 2


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#redirect-server-address-by-type)
; AVP: Redirect-Server-Address
; Within: Redirect-Server
; Section: 8.38
; Page: 73
"IPv4 Address 0 The address type is in the form of \"dotted-decimal\" IPv4 address, as defined in [IPv4]."
"IPv6 Address 1 The address type is in the form of IPv6 address, as defined in [IPv6Addr]. The address is a text representation of the address in either the preferred or alternate text form [IPv6Addr]."
"URL 2 The address type is in the form of Uniform Resource Locator, as defined in [URL]."
"SIP URI 3 The address type is in the form of SIP Uniform Resource Identifier, as defined in [SIP]."
    text-only


; Type: Enumerated AVP
; Name: Multiple-Services-Indicator
; Section: 8.40
; Page: 74
Multiple-Services-Indicator ::= < Enumerated AVP header: 455 >
        MULTIPLE_SERVICES_NOT_SUPPORTED = 0
        MULTIPLE_SERVICES_SUPPORTED     = 1


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#multiple-services-indicator-default)
; AVP: Multiple-Services-Indicator
; Section: 8.40
; Page: 74
"The absence of this AVP means that independent credit-control of multiple services is not supported."
    default MULTIPLE_SERVICES_NOT_SUPPORTED


; Type: Enumerated AVP
; Name: Requested-Action
; Section: 8.41
; Page: 74
Requested-Action ::= < Enumerated AVP header: 436 >
        DIRECT_DEBITING = 0
        REFUND_ACCOUNT  = 1
        CHECK_BALANCE   = 2
        PRICE_ENQUIRY   = 3


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#service-context-id-format)
; AVP: Service-Context-Id
; Section: 8.42
; Page: 75
"This is an identifier allocated by the service provider, by the service element manufacturer, or by a standardization body, and MUST uniquely identify a given Diameter credit-control service specific document."
    text-only
"\"service-context\" \"@\" \"domain\""
    text-only


; Type: Grouped AVP
; Name: Service-Parameter-Info
; Section: 8.43
; Page: 76
Service-Parameter-Info ::= < AVP header: 440 >
        { Service-Parameter-Type }
        { Service-Parameter-Value }


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#cca-unknown-service-failed-avp)
; AVP: Failed-AVP
; Command: Credit-Control-Answer
; Section: 8.43
; Page: 76
"A Credit-Control-Answer message with this error MUST contain one or more Failed-AVP AVPs containing the Service-Parameter-Info AVPs that caused the failure."
    present-if Result-Code = DIAMETER_RATING_FAILED


; Type: Grouped AVP
; Name: Subscription-Id
; Section: 8.46
; Page: 77
Subscription-Id ::= < AVP header: 443 >
        { Subscription-Id-Type }
        { Subscription-Id-Data }


; Type: Enumerated AVP
; Name: Subscription-Id-Type
; Section: 8.47
; Page: 77
Subscription-Id-Type ::= < Enumerated AVP header: 450 >
        END_USER_E164    = 0
        END_USER_IMSI    = 1
        END_USER_SIP_URI = 2
        END_USER_NAI     = 3
        END_USER_PRIVATE = 4


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#subscription-id-data-by-type)
; AVP: Subscription-Id-Data
; Within: Subscription-Id
; Section: 8.47
; Page: 77
"END_USER_E164 0 The identifier is in international E.164 format (e.g., MSISDN), according to the ITU-T E.164 numbering plan defined in [E164] and [CE164]."
"END_USER_IMSI 1 The identifier is in international IMSI format, according to the ITU-T E.212 numbering plan as defined in [E212] and [CE212]."
"END_USER_SIP_URI 2 The identifier is in the form of a SIP URI, as defined in [SIP]."
"END_USER_NAI 3 The identifier is in the form of a Network Access Identifier, as defined in [NAI]."
    text-only


; Type: Grouped AVP
; Name: User-Equipment-Info
; Section: 8.49
; Page: 78
User-Equipment-Info ::= < AVP header: 458 >
        { User-Equipment-Info-Type }
        { User-Equipment-Info-Value }


; Type: Enumerated AVP
; Name: User-Equipment-Info-Type
; Section: 8.50
; Page: 78
User-Equipment-Info-Type ::= < Enumerated AVP header: 459 >
        IMEISV         = 0
        MAC            = 1
        EUI64          = 2
        MODIFIED_EUI64 = 3


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#user-equipment-info-value-by-type)
; AVP: User-Equipment-Info-Value
; Within: User-Equipment-Info
; Section: 8.50
; Page: 78
"IMEISV 0 The identifier contains the International Mobile Equipment Identifier and Software Version in the international IMEISV format according to 3GPP TS 23.003 [3GPPIMEI]."
"MAC 1 The 48-bit MAC address is formatted as described in [RAD802.1X]."
"EUI64 2 The 64-bit identifier used to identify hardware instance of the product, as defined in [EUI64]."
    text-only


; Type: Value Table
; AVP: Result-Code
; Kind: result-codes
; Section: 9
; Page: 79
DIAMETER_END_USER_SERVICE_DENIED       = 4010 ; 9.1
DIAMETER_CREDIT_CONTROL_NOT_APPLICABLE = 4011 ; 9.1
DIAMETER_CREDIT_LIMIT_REACHED          = 4012 ; 9.1
DIAMETER_USER_UNKNOWN                  = 5030 ; 9.2
DIAMETER_RATING_FAILED                 = 5031 ; 9.2


; Type: Interpreted Constraints ;; interpreted: (RFC4006.dadx#cca-rating-failed-result-failed-avp)
; AVP: Failed-AVP
; Command: Credit-Control-Answer
; Section: 9.2
; Page: 80
"The Failed-AVP AVP MUST be included and contain a copy of the entire AVP(s) that could not be processed successfully or an example of the missing AVP complete with the Vendor-Id if applicable."
    present-if Result-Code = DIAMETER_RATING_FAILED


