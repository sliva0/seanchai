; Specification: RFC 4072
; Vendor-ID: 0
; Bases: RFC6733, RFC4005 ;; corrected: (RFC4072.py#bases-nasreq)
; Link: https://www.rfc-editor.org/rfc/rfc4072.txt


; Type: Application Scope ;; inserted: (RFC4072.py#application-id)
; Name: Diameter EAP
; Section: 2.1
; Page: 3
; Application-ID: 5
; Applies-To: 3.*


; Type: Interpreted Constraints ;; interpreted: (RFC4072.dadx#dea-fatal-error-eap-failure)
; AVP: EAP-Payload
; Command: Diameter-EAP-Answer
; Section: 2.4
; Page: 10
"A Diameter server determining that a fatal error has occurred MUST send a Diameter-EAP-Answer with a failure Result-Code and an EAP-Payload AVP encapsulating an EAP Failure packet."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC4072.dadx#dea-non-fatal-error-reissued-payload)
; AVP: EAP-Reissued-Payload
; Command: Diameter-EAP-Answer
; Section: 2.4
; Page: 10
"A Diameter server determining that a non-fatal error has occurred MUST send a Diameter-EAP-Answer with DIAMETER_MULTI_ROUND_AUTH Result-Code, but no EAP-Payload AVP."
"To simplify RADIUS translation, this message MUST also include an EAP-Reissued-Payload AVP encapsulating the previous EAP Request sent by the server."
    present-if Result-Code = DIAMETER_MULTI_ROUND_AUTH and not EAP-Payload


; Type: Interpreted Constraints ;; interpreted: (RFC4072.dadx#dea-eap-result-not-multi-round)
; AVP: Result-Code
; Command: Diameter-EAP-Answer
; Section: 2.8.2
; Page: 13
"A Diameter-EAP-Answer message containing an EAP-Payload of type EAP-Success or EAP-Failure MUST NOT have the Result-Code AVP set to DIAMETER_MULTI_ROUND_AUTH."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC4072.dadx#dea-reply-message-without-eap-payload)
; AVP: Reply-Message
; Command: Diameter-EAP-Answer
; Section: 2.8.3
; Page: 14
"The Reply-Message AVP [NASREQ] MUST NOT be included in any Diameter message containing an EAP-Payload AVP."
    excludes EAP-Payload


; Type: Interpreted Constraints ;; interpreted: (RFC4072.dadx#der-eap-payload-no-eap-request)
; AVP: EAP-Payload
; Command: Diameter-EAP-Request
; Section: 2.8.4
; Page: 14
"A Diameter client MUST NOT send a Diameter-EAP-Request encapsulating an EAP Request packet, and a Diameter server receiving such a packet MUST respond with a failure Result-Code."
    text-only


; Type: Message
; Name: Diameter-EAP-Request, DER
; Section: 3.1
; Page: 15
<Diameter-EAP-Request> ::= < Diameter Header: 268, REQ, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Auth-Request-Type }
        [ Destination-Host ]
        [ NAS-Identifier ]
        [ NAS-IP-Address ]
        [ NAS-IPv6-Address ]
        [ NAS-Port ]
        [ NAS-Port-Id ]
        [ NAS-Port-Type ]
        [ Origin-State-Id ]
        [ Port-Limit ]
        [ User-Name ]
        { EAP-Payload }
        [ EAP-Key-Name ]
        [ Service-Type ]
        [ State ]
        [ Authorization-Lifetime ]
        [ Auth-Grace-Period ]
        [ Auth-Session-State ]
        [ Callback-Number ]
        [ Called-Station-Id ]
        [ Calling-Station-Id ]
        [ Originating-Line-Info ]
        [ Connect-Info ]
      * [ Framed-Compression ]
        [ Framed-Interface-Id ]
        [ Framed-IP-Address ]
      * [ Framed-IPv6-Prefix ]
        [ Framed-IP-Netmask ]
        [ Framed-MTU ]
        [ Framed-Protocol ]
      * [ Tunneling ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC4072.dadx#der-state-from-the-dea)
; AVP: State
; Command: Diameter-EAP-Request
; Section: 3.1
; Page: 15
"A subsequent DER message MUST include any State AVPs [NASREQ] that were present in the DEA."
    text-only


; Type: Message
; Name: Diameter-EAP-Answer, DEA
; Section: 3.2
; Page: 16
<Diameter-EAP-Answer> ::= < Diameter Header: 268, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Auth-Request-Type }
        { Result-Code }
        { Origin-Host }
        { Origin-Realm }
        [ User-Name ]
        [ EAP-Payload ]
        [ EAP-Reissued-Payload ]
        [ EAP-Master-Session-Key ]
        [ EAP-Key-Name ]
        [ Multi-Round-Time-Out ]
        [ Accounting-EAP-Auth-Method ]
        [ Service-Type ]
      * [ Class ]
      * [ Configuration-Token ]
        [ Acct-Interim-Interval ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
      * [ Failed-AVP ]
        [ Idle-Timeout ]
        [ Authorization-Lifetime ]
        [ Auth-Grace-Period ]
        [ Auth-Session-State ]
        [ Re-Auth-Request-Type ]
        [ Session-Timeout ]
        [ State ]
      * [ Reply-Message ]
        [ Origin-State-Id ]
      * [ Filter-Id ]
        [ Port-Limit ]
        [ Callback-Id ]
        [ Callback-Number ]
        [ Framed-AppleTalk-Link ] ;; corrected: (RFC4072.py#dea-framed-appletalk-link-case)
      * [ Framed-AppleTalk-Network ] ;; corrected: (RFC4072.py#dea-framed-appletalk-network-case)
        [ Framed-AppleTalk-Zone ] ;; corrected: (RFC4072.py#dea-framed-appletalk-zone-case)
      * [ Framed-Compression ]
        [ Framed-Interface-Id ]
        [ Framed-IP-Address ]
      * [ Framed-IPv6-Prefix ]
        [ Framed-IPv6-Pool ]
      * [ Framed-IPv6-Route ]
        [ Framed-IP-Netmask ]
      * [ Framed-Route ]
        [ Framed-Pool ]
        [ Framed-IPX-Network ]
        [ Framed-MTU ]
        [ Framed-Protocol ]
        [ Framed-Routing ]
      * [ NAS-Filter-Rule ]
      * [ QoS-Filter-Rule ]
      * [ Tunneling ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Proxy-Info ]
      * [ AVP ]


; Type: AVP Table
; Section: 4.1.1
; Page: 18
; Columns: Name              Code   Section   Type
EAP-Payload                  462    4.1.1     OctetString
EAP-Reissued-Payload         463    4.1.2     OctetString
EAP-Master-Session-Key       464    4.1.3     OctetString
EAP-Key-Name                 102    4.1.4     OctetString
Accounting-EAP-Auth-Method   465    4.1.5     Unsigned64


; Type: Interpreted Constraints ;; interpreted: (RFC4072.dadx#der-eap-key-name-empty)
; AVP: EAP-Key-Name
; Command: Diameter-EAP-Request
; Section: 4.1.4
; Page: 19
"As a result, a Key-Name AVP sent in a Diameter-EAP-Request MUST NOT contain any data."
    length 0 octets


