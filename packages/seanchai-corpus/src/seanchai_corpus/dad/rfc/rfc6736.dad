RESOURCE_FAILURE                      = 4014 ; 8.2.2
UNKNOWN_BINDING_TEMPLATE_NAME         = 5042 ; 8.2.3
BINDING_FAILURE                       = 5043 ; 8.2.3
MAX_BINDINGS_SET_FAILURE              = 5044 ; 8.2.3
