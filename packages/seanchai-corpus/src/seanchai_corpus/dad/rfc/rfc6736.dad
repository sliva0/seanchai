SESSION_EXISTS                        = 5046 ; 8.2.3
INSUFFICIENT_CLASSIFIERS              = 5047 ; 8.2.3


; Type: Enumerated AVP
; Name: NC-Request-Type
; Section: 8.7.1
; Page: 36
NC-Request-Type ::= < Enumerated AVP header: 595 >
        INITIAL_REQUEST = 1
        UPDATE_REQUEST  = 2
        QUERY_REQUEST   = 3


; Type: Grouped AVP
; Name: NAT-Control-Install
; Section: 8.7.2
; Page: 36
NAT-Control-Install ::= < AVP header: 596 >
      * [ NAT-Control-Definition ]
        [ NAT-Control-Binding-Template ]
        [ Max-NAT-Bindings ]
        [ NAT-External-Port-Style ]
      * [ AVP ]


; Type: Grouped AVP
; Name: NAT-Control-Remove
; Section: 8.7.3
; Page: 37
NAT-Control-Remove ::= < AVP header: 597 >
      * [ NAT-Control-Definition ]
        [ NAT-Control-Binding-Template ]
      * [ AVP ]


; Type: Grouped AVP
; Name: NAT-Control-Definition
; Section: 8.7.4
; Page: 37
NAT-Control-Definition ::= < AVP header: 598 >
        { NAT-Internal-Address }
        [ Protocol ]
        [ Direction ]
        [ NAT-External-Address ]
        [ Session-Id ]
      * [ AVP ]


; Type: Grouped AVP
; Name: NAT-Internal-Address
; Section: 8.7.5
; Page: 38
NAT-Internal-Address ::= < AVP header: 599 >
        [ Framed-IP-Address ]
        [ Framed-IPv6-Prefix ]
        [ Port ]
      * [ AVP ]


; Type: Grouped AVP
; Name: NAT-External-Address
; Section: 8.7.6
; Page: 38
NAT-External-Address ::= < AVP header: 600 >
        [ Framed-IP-Address ]
        [ Port ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: NAT-External-Port-Style
; Section: 8.7.10
; Page: 39
NAT-External-Port-Style ::= < Enumerated AVP header: 604 >
        FOLLOW_INTERNAL_PORT_STYLE = 1


; Type: Grouped AVP
; Name: NAT-Control-Record
; Section: 9.2.1
; Page: 41
NAT-Control-Record ::= < AVP header: 605 >
        { NAT-Control-Definition }
        { NAT-Control-Binding-Status }
        [ Event-Timestamp ]


; Type: Enumerated AVP
; Name: NAT-Control-Binding-Status
; Section: 9.2.2
; Page: 41
NAT-Control-Binding-Status ::= < Enumerated AVP header: 606 >
        Created = 1
        Active  = 2
        Removed = 3
