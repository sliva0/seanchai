        "LSR - Loose Source Route"             = 131 ;; supplied: (RFC5777.py#ip-option-type-values)
        "E-SEC - Extended Security"            = 133 ;; supplied: (RFC5777.py#ip-option-type-values)
        "CIPSO - Commercial Security"          = 134 ;; supplied: (RFC5777.py#ip-option-type-values)
        "SID - Stream ID"                      = 136 ;; supplied: (RFC5777.py#ip-option-type-values)
        "SSR - Strict Source Route"            = 137 ;; supplied: (RFC5777.py#ip-option-type-values)
        "VISA - Experimental Access Control"   = 142 ;; supplied: (RFC5777.py#ip-option-type-values)
        "IMITD - IMI Traffic Descriptor"       = 144 ;; supplied: (RFC5777.py#ip-option-type-values)
        "EIP - Extended Internet Protocol"     = 145 ;; supplied: (RFC5777.py#ip-option-type-values)
        "ADDEXT - Address Extension"           = 147 ;; supplied: (RFC5777.py#ip-option-type-values)
        "RTRALT - Router Alert"                = 148 ;; supplied: (RFC5777.py#ip-option-type-values)
        "SDB - Selective Directed Broadcast"   = 149 ;; supplied: (RFC5777.py#ip-option-type-values)
        "DPS - Dynamic Packet State"           = 151 ;; supplied: (RFC5777.py#ip-option-type-values)
        "UMP - Upstream Multicast Pkt."        = 152 ;; supplied: (RFC5777.py#ip-option-type-values)
        "EXP - RFC3692-style Experiment (158)" = 158 ;; supplied: (RFC5777.py#ip-option-type-values)
        "FINN - Experimental Flow Control"     = 205 ;; supplied: (RFC5777.py#ip-option-type-values)
        "EXP - RFC3692-style Experiment (222)" = 222 ;; supplied: (RFC5777.py#ip-option-type-values)


; Type: Grouped AVP
; Name: TCP-Option
; Section: 4.1.8.6
; Page: 17
TCP-Option ::= < AVP header: 540 >
        { TCP-Option-Type }
      * [ TCP-Option-Value ]
        [ Negated ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: TCP-Option-Type
; Section: 4.1.8.7
; Page: 17
; Values: IANA under the TCP Option Numbers registry as defined in [RFC2780]
TCP-Option-Type ::= < Enumerated AVP header: 541 >
        "End of Option List"                                                      = 0 ;; supplied: (RFC5777.py#tcp-option-type-values)
        No-Operation                                                              = 1 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Maximum Segment Size"                                                    = 2 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Window Scale"                                                            = 3 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "SACK Permitted"                                                          = 4 ;; supplied: (RFC5777.py#tcp-option-type-values)
        SACK                                                                      = 5 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Echo (obsoleted by option 8)"                                            = 6 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Echo Reply (obsoleted by option 8)"                                      = 7 ;; supplied: (RFC5777.py#tcp-option-type-values)
        Timestamps                                                                = 8 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Partial Order Connection Permitted (obsolete)"                           = 9 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Partial Order Service Profile (obsolete)"                                = 10 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "CC (obsolete)"                                                           = 11 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "CC.NEW (obsolete)"                                                       = 12 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "CC.ECHO (obsolete)"                                                      = 13 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "TCP Alternate Checksum Request (obsolete)"                               = 14 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "TCP Alternate Checksum Data (obsolete)"                                  = 15 ;; supplied: (RFC5777.py#tcp-option-type-values)
        Skeeter                                                                   = 16 ;; supplied: (RFC5777.py#tcp-option-type-values)
        Bubba                                                                     = 17 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Trailer Checksum Option"                                                 = 18 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "MD5 Signature Option (obsoleted by option 29)"                           = 19 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "SCPS Capabilities"                                                       = 20 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Selective Negative Acknowledgements"                                     = 21 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Record Boundaries"                                                       = 22 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Corruption experienced"                                                  = 23 ;; supplied: (RFC5777.py#tcp-option-type-values)
        SNAP                                                                      = 24 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "TCP Compression Filter"                                                  = 26 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Quick-Start Response"                                                    = 27 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "User Timeout Option (also, other known unauthorized use)"                = 28 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "TCP Authentication Option (TCP-AO)"                                      = 29 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Multipath TCP (MPTCP)"                                                   = 30 ;; supplied: (RFC5777.py#tcp-option-type-values)
      ; RESERVED                                                                  = 31-33 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "TCP Fast Open Cookie"                                                    = 34 ;; supplied: (RFC5777.py#tcp-option-type-values)
      ; RESERVED                                                                  = 35-68 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Encryption Negotiation (TCP-ENO)"                                        = 69 ;; supplied: (RFC5777.py#tcp-option-type-values)
      ; RESERVED                                                                  = 70-171 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Accurate ECN Order 0 (AccECN0)"                                          = 172 ;; supplied: (RFC5777.py#tcp-option-type-values)
      ; RESERVED                                                                  = 173 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "Accurate ECN Order 1 (AccECN1)"                                          = 174 ;; supplied: (RFC5777.py#tcp-option-type-values)
      ; RESERVED                                                                  = 175-252 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "RFC3692-style Experiment 1 (also improperly used for shipping products)" = 253 ;; supplied: (RFC5777.py#tcp-option-type-values)
        "RFC3692-style Experiment 2 (also improperly used for shipping products)" = 254 ;; supplied: (RFC5777.py#tcp-option-type-values)


; Type: Grouped AVP
; Name: TCP-Flags
; Section: 4.1.8.9
; Page: 17
TCP-Flags ::= < AVP header: 543 >
        { TCP-Flag-Type }
        [ Negated ]
      * [ AVP ]


; Type: Grouped AVP
; Name: ICMP-Type
; Section: 4.1.8.11
; Page: 18
ICMP-Type ::= < AVP header: 545 >
        { ICMP-Type-Number }
      * [ ICMP-Code ]
        [ Negated ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: ICMP-Type-Number
; Section: 4.1.8.12
; Page: 18
; Values: IANA under the ICMP Type Numbers registry as defined in [RFC2780]
ICMP-Type-Number ::= < Enumerated AVP header: 546 >
        "Echo Reply"                                                                = 0 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Destination Unreachable"                                                   = 3 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Source Quench (Deprecated)"                                                = 4 ;; supplied: (RFC5777.py#icmp-type-number-values)
        Redirect                                                                    = 5 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Alternate Host Address (Deprecated)"                                       = 6 ;; supplied: (RFC5777.py#icmp-type-number-values)
        Echo                                                                        = 8 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Router Advertisement"                                                      = 9 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Router Solicitation"                                                       = 10 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Time Exceeded"                                                             = 11 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Parameter Problem"                                                         = 12 ;; supplied: (RFC5777.py#icmp-type-number-values)
        Timestamp                                                                   = 13 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Timestamp Reply"                                                           = 14 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Information Request (Deprecated)"                                          = 15 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Information Reply (Deprecated)"                                            = 16 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Address Mask Request (Deprecated)"                                         = 17 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Address Mask Reply (Deprecated)"                                           = 18 ;; supplied: (RFC5777.py#icmp-type-number-values)
      ; RESERVED                                                                    = 19-29 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Traceroute (Deprecated)"                                                   = 30 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Datagram Conversion Error (Deprecated)"                                    = 31 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Mobile Host Redirect (Deprecated)"                                         = 32 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "IPv6 Where-Are-You (Deprecated)"                                           = 33 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "IPv6 I-Am-Here (Deprecated)"                                               = 34 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Mobile Registration Request (Deprecated)"                                  = 35 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Mobile Registration Reply (Deprecated)"                                    = 36 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Domain Name Request (Deprecated)"                                          = 37 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Domain Name Reply (Deprecated)"                                            = 38 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "SKIP (Deprecated)"                                                         = 39 ;; supplied: (RFC5777.py#icmp-type-number-values)
        Photuris                                                                    = 40 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "ICMP messages utilized by experimental mobility protocols such as Seamoby" = 41 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Extended Echo Request"                                                     = 42 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "Extended Echo Reply"                                                       = 43 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "RFC3692-style Experiment 1"                                                = 253 ;; supplied: (RFC5777.py#icmp-type-number-values)
        "RFC3692-style Experiment 2"                                                = 254 ;; supplied: (RFC5777.py#icmp-type-number-values)
      ; RESERVED                                                                    = 255 ;; supplied: (RFC5777.py#icmp-type-number-values)


; Type: Enumerated AVP
; Name: ICMP-Code
; Section: 4.1.8.13
; Page: 19
; Values: IANA under the ICMP Type Numbers registry as defined in [RFC2780]
ICMP-Code ::= < Enumerated AVP header: 547 >


; Type: Grouped AVP
; Name: ETH-Option
; Section: 4.1.8.14
; Page: 19
ETH-Option ::= < AVP header: 548 >
        { ETH-Proto-Type }
      * [ VLAN-ID-Range ]
      * [ User-Priority-Range ]
      * [ AVP ]


; Type: Grouped AVP
; Name: ETH-Proto-Type
; Section: 4.1.8.15
; Page: 19
ETH-Proto-Type ::= < AVP header: 549 >
      * [ ETH-Ether-Type ]
      * [ ETH-SAP ]
      * [ AVP ]


; Type: Grouped AVP
; Name: VLAN-ID-Range
; Section: 4.1.8.18
; Page: 20
VLAN-ID-Range ::= < AVP header: 552 >
        [ S-VID-Start ]
        [ S-VID-End ]
        [ C-VID-Start ]
        [ C-VID-End ]
      * [ AVP ]


; Type: Grouped AVP
; Name: User-Priority-Range
; Section: 4.1.8.23
; Page: 22
User-Priority-Range ::= < AVP header: 557 >
      * [ Low-User-Priority ]
      * [ High-User-Priority ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Time-Of-Day-Condition
; Section: 4.2.1
; Page: 22
Time-Of-Day-Condition ::= < AVP header: 560 >
        [ Time-Of-Day-Start ]
        [ Time-Of-Day-End ]
        [ Day-Of-Week-Mask ]
        [ Day-Of-Month-Mask ]
        [ Month-Of-Year-Mask ]
        [ Absolute-Start-Time ]
        [ Absolute-Start-Fractional-Seconds ] ;; inserted: (RFC5777.py#time-of-day-condition-absolute-start-fractional-seconds)
        [ Absolute-End-Time ]
        [ Absolute-End-Fractional-Seconds ] ;; inserted: (RFC5777.py#time-of-day-condition-absolute-end-fractional-seconds)
        [ Timezone-Flag ]
        [ Timezone-Offset ] ;; inserted: (RFC5777.py#time-of-day-condition-timezone-offset)
      * [ AVP ]


; Type: Enumerated AVP
; Name: Timezone-Flag
; Section: 4.2.11
; Page: 25
Timezone-Flag ::= < Enumerated AVP header: 570 >
        UTC    = 0
        LOCAL  = 1
        OFFSET = 2


; Type: Grouped AVP
; Name: QoS-Profile-Template
; Section: 5.3
; Page: 27
QoS-Profile-Template ::= < AVP header: 574 >
        { Vendor-Id }
        { QoS-Profile-Id }
      * [ AVP ]


; Type: Enumerated AVP
; Name: QoS-Semantics
; Section: 5.4
; Page: 28
QoS-Semantics ::= < Enumerated AVP header: 575 >
        QoS-Desired    = 0
        QoS-Available  = 1
        QoS-Delivered  = 2
        Minimum-QoS    = 3
        QoS-Authorized = 4


; Type: Grouped AVP
; Name: QoS-Parameters
; Section: 5.5
; Page: 29
QoS-Parameters ::= < AVP header: 576 >
      * [ AVP ]


; Type: Grouped AVP
; Name: Excess-Treatment
; Section: 5.6
; Page: 29
Excess-Treatment ::= < AVP header: 577 >
        { Treatment-Action }
        [ QoS-Profile-Template ]
        [ QoS-Parameters ]
      * [ AVP ]
