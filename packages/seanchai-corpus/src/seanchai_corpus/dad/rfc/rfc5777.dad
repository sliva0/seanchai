; Type: Grouped AVP
; Name: MAC-Address-Mask
; Section: 4.1.7.9
; Page: 13
MAC-Address-Mask ::= < AVP header: 525 >
        { MAC-Address }
        { MAC-Address-Mask-Pattern }
