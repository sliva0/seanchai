; Type: Grouped AVP
; Name: QoS-Resources
; Section: 3.1
; Page: 5
QoS-Resources ::= < AVP header: 508 >
     1* { Filter-Rule }
      * [ AVP ]


; Type: Grouped AVP
; Name: Filter-Rule
; Section: 3.2
; Page: 5
Filter-Rule ::= < AVP header: 509 >
        [ Filter-Rule-Precedence ]
        [ Classifier ]
      * [ Time-Of-Day-Condition ]
        [ Treatment-Action ]
        [ QoS-Semantics ]
        [ QoS-Profile-Template ]
        [ QoS-Parameters ]
        [ Excess-Treatment ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Classifier
; Section: 4.1.1
; Page: 8
