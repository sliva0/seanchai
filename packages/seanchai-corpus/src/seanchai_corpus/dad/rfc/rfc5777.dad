; Type: Enumerated AVP
; Name: Direction
; Section: 4.1.4
; Page: 9
Direction ::= < Enumerated AVP header: 514 >
        IN   = 0
        OUT  = 1
        BOTH = 2


; Type: Grouped AVP
; Name: From-Spec
; Section: 4.1.5
; Page: 9
From-Spec ::= < AVP header: 515 >
      * [ IP-Address ]
      * [ IP-Address-Range ]
      * [ IP-Address-Mask ]
      * [ MAC-Address ]
      * [ MAC-Address-Mask ]
      * [ EUI64-Address ]
      * [ EUI64-Address-Mask ]
      * [ Port ]
      * [ Port-Range ]
        [ Negated ]
        [ Use-Assigned-Address ]
      * [ AVP ]


; Type: Grouped AVP
; Name: To-Spec
; Section: 4.1.6
; Page: 10
To-Spec ::= < AVP header: 516 >
      * [ IP-Address ]
      * [ IP-Address-Range ]
      * [ IP-Address-Mask ]
      * [ MAC-Address ]
      * [ MAC-Address-Mask ]
      * [ EUI64-Address ]
      * [ EUI64-Address-Mask ]
      * [ Port ]
      * [ Port-Range ]
        [ Negated ]
        [ Use-Assigned-Address ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Negated
; Section: 4.1.7.1
; Page: 11
Negated ::= < Enumerated AVP header: 517 >
        False = 0
        True  = 1


; Type: Grouped AVP
; Name: IP-Address-Range
; Section: 4.1.7.3
; Page: 12
IP-Address-Range ::= < AVP header: 519 >
        [ IP-Address-Start ]
        [ IP-Address-End ]
      * [ AVP ]


; Type: Grouped AVP
; Name: IP-Address-Mask
; Section: 4.1.7.6
; Page: 13
IP-Address-Mask ::= < AVP header: 522 >
        { IP-Address }
        { IP-Mask-Bit-Mask-Width } ;; corrected: (RFC5777.py#ip-mask-bit-mask-width-name)
