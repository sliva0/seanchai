Accounting-Auth-Method ::= < Enumerated AVP header: 406 >
        PAP       = 1 ;; supplied: (RFC7155.py#accounting-auth-method-values)
        CHAP      = 2 ;; supplied: (RFC7155.py#accounting-auth-method-values)
        MS-CHAP-1 = 3 ;; supplied: (RFC7155.py#accounting-auth-method-values)
        MS-CHAP-2 = 4 ;; supplied: (RFC7155.py#accounting-auth-method-values)
        EAP       = 5 ;; supplied: (RFC7155.py#accounting-auth-method-values)
