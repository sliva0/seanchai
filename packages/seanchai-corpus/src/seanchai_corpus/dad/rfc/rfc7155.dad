; Values: [RADIUSAttrVals]
Prompt ::= < Enumerated AVP header: 76 >
        "No Echo" = 0 ;; supplied: (RFC7155.py#prompt-values)
        Echo      = 1 ;; supplied: (RFC7155.py#prompt-values)


; Type: Grouped AVP
; Name: CHAP-Auth
; Section: 4.3.4
; Page: 29
CHAP-Auth ::= < AVP header: 402 >
        { CHAP-Algorithm }
        { CHAP-Ident }
        [ CHAP-Response ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: CHAP-Algorithm
; Section: 4.3.5
; Page: 30
CHAP-Algorithm ::= < Enumerated AVP header: 403 >
        "CHAP with MD5" = 5


; Type: Enumerated AVP
; Name: Service-Type
; Section: 4.4.1
; Page: 33
; Values: [RFC2865] and the relevant IANA registry [RADIUSAttrVals]
Service-Type ::= < Enumerated AVP header: 6 >
        Login                     = 1
        Framed                    = 2
        "Callback Login"          = 3
        "Callback Framed"         = 4
        Outbound                  = 5 ;; supplied: (RFC7155.py#service-type-values)
        Administrative            = 6 ;; supplied: (RFC7155.py#service-type-values)
        "NAS Prompt"              = 7 ;; supplied: (RFC7155.py#service-type-values)
        "Authenticate Only"       = 8 ;; supplied: (RFC7155.py#service-type-values)
        "Callback NAS Prompt"     = 9 ;; supplied: (RFC7155.py#service-type-values)
        "Call Check"              = 10 ;; supplied: (RFC7155.py#service-type-values)
        "Callback Administrative" = 11 ;; supplied: (RFC7155.py#service-type-values)
        Voice                     = 12 ;; supplied: (RFC7155.py#service-type-values)
        Fax                       = 13 ;; supplied: (RFC7155.py#service-type-values)
        "Modem Relay"             = 14 ;; supplied: (RFC7155.py#service-type-values)
        IAPP-Register             = 15 ;; supplied: (RFC7155.py#service-type-values)
        IAPP-AP-Check             = 16 ;; supplied: (RFC7155.py#service-type-values)
        "Authorize Only"          = 17 ;; supplied: (RFC7155.py#service-type-values)
        Framed-Management         = 18 ;; supplied: (RFC7155.py#service-type-values)
        Additional-Authorization  = 19 ;; supplied: (RFC7155.py#service-type-values)


; Type: Enumerated AVP
; Name: Framed-Protocol
; Section: 4.4.10.1
; Page: 36
; Values: [RADIUSAttrVals]
Framed-Protocol ::= < Enumerated AVP header: 7 >
        PPP                                                 = 1 ;; supplied: (RFC7155.py#framed-protocol-values)
        SLIP                                                = 2 ;; supplied: (RFC7155.py#framed-protocol-values)
        "AppleTalk Remote Access Protocol (ARAP)"           = 3 ;; supplied: (RFC7155.py#framed-protocol-values)
        "Gandalf proprietary SingleLink/MultiLink protocol" = 4 ;; supplied: (RFC7155.py#framed-protocol-values)
        "Xylogics proprietary IPX/SLIP"                     = 5 ;; supplied: (RFC7155.py#framed-protocol-values)
        "X.75 Synchronous"                                  = 6 ;; supplied: (RFC7155.py#framed-protocol-values)
        "GPRS PDP Context"                                  = 7 ;; supplied: (RFC7155.py#framed-protocol-values)


; Type: Enumerated AVP
; Name: Framed-Routing
; Section: 4.4.10.2
; Page: 36
; Values: [RADIUSAttrVals]
Framed-Routing ::= < Enumerated AVP header: 10 >
        None                         = 0 ;; supplied: (RFC7155.py#framed-routing-values)
        "Send routing packets"       = 1 ;; supplied: (RFC7155.py#framed-routing-values)
        "Listen for routing packets" = 2 ;; supplied: (RFC7155.py#framed-routing-values)
        "Send and Listen"            = 3 ;; supplied: (RFC7155.py#framed-routing-values)


; Type: Enumerated AVP
; Name: Framed-Compression
; Section: 4.4.10.4
; Page: 37
; Values: [RADIUSAttrVals]
Framed-Compression ::= < Enumerated AVP header: 13 >
        None                           = 0 ;; supplied: (RFC7155.py#framed-compression-values)
        "VJ TCP/IP header compression" = 1 ;; supplied: (RFC7155.py#framed-compression-values)
        "IPX header compression"       = 2 ;; supplied: (RFC7155.py#framed-compression-values)
        "Stac-LZS compression"         = 3 ;; supplied: (RFC7155.py#framed-compression-values)


; Type: Enumerated AVP
; Name: ARAP-Zone-Access
; Section: 4.4.10.8.2
; Page: 41
; Values: [RADIUSAttrVals] and defined in [RFC2869]
ARAP-Zone-Access ::= < Enumerated AVP header: 72 >
        "Only allow access to default zone" = 1 ;; supplied: (RFC7155.py#arap-zone-access-values)
        "Use zone filter inclusively"       = 2 ;; supplied: (RFC7155.py#arap-zone-access-values)
        "Not used"                          = 3 ;; supplied: (RFC7155.py#arap-zone-access-values)
        "Use zone filter exclusively"       = 4 ;; supplied: (RFC7155.py#arap-zone-access-values)


; Type: Enumerated AVP
; Name: Login-Service
; Section: 4.4.11.3
; Page: 42
; Values: RFC 2869
Login-Service ::= < Enumerated AVP header: 15 >
        Telnet                                                          = 0 ;; supplied: (RFC7155.py#login-service-values)
        Rlogin                                                          = 1 ;; supplied: (RFC7155.py#login-service-values)
        "TCP Clear"                                                     = 2 ;; supplied: (RFC7155.py#login-service-values)
        "PortMaster (proprietary)"                                      = 3 ;; supplied: (RFC7155.py#login-service-values)
        LAT                                                             = 4 ;; supplied: (RFC7155.py#login-service-values)
        X25-PAD                                                         = 5 ;; supplied: (RFC7155.py#login-service-values)
        X25-T3POS                                                       = 6 ;; supplied: (RFC7155.py#login-service-values)
        "TCP Clear Quiet (suppresses any NAS-generated connect string)" = 8 ;; supplied: (RFC7155.py#login-service-values)


; Type: Grouped AVP
; Name: Tunneling
; Section: 4.5.1
; Page: 45
Tunneling ::= < AVP header: 401 >
        { Tunnel-Type }
        { Tunnel-Medium-Type }
        { Tunnel-Client-Endpoint }
        { Tunnel-Server-Endpoint }
        [ Tunnel-Preference ]
        [ Tunnel-Client-Auth-Id ]
        [ Tunnel-Server-Auth-Id ]
        [ Tunnel-Assignment-Id ]
        [ Tunnel-Password ]
        [ Tunnel-Private-Group-Id ]


; Type: Enumerated AVP
; Name: Tunnel-Type
; Section: 4.5.2
; Page: 46
; Values: [RADIUSAttrVals]
Tunnel-Type ::= < Enumerated AVP header: 64 >
        "Point-to-Point Tunneling Protocol (PPTP)"                   = 1 ;; supplied: (RFC7155.py#tunnel-type-values)
        "Layer Two Forwarding (L2F)"                                 = 2 ;; supplied: (RFC7155.py#tunnel-type-values)
        "Layer Two Tunneling Protocol (L2TP)"                        = 3 ;; supplied: (RFC7155.py#tunnel-type-values)
        "Ascend Tunnel Management Protocol (ATMP)"                   = 4 ;; supplied: (RFC7155.py#tunnel-type-values)
        "Virtual Tunneling Protocol (VTP)"                           = 5 ;; supplied: (RFC7155.py#tunnel-type-values)
        "IP Authentication Header in the Tunnel-mode (AH)"           = 6 ;; supplied: (RFC7155.py#tunnel-type-values)
        "IP-in-IP Encapsulation (IP-IP)"                             = 7 ;; supplied: (RFC7155.py#tunnel-type-values)
        "Minimal IP-in-IP Encapsulation (MIN-IP-IP)"                 = 8 ;; supplied: (RFC7155.py#tunnel-type-values)
        "IP Encapsulating Security Payload in the Tunnel-mode (ESP)" = 9 ;; supplied: (RFC7155.py#tunnel-type-values)
        "Generic Route Encapsulation (GRE)"                          = 10 ;; supplied: (RFC7155.py#tunnel-type-values)
        "Bay Dial Virtual Services (DVS)"                            = 11 ;; supplied: (RFC7155.py#tunnel-type-values)
        "IP-in-IP Tunneling"                                         = 12 ;; supplied: (RFC7155.py#tunnel-type-values)
        "Virtual LANs (VLAN)"                                        = 13 ;; supplied: (RFC7155.py#tunnel-type-values)


; Type: Enumerated AVP
; Name: Tunnel-Medium-Type
; Section: 4.5.3
; Page: 46
; Values: [RADIUSAttrVals]
Tunnel-Medium-Type ::= < Enumerated AVP header: 65 >
        "IPv4 (IP version 4)"                                             = 1 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        "IPv6 (IP version 6)"                                             = 2 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        NSAP                                                              = 3 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        "HDLC (8-bit multidrop)"                                          = 4 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        "BBN 1822"                                                        = 5 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        "802 (includes all 802 media plus Ethernet \"canonical format\")" = 6 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        "E.163 (POTS)"                                                    = 7 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        "E.164 (SMDS, Frame Relay, ATM)"                                  = 8 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        "F.69 (Telex)"                                                    = 9 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        "X.121 (X.25, Frame Relay)"                                       = 10 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        IPX                                                               = 11 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        Appletalk                                                         = 12 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        "Decnet IV"                                                       = 13 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        "Banyan Vines"                                                    = 14 ;; supplied: (RFC7155.py#tunnel-medium-type-values)
        "E.164 with NSAP format subaddress"                               = 15 ;; supplied: (RFC7155.py#tunnel-medium-type-values)


; Type: Enumerated AVP
; Name: Acct-Authentic
; Section: 4.6.6
; Page: 53
; Values: [RADIUSAttrVals]
Acct-Authentic ::= < Enumerated AVP header: 45 >
        RADIUS   = 1 ;; supplied: (RFC7155.py#acct-authentic-values)
        Local    = 2 ;; supplied: (RFC7155.py#acct-authentic-values)
        Remote   = 3 ;; supplied: (RFC7155.py#acct-authentic-values)
        Diameter = 4 ;; supplied: (RFC7155.py#acct-authentic-values)


; Type: Enumerated AVP
; Name: Accounting-Auth-Method
; Section: 4.6.7
; Page: 53
