    absent


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#aar-class-table-absent)
; AVP: Class
; Command: AA-Request
; Section: 10.1
; Page: 71
"0 The AVP MUST NOT be present in the message."
"Class | 0 | 0+ |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#aar-configuration-token-table-absent)
; AVP: Configuration-Token
; Command: AA-Request
; Section: 10.1
; Page: 71
"0 The AVP MUST NOT be present in the message."
"Configuration-Token | 0 | 0+ |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#aar-error-message-table-absent)
; AVP: Error-Message
; Command: AA-Request
; Section: 10.1
