        Token-Ring                                                          = 20
        FDDI                                                                = 21
        "Wireless - CDMA2000"                                               = 22
        "Wireless - UMTS"                                                   = 23
        "Wireless - 1X-EV"                                                  = 24
        IAPP                                                                = 25
        "FTTP - Fiber to the Premises"                                      = 26 ;; supplied: (RFC4005.py#nas-port-type-values)
        "Wireless - IEEE 802.16"                                            = 27 ;; supplied: (RFC4005.py#nas-port-type-values)
        "Wireless - IEEE 802.20"                                            = 28 ;; supplied: (RFC4005.py#nas-port-type-values)
        "Wireless - IEEE 802.22"                                            = 29 ;; supplied: (RFC4005.py#nas-port-type-values)
        "PPPoA - PPP over ATM"                                              = 30 ;; supplied: (RFC4005.py#nas-port-type-values)
        "PPPoEoA - PPP over Ethernet over ATM"                              = 31 ;; supplied: (RFC4005.py#nas-port-type-values)
        "PPPoEoE - PPP over Ethernet over Ethernet"                         = 32 ;; supplied: (RFC4005.py#nas-port-type-values)
        "PPPoEoVLAN - PPP over Ethernet over VLAN"                          = 33 ;; supplied: (RFC4005.py#nas-port-type-values)
        "PPPoEoQinQ - PPP over Ethernet over IEEE 802.1QinQ"                = 34 ;; supplied: (RFC4005.py#nas-port-type-values)
        "xPON - Passive Optical Network"                                    = 35 ;; supplied: (RFC4005.py#nas-port-type-values)
        "Wireless - XGP"                                                    = 36 ;; supplied: (RFC4005.py#nas-port-type-values)
        "WiMAX Pre-Release 8 IWK Function"                                  = 37 ;; supplied: (RFC4005.py#nas-port-type-values)
        "WIMAX-WIFI-IWK: WiMAX WIFI Interworking"                           = 38 ;; supplied: (RFC4005.py#nas-port-type-values)
        "WIMAX-SFF: Signaling Forwarding Function for LTE/3GPP2"            = 39 ;; supplied: (RFC4005.py#nas-port-type-values)
        "WIMAX-HA-LMA: WiMAX HA and or LMA function"                        = 40 ;; supplied: (RFC4005.py#nas-port-type-values)
        "WIMAX-DHCP: WIMAX DCHP service"                                    = 41 ;; supplied: (RFC4005.py#nas-port-type-values)
        "WIMAX-LBS: WiMAX location based service"                           = 42 ;; supplied: (RFC4005.py#nas-port-type-values)
        "WIMAX-WVS: WiMAX voice service"                                    = 43 ;; supplied: (RFC4005.py#nas-port-type-values)


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#originating-line-info-octets)
; AVP: Originating-Line-Info
; Section: 4.8
; Page: 24
"The Value field contains two octets (00 - 99)."
    length 2 octets


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#user-password-length)
; AVP: User-Password
; Section: 5.1
; Page: 26
"The clear-text password (prior to encryption) MUST NOT be longer than 128 bytes in length."
    length *..128 octets


; Type: Enumerated AVP
; Name: Prompt
; Section: 5.3
; Page: 27
; Values: [RADIUSTypes]
Prompt ::= < Enumerated AVP header: 76 >
        "No Echo" = 0
        Echo      = 1


; Type: Grouped AVP
; Name: CHAP-Auth
; Section: 5.4
; Page: 27
CHAP-Auth ::= < AVP header: 402 >
        { CHAP-Algorithm }
        { CHAP-Ident }
        [ CHAP-Response ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#aar-chap-auth-with-challenge)
; AVP: CHAP-Auth
; Command: AA-Request
; Section: 5.4
; Page: 27
"If the CHAP-Auth AVP is found in a message, the CHAP-Challenge AVP MUST be present as well."
    requires CHAP-Challenge


; Type: Enumerated AVP
; Name: CHAP-Algorithm
; Section: 5.5
; Page: 28
CHAP-Algorithm ::= < Enumerated AVP header: 403 >
        "CHAP with MD5" = 5


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#chap-auth-md5-response)
; AVP: CHAP-Response
; Within: CHAP-Auth
; Section: 5.5
; Page: 28
"This algorithm requires that the CHAP-Response AVP MUST be present in the CHAP-Auth AVP."
    present-if CHAP-Algorithm = "CHAP with MD5"


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#chap-ident-octet)
; AVP: CHAP-Ident
; Section: 5.6
; Page: 28
"The CHAP-Ident AVP (AVP Code 404) is of type OctetString and contains the 1 octet CHAP Identifier used in the computation of the CHAP response [PPPCHAP]."
    length 1 octets


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#chap-response-octets)
; AVP: CHAP-Response
; Section: 5.7
; Page: 28
"The CHAP-Response AVP (AVP Code 405) is of type OctetString and contains the 16 octet authentication data provided by the user in response to the CHAP challenge [PPPCHAP]."
    length 16 octets


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#aar-arap-password-without-other-passwords)
; AVP: ARAP-Password
; Command: AA-Request
; Section: 5.9
; Page: 28
"This AVP MUST NOT be present if either the User-Password or the CHAP-Auth AVP is present."
    excludes User-Password or CHAP-Auth


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#arap-challenge-response-octets)
; AVP: ARAP-Challenge-Response
; Section: 5.10
; Page: 28
"This AVP contains an 8 octet response to the dial-in client's challenge."
    length 8 octets


; Type: Enumerated AVP
; Name: Service-Type
; Section: 6.1
; Page: 30
; Values: [RADIUS] and [RADIUSTypes]
Service-Type ::= < Enumerated AVP header: 6 >
        Login                     = 1
        Framed                    = 2
        "Callback Login"          = 3
        "Callback Framed"         = 4
        Outbound                  = 5
        Administrative            = 6
        "NAS Prompt"              = 7
        "Authenticate Only"       = 8
        "Callback NAS Prompt"     = 9
        "Call Check"              = 10
        "Callback Administrative" = 11
        Voice                     = 12
        Fax                       = 13
        "Modem Relay"             = 14
        IAPP-Register             = 15
        IAPP-AP-Check             = 16
        "Authorize Only"          = 17
        Framed-Management         = 18 ;; supplied: (RFC4005.py#service-type-values)
        Additional-Authorization  = 19 ;; supplied: (RFC4005.py#service-type-values)


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#qos-filter-rule-format)
; AVP: QoS-Filter-Rule
; Section: 6.9
; Page: 33
"QoSFilterRule filters MUST follow the following format:"
    text-only


; Type: Enumerated AVP
; Name: Framed-Protocol
; Section: 6.10.1
; Page: 35
; Values: [RADIUSTypes]
Framed-Protocol ::= < Enumerated AVP header: 7 >
        PPP                                                 = 1
        SLIP                                                = 2
        "AppleTalk Remote Access Protocol (ARAP)"           = 3
        "Gandalf proprietary SingleLink/MultiLink protocol" = 4
        "Xylogics proprietary IPX/SLIP"                     = 5
        "X.75 Synchronous"                                  = 6
        "GPRS PDP Context"                                  = 7 ;; supplied: (RFC4005.py#framed-protocol-values)


; Type: Enumerated AVP
; Name: Framed-Routing
; Section: 6.10.2
; Page: 35
; Values: [RADIUSTypes]
Framed-Routing ::= < Enumerated AVP header: 10 >
        None                         = 0
        "Send routing packets"       = 1
        "Listen for routing packets" = 2
        "Send and Listen"            = 3


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#framed-mtu-range)
; AVP: Framed-MTU
; Section: 6.10.3
; Page: 35
"The MTU value MUST be in the range from 64 to 65535."
    range 64..65535


; Type: Enumerated AVP
; Name: Framed-Compression
; Section: 6.10.4
; Page: 36
; Values: [RADIUSTypes]
Framed-Compression ::= < Enumerated AVP header: 13 >
        None                           = 0
        "VJ TCP/IP header compression" = 1
        "IPX header compression"       = 2
        "Stac-LZS compression"         = 3


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#framed-ip-address-octets)
; AVP: Framed-IP-Address
; Section: 6.11.1
; Page: 36
"The Framed-IP-Address AVP (AVP Code 8) [RADIUS] is of type OctetString and contains an IPv4 address of the type specified in the attribute value to be configured for the user."
    length 4 octets


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#framed-ip-netmask-octets)
; AVP: Framed-IP-Netmask
; Section: 6.11.2
; Page: 36
"The Framed-IP-Netmask AVP (AVP Code 9) is of type OctetString and contains the four octets of the IPv4 netmask to be configured for the user when the user is a router to a network."
    length 4 octets


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#aaa-framed-ip-netmask-after-all-ones)
; AVP: Framed-IP-Netmask
; Command: AA-Answer
; Section: 6.11.2
; Page: 36
"This AVP MUST be present in a response if the request included this AVP with a value of 0xFFFFFFFF."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#framed-route-text)
; AVP: Framed-Route
; Section: 6.11.3
; Page: 37
"The string MUST contain a destination prefix in dotted quad form optionally followed by a slash and a decimal length specifier stating how many high-order bits of the prefix should be used."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#framed-ipv6-route-text)
; AVP: Framed-IPv6-Route
; Section: 6.11.7
; Page: 38
"The string MUST contain an IPv6 address prefix followed by a slash and a decimal length specifier stating how many high order bits of the prefix should be used."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#framed-appletalk-link-range)
; AVP: Framed-AppleTalk-Link
; Section: 6.13.1
; Page: 39
"Despite the size of the field, values range from 0 to 65,535."
    range 0..65535


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#framed-appletalk-network-range)
; AVP: Framed-AppleTalk-Network
; Section: 6.13.2
; Page: 39
"Despite the size of the field, values range from 0 to 65,535."
    range 0..65535


; Type: Enumerated AVP
; Name: ARAP-Zone-Access
; Section: 6.14.2
; Page: 40
; Values: [RADIUSTypes] and defined in [RADIUSExt]
ARAP-Zone-Access ::= < Enumerated AVP header: 72 >
        "Only allow access to default zone" = 1 ;; supplied: (RFC4005.py#arap-zone-access-values)
        "Use zone filter inclusively"       = 2 ;; supplied: (RFC4005.py#arap-zone-access-values)
        "Not used"                          = 3 ;; supplied: (RFC4005.py#arap-zone-access-values)
        "Use zone filter exclusively"       = 4 ;; supplied: (RFC4005.py#arap-zone-access-values)


; Type: Enumerated AVP
; Name: Login-Service
; Section: 6.15.3
; Page: 41
; Values: [RADIUSTypes]
Login-Service ::= < Enumerated AVP header: 15 >
        Telnet                                                          = 0
        Rlogin                                                          = 1
        "TCP Clear"                                                     = 2
        "PortMaster (proprietary)"                                      = 3
        LAT                                                             = 4
        X25-PAD                                                         = 5
        X25-T3POS                                                       = 6
        "TCP Clear Quiet (suppresses any NAS-generated connect string)" = 8


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#login-tcp-port-range)
; AVP: Login-TCP-Port
; Section: 6.16.1
; Page: 42
"The value MUST NOT be greater than 65,535."
    range 0..65535


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#aaa-login-lat-service-for-lat)
; AVP: Login-LAT-Service
; Command: AA-Answer
; Section: 6.17.1
; Page: 42
"This AVP MUST only be present in the response if the Login-Service AVP states that LAT is desired."
    requires Login-Service = LAT


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#aaa-login-lat-node-for-lat)
; AVP: Login-LAT-Node
; Command: AA-Answer
; Section: 6.17.2
; Page: 43
"This AVP MUST only be present in a response if the Login-Service-Type AVP is set to LAT."
    requires Login-Service = LAT


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#aaa-login-lat-group-for-lat)
; AVP: Login-LAT-Group
; Command: AA-Answer
; Section: 6.17.3
; Page: 43
"This AVP MUST only be present in a response if the Login-Service-Type AVP is set to LAT."
    requires Login-Service = LAT


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#aaa-login-lat-port-for-lat)
; AVP: Login-LAT-Port
; Command: AA-Answer
; Section: 6.17.4
; Page: 43
"This AVP MUST only be present in a response if the Login-Service-Type AVP is set to LAT."
    requires Login-Service = LAT


; Type: Grouped AVP
; Name: Tunneling
; Section: 7.1
; Page: 44
Tunneling ::= < AVP header: 401 >
        { Tunnel-Type }
        { Tunnel-Medium-Type }
        { Tunnel-Client-Endpoint }
        { Tunnel-Server-Endpoint }
        [ Tunnel-Preference ]
        [ Tunnel-Client-Auth-Id ]
        [ Tunnel-Server-Auth-Id ]
        [ Tunnel-Assignment-Id ]
        [ Tunnel-Password ]
        [ Tunnel-Private-Group-Id ]


; Type: Enumerated AVP
; Name: Tunnel-Type
; Section: 7.2
; Page: 45
; Values: [RADIUSTypes]
Tunnel-Type ::= < Enumerated AVP header: 64 >
        "Point-to-Point Tunneling Protocol (PPTP)"                   = 1
        "Layer Two Forwarding (L2F)"                                 = 2
        "Layer Two Tunneling Protocol (L2TP)"                        = 3
        "Ascend Tunnel Management Protocol (ATMP)"                   = 4
        "Virtual Tunneling Protocol (VTP)"                           = 5
        "IP Authentication Header in the Tunnel-mode (AH)"           = 6
        "IP-in-IP Encapsulation (IP-IP)"                             = 7
        "Minimal IP-in-IP Encapsulation (MIN-IP-IP)"                 = 8
        "IP Encapsulating Security Payload in the Tunnel-mode (ESP)" = 9
        "Generic Route Encapsulation (GRE)"                          = 10
        "Bay Dial Virtual Services (DVS)"                            = 11
        "IP-in-IP Tunneling"                                         = 12
        "Virtual LANs (VLAN)"                                        = 13


; Type: Enumerated AVP
; Name: Tunnel-Medium-Type
; Section: 7.3
; Page: 46
; Values: [RADIUSTypes]
Tunnel-Medium-Type ::= < Enumerated AVP header: 65 >
        "IPv4 (IP version 4)"                                             = 1
        "IPv6 (IP version 6)"                                             = 2
        NSAP                                                              = 3
        "HDLC (8-bit multidrop)"                                          = 4
        "BBN 1822"                                                        = 5
        "802 (includes all 802 media plus Ethernet \"canonical format\")" = 6
        "E.163 (POTS)"                                                    = 7
        "E.164 (SMDS, Frame Relay, ATM)"                                  = 8
        "F.69 (Telex)"                                                    = 9
        "X.121 (X.25, Frame Relay)"                                       = 10
        IPX                                                               = 11
        Appletalk                                                         = 12
        "Decnet IV"                                                       = 13
        "Banyan Vines"                                                    = 14
        "E.164 with NSAP format subaddress"                               = 15


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#tunnel-client-auth-id-other-than-default)
; AVP: Tunnel-Client-Auth-Id
; Within: Tunneling
; Section: 7.10
; Page: 50
"This AVP MUST be present in the authorization response if an authentication name other than the default is desired."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#tunnel-server-auth-id-other-than-default)
; AVP: Tunnel-Server-Auth-Id
; Within: Tunneling
; Section: 7.11
; Page: 50
"This AVP MUST be present in the authorization response if an authentication name other than the default is desired."
    text-only


; Type: Enumerated AVP
; Name: Acct-Authentic
; Section: 8.6
; Page: 52
; Values: [RADIUSTypes]
Acct-Authentic ::= < Enumerated AVP header: 45 >
        RADIUS   = 1
        Local    = 2
        Remote   = 3
        Diameter = 4


; Type: Enumerated AVP
; Name: Accounting-Auth-Method
; Section: 8.7
; Page: 53
Accounting-Auth-Method ::= < Enumerated AVP header: 406 >
        PAP       = 1
        CHAP      = 2
        MS-CHAP-1 = 3
        MS-CHAP-2 = 4
        EAP       = 5
        None      = 7


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#aar-state-returned-unmodified)
; AVP: State
; Command: AA-Request
; Section: 9.3.4
; Page: 65
"If so, the NAS MUST return it unmodified in the subsequent AA-Request command."
"If the NAS performs the Termination-Action by sending a new AA-Request command upon termination of the current service, it MUST return the State AVP unmodified in the new request command."
    text-only


; Type: Enumerated AVP
; Name: Termination-Cause
; Section: 9.3.5
; Page: 66
Termination-Cause ::= < Enumerated AVP header: 295 >
        "User Request"             = 11
        "Lost Carrier"             = 12
        "Lost Service"             = 13
        "Idle Timeout"             = 14
        "Session Timeout"          = 15
        "Admin Reset"              = 16
        "Admin Reboot"             = 17
        "Port Error"               = 18
        "NAS Error"                = 19
        "NAS Request"              = 20
        "NAS Reboot"               = 21
        "Port Unneeded"            = 22
        "Port Preempted"           = 23
        "Port Suspended"           = 24
        "Service Unavailable"      = 25
        Callback                   = 26
        "User Error"               = 27
        "Host Request"             = 28
        "Supplicant Restart"       = 29
        "Reauthentication Failure" = 30
        "Port Reinit"              = 31
        "Port Disabled"            = 32


; Type: Enumerated AVP
; Name: Origin-AAA-Protocol
; Section: 9.3.6
; Page: 68
Origin-AAA-Protocol ::= < Enumerated AVP header: 408 >
        RADIUS = 1


; Type: Interpreted Constraints ;; interpreted: (RFC4005.dadx#aar-acct-interim-interval-table-absent)
; AVP: Acct-Interim-Interval
; Command: AA-Request
; Section: 10.1
; Page: 71
"0 The AVP MUST NOT be present in the message."
"Acct-Interim-Interval | 0 | 0-1 |"
    absent


