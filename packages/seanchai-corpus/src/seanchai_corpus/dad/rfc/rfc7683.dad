; Specification: RFC 7683
; Vendor-ID: 0
; Bases: RFC6733
; Link: https://www.rfc-editor.org/rfc/rfc7683.txt


; Type: Interpreted Constraints ;; interpreted: (RFC7683.dadx#oc-supported-features-in-requests)
; AVP: OC-Supported-Features
; Section: 5.1.1
; Page: 13
"A reacting node MUST include the OC-Supported-Features AVP in all requests."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC7683.dadx#oc-feature-vector-reacting-node)
; AVP: OC-Feature-Vector
; Within: OC-Supported-Features
; Section: 5.1.1
; Page: 13
"It MAY include the OC-Feature-Vector AVP, as a sub-AVP of OC-Supported-Features. If it does so, it MUST indicate support for the \"loss\" algorithm."
    text-only
"If the reacting node is configured to support features (including other algorithms) in addition to the loss algorithm, it MUST indicate such support in an OC-Feature-Vector AVP."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC7683.dadx#oc-supported-features-in-answers)
; AVP: OC-Supported-Features
; Section: 5.1.2
; Page: 13
"If the request message contains an OC-Supported-Features AVP, then a reporting node MUST include the OC-Supported-Features AVP in the answer message for that transaction."
    text-only
"A reporting node MUST NOT include the OC-Supported-Features AVP, OC-OLR AVP, or any other overload control AVPs defined in extension documents in response messages for transactions where the request message does not include the OC-Supported-Features AVP."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC7683.dadx#oc-olr-without-the-requests-features)
; AVP: OC-OLR
; Section: 5.1.2
; Page: 13
"A reporting node MUST NOT include the OC-Supported-Features AVP, OC-OLR AVP, or any other overload control AVPs defined in extension documents in response messages for transactions where the request message does not include the OC-Supported-Features AVP."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC7683.dadx#oc-feature-vector-reporting-node)
; AVP: OC-Feature-Vector
; Within: OC-Supported-Features
; Section: 5.1.2
; Page: 13
"A reporting node MUST select a single abatement algorithm in the OC-Feature-Vector AVP."
    text-only
"The abatement algorithm selected MUST be from the set of abatement algorithms contained in the request message's OC-Feature-Vector AVP."
    text-only
"If it selects a different algorithm, it MUST include the OC-Feature-Vector AVP with an explicit indication of the selected algorithm."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC7683.dadx#oc-sequence-number-increasing)
; AVP: OC-Sequence-Number
; Section: 5.2.1.4
; Page: 18
"When generating sequence numbers for new overload conditions, the new sequence number MUST be greater than any sequence number in an active (unexpired) overload report for the same application and report type previously sent by the reporting node."
    text-only
"A reporting node MUST increment the sequence number associated with the OCS entry anytime the contents of the OCS entry are changed."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC7683.dadx#oc-report-type-advertised)
; AVP: OC-Report-Type
; Section: 5.2.3
; Page: 20
"A reporting node MUST NOT send overload reports of a type that has not been advertised as supported by the reacting node."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC7683.dadx#oc-olr-loss-reduction-percentage)
; AVP: OC-Reduction-Percentage
; Within: OC-OLR
; Section: 6.2
; Page: 24
"When sending the OC-OLR AVP, the reporting node MUST indicate a percentage reduction in the OC-Reduction-Percentage AVP."
    text-only


; Type: AVP Table
; Section: 7.8
; Page: 28
; Columns: Name           Code   Section   Type         Must   M.not
OC-Supported-Features     621    7.1       Grouped      -      V
OC-Feature-Vector         622    7.2       Unsigned64   -      V
OC-OLR                    623    7.3       Grouped      -      V
OC-Sequence-Number        624    7.4       Unsigned64   -      V
OC-Validity-Duration      625    7.5       Unsigned32   -      V
OC-Report-Type            626    7.6       Enumerated   -      V
OC-Reduction-Percentage   627    7.7       Unsigned32   -      V


; Type: Grouped AVP
; Name: OC-Supported-Features
; Section: 7.1
; Page: 25
OC-Supported-Features ::= < AVP header: 621 >
        [ OC-Feature-Vector ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC7683.dadx#oc-supported-features-doic-node)
; AVP: OC-Supported-Features
; Section: 7.1
; Page: 25
"The OC-Supported-Features AVP MUST be included in every Diameter request message a DOIC supporting node sends."
    text-only


; Type: Value Table
; AVP: OC-Feature-Vector
; Kind: bits
; Section: 7.2
; Page: 25
OLR_DEFAULT_ALGO = 0


; Type: Grouped AVP
; Name: OC-OLR
; Section: 7.3
; Page: 26
OC-OLR ::= < AVP header: 623 >
        < OC-Sequence-Number >
        < OC-Report-Type >
        [ OC-Reduction-Percentage ]
        [ OC-Validity-Duration ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC7683.dadx#oc-validity-duration-default-and-maximum)
; AVP: OC-Validity-Duration
; Section: 7.5
; Page: 26
"The default value for the OC-Validity-Duration AVP is 30 seconds. When the OC-Validity-Duration AVP is not present in the OC-OLR AVP, the default value applies."
    default 30
"The maximum value for the OC-Validity-Duration AVP is 86,400 seconds (24 hours)."
    range 0..86400


; Type: Enumerated AVP
; Name: OC-Report-Type
; Section: 7.6
; Page: 27
OC-Report-Type ::= < Enumerated AVP header: 626 >
        HOST_REPORT  = 0
        REALM_REPORT = 1
        PEER_REPORT  = 2 ;; inserted: (RFC7683.py#peer-report-rfc8581)


; Type: Interpreted Constraints ;; interpreted: (RFC7683.dadx#oc-reduction-percentage-range)
; AVP: OC-Reduction-Percentage
; Section: 7.7
; Page: 27
"The value of the Reduction-Percentage AVP is between zero (0) and one hundred (100)."
    range 0..100
