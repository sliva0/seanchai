; Type: Grouped AVP
; Name: SIP-Accounting-Information
; Section: 9.1
; Page: 46
SIP-Accounting-Information ::= < AVP header: 368 >
      * [ SIP-Accounting-Server-URI ]
      * [ SIP-Credit-Control-Server-URI ]
      * [ AVP ]


; Type: Grouped AVP
; Name: SIP-Server-Capabilities
; Section: 9.3
; Page: 47
SIP-Server-Capabilities ::= < AVP header: 372 >
      * [ SIP-Mandatory-Capability ]
      * [ SIP-Optional-Capability ]
      * [ SIP-Server-URI ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: SIP-Server-Assignment-Type
; Section: 9.4
; Page: 48
SIP-Server-Assignment-Type ::= < Enumerated AVP header: 375 >
        NO_ASSIGNMENT                            = 0
        REGISTRATION                             = 1
        RE_REGISTRATION                          = 2
        UNREGISTERED_USER                        = 3
        TIMEOUT_DEREGISTRATION                   = 4
        USER_DEREGISTRATION                      = 5
        TIMEOUT_DEREGISTRATION_STORE_SERVER_NAME = 6
        USER_DEREGISTRATION_STORE_SERVER_NAME    = 7
        ADMINISTRATIVE_DEREGISTRATION            = 8
        AUTHENTICATION_FAILURE                   = 9
        AUTHENTICATION_TIMEOUT                   = 10
        DEREGISTRATION_TOO_MUCH_DATA             = 11


; Type: Grouped AVP
; Name: SIP-Auth-Data-Item
; Section: 9.5
; Page: 50
SIP-Auth-Data-Item ::= < AVP header: 376 >
        { SIP-Authentication-Scheme }
        [ SIP-Item-Number ]
        [ SIP-Authenticate ]
        [ SIP-Authorization ]
        [ SIP-Authentication-Info ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: SIP-Authentication-Scheme
; Section: 9.5.1
; Page: 50
SIP-Authentication-Scheme ::= < Enumerated AVP header: 377 >
        DIGEST = 0


; Type: Grouped AVP
; Name: SIP-Authenticate
; Section: 9.5.3
; Page: 51
SIP-Authenticate ::= < AVP header: 379 >
        { Digest-Realm }
        { Digest-Nonce }
        [ Digest-Domain ]
        [ Digest-Opaque ]
        [ Digest-Stale ]
        [ Digest-Algorithm ]
        [ Digest-Qop ] ;; corrected: (RFC4740.py#digest-qop-case-sip-authenticate)
        [ Digest-HA1 ]
      * [ Digest-Auth-Param ]
      * [ AVP ]


; Type: Grouped AVP
; Name: SIP-Authorization
; Section: 9.5.4
; Page: 52
SIP-Authorization ::= < AVP header: 380 >
        { Digest-Username }
        { Digest-Realm }
        { Digest-Nonce }
        { Digest-URI }
        { Digest-Response }
        [ Digest-Algorithm ]
        [ Digest-CNonce ]
        [ Digest-Opaque ]
        [ Digest-Qop ] ;; corrected: (RFC4740.py#digest-qop-case-sip-authorization)
        [ Digest-Nonce-Count ]
        [ Digest-Method ]
        [ Digest-Entity-Body-Hash ]
      * [ Digest-Auth-Param ]
      * [ AVP ]


; Type: Grouped AVP
; Name: SIP-Authentication-Info
; Section: 9.5.5
; Page: 52
SIP-Authentication-Info ::= < AVP header: 381 >
        [ Digest-Nextnonce ]
        [ Digest-Qop ] ;; corrected: (RFC4740.py#digest-qop-case-sip-authentication-info)
