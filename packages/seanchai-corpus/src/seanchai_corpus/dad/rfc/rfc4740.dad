; Type: Enumerated AVP
; Name: SIP-User-Data-Already-Available
; Section: 9.13
; Page: 58
SIP-User-Data-Already-Available ::= < Enumerated AVP header: 392 >
        USER_DATA_NOT_AVAILABLE     = 0
        USER_DATA_ALREADY_AVAILABLE = 1


