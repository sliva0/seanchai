; Type: Enumerated AVP
; Name: SIP-Reason-Code
; Section: 9.7.1
; Page: 55
SIP-Reason-Code ::= < Enumerated AVP header: 384 >
        PERMANENT_TERMINATION   = 0
        NEW_SIP_SERVER_ASSIGNED = 1
        SIP_SERVER_CHANGE       = 2
        REMOVE_SIP_SERVER       = 3


; Type: Enumerated AVP
; Name: SIP-User-Authorization-Type
; Section: 9.10
; Page: 56
SIP-User-Authorization-Type ::= < Enumerated AVP header: 387 >
        REGISTRATION                  = 0
        DEREGISTRATION                = 1
        REGISTRATION_AND_CAPABILITIES = 2


; Type: Grouped AVP
; Name: SIP-User-Data
; Section: 9.12
; Page: 57
SIP-User-Data ::= < AVP header: 389 >
        { SIP-User-Data-Type }
        { SIP-User-Data-Contents }
