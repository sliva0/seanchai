        [ Digest-CNonce ]
        [ Digest-Nonce-Count ]
      * [ AVP ]


; Type: Grouped AVP
; Name: SIP-Deregistration-Reason
; Section: 9.7
; Page: 55
SIP-Deregistration-Reason ::= < AVP header: 383 >
        { SIP-Reason-Code }
