; Type: Enumerated AVP
; Name: CC-Request-Type
; Section: 8.3
; Page: 62
CC-Request-Type ::= < Enumerated AVP header: 416 >
        INITIAL_REQUEST     = 1
        UPDATE_REQUEST      = 2
        TERMINATION_REQUEST = 3
        EVENT_REQUEST       = 4


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-event-request-requested-action)
; AVP: Requested-Action
; Command: Credit-Control-Request
; Section: 8.3
; Page: 62
"The Requested-Action AVP MUST be included in the Credit-Control-Request message when CC-Request-Type is set to EVENT_REQUEST."
    present-if CC-Request-Type = EVENT_REQUEST


; Type: Enumerated AVP
; Name: CC-Session-Failover
; Section: 8.4
; Page: 63
CC-Session-Failover ::= < Enumerated AVP header: 418 >
        FAILOVER_NOT_SUPPORTED = 0
        FAILOVER_SUPPORTED     = 1


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#cc-session-failover-default)
; AVP: CC-Session-Failover
; Section: 8.4
; Page: 63
"FAILOVER_NOT_SUPPORTED 0"
"When the CC-Session-Failover AVP is set to FAILOVER_NOT_SUPPORTED, the credit-control message stream MUST NOT be moved to an alternative destination in the case of a communication failure. This is the default behavior if the AVP isn't included in the reply from the authorization or credit-control server."
    default FAILOVER_NOT_SUPPORTED


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#cc-sub-session-id-increasing)
; AVP: CC-Sub-Session-Id
; Section: 8.5
; Page: 64
"The combination of the Session-Id AVP and this AVP MUST be unique per sub-session, and the value of this AVP MUST be monotonically increased by one for all new sub-sessions."
    text-only
"The absence of this AVP implies that no sub-sessions are in use."
    text-only


; Type: Enumerated AVP
; Name: Check-Balance-Result
; Section: 8.6
; Page: 64
Check-Balance-Result ::= < Enumerated AVP header: 422 >
        ENOUGH_CREDIT = 0
        NO_CREDIT     = 1


; Type: Grouped AVP
; Name: Cost-Information
; Section: 8.7
; Page: 64
Cost-Information ::= < AVP header: 423 >
        { Unit-Value }
        { Currency-Code }
        [ Cost-Unit ]


; Type: Grouped AVP
; Name: Unit-Value
; Section: 8.8
; Page: 65
Unit-Value ::= < AVP header: 445 >
        { Value-Digits }
        [ Exponent ]


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#exponent-default)
; AVP: Exponent
; Within: Unit-Value
; Section: 8.8
; Page: 65
"The absence of the exponent part MUST be interpreted as an exponent equal to zero."
    default 0


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#currency-code-iso-4217)
; AVP: Currency-Code
; Section: 8.11
; Page: 66
"It is specified by using the numeric values defined in the ISO 4217 standard [ISO4217]."
    text-only


; Type: Enumerated AVP
; Name: Credit-Control
; Section: 8.13
; Page: 66
Credit-Control ::= < Enumerated AVP header: 426 >
        CREDIT_AUTHORIZATION = 0
        RE_AUTHORIZATION     = 1


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#credit-control-in-aa-requests)
; AVP: Credit-Control
; Section: 8.13
; Page: 66
"The Credit-Control AVP (AVP Code 426) is of type Enumerated and MUST be included in AA-Request messages when the Service Element has credit-control capabilities."
    text-only
"The value of the Credit-Control AVP MUST always be set to 0 in an AA-Request sent to perform the first interrogation and to initiate a new credit-control session."
    text-only
"This value MUST NOT be used in an AA-Request sent to perform the first interrogation."
    text-only


; Type: Enumerated AVP
; Name: Credit-Control-Failure-Handling
; Section: 8.14
; Page: 67
Credit-Control-Failure-Handling ::= < Enumerated AVP header: 427 >
        TERMINATE           = 0
        CONTINUE            = 1
        RETRY_AND_TERMINATE = 2


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#credit-control-failure-handling-default)
; AVP: Credit-Control-Failure-Handling
; Section: 8.14
; Page: 67
"This is the default behavior if the AVP isn't included in the reply from the authorization or credit-control server."
    default TERMINATE


; Type: Enumerated AVP
; Name: Direct-Debiting-Failure-Handling
; Section: 8.15
; Page: 68
Direct-Debiting-Failure-Handling ::= < Enumerated AVP header: 428 >
        TERMINATE_OR_BUFFER = 0
        CONTINUE            = 1


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#direct-debiting-failure-handling-default)
; AVP: Direct-Debiting-Failure-Handling
; Section: 8.15
; Page: 68
"This is the default behavior if the AVP isn't included in the reply from the authorization server."
    default TERMINATE_OR_BUFFER


; Type: Grouped AVP
; Name: Multiple-Services-Credit-Control
; Section: 8.16
; Page: 68
Multiple-Services-Credit-Control ::= < AVP header: 456 >
        [ Granted-Service-Unit ]
        [ Requested-Service-Unit ]
      * [ Used-Service-Unit ]
        [ Tariff-Change-Usage ]
      * [ Service-Identifier ]
        [ Rating-Group ]
      * [ G-S-U-Pool-Reference ]
        [ Validity-Time ]
        [ Result-Code ]
        [ Final-Unit-Indication ]
        [ QoS-Final-Unit-Indication ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#g-s-u-pool-reference-granted-units)
; AVP: G-S-U-Pool-Reference
; Within: Multiple-Services-Credit-Control
; Section: 8.16
; Page: 68
"If a G-S-U-Pool-Reference AVP is present, then actual service units of the specified type MUST also be present. For example, if the G-S-U-Pool-Reference AVP specifies a CC-Unit-Type value of TIME (Section 8.32), then the CC-Time AVP MUST be present."
    excludes G-S-U-Pool-Reference/CC-Unit-Type = TIME and not Granted-Service-Unit/CC-Time or G-S-U-Pool-Reference/CC-Unit-Type = MONEY and not Granted-Service-Unit/CC-Money or G-S-U-Pool-Reference/CC-Unit-Type = TOTAL-OCTETS and not Granted-Service-Unit/CC-Total-Octets or G-S-U-Pool-Reference/CC-Unit-Type = INPUT-OCTETS and not Granted-Service-Unit/CC-Input-Octets or G-S-U-Pool-Reference/CC-Unit-Type = OUTPUT-OCTETS and not Granted-Service-Unit/CC-Output-Octets or G-S-U-Pool-Reference/CC-Unit-Type = SERVICE-SPECIFIC-UNITS and not Granted-Service-Unit/CC-Service-Specific-Units


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-multiple-services-credit-control-members)
; AVP: Multiple-Services-Credit-Control
; Command: Credit-Control-Request
; Section: 8.16
; Page: 68
"It MUST be present in the initial interrogation and within the intermediate interrogations in which a new quota is requested."
    absent-if CC-Request-Type = INITIAL_REQUEST and not Multiple-Services-Credit-Control/Requested-Service-Unit
"When the client is reporting used units before and after the tariff time change, it MUST use the Tariff-Change-Usage AVP inside the Used-Service-Unit AVP."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#cca-tariff-change-two-quotas)
; AVP: Multiple-Services-Credit-Control
; Command: Credit-Control-Answer
; Section: 8.16
; Page: 68
"When both the Tariff-Time-Change AVP and the Tariff-Change-Usage AVP are present, the server MUST include two separate instances of the Multiple-Services-Credit-Control AVP with the Granted-Service-Unit AVP associated to the same service-identifier and/or rating-group."
    text-only


; Type: Grouped AVP
; Name: Granted-Service-Unit
; Section: 8.17
; Page: 70
Granted-Service-Unit ::= < AVP header: 431 >
        [ Tariff-Time-Change ]
        [ CC-Time ]
        [ CC-Money ]
        [ CC-Total-Octets ]
        [ CC-Input-Octets ]
        [ CC-Output-Octets ]
        [ CC-Service-Specific-Units ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Requested-Service-Unit
; Section: 8.18
; Page: 71
Requested-Service-Unit ::= < AVP header: 437 >
        [ CC-Time ]
        [ CC-Money ]
        [ CC-Total-Octets ]
        [ CC-Input-Octets ]
        [ CC-Output-Octets ]
        [ CC-Service-Specific-Units ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Used-Service-Unit
; Section: 8.19
; Page: 71
Used-Service-Unit ::= < AVP header: 446 >
        [ Tariff-Change-Usage ]
        [ CC-Time ]
        [ CC-Money ]
        [ CC-Total-Octets ]
        [ CC-Input-Octets ]
        [ CC-Output-Octets ]
        [ CC-Service-Specific-Units ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#tariff-time-change-omitted)
; AVP: Tariff-Time-Change
; Section: 8.20
; Page: 72
"Omission of this AVP means that no tariff change is to be reported."
    text-only


; Type: Grouped AVP
; Name: CC-Money
; Section: 8.22
; Page: 72
CC-Money ::= < AVP header: 413 >
        { Unit-Value }
        [ Currency-Code ]


; Type: Enumerated AVP
; Name: Tariff-Change-Usage
; Section: 8.27
; Page: 73
Tariff-Change-Usage ::= < Enumerated AVP header: 452 >
        UNIT_BEFORE_TARIFF_CHANGE = 0
        UNIT_AFTER_TARIFF_CHANGE  = 1
        UNIT_INDETERMINATE        = 2


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#tariff-change-usage-omitted)
; AVP: Tariff-Change-Usage
; Section: 8.27
; Page: 73
"Omission of this AVP means that no tariff change has occurred."
    text-only


; Type: Grouped AVP
; Name: G-S-U-Pool-Reference
; Section: 8.30
; Page: 74
G-S-U-Pool-Reference ::= < AVP header: 457 >
        { G-S-U-Pool-Identifier }
        { CC-Unit-Type }
        { Unit-Value }


; Type: Enumerated AVP
; Name: CC-Unit-Type
; Section: 8.32
; Page: 75
CC-Unit-Type ::= < Enumerated AVP header: 454 >
        TIME                   = 0
        MONEY                  = 1
        TOTAL-OCTETS           = 2
        INPUT-OCTETS           = 3
        OUTPUT-OCTETS          = 4
        SERVICE-SPECIFIC-UNITS = 5


; Type: Grouped AVP
; Name: Final-Unit-Indication
; Section: 8.34
; Page: 76
Final-Unit-Indication ::= < AVP header: 430 >
        { Final-Unit-Action }
      * [ Restriction-Filter-Rule ]
      * [ Filter-Id ]
        [ Redirect-Server ]


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#final-unit-indication-terminate)
; AVP: Final-Unit-Indication
; Section: 8.34
; Page: 76
"If the Final-Unit-Action AVP is set to TERMINATE, the Final-Unit-Indication group AVP MUST NOT contain any other AVPs."
    excludes Final-Unit-Action = TERMINATE and Restriction-Filter-Rule or Final-Unit-Action = TERMINATE and Filter-Id or Final-Unit-Action = TERMINATE and Redirect-Server


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#final-unit-indication-redirect-server)
; AVP: Redirect-Server
; Within: Final-Unit-Indication
; Section: 8.34
; Page: 76
"If the Final-Unit-Action AVP is set to REDIRECT, the Redirect-Server AVP or the Redirect-Server-Extension AVP (at least one) MUST be present."
    present-if Final-Unit-Action = REDIRECT


; Type: Enumerated AVP
; Name: Final-Unit-Action
; Section: 8.35
; Page: 77
Final-Unit-Action ::= < Enumerated AVP header: 449 >
        TERMINATE       = 0
        REDIRECT        = 1
        RESTRICT_ACCESS = 2


; Type: Grouped AVP
; Name: Redirect-Server
; Section: 8.37
; Page: 78
Redirect-Server ::= < AVP header: 434 >
        { Redirect-Address-Type }
        { Redirect-Server-Address }


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#redirect-server-redirect)
; AVP: Redirect-Server
; Within: Final-Unit-Indication
; Section: 8.37
; Page: 78
"It MUST be present when the Final-Unit-Action AVP is set to REDIRECT."
    present-if Final-Unit-Action = REDIRECT


; Type: Enumerated AVP
; Name: Redirect-Address-Type
; Section: 8.38
; Page: 79
Redirect-Address-Type ::= < Enumerated AVP header: 433 >
        URL = 2


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#redirect-server-address-by-type)
; AVP: Redirect-Server-Address
; Within: Redirect-Server
; Section: 8.38
; Page: 79
"IPv4 Address 0"
"The address type is in the form of a \"dotted-decimal\" IPv4 address, as defined in [RFC791]."
"IPv6 Address 1"
"The address type is in the form of an IPv6 address, as defined in [RFC4291]. The address MUST conform to the textual representation of the address according to [RFC5952]."
"URL 2"
"The address type is in the form of a Uniform Resource Locator, as defined in [RFC3986]."
"SIP URI 3"
"The address type is in the form of a SIP Uniform Resource Identifier, as defined in [RFC3261]."
    text-only


; Type: Enumerated AVP
; Name: Multiple-Services-Indicator
; Section: 8.40
; Page: 80
Multiple-Services-Indicator ::= < Enumerated AVP header: 455 >
        MULTIPLE_SERVICES_NOT_SUPPORTED = 0
        MULTIPLE_SERVICES_SUPPORTED     = 1


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#multiple-services-indicator-default)
; AVP: Multiple-Services-Indicator
; Section: 8.40
; Page: 80
"The absence of this AVP means that independent credit-control of multiple services is not supported."
    default MULTIPLE_SERVICES_NOT_SUPPORTED


; Type: Enumerated AVP
; Name: Requested-Action
; Section: 8.41
; Page: 80
Requested-Action ::= < Enumerated AVP header: 436 >
        DIRECT_DEBITING = 0
        REFUND_ACCOUNT  = 1
        CHECK_BALANCE   = 2
        PRICE_ENQUIRY   = 3


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#service-context-id-format)
; AVP: Service-Context-Id
; Section: 8.42
; Page: 81
"This is an identifier allocated by the service provider, the Service Element manufacturer, or a standardization body, and MUST uniquely identify a given Diameter Credit-Control service-specific document."
    text-only
"\"service-context\" \"@\" \"domain\""
    text-only


; Type: Grouped AVP
; Name: Service-Parameter-Info
; Section: 8.43
; Page: 82
Service-Parameter-Info ::= < AVP header: 440 >
        { Service-Parameter-Type }
        { Service-Parameter-Value }


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#cca-unknown-service-failed-avp)
; AVP: Failed-AVP
; Command: Credit-Control-Answer
; Section: 8.43
; Page: 82
"A Credit-Control-Answer message with this error MUST contain one or more Failed-AVP AVPs containing the Service-Parameter-Info AVPs that caused the failure."
    present-if Result-Code = DIAMETER_RATING_FAILED


; Type: Grouped AVP
; Name: Subscription-Id
; Section: 8.46
; Page: 83
Subscription-Id ::= < AVP header: 443 >
        { Subscription-Id-Type }
        { Subscription-Id-Data }


; Type: Enumerated AVP
; Name: Subscription-Id-Type
; Section: 8.47
; Page: 83
Subscription-Id-Type ::= < Enumerated AVP header: 450 >
        END_USER_E164    = 0
        END_USER_IMSI    = 1
        END_USER_SIP_URI = 2
        END_USER_NAI     = 3
        END_USER_PRIVATE = 4


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#subscription-id-data-by-type)
; AVP: Subscription-Id-Data
; Within: Subscription-Id
; Section: 8.47
; Page: 83
"END_USER_E164 0"
"The identifier is in international E.164 format (e.g., MSISDN), according to the ITU-T E.164 numbering plan defined in [E164] and [CE164]."
"END_USER_IMSI 1"
"The identifier is in IMSI format, according to the ITU-T E.212 identification plan as defined in [E212] and [CE212]."
"END_USER_SIP_URI 2"
"The identifier is in the form of a SIP URI, as defined in [RFC3261]. END_USER_NAI 3"
"The identifier is in the form of a Network Access Identifier, as defined in [RFC7542]."
    text-only


; Type: Grouped AVP
; Name: User-Equipment-Info
; Section: 8.49
; Page: 84
User-Equipment-Info ::= < AVP header: 458 >
        { User-Equipment-Info-Type }
        { User-Equipment-Info-Value }


; Type: Enumerated AVP
; Name: User-Equipment-Info-Type
; Section: 8.50
; Page: 84
User-Equipment-Info-Type ::= < Enumerated AVP header: 459 >
        IMEISV         = 0
        MAC            = 1
        EUI64          = 2
        MODIFIED_EUI64 = 3


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#user-equipment-info-value-by-type)
; AVP: User-Equipment-Info-Value
; Within: User-Equipment-Info
; Section: 8.50
; Page: 84
"IMEISV 0"
"The identifier contains the International Mobile Equipment Identifier and Software Version (IMEISV) in the IMEISV format according to 3GPP TS 23.003 [TGPPIMEI]."
"MAC 1"
"The 48-bit Media Access Control (MAC) address is formatted as described in Section 3.21 of [RFC3580]."
"EUI64 2"
"The 64-bit identifier used to identify the hardware instance of the product, as defined in [EUI64]."
    text-only


; Type: Grouped AVP
; Name: User-Equipment-Info-Extension
; Section: 8.52
; Page: 85
User-Equipment-Info-Extension ::= < AVP header: 653 >
        [ User-Equipment-Info-IMEISV ]
        [ User-Equipment-Info-MAC ]
        [ User-Equipment-Info-EUI64 ]
        [ User-Equipment-Info-ModifiedEUI64 ]
        [ User-Equipment-Info-IMEI ]
        [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#user-equipment-info-extension-imeisv-alone)
; AVP: User-Equipment-Info-IMEISV
; Within: User-Equipment-Info-Extension
; Section: 8.52
; Page: 85
"Exactly one AVP MUST be included inside the User-Equipment-Info-Extension AVP."
    excludes User-Equipment-Info-MAC or User-Equipment-Info-EUI64 or User-Equipment-Info-ModifiedEUI64 or User-Equipment-Info-IMEI


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#user-equipment-info-extension-mac-alone)
; AVP: User-Equipment-Info-MAC
; Within: User-Equipment-Info-Extension
; Section: 8.52
; Page: 85
"Exactly one AVP MUST be included inside the User-Equipment-Info-Extension AVP."
    excludes User-Equipment-Info-EUI64 or User-Equipment-Info-ModifiedEUI64 or User-Equipment-Info-IMEI


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#user-equipment-info-extension-eui64-alone)
; AVP: User-Equipment-Info-EUI64
; Within: User-Equipment-Info-Extension
; Section: 8.52
; Page: 85
"Exactly one AVP MUST be included inside the User-Equipment-Info-Extension AVP."
    excludes User-Equipment-Info-ModifiedEUI64 or User-Equipment-Info-IMEI


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#user-equipment-info-extension-modified-eui64-alone)
; AVP: User-Equipment-Info-ModifiedEUI64
; Within: User-Equipment-Info-Extension
; Section: 8.52
; Page: 85
"Exactly one AVP MUST be included inside the User-Equipment-Info-Extension AVP."
    excludes User-Equipment-Info-IMEI


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#user-equipment-info-imeisv-element)
; AVP: User-Equipment-Info-IMEISV
; Section: 8.53
; Page: 86
"The User-Equipment-Info-IMEISV AVP contains the International Mobile Equipment Identifier and Software Version in the IMEISV format according to 3GPP TS 23.003 [TGPPIMEI]."
    encoding element TS23.003 6.2.2 "IMEISV"


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#user-equipment-info-mac-element)
; AVP: User-Equipment-Info-MAC
; Section: 8.54
; Page: 86
"The User-Equipment-Info-MAC AVP contains the 48-bit MAC address; the MAC address is formatted as described in Section 4.1.7.8 of [RFC5777]."
    encoding element RFC5777 4.1.7.8 "MAC-Address"


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#user-equipment-info-eui64-length)
; AVP: User-Equipment-Info-EUI64
; Section: 8.55
; Page: 86
"The User-Equipment-Info-EUI64 AVP contains the 64-bit identifier used to identify the hardware instance of the product, as defined in [EUI64]."
    length 8 octets


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#user-equipment-info-modified-eui64-element)
; AVP: User-Equipment-Info-ModifiedEUI64
; Section: 8.56
; Page: 86
"These identifiers can be converted to modified EUI-64 format as described in [RFC4291] or by using some other methods referred to in the service-specific documentation. The User-Equipment-Info-ModifiedEUI64 AVP contains such identifiers."
    encoding element RFC4291 2.5.1 "Modified EUI-64"


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#user-equipment-info-imei-element)
; AVP: User-Equipment-Info-IMEI
; Section: 8.57
; Page: 86
"The User-Equipment-Info-IMEI AVP contains the International Mobile Equipment Identifier in the IMEI format according to 3GPP TS 23.003 [TGPPIMEI]."
    encoding element TS23.003 6.2.1 "IMEI"


; Type: Grouped AVP
; Name: Subscription-Id-Extension
; Section: 8.58
; Page: 87
Subscription-Id-Extension ::= < AVP header: 659 >
        [ Subscription-Id-E164 ]
        [ Subscription-Id-IMSI ]
        [ Subscription-Id-SIP-URI ]
        [ Subscription-Id-NAI ]
        [ Subscription-Id-Private ]
        [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#subscription-id-extension-one-identifier)
; AVP: Subscription-Id-Extension
; Section: 8.58
; Page: 87
"The Subscription-Id-Extension group AVP MUST include an AVP holding the subscription identifier."
    text-only
"If full backward compatibility with [RFC4006] is required, then the Subscription-Id AVP MUST be used to indicate identifier types enumerated in the Subscription-Id-Type AVP, whereas the Subscription-Id-Extension AVP MUST be used only for newly defined identifier types."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#subscription-id-extension-e164-alone)
; AVP: Subscription-Id-E164
; Within: Subscription-Id-Extension
; Section: 8.58
; Page: 87
"Exactly one sub-AVP MUST be included inside the Subscription-Id-Extension AVP."
    excludes Subscription-Id-IMSI or Subscription-Id-SIP-URI or Subscription-Id-NAI or Subscription-Id-Private


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#subscription-id-extension-imsi-alone)
; AVP: Subscription-Id-IMSI
; Within: Subscription-Id-Extension
; Section: 8.58
; Page: 87
"Exactly one sub-AVP MUST be included inside the Subscription-Id-Extension AVP."
    excludes Subscription-Id-SIP-URI or Subscription-Id-NAI or Subscription-Id-Private


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#subscription-id-extension-sip-uri-alone)
; AVP: Subscription-Id-SIP-URI
; Within: Subscription-Id-Extension
; Section: 8.58
; Page: 87
"Exactly one sub-AVP MUST be included inside the Subscription-Id-Extension AVP."
    excludes Subscription-Id-NAI or Subscription-Id-Private


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#subscription-id-extension-nai-alone)
; AVP: Subscription-Id-NAI
; Within: Subscription-Id-Extension
; Section: 8.58
; Page: 87
"Exactly one sub-AVP MUST be included inside the Subscription-Id-Extension AVP."
    excludes Subscription-Id-Private


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#subscription-id-e164-format)
; AVP: Subscription-Id-E164
; Section: 8.59
; Page: 87
"The Subscription-Id-E164 AVP contains the international E.164 format (e.g., MSISDN), according to the ITU-T E.164 numbering plan defined in [E164] and [CE164]."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#subscription-id-imsi-format)
; AVP: Subscription-Id-IMSI
; Section: 8.60
; Page: 87
"The Subscription-Id-IMSI AVP contains the IMSI format, according to the ITU-T E.212 identification plan as defined in [E212] and [CE212]."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#subscription-id-sip-uri-format)
; AVP: Subscription-Id-SIP-URI
; Section: 8.61
; Page: 88
"The Subscription-Id-SIP-URI AVP contains the identifier in the form of a SIP URI, as defined in [RFC3261]."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#subscription-id-nai-format)
; AVP: Subscription-Id-NAI
; Section: 8.62
; Page: 88
"The Subscription-Id-NAI AVP contains the identifier in the form of a Network Access Identifier, as defined in [RFC7542]."
    text-only


; Type: Grouped AVP
; Name: Redirect-Server-Extension
; Section: 8.64
; Page: 88
Redirect-Server-Extension ::= < AVP header: 665 >
        [ Redirect-Address-IPAddress ]
        [ Redirect-Address-URL ]
        [ Redirect-Address-SIP-URI ]
        [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#qos-final-unit-indication-redirect-server-extension)
; AVP: Redirect-Server-Extension
; Within: QoS-Final-Unit-Indication
; Section: 8.64
; Page: 88
"It MUST be present inside the QoS-Final-Unit-Indication AVP when the Final-Unit-Action AVP is set to REDIRECT."
    present-if Final-Unit-Action = REDIRECT


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#redirect-server-extension-ip-address-alone)
; AVP: Redirect-Address-IPAddress
; Within: Redirect-Server-Extension
; Section: 8.64
; Page: 88
"Exactly one AVP MUST be included inside the Redirect-Server-Extension AVP."
    excludes Redirect-Address-URL or Redirect-Address-SIP-URI


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#redirect-server-extension-url-alone)
; AVP: Redirect-Address-URL
; Within: Redirect-Server-Extension
; Section: 8.64
; Page: 88
"Exactly one AVP MUST be included inside the Redirect-Server-Extension AVP."
    excludes Redirect-Address-SIP-URI


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#redirect-address-ip-address-family)
; AVP: Redirect-Address-IPAddress
; Section: 8.65
; Page: 89
"The Redirect-Address-IPAddress AVP (AVP Code 666) is of type Address and defines the IPv4 or IPv6 address of the redirect server with which the end user is to be connected when the account cannot cover the service cost."
    encoding ip-address


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#redirect-address-url-format)
; AVP: Redirect-Address-URL
; Section: 8.66
; Page: 89
"The address type is in the form of a Uniform Resource Locator, as defined in [RFC3986]."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#redirect-address-sip-uri-format)
; AVP: Redirect-Address-SIP-URI
; Section: 8.67
; Page: 89
"The address type is in the form of a SIP Uniform Resource Identifier, as defined in [RFC3261]."
    text-only


; Type: Grouped AVP
; Name: QoS-Final-Unit-Indication
; Section: 8.68
; Page: 89
QoS-Final-Unit-Indication ::= < AVP header: 669 >
        { Final-Unit-Action }
      * [ Filter-Rule ]
      * [ Filter-Id ]
        [ Redirect-Server-Extension ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#qos-final-unit-indication-terminate)
; AVP: QoS-Final-Unit-Indication
; Section: 8.68
; Page: 89
"If the Final-Unit-Action AVP is set to TERMINATE, the QoS-Final-Unit-Indication group AVP MUST NOT contain any other AVPs."
    excludes Final-Unit-Action = TERMINATE and Filter-Rule or Final-Unit-Action = TERMINATE and Filter-Id or Final-Unit-Action = TERMINATE and Redirect-Server-Extension


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#qos-final-unit-indication-redirect)
; AVP: Redirect-Server-Extension
; Within: QoS-Final-Unit-Indication
; Section: 8.68
; Page: 89
"If the Final-Unit-Action AVP is set to REDIRECT, then the Redirect-Server-Extension AVP MUST be present."
    present-if Final-Unit-Action = REDIRECT


; Type: Value Table
; AVP: Result-Code
; Kind: result-codes
; Section: 9
; Page: 91
DIAMETER_END_USER_SERVICE_DENIED       = 4010 ; 9.1
DIAMETER_CREDIT_CONTROL_NOT_APPLICABLE = 4011 ; 9.1
DIAMETER_CREDIT_LIMIT_REACHED          = 4012 ; 9.1
DIAMETER_USER_UNKNOWN                  = 5030 ; 9.2
DIAMETER_RATING_FAILED                 = 5031 ; 9.2


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#cca-rating-failed-result-failed-avp)
; AVP: Failed-AVP
; Command: Credit-Control-Answer
; Section: 9.2
; Page: 92
"The Failed-AVP AVP MUST be included and contain (1) a copy of the entire AVP or AVPs that could not be processed successfully or (2) an example of the missing AVP, complete with the Vendor-Id if applicable."
    present-if Result-Code = DIAMETER_RATING_FAILED


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-cc-session-failover-table-absent)
; AVP: CC-Session-Failover
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"CC-Session-Failover | 0 | 0-1 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-check-balance-result-table-absent)
; AVP: Check-Balance-Result
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Check-Balance-Result | 0 | 0-1 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-cost-information-table-absent)
; AVP: Cost-Information
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Cost-Information | 0 | 0-1 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-credit-control-failure-handling-table-absent)
; AVP: Credit-Control-Failure-Handling
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Credit-Control-Failure-Handling | 0 | 0-1 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-direct-debiting-failure-handling-table-absent)
; AVP: Direct-Debiting-Failure-Handling
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Direct-Debiting-Failure-Handling | 0 | 0-1 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-failed-avp-table-absent)
; AVP: Failed-AVP
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Failed-AVP | 0 | 0+ |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-final-unit-indication-table-absent)
; AVP: Final-Unit-Indication
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Final-Unit-Indication | 0 | 0-1 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-qos-final-unit-indication-table-absent)
; AVP: QoS-Final-Unit-Indication
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"QoS-Final-Unit-Indication | 0 | 0-1 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-granted-service-unit-table-absent)
; AVP: Granted-Service-Unit
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Granted-Service-Unit | 0 | 0-1 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-redirect-host-table-absent)
; AVP: Redirect-Host
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Redirect-Host | 0 | 0+ |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-redirect-host-usage-table-absent)
; AVP: Redirect-Host-Usage
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Redirect-Host-Usage | 0 | 0-1 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-redirect-max-cache-time-table-absent)
; AVP: Redirect-Max-Cache-Time
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Redirect-Max-Cache-Time | 0 | 0-1 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-result-code-table-absent)
; AVP: Result-Code
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Result-Code | 0 | 1 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#ccr-validity-time-table-absent)
; AVP: Validity-Time
; Command: Credit-Control-Request
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Validity-Time | 0 | 0-1 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#cca-cc-correlation-id-table-absent)
; AVP: CC-Correlation-Id
; Command: Credit-Control-Answer
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"CC-Correlation-Id | 0-1 | 0 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#cca-destination-host-table-absent)
; AVP: Destination-Host
; Command: Credit-Control-Answer
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Destination-Host | 0-1 | 0 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#cca-destination-realm-table-absent)
; AVP: Destination-Realm
; Command: Credit-Control-Answer
; Section: 10.1
; Page: 93
"0 The AVP MUST NOT be present in the message."
"Destination-Realm | 1 | 0 |"
    absent


; Type: Interpreted Constraints ;; interpreted: (RFC8506.dadx#cca-multiple-services-indicator-table-absent)
; AVP: Multiple-Services-Indicator
