; Specification: RFC 5778
; Vendor-ID: 0
; Bases: RFC6733, RFC4004, RFC4005, RFC4072, RFC5447, RFC5777 ;; corrected: (RFC5778.py#bases-mip6-dependencies)
; Link: https://www.rfc-editor.org/rfc/rfc5778.txt


; Type: Application Scope ;; inserted: (RFC5778.py#application-id-mip6i)
; Name: Diameter Mobile IPv6 IKE (MIP6I)
; Section: 3
; Page: 6
; Application-ID: 7
; Applies-To: 5.1.*


; Type: Application Scope ;; inserted: (RFC5778.py#application-id-mip6a)
; Name: Diameter Mobile IPv6 Auth (MIP6A)
; Section: 3
; Page: 6
; Application-ID: 8
; Applies-To: 5.2.*


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#mir-user-name-the-mn-nai)
; AVP: User-Name
; Command: MIP6-Request
; Section: 4.2
; Page: 10
"The HA MUST copy the MN-NAI mobility option value to the User-Name AVP in the subsequent request messages."
    text-only


; Type: Message
; Name: Diameter-EAP-Request, DER
; Section: 5.1.1
; Page: 13
<Diameter-EAP-Request> ::= < Diameter Header: 268, REQ, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Auth-Request-Type }
        [ Destination-Host ]
        [ NAS-Identifier ]
        [ NAS-IP-Address ]
        [ NAS-IPv6-Address ]
        [ NAS-Port-Type ]
        [ User-Name ]
;; ...
        { EAP-Payload }
;; ...
        [ MIP6-Feature-Vector ]
        [ MIP6-Agent-Info ]
     *2 [ MIP-Mobile-Node-Address ]
        [ Chargeable-User-Identity ]
        [ Service-Selection ]
        [ QoS-Capability ]
      * [ QoS-Resources ]
;; ...
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#der-auth-request-type-authorize-authenticate)
; AVP: Auth-Request-Type
; Command: Diameter-EAP-Request
; Section: 5.1.1
; Page: 13
"Thus, the Auth-Request-Type AVP MUST be set to the value AUTHORIZE_AUTHENTICATE."
    range 3


; Type: Message
; Name: Diameter-EAP-Answer, DEA
; Section: 5.1.2
; Page: 14
<Diameter-EAP-Answer> ::= < Diameter Header: 268, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Auth-Request-Type }
        { Result-Code }
        { Origin-Host }
        { Origin-Realm }
        [ User-Name ]
        [ EAP-Payload ]
        [ EAP-Reissued-Payload ]
        [ EAP-Master-Session-Key ]
        [ EAP-Key-Name ]
        [ Multi-Round-Time-Out ] ;; corrected: (RFC5778.py#dea-multi-round-time-out)
;; ...
     *2 [ MIP-Mobile-Node-Address ]
        [ MIP6-Feature-Vector ]
        [ MIP6-Agent-Info ]
        [ Service-Selection ]
      * [ QoS-Resources ]
        [ Chargeable-User-Identity ]
;; ...
      * [ AVP ]


; Type: Message
; Name: MIP6-Request, MIR
; Section: 5.2.1
; Page: 16
<MIP6-Request> ::= < Diameter Header: 325, REQ, PXY >
        < Session-Id > ;; corrected: (RFC5778.py#mir-session-id-case)
        { Auth-Application-Id }
        { User-Name }
        { Destination-Realm }
        { Origin-Host }
        { Origin-Realm }
        { Auth-Request-Type }
        [ Destination-Host ]
        [ Origin-State-Id ]
        [ NAS-Identifier ]
        [ NAS-IP-Address ]
        [ NAS-IPv6-Address ]
        [ NAS-Port-Type ]
        [ Called-Station-Id ]
        [ Calling-Station-Id ]
        [ MIP6-Feature-Vector ]
        { MIP6-Auth-Mode }
        [ MIP-MN-AAA-SPI ]
        [ MIP-MN-HA-SPI ]
    1*2 { MIP-Mobile-Node-Address }
        { MIP6-Agent-Info }
        { MIP-Careof-Address }
        [ MIP-Authenticator ]
        [ MIP-MAC-Mobility-Data ]
        [ MIP-Timestamp ]
        [ QoS-Capability ]
      * [ QoS-Resources ]
        [ Chargeable-User-Identity ]
        [ Service-Selection ]
        [ Authorization-Lifetime ]
        [ Auth-Session-State ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: MIP6-Answer, MIA
; Section: 5.2.2
; Page: 17
<MIP6-Answer> ::= < Diameter Header: 325, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Result-Code }
        { Origin-Host }
        { Origin-Realm }
        { Auth-Request-Type }
        [ User-Name ]
        [ Authorization-Lifetime ]
        [ Auth-Session-State ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
        [ Re-Auth-Request-Type ]
        [ MIP6-Feature-Vector ]
        [ MIP6-Agent-Info ] ;; corrected: (RFC5778.py#mia-mip6-agent-info)
     *2 [ MIP-Mobile-Node-Address ]
        [ MIP-MN-HA-MSA ]
      * [ QoS-Resources ]
        [ Chargeable-User-Identity ]
        [ Service-Selection ]
        [ Origin-State-Id ]
      * [ Proxy-Info ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Failed-AVP ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#mia-success-mip-mobile-node-address)
; AVP: MIP-Mobile-Node-Address
; Command: MIP6-Answer
; Section: 5.2.2
; Page: 17
"An MIA message with the Result-Code AVP set to DIAMETER_SUCCESS MUST include the MIP-Mobile-Node-Address AVP."
    present-if Result-Code = DIAMETER_SUCCESS


; Type: AVP Table
; Section: 6
; Page: 18
; Columns: Name            Code   Section   Type          Must   May   S.not   M.not   Encrypt
Service-Selection          493    6.2       UTF8String    M      P     -       V       Yes
MIP-MN-HA-MSA              492    6.12      Grouped       M      P     -       V       Yes
Chargeable-User-Identity   89     6.19      OctetString   M      P     -       V       Yes


; Type: AVP Table
; Section: 6
; Page: 18
; Columns: Name            Code   Section   Type          Must   May   S.not   M.not   Encrypt
Service-Selection          493    6.2       UTF8String    M      P     -       V       Yes
MIP-MN-HA-SPI              491    6.4       Unsigned32    M      P     -       V       Yes
MIP-Careof-Address         487    6.7       Address       M      P     -       V       Yes
MIP-Authenticator          488    6.8       OctetString   M      P     -       V       Yes
MIP-MAC-Mobility-Data      489    6.9       OctetString   M      P     -       V       Yes
MIP-Session-Key            343    6.10      OctetString   M      P     -       V       Yes
MIP-MN-HA-MSA              492    6.12      Grouped       M      P     -       V       Yes
MIP-Algorithm-Type         345    6.13      Enumerated    M      P     -       V       Yes
MIP-Replay-Mode            346    6.14      Enumerated    M      P     -       V       Yes
MIP-Timestamp              490    6.16      OctetString   M      P     -       V       Yes
Chargeable-User-Identity   89     6.19      OctetString   M      P     -       V       Yes
MIP6-Auth-Mode             494    6.20      Enumerated    M      P     -       V       Yes


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#mir-mn-aaa-mip-mn-aaa-spi)
; AVP: MIP-MN-AAA-SPI
; Command: MIP6-Request
; Section: 6.3
; Page: 21
"When the MIP6-Auth-Mode AVP is set to value MIP6_AUTH_MN_AAA, this AVP MUST be present in the MIR message."
    present-if MIP6-Auth-Mode = MIP6_AUTH_MN_AAA


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#mia-mn-aaa-mip-mn-ha-spi)
; AVP: MIP-MN-HA-MSA
; Command: MIP6-Answer
; Section: 6.4
; Page: 22
"When the MIP6-Auth-Mode AVP is set to value MIP6_AUTH_MN_AAA, and the Diameter server returns a valid MIP-MN-HA-MSA AVP in the MIA message, this AVP MUST be present inside the MIP-MN-HA-MSA AVP."
    absent-if request/MIP6-Auth-Mode = MIP6_AUTH_MN_AAA and not MIP-MN-HA-MSA/MIP-MN-HA-SPI


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#mip-mobile-node-address-family)
; AVP: MIP-Mobile-Node-Address
; Section: 6.5
; Page: 22
"The MIP-Mobile-Node-Address AVP (AVP Code 333) is of type Address and contains the HA assigned IPv6 or IPv4 home address of the mobile node."
    encoding ip-address


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#mia-mip-mobile-node-address-prefix-only)
; AVP: MIP-Mobile-Node-Address
; Command: MIP6-Answer
; Section: 6.5
; Page: 22
"If the Diameter server assigns only an IPv6 home network prefix to the mobile node, the lower 64 bits of the MIP-Mobile-Node-Address AVP provided address MUST be set to zero."
    text-only


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#mip-careof-address-family)
; AVP: MIP-Careof-Address
; Section: 6.7
; Page: 23
"The MIP-Careof-Address AVP (AVP Code 487) is of type Address and contains the IPv6 or the IPv4 care-of address of the mobile node."
    encoding ip-address


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#mir-mn-aaa-mip-authenticator)
; AVP: MIP-Authenticator
; Command: MIP6-Request
; Section: 6.8
; Page: 23
"When the MIP6-Auth-Mode AVP is set to value MIP6_AUTH_MN_AAA, this AVP MUST be present in the MIR message."
    present-if MIP6-Auth-Mode = MIP6_AUTH_MN_AAA


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#mir-mn-aaa-mip-mac-mobility-data)
; AVP: MIP-MAC-Mobility-Data
; Command: MIP6-Request
; Section: 6.9
; Page: 23
"When the MIP6-Auth-Mode AVP is set to value MIP6_AUTH_MN_AAA, this AVP MUST be present in the MIR message."
    present-if MIP6-Auth-Mode = MIP6_AUTH_MN_AAA


; Type: Grouped AVP
; Name: MIP-MN-HA-MSA
; Section: 6.12
; Page: 24
MIP-MN-HA-MSA ::= < AVP header: 492 >
        { MIP-Session-Key }
        { MIP-MSA-Lifetime }
        [ MIP-MN-HA-SPI ]
        [ MIP-Algorithm-Type ]
        [ MIP-Replay-Mode ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#mip-replay-mode-default)
; AVP: MIP-Replay-Mode
; Within: MIP-MN-HA-MSA
; Section: 6.12
; Page: 24
"The absence of the MIP-Replay-Mode AVP MUST be treated as no replay protection was selected."
    default None


; Type: Enumerated AVP
; Name: MIP-Algorithm-Type
; Section: 6.13
; Page: 24
; Values: [RFC4004] that also fulfill current RFC 4285 requirements
MIP-Algorithm-Type ::= < Enumerated AVP header: 345 >
        HMAC-SHA-1 = 2 ;; supplied: (RFC5778.py#mip-algorithm-type-values)


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#mia-mn-aaa-mip-algorithm-type)
; AVP: MIP-MN-HA-MSA
; Command: MIP6-Answer
; Section: 6.13
; Page: 24
"When the MIP6-Auth-Mode AVP is set to value MIP6_AUTH_MN_AAA, and the Diameter server returns a valid MIP-MN-HA-MSA AVP in the MIA message, this AVP MUST be present inside the MIP-MN-HA-MSA AVP."
    absent-if request/MIP6-Auth-Mode = MIP6_AUTH_MN_AAA and not MIP-MN-HA-MSA/MIP-Algorithm-Type


; Type: Enumerated AVP
; Name: MIP-Replay-Mode
; Section: 6.14
; Page: 24
MIP-Replay-Mode ::= < Enumerated AVP header: 346 >
        None      = 1
        Timestamp = 2


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#mip-timestamp-octets)
; AVP: MIP-Timestamp
; Section: 6.16
; Page: 25
"The MIP-Timestamp AVP (AVP Code 490) is of type OctetString and contains an 8-octet timestamp value (i.e., 64-bit timestamp) from the Mobility message replay protection option, defined in [RFC4285]."
    length 8 octets


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#mir-mn-aaa-auth-request-type)
; AVP: Auth-Request-Type
; Command: MIP6-Request
; Section: 6.20
; Page: 25
"When the MIP6-Auth_Mode AVP is set to the value of MIP6_AUTH_MN_AAA, the Auth-Request-Type AVP MUST be set to the value of AUTHORIZE_AUTHENTICATE."
    values 3 if MIP6-Auth-Mode = MIP6_AUTH_MN_AAA


; Type: Interpreted Constraints ;; interpreted: (RFC5778.dadx#acr-chargeable-user-identity-if-available)
; AVP: Chargeable-User-Identity
; Section: 6.21
; Page: 26
"This AVP MUST be included if it is available in the home agent."
    text-only


; Type: Value Table
; AVP: Result-Code
; Kind: result-codes
; Section: 7
; Page: 27
DIAMETER_SUCCESS_RELOCATE_HA  = 2009 ; 7.1
DIAMETER_ERROR_MIP6_AUTH_MODE = 5041 ; 7.2


