; Type: Enumerated AVP
; Name: Accounting-Record-Type
; Section: A.5.3
Accounting-Record-Type ::= < Enumerated AVP header: 480 >
        EVENT_RECORD = 1


; Type: Grouped AVP
; Name: M2M-Information
; Section: A.5.14
M2M-Information ::= < AVP header: 1011 45687 > ;; corrected: (oneM2M-TS-0004.py#m2m-information-vendor)
        [ Application-Entity-ID ]
        [ External-ID ]
        [ Receiver ]
        [ Originator ]
        [ Hosting-CSE-ID ]
        [ Target-ID ]
        [ Protocol-Type ]
        [ Request-Operation ]
        [ Request-Headers-Size ]
        [ Request-Body-Size ]
        [ Response-Headers-Size ]
        [ Response-Body-Size ]
        [ Response-Status-Code ]
        [ Rating-Group ]
        [ M2M-Event-Record-Timestamp ]
        [ Control-Memory-Size ]
        [ Data-Memory-Size ]
        [ Access-Network-Identifier ]
        [ Occupancy ]
        [ Group-Name ]
        [ Maximum-Number-Members ]
        [ Current-Number-Members ]
        [ Subgroup-Name ]
        [ Node-Id ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Protocol-Type
; Section: A.5.17
Protocol-Type ::= < Enumerated AVP header: 1013 45687 >
        HTTP            = 0
        CoAP            = 1
        MQTT            = 2
        WebSocket       = 3
      ; RESERVED        = 4-99
      ; VENDOR-SPECIFIC = 100-199 ; Operator and vendor specific protocol types


; Type: Enumerated AVP
; Name: Request-Operation
; Section: A.5.22
; Values: Table 6.3.4.2.5-6
