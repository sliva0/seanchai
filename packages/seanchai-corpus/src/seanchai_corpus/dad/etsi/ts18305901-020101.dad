;; The cover prints "ETSI TS 183 059-1 V2.1.1"; the title is written as its
;; spec-ref, since `ast.spec_ref` reads no part in a spaced ETSI title.


; Specification: ETSI-TS183.059-1
; Version: 2.1.1
; Vendor-ID: 13019
; Bases: RFC6733
; Link: https://www.etsi.org/deliver/etsi_ts/183000_183099/18305901/02.01.01_60/ts_18305901v020101p.pdf
; Transcribed: by hand from https://www.etsi.org/deliver/etsi_ts/183000_183099/18305901/02.01.01_60/ts_18305901v020101p.pdf


;; Clause 7: "The Diameter application identifier assigned to this application
;; is 16777231 (allocated by IANA for e4)", the id ES 283 034 prints; clause 6.6
;; has the NACF and the CLF advertise "the e4 specific application".
; Type: Application Scope
; Name: a2
; Section: 7
; Page: 15
; Application-ID: 16777231
; Applies-To: 7.*


; Type: Message
; Name: Push-Notification-Request, PNR
; Section: 7.1.1
; Page: 16
<Push-Notification-Request> ::= < Diameter Header: 309, REQ, PXY, 16777231 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Host }
        { Destination-Realm }
        [ Globally-Unique-Address ]        ; bold
        [ Logical-Access-ID ]              ; bold ;; corrected: (ETSI-TS183.059-1.py#push-notification-request-logical-access-id-case)
        [ Physical-Access-ID ]             ; bold ;; corrected: (ETSI-TS183.059-1.py#push-notification-request-physical-access-id-case)
        [ Terminal-Type ]                  ; bold
        [ Access-Network-Type ]            ; bold
        [ IP-Connectivity-Status ]         ; bold
      * [ AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


; Type: Message
; Name: Push-Notification-Answer, PNA
; Section: 7.1.2
; Page: 16
<Push-Notification-Answer> ::= < Diameter Header: 309, PXY, 16777231 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        [ Result-Code ]
        [ Experimental-Result ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ CNGCF-Address ]                  ; bold
        [ Location-Data ]                  ; bold
        [ SIP-Outbound-Proxy ]             ; bold
      * [ AVP ]
      * [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


; Type: Message
; Name: User-Data-Request, UDR
; Section: 7.1.3
; Page: 16
<User-Data-Request> ::= < Diameter Header: 306, REQ, PXY, 16777231 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Destination-Host ]
        { Destination-Realm }
        [ Globally-Unique-Address ]        ; bold
        [ Logical-Access-ID ]              ; bold ;; corrected: (ETSI-TS183.059-1.py#user-data-request-logical-access-id-case)
      * [ AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


; Type: Message
; Name: User-Data-Answer, UDA
; Section: 7.1.4
; Page: 17
<User-Data-Answer> ::= < Diameter Header: 306, PXY, 16777231 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        [ Result-Code ]
        [ Experimental-Result ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Globally-Unique-Address ]        ; bold
        [ Logical-Access-ID ]              ; bold ;; corrected: (ETSI-TS183.059-1.py#user-data-answer-logical-access-id-case)
        [ Physical-Access-ID ]             ; bold ;; corrected: (ETSI-TS183.059-1.py#user-data-answer-physical-access-id-case)
        [ Terminal-Type ]                  ; bold
        [ Access-Network-Type ]            ; bold
      * [ AVP ]
      * [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


;; Table 7.1's code cells print the vendor after the code, "601 13019", and its
;; Clause defined cells print "7.3" for all four rows.
; Type: AVP Table
; Section: 7.3
; Table: 7.1
; Page: 18
; Columns: Name      Code   Vendor-ID   Section   Type          Must   May   S.not   M.not   Encrypt
SIP-Outbound-Proxy   601    13019       7.3       OctetString   V      M     -       -       No
CNGCF-Address        600    13019       7.3       Grouped       V      M     -       -       No
TFTP-Server          602    13019       7.3       UTF8String    V      M     -       -       No
ACS-Server           603    13019       7.3       UTF8String    V      M     -       -       No
;; NOTE: The AVP header bit denoted as "M", indicates whether support of the AVP is required. The AVP header bit denoted as "V", indicates whether the optional Vendor-ID field is present in the AVP header.


;; Table 7.2 prints "See ES 283 035 [10]" in its Clause column and flag rules
;; "in the context of the present document": V in Must, M in May; May Encrypt
;; No.
; Type: Reused AVPs
; Section: 7.3
; Table: 7.2
; Page: 18
; Columns: Name   Code   From             Type
Terminal-Type     352    ETSI-ES283.035   OctetString


;; Table 7.3 prints "See ES 283 034 [9]" in its Clause column and flag rules
;; "in the context of the present document": V in Must, M in May; May Encrypt No
;; for all.
; Type: Reused AVPs
; Section: 7.3
; Table: 7.3
; Page: 19
; Columns: Name           Code   From             Type
Logical-Access-ID         302    ETSI-ES283.034   OctetString ;; corrected: (ETSI-TS183.059-1.py#logical-access-id-row-case)
Physical-Access-ID        313    ETSI-ES283.034   UTF8String ;; corrected: (ETSI-TS183.059-1.py#physical-access-id-row-case)
Access-Network-Type       306    ETSI-ES283.034   Grouped
IP-Connectivity-Status    305    ETSI-ES283.034   Enumerated
Globally-Unique-Address   300    ETSI-ES283.034   Grouped ;; inserted: (ETSI-TS183.059-1.py#globally-unique-address-reused)


;; Table 7.4 prints flag rules "in the context of the present document": M in
;; May, V in Must not; May Encrypt No. Clause 2.1 [8] is
;; draft-ietf-geopriv-radius-lo-24 (January 2008), "Carrying Location Objects in
;; RADIUS and Diameter"; clause 7.3.8 cites the same draft as -19.
; Type: Reused AVPs
; Section: 7.3
; Table: 7.4
; Page: 19
; Columns: Name   Code   From      Type
Location-Data     128    RFC5580   OctetString


; Type: Grouped AVP
; Name: CNGCF-Address
; Section: 7.3.5
; Page: 19
CNGCF-Address ::= < AVP header: 600 13019 >
        [ TFTP-Server ]
        [ ACS-Server ]
