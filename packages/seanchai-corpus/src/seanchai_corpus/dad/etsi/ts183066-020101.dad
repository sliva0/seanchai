;; Clause 7 and clause 7.4.4 say the same: "16777257 (allocated by IANA)".
; Type: Application Scope
; Name: a4
; Section: 6.6
; Page: 16
; Application-ID: 16777257
; Applies-To: 7.*


; Type: Message
; Name: User-Data-Request, UDR
; Section: 7.1.1
; Page: 17
<User-Data-Request> ::= < Diameter Header: 306, REQ, PXY, 16777257 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Destination-Host ]
        { Destination-Realm }
        [ Globally-Unique-Address ]        ; bold
        [ Logical-Access-ID ]              ; bold ;; corrected: (ETSI-TS183.066.py#user-data-request-logical-access-id-case)
        [ User-Name ]                      ; bold
      * [ AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


; Type: Message
; Name: User-Data-Answer, UDA
; Section: 7.1.2
; Page: 17
<User-Data-Answer> ::= < Diameter Header: 306, PXY, 16777257 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        [ Result-Code ]
        [ Experimental-Result ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Globally-Unique-Address ]          ; bold
        [ User-Name ]                        ; bold
        [ Logical-Access-ID ]                ; bold ;; corrected: (ETSI-TS183.066.py#user-data-answer-logical-access-id-case)
        [ Physical-Access-ID ]               ; bold ;; corrected: (ETSI-TS183.066.py#user-data-answer-physical-access-id-case)
        [ CNGCF-Address ]                    ; bold
        [ SIP-Outbound-Proxy ]               ; bold
        [ Initial-Gate-Setting-Description ] ; bold
      * [ QoS-Profile-Description ]          ; bold
        [ QoS-Profile-ID ]                   ; bold
        [ Initial-Gate-Setting-ID ]          ; bold
      * [ Privacy-Indicator ]                ; bold
      * [ AVP ]
      * [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


; Type: Message
; Name: Push-Notification-Request, PNR
; Section: 7.1.3
; Page: 18
<Push-Notification-Request> ::= < Diameter Header: 309, REQ, PXY, 16777257 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Host }
        { Destination-Realm }
        [ Globally-Unique-Address ]          ; bold
        [ User-Name ]                        ; bold
        [ Logical-Access-ID ]                ; bold ;; corrected: (ETSI-TS183.066.py#push-notification-request-logical-access-id-case)
        [ Physical-Access-ID ]               ; bold ;; corrected: (ETSI-TS183.066.py#push-notification-request-physical-access-id-case)
        [ CNGCF-Address ]                    ; bold
        [ SIP-Outbound-Proxy ]               ; bold
        [ Initial-Gate-Setting-Description ] ; bold
      * [ QoS-Profile-Description ]          ; bold
        [ QoS-Profile-ID ]                   ; bold
        [ Initial-Gate-Setting-ID ]          ; bold
      * [ Privacy-Indicator ]                ; bold
        [ Data-Operation-Indicator ]         ; bold
      * [ AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


; Type: Message
; Name: Push-Notification-Answer, PNA
; Section: 7.1.4
; Page: 18
<Push-Notification-Answer> ::= < Diameter Header: 309, PXY, 16777257 >
        < Session-Id >
        { Vendor-Specific-Application-Id }
        [ Result-Code ]
        [ Experimental-Result ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
      * [ AVP ]
      * [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


; Type: AVP Table
; Section: 7.3
