; Specification: 3GPP TS 29.173
; Version: 18.0.0
; Vendor-ID: 10415
; Bases: RFC6733
; Link: https://www.etsi.org/deliver/etsi_ts/129100_129199/129173/18.00.00_60/ts_129173v180000p.pdf


; Type: Message
; Name: LCS-Routing-Info-Request, RIR
; Section: 6.2.3
; Page: 14
<LCS-Routing-Info-Request> ::= < Diameter Header: 8388622, REQ, PXY, 16777291 >
        < Session-Id >
        [ Vendor-Specific-Application-Id ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Destination-Host ]
        { Destination-Realm }
        [ User-Name ]
        [ MSISDN ]
        [ GMLC-Number ]
      * [ Supported-Features ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: LCS-Routing-Info-Answer, RIA
; Section: 6.2.4
; Page: 15
<LCS-Routing-Info-Answer> ::= < Diameter Header: 8388622, PXY, 16777291 >
        < Session-Id >
        [ Vendor-Specific-Application-Id ]
        [ Result-Code ]
        [ Experimental-Result ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
      * [ Supported-Features ]
        [ User-Name ]
        [ MSISDN ]
        [ LMSI ]
        [ Serving-Node ]
      * [ Additional-Serving-Node ]
        [ GMLC-Address ]
        [ PPR-Address ]
        [ RIA-Flags ]
      * [ AVP ]
        [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]


