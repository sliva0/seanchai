; Type: Enumerated AVP
; Name: Abort-Cause
; Section: 5.3.1
; Page: 36
Abort-Cause ::= < Enumerated AVP header: 500 10415 >
        BEARER_RELEASED                        = 0
        INSUFFICIENT_SERVER_RESOURCES          = 1
        INSUFFICIENT_BEARER_RESOURCES          = 2
        PS_TO_CS_HANDOVER                      = 3
        SPONSORED_DATA_CONNECTIVITY_DISALLOWED = 4


; Type: Interpreted Constraints ;; interpreted: (TS29.214.dadx#access-network-charging-address-forwarding)
; AVP: Access-Network-Charging-Address
; Section: 5.3.2
; Page: 37
; Versions: 18.4.0..19.3.0
"The Access-Network-Charging-Address AVP should not be forwarded over an inter-operator interface."
    text-only


; Type: Grouped AVP
; Name: Access-Network-Charging-Identifier
; Section: 5.3.3
; Page: 37
Access-Network-Charging-Identifier ::= < AVP header: 502 10415 > ;; corrected: (TS29.214.py#vendor-id-access-network-charging-identifier)
        { Access-Network-Charging-Identifier-Value }
      * [ Flows ]


; Type: Interpreted Constraints ;; interpreted: (TS29.214.dadx#codec-data-layout)
; AVP: Codec-Data
; Section: 5.3.7
; Page: 38
; Versions: 18.4.0..19.3.0
"The first line of the value of the Codec-Data AVP shall consist of either the word \"uplink\" or the word \"downlink\" (in ASCII, without quotes) followed by a new-line character."
"The second line of the value of the Codec-Data AVP shall consist of either the word \"offer\" or the word \"answer\", or the word \"description\" (in ASCII, without quotes) followed by a new-line character."
"The rest of the value shall consist of SDP line(s) in ASCII encoding separated by new-line characters, as specified in IETF RFC 4566 [13]. The first of these line(s) shall be an \"m\" line."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.214.dadx#flow-description-rx)
; AVP: Flow-Description
; Section: 5.3.8
; Page: 38
; Versions: 18.4.0..19.3.0
"The Source Port may be omitted to indicate that any source port is allowed. Lists or ranges shall not be used."
"Only the Action \"permit\" shall be used."
"No \"options\" shall be used."
"The invert modifier \"!\" for addresses shall not be used."
"The keyword \"assigned\" shall not be used."
    encoding ip-filter from any port to any
"For the Rx interface, the Flow description AVP shall be used to describe a single IP flow."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.214.dadx#aaa-filter-restrictions)
; AVP: Experimental-Result
; Command: AA-Answer
; Section: 5.3.8
; Page: 38
; Versions: 18.4.0..19.3.0
"If any of these restrictions is not observed by the AF, the server shall send an error response to the AF containing the Experimental-Result-Code AVP with value FILTER_RESTRICTIONS."
    text-only


; Type: Grouped AVP
; Name: Flows
; Section: 5.3.10
; Page: 39
Flows ::= < AVP header: 510 10415 > ;; corrected: (TS29.214.py#vendor-id-flows)
        { Media-Component-Number }
      * [ Flow-Number ]
      * [ Content-Version ]
        [ Final-Unit-Action ]
        [ Media-Component-Status ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.214.dadx#flows-content-version)
; AVP: Content-Version
; Within: Flows
; Section: 5.3.10
; Page: 39
; Versions: 18.4.0..19.3.0
"The Content-Version AVP(s) shall be included if it was included in the Media-Component-Description AVP when the corresponding media component was provisioned."
    text-only


; Type: Enumerated AVP
; Name: Flow-Status
; Section: 5.3.11
; Page: 39
Flow-Status ::= < Enumerated AVP header: 511 10415 >
        ENABLED-UPLINK   = 0
        ENABLED-DOWNLINK = 1
        ENABLED          = 2
        DISABLED         = 3
        REMOVED          = 4


; Type: Enumerated AVP
; Name: Flow-Usage
; Section: 5.3.12
; Page: 40
Flow-Usage ::= < Enumerated AVP header: 512 10415 >
        NO_INFORMATION = 0
        RTCP           = 1
        AF_SIGNALLING  = 2


; Type: Interpreted Constraints ;; interpreted: (TS29.214.dadx#flow-usage-default)
; AVP: Flow-Usage
; Section: 5.3.12
; Page: 40
; Versions: 18.4.0..19.3.0
"NO_INFORMATION is the default value."
    default NO_INFORMATION


; Type: Enumerated AVP
; Name: Specific-Action
; Section: 5.3.13
; Page: 40
Specific-Action ::= < Enumerated AVP header: 513 10415 >
      ; VOID                                                = 0
        CHARGING_CORRELATION_EXCHANGE                       = 1
        INDICATION_OF_LOSS_OF_BEARER                        = 2
        INDICATION_OF_RECOVERY_OF_BEARER                    = 3
        INDICATION_OF_RELEASE_OF_BEARER                     = 4
      ; VOID                                                = 5
        IP-CAN_CHANGE                                       = 6
        INDICATION_OF_OUT_OF_CREDIT                         = 7
        INDICATION_OF_SUCCESSFUL_RESOURCES_ALLOCATION       = 8
        INDICATION_OF_FAILED_RESOURCES_ALLOCATION           = 9
        INDICATION_OF_LIMITED_PCC_DEPLOYMENT                = 10
        USAGE_REPORT                                        = 11
        ACCESS_NETWORK_INFO_REPORT                          = 12
        INDICATION_OF_RECOVERY_FROM_LIMITED_PCC_DEPLOYMENT  = 13
        INDICATION_OF_ACCESS_NETWORK_INFO_REPORTING_FAILURE = 14
        INDICATION_OF_TRANSFER_POLICY_EXPIRED               = 15
        PLMN_CHANGE                                         = 16
        EPS_FALLBACK                                        = 17
        INDICATION_OF_REALLOCATION_OF_CREDIT                = 18
        SUCCESSFUL_QOS_UPDATE                               = 19
        FAILED_QOS_UPDATE                                   = 20


; Type: Interpreted Constraints ;; interpreted: (TS29.214.dadx#aar-specific-action-initial)
; AVP: Specific-Action
; Command: AA-Request
; Section: 5.3.13
; Page: 40
; Versions: 18.4.0..19.3.0
"Non-one-time-specific-action value(s) may only be provided in the initial AA-Request and shall then be applicable for the entire lifetime of the Rx session."
    values 12, 21 if Rx-Request-Type = UPDATE_REQUEST


; Type: Interpreted Constraints ;; interpreted: (TS29.214.dadx#rar-charging-correlation)
; AVP: Access-Network-Charging-Identifier
; Command: RA-Request
; Section: 5.3.13
; Page: 40
; Versions: 18.4.0..19.3.0
"Within a RAR, this value shall be used when the server reports the access network charging identifier to the AF."
"The Access-Network-Charging-Identifier AVP shall be included within the request."
    present-if Specific-Action = CHARGING_CORRELATION_EXCHANGE


; Type: Interpreted Constraints ;; interpreted: (TS29.214.dadx#rar-flows)
; AVP: Flows
; Command: RA-Request
; Section: 5.3.13
; Page: 40
; Versions: 18.4.0..19.3.0
"Within a RAR, this value shall be used when the server reports a loss of a bearer (in the case of GPRS PDP context bandwidth modification to 0 kbit for GBR bearers) to the AF."
"The SDFs that are deactivated as a consequence of this loss of bearer shall be provided within the Flows AVP."
    present-if Specific-Action = INDICATION_OF_LOSS_OF_BEARER
"Within a RAR, this value shall be used when the server reports a recovery of a bearer (in the case of 3GPP-GPRS or 3GPP-EPS when PGW interoperates with a Gn/Gp SGSN, PDP context bandwidth modification from 0 kbit to another value for GBR bearers) to the AF."
"The SDFs that are re-activated as a consequence of the recovery of bearer shall be provided within the Flows AVP."
    present-if Specific-Action = INDICATION_OF_RECOVERY_OF_BEARER
"Within a RAR, this value shall be used when the server reports the release of a bearer (e.g. PDP context removal for 3GPP-GPRS or bearer/PDP context removal for 3GPP-EPS) to the AF."
"The SDFs that are deactivated as a consequence of this release of bearer shall be provided within the Flows AVP."
    present-if Specific-Action = INDICATION_OF_RELEASE_OF_BEARER
"Within a RAR, this value shall be used when the PCRF reports to the AF that SDFs have run out of credit, and that the termination action indicated by the corresponding Final-Unit-Action AVP applies (3GPP TS 32.240 [23] and 3GPP TS 32.299 [24]."
"The SDFs that are impacted as a consequence of the out of credit condition shall be provided within the Flows AVP."
    present-if Specific-Action = INDICATION_OF_OUT_OF_CREDIT
"Within a RAR, this value shall be used by the PCRF to indicate that the resources requested for particular service information have been successfully allocated."
"The SDFs corresponding to the resources successfully allocated shall be provided within the Flows AVP and the content version within the Content-Version AVP as included when the corresponding media component was provisioned."
    present-if Specific-Action = INDICATION_OF_SUCCESSFUL_RESOURCES_ALLOCATION
"Within a RAR, this value shall be used by the PCRF to indicate that the resources requested for a particular service information cannot be successfully allocated."
"The SDFs corresponding to the resources that could not be allocated shall be provided within the Flows AVP."
    present-if Specific-Action = INDICATION_OF_FAILED_RESOURCES_ALLOCATION
"Within a RAR, this value shall be used to report to the AF the SDFs for which credit has been reallocated after the former out of credit indication (3GPP TS 32.240 [23] and 3GPP TS 32.299 [24])."
"The SDFs that are impacted as a consequence of the reallocation of credit condition shall be provided within the Flows AVP."
    present-if Specific-Action = INDICATION_OF_REALLOCATION_OF_CREDIT
"If an IP-CAN type or RAT type change is due to IP flow mobility and a subset of the flows within the AF session is affected, the affected service data flows shall be provided in the same request."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.214.dadx#rar-ip-can-change-ip-can-type)
; AVP: IP-CAN-Type
; Command: RA-Request
; Section: 5.3.13
; Page: 40
; Versions: 18.4.0..19.3.0
"When used in RAR it indicates that the PCRF generated the request because of an IP-CAN or RAT change. IP-CAN-Type AVP, RAT-Type AVP (if applicable) ,AN-Trusted AVP (if applicable) and AN-GW-Address AVP (if applicable) shall be provided in the same request with the new/valid value(s)."
    present-if Specific-Action = IP-CAN_CHANGE and not MA-Information/IP-CAN-Type


; Type: Interpreted Constraints ;; interpreted: (TS29.214.dadx#rar-ip-can-change-rat-type)
; AVP: RAT-Type
; Command: RA-Request
; Section: 5.3.13
; Page: 40
; Versions: 18.4.0..19.3.0
"When used in RAR it indicates that the PCRF generated the request because of an IP-CAN or RAT change. IP-CAN-Type AVP, RAT-Type AVP (if applicable) ,AN-Trusted AVP (if applicable) and AN-GW-Address AVP (if applicable) shall be provided in the same request with the new/valid value(s)."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.214.dadx#rar-ip-can-change-an-trusted)
; AVP: AN-Trusted
