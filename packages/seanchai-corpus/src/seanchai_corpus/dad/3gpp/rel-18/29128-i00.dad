; Type: Value Table
; AVP: Experimental-Result-Code
; Kind: result-codes
; Section: 6.3
; Page: 38
DIAMETER_ERROR_UNAUTHORIZED_REQUESTING_ENTITY             = 5510 ; 6.3.3.1  from TS29.336
DIAMETER_ERROR_UNAUTHORIZED_SERVICE                       = 5511 ; 6.3.3.2  from TS29.336
DIAMETER_ERROR_CONFIGURATION_EVENT_STORAGE_NOT_SUCCESSFUL = 5513 ; 6.3.3.3  from TS29.336 ;; corrected: (TS29.128.py#configuration-event-storage-result-spelling)
DIAMETER_ERROR_CONFIGURATION_EVENT_NON_EXISTANT           = 5514 ; 6.3.3.4  from TS29.336
DIAMETER_ERROR_REQUESTED_LOCATION_NOT_SERVED              = 5650 ; 6.3.3.5
DIAMETER_ERROR_USER_UNKNOWN                               = 5001 ; 6.3.3.6  from TS29.229
DIAMETER_ERROR_OPERATION_NOT_ALLOWED                      = 5101 ; 6.3.3.7  from TS29.329
DIAMETER_ERROR_INVALID_EPS_BEARER                         = 5651 ; 6.3.3.8
DIAMETER_ERROR_NIDD_CONFIGURATION_NOT_AVAILABLE           = 5652 ; 6.3.3.9
DIAMETER_ERROR_SCEF_REFERENCE_ID_UNKNOWN                  = 5515 ; 6.3.3.10 ;; corrected: (TS29.128.py#scef-reference-id-result-spelling)
DIAMETER_ERROR_USER_TEMPORARILY_UNREACHABLE               = 5653 ; 6.3.3.11
DIAMETER_ERROR_UNREACHABLE_USER                           = 4221 ; 6.3.3.12 from TS29.172


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#ria-result-code-absent-with-experimental-result)
; AVP: Result-Code
; Command: Reporting-Information-Answer
; Section: 6.3.3
; Page: 38
; Versions: 18.0.0..19.2.0
"When one of the result codes defined here is included in a response, it shall be inside an Experimental-Result AVP and the Result-Code AVP shall be absent."
    absent-if Experimental-Result/Vendor-Id = 10415 and Experimental-Result/Experimental-Result-Code in DIAMETER_ERROR_UNAUTHORIZED_REQUESTING_ENTITY,
        DIAMETER_ERROR_UNAUTHORIZED_SERVICE,
        DIAMETER_ERROR_CONFIGURATION_EVENT_STORAGE_NOT_SUCCESSFUL,
        DIAMETER_ERROR_CONFIGURATION_EVENT_NON_EXISTANT,
        DIAMETER_ERROR_REQUESTED_LOCATION_NOT_SERVED,
        DIAMETER_ERROR_USER_UNKNOWN, DIAMETER_ERROR_OPERATION_NOT_ALLOWED,
        DIAMETER_ERROR_INVALID_EPS_BEARER,
        DIAMETER_ERROR_NIDD_CONFIGURATION_NOT_AVAILABLE,
        DIAMETER_ERROR_SCEF_REFERENCE_ID_UNKNOWN,
        DIAMETER_ERROR_USER_TEMPORARILY_UNREACHABLE,
        DIAMETER_ERROR_UNREACHABLE_USER
    exclude 4221, 5101, 5510, 5511, 5513, 5514, 5515, 5650, 5651, 5652, 5653


