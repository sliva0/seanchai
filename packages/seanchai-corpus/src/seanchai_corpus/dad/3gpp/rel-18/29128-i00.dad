; Type: Grouped AVP
; Name: Monitoring-Event-Configuration
; Section: 6.4.2
; Page: 43
Monitoring-Event-Configuration ::= < AVP header: 3122 10415 >
        [ SCEF-Reference-ID ]
        [ SCEF-Reference-ID-Ext ]
        { SCEF-ID }
        { Monitoring-Type }
      * [ SCEF-Reference-ID-for-Deletion ]
      * [ SCEF-Reference-ID-for-Deletion-Ext ]
        [ Maximum-Number-of-Reports ]
        [ Monitoring-Duration ]
        [ Charged-Party ]
        [ UE-Reachability-Configuration ]
        [ Location-Information-Configuration ]
      * [ Number-Of-UE-Per-Location-Configuration ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#monitoring-event-configuration-extended-reference-ids)
; AVP: SCEF-Reference-ID-Ext
; Within: Monitoring-Event-Configuration
; Section: 6.4.2
; Page: 43
; Versions: 18.0.0..19.2.0
"When the \"Extended Reference IDs\" feature is supported by the SCEF and MME/SGSN, the SCEF-Reference-ID-Ext and SCEF-Reference-ID-for-Deletion-Ext AVPs shall be used insted of SCEF-Reference-ID and SCEF-Reference-ID-for-Deletion respectively."
    text-only


; Type: Grouped AVP
; Name: Monitoring-Event-Report
; Section: 6.4.3
; Page: 43
Monitoring-Event-Report ::= < AVP header: 3123 10415 >
        { SCEF-Reference-ID }
        [ SCEF-Reference-ID-Ext ]
        [ SCEF-ID ]
        [ Monitoring-Type ]
        [ Reachability-Information ]
        [ EPS-Location-Information ]
        [ Communication-Failure-Information ]
      * [ Number-Of-UE-Per-Location-Report ]
        [ Loss-Of-Connectivity-Reason ]
        [ Visited-PLMN-Id ]
        [ Idle-Status-Indication ]
        [ Reporting-Time-Stamp ]
        [ Maximum-UE-Availability-Time ]
      * [ PDN-Connectivity-Status-Report ]
        [ Reachability-Cause ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Communication-Failure-Information
; Section: 6.4.4
; Page: 44
Communication-Failure-Information ::= < AVP header: 4300 10415 >
        [ Cause-Type ]
        [ S1AP-Cause ]
        [ RANAP-Cause ]
        [ BSSGP-Cause ]
        [ GMM-Cause ]
        [ SM-Cause ]
      * [ AVP ]


; Type: Value Table
; AVP: Cause-Type
; Kind: values
; Section: 6.4.5
; Page: 44
RADIO_NETWORK_LAYER = 0
TRANSPORT_LAYER     = 1
NAS                 = 2
PROTOCOL            = 3
MISCELLANEOUS       = 4


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#s1ap-cause-coding)
; AVP: S1AP-Cause
; Section: 6.4.6
; Page: 45
; Versions: 18.0.0..19.2.0
"It shall contain a non-transparent copy of the S1AP cause code as specified clause 9.2.1.3 of"
"TS 36.413 [13]."
    encoding element TS36.413 9.2.1.3 "Cause"


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#ranap-cause-coding)
; AVP: RANAP-Cause
; Section: 6.4.7
; Page: 45
; Versions: 18.0.0..19.2.0
"It shall contain the non-transparent copy of the cause value of the RANAP cause code as specified in clause 9.2.1.4 of"
"TS 25.413 [11]."
    encoding element TS25.413 9.2.1.4 "Cause"


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#bssgp-cause-coding)
; AVP: BSSGP-Cause
; Section: 6.4.8
; Page: 45
; Versions: 18.0.0..19.2.0
"It shall contain the non-transparent copy of the cause value of the BSSGP \"Cause\" as specified in clause 11.3.8 in"
"TS 48.018 [14]."
    encoding element TS48.018 11.3.8 "Cause"


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#gmm-cause-coding)
; AVP: GMM-Cause
; Section: 6.4.9
; Page: 45
; Versions: 18.0.0..19.2.0
"It shall contain the GMM cause code as specified in clause 10.5.5.14 of"
"TS 24.008 [12]."
    encoding element TS24.008 10.5.5.14 "GMM cause"


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#sm-cause-coding)
; AVP: SM-Cause
; Section: 6.4.10
; Page: 45
; Versions: 18.0.0..19.2.0
"It shall contain the SM cause code as specified in clause 10.5.6.6 and 10.5.6.6A of"
"TS 24.008 [12]."
    encoding element TS24.008 10.5.6.6 "SM cause"


; Type: Grouped AVP
; Name: Number-Of-UE-Per-Location-Configuration
; Section: 6.4.11
; Page: 45
Number-Of-UE-Per-Location-Configuration ::= < AVP header: 4306 10415 >
        { EPS-Location-Information }
        [ IMSI-Group-Id ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Number-Of-UE-Per-Location-Report
; Section: 6.4.12
; Page: 45
Number-Of-UE-Per-Location-Report ::= < AVP header: 4307 10415 >
        { EPS-Location-Information }
        { UE-Count }
        [ IMSI-Group-Id ]
      * [ AVP ]


; Type: Value Table
; AVP: Feature-List
; Kind: features
; Application: T6a/b
; Section: 6.4.14.1
; Table: 6.4.14.1-1
; Page: 46
MONTE                    = 0 ; O
NIDD                     = 1 ; O
Filtering                = 2 ; O
"Extended Reference IDs" = 3 ; O


; Type: Value Table
; AVP: Connection-Action
; Kind: values
; Section: 6.4.18
; Page: 47
CONNECTION_ESTABLISHMENT = 0
CONNECTION_RELEASE       = 1
CONNECTION_UPDATE        = 2


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#service-selection-labels)
; AVP: Service-Selection
; Section: 6.4.20
; Page: 47
; Versions: 18.0.0..19.2.0
"The contents of the Service-Selection AVP shall be formatted as a character string composed of one or more labels separated by dots (\".\")."
    encoding labels


; Type: Grouped AVP
; Name: Serving-PLMN-Rate-Control
; Section: 6.4.21
; Page: 47
Serving-PLMN-Rate-Control ::= < AVP header: 4310 10415 >
        [ Uplink-Rate-Limit ]
        [ Downlink-Rate-Limit ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#downlink-rate-limit-activated)
; AVP: Downlink-Rate-Limit
; Within: Serving-PLMN-Rate-Control
; Section: 6.4.21
; Page: 47
; Versions: 18.0.0..19.2.0
"A Downlink-Rate-Limit set to 0 shall be interpreted that the Serving PLMN Rate Control for downlink messages is deactivated in the MME."
"If the Serving PLMN Rate Control is activated, the value of Downlink-Rate-Limit shall not be less than 10"
    exclude 1, 2, 3, 4, 5, 6, 7, 8, 9


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#uplink-rate-limit-activated)
; AVP: Uplink-Rate-Limit
; Within: Serving-PLMN-Rate-Control
; Section: 6.4.21
; Page: 47
; Versions: 18.0.0..19.2.0
"An Uplink-Rate-Limit set ot 0 shall be interpreted that the Serving PLMN Rate Control for uplink messages is deactivated in the MME."
"If Serving PLMN Rate Control is activated, the value of Uplink-Rate-Limit shall not be less than 10"
    exclude 1, 2, 3, 4, 5, 6, 7, 8, 9


; Type: Value Table
; AVP: CMR-Flags
; Kind: bits
; Section: 6.4.25
; Table: 6.4.25/1
; Page: 48
UE-Reachable-Indicator = 0


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#cmr-flags-undefined-bits)
; AVP: CMR-Flags
; Section: 6.4.25
; Table: 6.4.25/1
; Page: 48
; Versions: 18.0.0..19.2.0
"NOTE 1: Bits not defined in this table shall be cleared by the sending entity and discarded by the receiving entity."
    bits only 0


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#extended-pco-value)
; AVP: Extended-PCO
; Section: 6.4.26
; Page: 48
; Versions: 18.0.0..19.2.0
"The Extended-PCO AVP shall contain the value part of the ePCO IE, starting from octet 4, as specified in clause 9.9.4.26 of"
"TS 24.301[28]."
    encoding element TS24.301 9.9.4.26 "Extended protocol configuration options"


; Type: Grouped AVP
; Name: RRC-Cause-Counter
; Section: 6.4.27
; Page: 48
RRC-Cause-Counter ::= < AVP header: 4318 10415 >
        [ Counter-Value ]
        [ RRC-Counter-Timestamp ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Terminal-Information
; Section: 6.4.30
; Page: 49
Terminal-Information ::= < AVP header: 1401 10415 >
        [ IMEI ]
        [ Software-Version ]
      * [ AVP ]


; Type: Value Table
; AVP: TDA-Flags
; Kind: bits
; Section: 6.4.31
; Table: 6.4.31-1
; Page: 49
"Acknowledged Delivery" = 0


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#tda-flags-undefined-bits)
; AVP: TDA-Flags
; Section: 6.4.31
; Table: 6.4.31-1
; Page: 49
; Versions: 18.0.0..19.2.0
"NOTE Bits not defined in this table shall be cleared by the sending entity and discarded by the receiving entity."
    bits only 0


; Type: Grouped AVP
; Name: Idle-Status-Indication
; Section: 6.4.32
; Page: 49
Idle-Status-Indication ::= < AVP header: 4322 10415 >
        [ Idle-Status-Timestamp ]
        [ Active-Time ]
        [ Subscribed-Periodic-RAU-TAU-Timer ]
        [ eDRX-Cycle-Length ]
        [ DL-Buffering-Suggested-Packet-Count ]
      * [ AVP ]


; Type: Value Table
; AVP: Reachability-Cause
; Kind: values
; Section: 6.4.35
; Page: 50
CHANGE_TO_CONNECTED_MODE = 0
REACHABLE_FOR_PAGING     = 1


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#uplink-number-of-packets-allowed-octets)
; AVP: Uplink-Number-Of-Packets-Allowed
; Section: 6.4.37
; Page: 51
; Versions: 18.0.0..19.2.0
"It shall contain information of octets k+1 to k+4 as specified in figure 8.38-10 of"
"TS 29.274 [33]."
    encoding element TS29.274 8.38 "Uplink number of packets allowed"


; Type: Interpreted Constraints ;; interpreted: (TS29.128.dadx#number-of-additional-exception-reports-octets)
; AVP: Number-Of-Additional-Exception-Reports
; Section: 6.4.38
; Page: 51
; Versions: 18.0.0..19.2.0
"It shall contain information of octets k+5 to k+8 as specified in figure 8.38-10 of"
