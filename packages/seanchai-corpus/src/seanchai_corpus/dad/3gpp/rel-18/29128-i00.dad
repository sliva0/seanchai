; Type: Message
; Name: Configuration-Information-Request, CIR
; Section: 6.2.3
; Page: 32
<Configuration-Information-Request> ::= < Diameter Header: 8388718, REQ, PXY, 16777346 >
        < Session-Id >
        [ DRMP ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Destination-Host ]
        { Destination-Realm }
      * [ Supported-Features ]
      * [ Monitoring-Event-Configuration ]
      * [ Monitoring-Event-Report ]
        [ User-Identifier ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: Configuration-Information-Answer, CIA
; Section: 6.2.4
; Page: 33
<Configuration-Information-Answer> ::= < Diameter Header: 8388718, PXY, 16777346 >
        < Session-Id >
        [ DRMP ]
        [ Result-Code ]
        [ Experimental-Result ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
      * [ Supported-Features ]
      * [ Monitoring-Event-Report ]
      * [ Monitoring-Event-Config-Status ]
        [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: Reporting-Information-Request, RIR
; Section: 6.2.5
; Page: 33
<Reporting-Information-Request> ::= < Diameter Header: 8388719, REQ, PXY, 16777346 >
        < Session-Id >
        [ DRMP ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Destination-Host ]
        { Destination-Realm }
        [ OC-Supported-Features ]
      * [ Supported-Features ]
        [ User-Identifier ]
      * [ Monitoring-Event-Report ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: Reporting-Information-Answer, RIA
; Section: 6.2.6
; Page: 34
<Reporting-Information-Answer> ::= < Diameter Header: 8388719, PXY, 16777346 >
        < Session-Id >
        [ DRMP ]
        [ Result-Code ]
        [ Experimental-Result ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ OC-Supported-Features ]
        [ OC-OLR ]
      * [ Load ]
      * [ Supported-Features ]
      * [ Monitoring-Event-Report-Status ]
        [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: Connection-Management-Request, CMR
; Section: 6.2.7
; Page: 35
<Connection-Management-Request> ::= < Diameter Header: 8388732, REQ, PXY, 16777346 >
        < Session-Id >
        < User-Identifier >
        < Bearer-Identifier >
        [ DRMP ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Destination-Host ]
        { Destination-Realm }
        [ OC-Supported-Features ]
        [ CMR-Flags ]
        [ Maximum-UE-Availability-Time ]
      * [ Supported-Features ]
        [ Connection-Action ]
        [ Service-Selection ]
        [ Serving-PLMN-Rate-Control ]
        [ Extended-PCO ]
        [ 3GPP-Charging-Characteristics ]
        [ RAT-Type ]
        [ Terminal-Information ]
        [ Visited-PLMN-Id ]
        [ APN-Rate-Control-Status ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: Connection-Management-Answer, CMA
; Section: 6.2.8
; Page: 35
<Connection-Management-Answer> ::= < Diameter Header: 8388732, PXY, 16777346 >
        < Session-Id >
        [ DRMP ]
        [ Result-Code ]
        [ Experimental-Result ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ OC-Supported-Features ]
        [ OC-OLR ]
      * [ Load ]
      * [ Supported-Features ]
        [ PDN-Connection-Charging-ID ] ;; corrected: (TS29.128.py#pdn-connection-charging-id-member-case)
        [ Extended-PCO ]
        [ APN-Rate-Control-Status ]
        [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


