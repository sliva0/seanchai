; Versions: 18.2.0..19.3.0
"When one of the result codes defined here is included in a response, it shall be inside an Experimental-Result AVP and the Result-Code AVP shall be absent."
    absent-if Experimental-Result/Experimental-Result-Code = DIAMETER_ERROR_USER_UNKNOWN or Experimental-Result/Experimental-Result-Code = DIAMETER_ERROR_ABSENT_USER or Experimental-Result/Experimental-Result-Code = DIAMETER_ERROR_USER_BUSY_FOR_MT_SMS or Experimental-Result/Experimental-Result-Code = DIAMETER_ERROR_FACILITY_NOT_SUPPORTED or Experimental-Result/Experimental-Result-Code = DIAMETER_ERROR_ILLEGAL_USER or Experimental-Result/Experimental-Result-Code = DIAMETER_ERROR_ILLEGAL_EQUIPMENT or Experimental-Result/Experimental-Result-Code = DIAMETER_ERROR_SM_DELIVERY_FAILURE or Experimental-Result/Experimental-Result-Code = DIAMETER_ERROR_SERVICE_NOT_SUBSCRIBED or Experimental-Result/Experimental-Result-Code = DIAMETER_ERROR_SERVICE_BARRED or Experimental-Result/Experimental-Result-Code = DIAMETER_ERROR_MWD_LIST_FULL


