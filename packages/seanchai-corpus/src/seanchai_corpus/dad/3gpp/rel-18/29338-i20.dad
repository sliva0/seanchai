; Type: Grouped AVP
; Name: Serving-Node
; Section: 5.3.3.6
; Page: 30
Serving-Node ::= < AVP header: 2401 10415 >
        [ SGSN-Name ]
        [ SGSN-Realm ]
        [ SGSN-Number ]
        [ MME-Name ]
        [ MME-Realm ]
        [ MME-Number-for-MT-SMS ]
        [ MSC-Number ]
        [ IP-SM-GW-Number ]
        [ IP-SM-GW-Name ]
        [ IP-SM-GW-Realm ]
        [ IP-SM-GW-SBI-Support-Indicator ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.338.dadx#serving-node-number)
; AVP: Serving-Node
; Section: 5.3.3.6
; Page: 30
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"a) SGSN-Number"
"c) MME-Name & MME-Realm & MME-Number-for-MT-SMS"
"d) MSC-Number"
"f) IP-SM-GW-Number"
    members at-least-one SGSN-Number MME-Number-for-MT-SMS MSC-Number IP-SM-GW-Number


; Type: Interpreted Constraints ;; interpreted: (TS29.338.dadx#serving-node-sgsn-number)
; AVP: SGSN-Number
; Within: Serving-Node
; Section: 5.3.3.6
; Page: 30
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"a) SGSN-Number"
"b) SGSN-Name & SGSN-Realm & SGSN-Number if the HSS supports the \"Gdd in SGSN\" feature and has received the \"Gdd in SGSN\" indication over S6a or Gr interface from the SGSN (cf. 3GPP TS 29.272 [4] and 3GPP TS 29.002 [9])"
    excludes MME-Name or MME-Realm or MME-Number-for-MT-SMS or MSC-Number or IP-SM-GW-Number or IP-SM-GW-Name or IP-SM-GW-Realm or IP-SM-GW-SBI-Support-Indicator


; Type: Interpreted Constraints ;; interpreted: (TS29.338.dadx#serving-node-sgsn-name)
; AVP: SGSN-Name
; Within: Serving-Node
; Section: 5.3.3.6
; Page: 30
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"b) SGSN-Name & SGSN-Realm & SGSN-Number if the HSS supports the \"Gdd in SGSN\" feature and has received the \"Gdd in SGSN\" indication over S6a or Gr interface from the SGSN (cf. 3GPP TS 29.272 [4] and 3GPP TS 29.002 [9])"
    requires SGSN-Realm and SGSN-Number


; Type: Interpreted Constraints ;; interpreted: (TS29.338.dadx#serving-node-sgsn-realm)
; AVP: SGSN-Realm
; Within: Serving-Node
; Section: 5.3.3.6
; Page: 30
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"b) SGSN-Name & SGSN-Realm & SGSN-Number if the HSS supports the \"Gdd in SGSN\" feature and has received the \"Gdd in SGSN\" indication over S6a or Gr interface from the SGSN (cf. 3GPP TS 29.272 [4] and 3GPP TS 29.002 [9])"
    requires SGSN-Name and SGSN-Number


; Type: Interpreted Constraints ;; interpreted: (TS29.338.dadx#serving-node-mme-name)
; AVP: MME-Name
; Within: Serving-Node
; Section: 5.3.3.6
; Page: 30
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"c) MME-Name & MME-Realm & MME-Number-for-MT-SMS"
"e) MSC-Number & MME-Name & MME-Realm"
    requires MME-Realm and MME-Number-for-MT-SMS or MME-Realm and MSC-Number


; Type: Interpreted Constraints ;; interpreted: (TS29.338.dadx#serving-node-mme-realm)
; AVP: MME-Realm
; Within: Serving-Node
; Section: 5.3.3.6
; Page: 30
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"c) MME-Name & MME-Realm & MME-Number-for-MT-SMS"
"e) MSC-Number & MME-Name & MME-Realm"
    requires MME-Name


; Type: Interpreted Constraints ;; interpreted: (TS29.338.dadx#serving-node-mme-number)
; AVP: MME-Number-for-MT-SMS
; Within: Serving-Node
; Section: 5.3.3.6
; Page: 30
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"c) MME-Name & MME-Realm & MME-Number-for-MT-SMS"
    requires MME-Name and MME-Realm
    excludes MSC-Number or IP-SM-GW-Number


; Type: Interpreted Constraints ;; interpreted: (TS29.338.dadx#serving-node-msc-number)
; AVP: MSC-Number
; Within: Serving-Node
; Section: 5.3.3.6
; Page: 30
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"d) MSC-Number"
"e) MSC-Number & MME-Name & MME-Realm"
    excludes IP-SM-GW-Number


; Type: Interpreted Constraints ;; interpreted: (TS29.338.dadx#serving-node-ip-sm-gw-name)
; AVP: IP-SM-GW-Name
; Within: Serving-Node
; Section: 5.3.3.6
; Page: 30
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"g) IP-SM-GW-Number & IP-SM-GW-Name"
"i) IP-SM-GW-Number & IP-SM-GW-Name & IP-SM-GW-SBI-Support-Indicator"
    requires IP-SM-GW-Number


; Type: Interpreted Constraints ;; interpreted: (TS29.338.dadx#serving-node-ip-sm-gw-sbi)
; AVP: IP-SM-GW-SBI-Support-Indicator
; Within: Serving-Node
; Section: 5.3.3.6
; Page: 30
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"h) IP-SM-GW-Number & IP-SM-GW-SBI-Support-Indicator"
"i) IP-SM-GW-Number & IP-SM-GW-Name & IP-SM-GW-SBI-Support-Indicator"
    requires IP-SM-GW-Number


; Type: Interpreted Constraints ;; interpreted: (TS29.338.dadx#serving-node-ip-sm-gw-realm)
; AVP: IP-SM-GW-Realm
; Within: Serving-Node
; Section: 5.3.3.6
; Page: 30
; Versions: 18.2.0..19.3.0
"The following combinations are allowed:"
"f) IP-SM-GW-Number"
"g) IP-SM-GW-Number & IP-SM-GW-Name"
"h) IP-SM-GW-Number & IP-SM-GW-SBI-Support-Indicator"
"i) IP-SM-GW-Number & IP-SM-GW-Name & IP-SM-GW-SBI-Support-Indicator"
    text-only


