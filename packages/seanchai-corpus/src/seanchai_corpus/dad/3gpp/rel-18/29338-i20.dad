DIAMETER_ERROR_USER_UNKNOWN           = 5001 ; 7.3.2
DIAMETER_ERROR_ABSENT_USER            = 5550 ; 7.3.3
DIAMETER_ERROR_USER_BUSY_FOR_MT_SMS   = 5551 ; 7.3.4
DIAMETER_ERROR_FACILITY_NOT_SUPPORTED = 5552 ; 7.3.5
DIAMETER_ERROR_ILLEGAL_USER           = 5553 ; 7.3.6
DIAMETER_ERROR_ILLEGAL_EQUIPMENT      = 5554 ; 7.3.7
DIAMETER_ERROR_SM_DELIVERY_FAILURE    = 5555 ; 7.3.8
