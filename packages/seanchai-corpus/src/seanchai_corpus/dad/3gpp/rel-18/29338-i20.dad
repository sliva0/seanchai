; Versions: 18.2.0..19.3.0
"This AVP contains an SMSF-Non-3GPP-Number in international number format as described in ITU-T Rec E.164 [13] and shall be encoded as a TBCD-string."
"This AVP shall not include leading indicators for the nature of address and the numbering plan; it shall contain only the TBCD-encoded digits of the address."
    encoding e164-tbcd


; Type: Grouped AVP
; Name: SMSF-3GPP-Address
; Section: 5.3.3.35
; Page: 36
SMSF-3GPP-Address ::= < AVP header: 3344 10415 >
        [ SMSF-3GPP-Number ]
        [ SMSF-3GPP-Name ]
        [ SMSF-3GPP-Realm ]
        [ SMSF-3GPP-SBI-Support-Indicator ]
      * [ AVP ]


; Type: Grouped AVP
; Name: SMSF-Non-3GPP-Address
; Section: 5.3.3.36
; Page: 36
SMSF-Non-3GPP-Address ::= < AVP header: 3345 10415 >
        [ SMSF-Non-3GPP-Number ]
        [ SMSF-Non-3GPP-Name ]
        [ SMSF-Non-3GPP-Realm ]
        [ SMSF-Non-3GPP-SBI-Support-Indicator ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: SMSF-3GPP-SBI-Support-Indicator
; Section: 5.3.3.37
; Page: 36
SMSF-3GPP-SBI-Support-Indicator ::= < Enumerated AVP header: 3346 10415 >
        NOT_SUPPORT_SBI = 0
        SUPPORT_SBI     = 1


; Type: Enumerated AVP
; Name: SMSF-Non-3GPP-SBI-Support-Indicator
; Section: 5.3.3.38
; Page: 37
SMSF-Non-3GPP-SBI-Support-Indicator ::= < Enumerated AVP header: 3347 10415 >
        NOT_SUPPORT_SBI = 0
        SUPPORT_SBI     = 1


; Type: Enumerated AVP
; Name: IP-SM-GW-SBI-Support-Indicator
; Section: 5.3.3.39
; Page: 37
IP-SM-GW-SBI-Support-Indicator ::= < Enumerated AVP header: 3348 10415 >
        NOT_SUPPORT_SBI = 0
        SUPPORT_SBI     = 1


