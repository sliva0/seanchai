; Type: Grouped AVP
; Name: PC5-Flow-Bitrates
; Section: 7.3.239
; Page: 174
PC5-Flow-Bitrates ::= < AVP header: 1714 10415 >
        [ Guaranteed-Flow-Bitrates ]
        [ Maximum-Flow-Bitrates ]


; Type: Grouped AVP
; Name: MDT-Configuration-NR
; Section: 7.3.245
; Page: 174
MDT-Configuration-NR ::= < AVP header: 1720 10415 >
        { Job-Type }
        [ Area-Scope ]
        [ List-Of-Measurements ]
        [ Reporting-Trigger ]
        [ Report-Interval ]
        [ Report-Amount ]
        [ Event-Threshold-RSRP ]
        [ Event-Threshold-RSRQ ]
        [ Event-Threshold-SINR ]
        [ Collection-Period-RRM-NR ]
        [ Collection-Period-M6-NR ]
        [ Collection-Period-M7-NR ]
        [ Positioning-Method ]
      * [ Sensor-Measurement ]
      * [ MDT-Allowed-PLMN-Id ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#event-threshold-sinr-element)
; AVP: Event-Threshold-SINR
; Section: 7.3.246
; Page: 175
; Versions: 18.7.0..19.6.0
"See TS 32.422 [23] for allowed values"
    encoding element TS32.422


; Type: Enumerated AVP
; Name: Collection-Period-RRM-NR
; Section: 7.3.247
; Page: 175
; Values: TS 32.422 [23] for Collection period for RRM measurements NR
Collection-Period-RRM-NR ::= < Enumerated AVP header: 1722 10415 >


; Type: Enumerated AVP
; Name: Collection-Period-M6-NR
; Section: 7.3.248
; Page: 175
; Values: TS 32.422 [23] for Collection period M6 in NR
Collection-Period-M6-NR ::= < Enumerated AVP header: 1723 10415 >


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#collection-period-m7-nr-element)
; AVP: Collection-Period-M7-NR
; Section: 7.3.249
; Page: 175
; Versions: 18.7.0..19.6.0
"The possible values are those defined in TS 32.422 [23] for Collection period M7 in NR in units of minutes."
    encoding element TS32.422 "Collection period M7 in NR"


; Type: Enumerated AVP
; Name: Sensor-Measurement
; Section: 7.3.250
; Page: 175
Sensor-Measurement ::= < Enumerated AVP header: 1725 10415 >
        BAROMETRIC_PRESSURE = 0
        UE_SPEED            = 1
        UE_ORIENTATION      = 2


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#nr-cell-global-identity-element)
; AVP: NR-Cell-Global-Identity
; Section: 7.3.251
; Page: 176
; Versions: 18.7.0..19.6.0
"Octets are coded as described in TS 29.002 [24]."
    encoding element TS29.002


