; Table: 7.3.182/1
; Page: 157
"WLAN offloadability for E-UTRAN" = 0


; Type: Value Table
; AVP: WLAN-offloadability-UTRAN
; Kind: bits
; Section: 7.3.183
; Table: 7.3.183/1
; Page: 157
"WLAN offloadability for UTRAN" = 0


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#mdt-allowed-plmn-id-layout)
; AVP: MDT-Allowed-PLMN-Id
; Section: 7.3.185
; Page: 157
; Versions: 18.7.0..19.6.0
"This AVP shall contain the concatenation of MCC and MNC."
"The content of this AVP shall be encoded as an octet string according to table 7.3.185/1."
"If MNC is 2 digits long, bits 5 to 8 of octet 2 are coded as \"1111\"."
    encoding plmn-id


; Type: Grouped AVP
; Name: Adjacent-PLMNs
; Section: 7.3.186
; Page: 158
Adjacent-PLMNs ::= < AVP header: 1672 10415 >
     1* { Visited-PLMN-Id }
      * [ AVP ]


; Type: Grouped AVP
; Name: Adjacent-Access-Restriction-Data
; Section: 7.3.187
; Page: 158
Adjacent-Access-Restriction-Data ::= < AVP header: 1673 10415 >
        { Visited-PLMN-Id }
        { Access-Restriction-Data }
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#dl-buffering-suggested-packet-count-range)
; AVP: DL-Buffering-Suggested-Packet-Count
; Section: 7.3.188
; Page: 158
; Versions: 18.7.0..19.6.0
"\"Extended DL Data Buffering NOT REQUESTED\" 0"
"\"Extended DL Data Buffering REQUESTED, without a suggested number of packets\" -1"
"\"Extended DL Data Buffering REQUESTED, with a suggested number of packets\" > 0"
    range -1..*


; Type: Grouped AVP
; Name: IMSI-Group-Id
; Section: 7.3.189
; Page: 159
IMSI-Group-Id ::= < AVP header: 1675 10415 >
        { Group-Service-Id }
        { Group-PLMN-Id }
        { Local-Group-Id }
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#group-service-id-operator-range)
; AVP: Group-Service-Id
; Section: 7.3.190
; Page: 159
; Versions: 18.7.0..19.6.0
"IMSI-Group-IDs with a Group-Service-Id in this range shall not be sent outside the HPLMN unless roaming agreements allow so."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#group-plmn-id-layout)
; AVP: Group-PLMN-Id
; Section: 7.3.191
; Page: 159
; Versions: 18.7.0..19.6.0
"This AVP shall contain the concatenation of MCC and MNC."
"The content of this AVP shall be encoded as an octet string according to table 7.3.191-1."
"If MNC is 2 digits long, bits 5 to 8 of octet 2 are coded as \"1111\"."
    encoding plmn-id


; Type: Grouped AVP
; Name: AESE-Communication-Pattern
; Section: 7.3.193
; Page: 159
AESE-Communication-Pattern ::= < AVP header: 3113 10415 >
        [ SCEF-Reference-ID ]
        [ SCEF-Reference-ID-Ext ]
        { SCEF-ID }
      * [ SCEF-Reference-ID-for-Deletion ]
      * [ SCEF-Reference-ID-for-Deletion-Ext ]
      * [ Communication-Pattern-Set ]
        [ MTC-Provider-Info ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Communication-Pattern-Set
; Section: 7.3.194
; Page: 160
Communication-Pattern-Set ::= < AVP header: 3114 10415 >
        [ Periodic-Communication-Indicator ]
        [ Communication-Duration-Time ]
        [ Periodic-Time ]
      * [ Scheduled-Communication-Time ]
        [ Stationary-Indication ]
        [ Reference-ID-Validity-Time ]
        [ Traffic-Profile ]
        [ Battery-Indicator ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Monitoring-Event-Configuration
; Section: 7.3.195
; Page: 160
Monitoring-Event-Configuration ::= < AVP header: 3122 10415 >
        [ SCEF-Reference-ID ]
        [ SCEF-Reference-ID-Ext ]
        { SCEF-ID }
        { Monitoring-Type }
      * [ SCEF-Reference-ID-for-Deletion ]
      * [ SCEF-Reference-ID-for-Deletion-Ext ]
        [ Maximum-Number-of-Reports ]
        [ Monitoring-Duration ]
        [ Charged-Party ]
        [ UE-Reachability-Configuration ]
        [ Location-Information-Configuration ]
        [ SCEF-Realm ]
        [ External-Identifier ]
        [ MTC-Provider-Info ]
        [ PDN-Connectivity-Status-Configuration ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#monitoring-event-configuration-scef-realm)
; AVP: SCEF-Realm
; Within: Monitoring-Event-Configuration
; Section: 7.3.195
; Page: 160
; Versions: 18.7.0..19.6.0
"When the Monitoring-Event-Configuration AVP is used over the S6a/S6d interfaces, the SCEF-Realm AVP shall be present"
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#monitoring-event-configuration-monitoring-type)
; AVP: Monitoring-Type
; Within: Monitoring-Event-Configuration
; Section: 7.3.195
; Page: 160
; Versions: 18.7.0..19.6.0
"Monitoring-Type AVP shall be ignored for deletion of an event (i.e. when SCEF-Reference-ID-for-Deletion/SCEF-Reference-ID-for-Deletion-Ext AVP is present)."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#monitoring-event-configuration-maximum-number-of-reports)
; AVP: Maximum-Number-of-Reports
; Within: Monitoring-Event-Configuration
; Section: 7.3.195
; Page: 160
; Versions: 18.7.0..19.6.0
"Maximum-Number-of-Reports shall not be present over S6a/S6d interfaces if Monitoring-Type is AVAILABILITY_AFTER_DDN_FAILURE (6)."
    absent-if Monitoring-Type = 6
"Maximum-Number-of-Reports shall not be greater than one over S6a/S6d interfaces if Monitoring-Type is LOCATION_REPORTING (2) and MONTE-Location-Type is LAST_KNOWN_LOCATION (1)."
    text-only


; Type: Grouped AVP
; Name: Monitoring-Event-Report
; Section: 7.3.196
; Page: 161
Monitoring-Event-Report ::= < AVP header: 3123 10415 >
        { SCEF-Reference-ID }
        [ SCEF-Reference-ID-Ext ]
        [ SCEF-ID ]
        [ Reachability-Information ]
        [ Reachability-Cause ]
        [ EPS-Location-Information ]
        [ Monitoring-Type ]
        [ Loss-Of-Connectivity-Reason ]
        [ Idle-Status-Indication ]
        [ Maximum-UE-Availability-Time ]
      * [ PDN-Connectivity-Status-Report ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#monitoring-event-report-reachability-information)
; AVP: Reachability-Information
; Within: Monitoring-Event-Report
; Section: 7.3.196
; Page: 161
; Versions: 18.7.0..19.6.0
"For S6a/S6d interface, when the Monitoring-Type AVP takes the value UE_REACHABILITY (1), the Reachability-Information AVP shall take the value REACHABLE_FOR_DATA (1)"
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#monitoring-event-report-pdn-connectivity)
; AVP: PDN-Connectivity-Status-Report
; Within: Monitoring-Event-Report
; Section: 7.3.196
; Page: 161
; Versions: 18.7.0..19.6.0
"each PDN-Connectivity-Status-Report shall have the PDN-Connectivity-Status-Type set to value \"CREATED (0)\"."
    text-only


; Type: Grouped AVP
; Name: UE-Reachability-Configuration
; Section: 7.3.197
; Page: 162
UE-Reachability-Configuration ::= < AVP header: 3129 10415 >
        [ Reachability-Type ]
        [ Maximum-Response-Time ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#ue-reachability-configuration-reachability-type)
; AVP: Reachability-Type
; Within: UE-Reachability-Configuration
; Section: 7.3.197
; Page: 162
; Versions: 18.7.0..19.6.0
"For S6a/S6d interface, the Reachability-Type AVP shall have bit 0 (\"Reachability for SMS\") cleared, and it shall have bit 1 (\"Reachability for Data\") set."
    text-only


; Type: Grouped AVP
; Name: Supported-Services
; Section: 7.3.199
; Page: 163
Supported-Services ::= < AVP header: 3143 10415 >
        [ Supported-Monitoring-Events ]
      * [ AVP ]


