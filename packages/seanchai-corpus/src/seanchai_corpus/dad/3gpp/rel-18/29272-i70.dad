; AVP: Supported-Monitoring-Events
; Kind: bits
; Section: 7.3.200
; Table: 7.3.200-1
; Page: 163
"UE and UICC and/or new IMSI-IMEI-SV association" = 0
UE-reachability                                   = 1
Location-of-the-UE                                = 2
Loss-of-connectivity                              = 3
Communication-failure                             = 4
Roaming-status                                    = 5
"Availability after DDN failure"                  = 6
"Idle Status Indication"                          = 7
"PDN Connectivity Status"                         = 8


; Type: Value Table
; AVP: AIR-Flags
; Kind: bits
; Section: 7.3.201
; Table: 7.3.201/1
; Page: 163
"Send UE Usage Type" = 0


