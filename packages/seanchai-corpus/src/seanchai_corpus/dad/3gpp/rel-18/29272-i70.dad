; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#nor-mip6-agent-info)
; AVP: MIP6-Agent-Info
; Command: Notify-Request
; Section: 5.2.5.1.1
; Table: 5.2.5.1.1/1
; Page: 53
; Versions: 18.7.0..19.6.0
