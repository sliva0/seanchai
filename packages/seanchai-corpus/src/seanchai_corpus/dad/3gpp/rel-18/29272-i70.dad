; Type: Grouped AVP
; Name: APN-Configuration
; Section: 7.3.35
; Page: 126
APN-Configuration ::= < AVP header: 1430 10415 >
        { Context-Identifier }
     *2 [ Served-Party-IP-Address ]
        { PDN-Type }
        { Service-Selection }
        [ EPS-Subscribed-QoS-Profile ]
        [ VPLMN-Dynamic-Address-Allowed ]
        [ MIP6-Agent-Info ]
        [ Visited-Network-Identifier ]
        [ PDN-GW-Allocation-Type ]
        [ 3GPP-Charging-Characteristics ]
        [ AMBR ]
      * [ Specific-APN-Info ]
        [ APN-OI-Replacement ]
        [ SIPTO-Permission ]
        [ LIPA-Permission ]
        [ Restoration-Priority ]
        [ SIPTO-Local-Network-Permission ]
        [ WLAN-offloadability ]
        [ Non-IP-PDN-Type-Indicator ]
        [ Non-IP-Data-Delivery-Mechanism ]
        [ SCEF-ID ]
        [ SCEF-Realm ]
        [ Preferred-Data-Mode ]
        [ PDN-Connection-Continuity ]
        [ RDS-Indicator ]
        [ Interworking-5GS-Indicator ]
        [ Ethernet-PDN-Type-Indicator ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#apn-configuration-context-identifier)
; AVP: Context-Identifier
; Within: APN-Configuration
; Section: 7.3.35
; Page: 126
; Versions: 18.7.0..19.6.0
"The Context-Identifier in the APN-Configuration AVP shall identify that APN configuration, and it shall not have a value of zero."
    exclude 0
"Furthermore, the Context-Identifier in the APN-Configuration AVP shall uniquely identify the EPS APN configuration per subscription."
    text-only
"NOTE: If interworking with MAP is needed, the Context-Identifier will be in the range of 1 and 50."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#apn-configuration-service-selection)
; AVP: Service-Selection
; Within: APN-Configuration
; Section: 7.3.35
; Page: 126
; Versions: 18.7.0..19.6.0
"For a particular EPS user having multiple APN configurations, the Service-Selection AVP values shall be unique across APN-Configuration AVPs."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#apn-configuration-served-party-ip-address)
; AVP: Served-Party-IP-Address
; Within: APN-Configuration
; Section: 7.3.35
; Page: 126
; Versions: 18.7.0..19.6.0
"These AVPs shall be present if static IP address allocation is used for the UE"
    text-only
"For the IPv6 prefix, the lower 64 bits of the address shall be set to zero."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#apn-configuration-pdn-gw-allocation-type)
; AVP: PDN-GW-Allocation-Type
; Within: APN-Configuration
; Section: 7.3.35
; Page: 126
; Versions: 18.7.0..19.6.0
"The PDN-GW-Allocation-Type AVP applies to the MIP6-Agent-Info AVP. Therefore, it shall not be present if MIP6-Agent-Info is not present."
    requires MIP6-Agent-Info


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#apn-configuration-non-ip-delivery)
; AVP: Non-IP-Data-Delivery-Mechanism
; Within: APN-Configuration
; Section: 7.3.35
; Page: 126
; Versions: 18.7.0..19.6.0
"The Non-IP-Data-Delivery-Mechanism shall only be present when Non-IP-PDN-Type-Indicator is set to TRUE (1)."
    requires Non-IP-PDN-Type-Indicator = TRUE


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#apn-configuration-scef-id)
; AVP: SCEF-ID
; Within: APN-Configuration
; Section: 7.3.35
; Page: 126
; Versions: 18.7.0..19.6.0
"The SCEF-ID AVP and the SCEF-Realm AVP shall only be present when Non-IP-PDN-Type-Indicator is set to TRUE (1), and Non-IP-Data-Delivery-Mechanism is set to SCEF-BASED-DATA-DELIVERY (1)."
    requires Non-IP-PDN-Type-Indicator = TRUE
    requires Non-IP-Data-Delivery-Mechanism = 1


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#apn-configuration-scef-realm)
; AVP: SCEF-Realm
; Within: APN-Configuration
; Section: 7.3.35
; Page: 126
; Versions: 18.7.0..19.6.0
"The SCEF-ID AVP and the SCEF-Realm AVP shall only be present when Non-IP-PDN-Type-Indicator is set to TRUE (1), and Non-IP-Data-Delivery-Mechanism is set to SCEF-BASED-DATA-DELIVERY (1)."
    requires Non-IP-PDN-Type-Indicator = TRUE
    requires Non-IP-Data-Delivery-Mechanism = 1


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#service-selection-apn)
; AVP: Service-Selection
; Section: 7.3.36
; Page: 128
; Versions: 18.7.0..19.6.0
"The contents of the Service-Selection AVP shall be formatted as a character string composed of one or more labels separated by dots (\".\"), or as the wild card APN, i.e., consisting of only one ASCII label, \"*\"."
    encoding apn


; Type: Grouped AVP
; Name: EPS-Subscribed-QoS-Profile
; Section: 7.3.37
; Page: 128
EPS-Subscribed-QoS-Profile ::= < AVP header: 1431 10415 >
        { QoS-Class-Identifier }
        { Allocation-Retention-Priority }
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#eps-subscribed-qos-profile-non-gbr)
; AVP: QoS-Class-Identifier
; Within: EPS-Subscribed-QoS-Profile
; Section: 7.3.37
; Page: 128
; Versions: 18.7.0..19.6.0
"values QCI_1, QCI_2, QCI_3 and QCI_4, which are associated to GBR bearers, cannot be sent over S6a/S6d."
    exclude 1, 2, 3, 4
"The values allowed for this AVP over the S6a/S6d interface are only those associated to non-GBR bearers, as indicated in TS 23.008 [30]"
    text-only


; Type: Enumerated AVP
; Name: VPLMN-Dynamic-Address-Allowed
; Section: 7.3.38
; Page: 128
VPLMN-Dynamic-Address-Allowed ::= < Enumerated AVP header: 1432 10415 >
        NOTALLOWED = 0
        ALLOWED    = 1


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#stn-sr-e164)
; AVP: STN-SR
; Section: 7.3.39
; Page: 129
; Versions: 18.7.0..19.6.0
"This AVP contains an STN-SR, in international number format as described in ITU-T Rec E.164 [41], encoded as a TBCD-string."
"This AVP shall not include leading indicators for the nature of address and the numbering plan; it shall contain only the TBCD-encoded digits of the address."
    encoding e164-tbcd


; Type: Grouped AVP
; Name: Allocation-Retention-Priority
; Section: 7.3.40
; Page: 129
Allocation-Retention-Priority ::= < AVP header: 1034 10415 >
        { Priority-Level }
        [ Pre-emption-Capability ]
        [ Pre-emption-Vulnerability ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#allocation-retention-priority-pre-emption-capability-default)
; AVP: Pre-emption-Capability
; Within: Allocation-Retention-Priority
; Section: 7.3.40
; Page: 129
; Versions: 18.7.0..19.6.0
"If the Pre-emption-Capability AVP is not present in the Allocation-Retention-Priority AVP, the default value shall be PRE-EMPTION_CAPABILITY_DISABLED (1)."
    default PRE-EMPTION_CAPABILITY_DISABLED


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#allocation-retention-priority-pre-emption-vulnerability-default)
; AVP: Pre-emption-Vulnerability
; Within: Allocation-Retention-Priority
; Section: 7.3.40
; Page: 129
; Versions: 18.7.0..19.6.0
"If the Pre-emption-Vulnerability AVP is not present in the Allocation-Retention-Priority AVP, the default value shall be PRE-EMPTION_VULNERABILITY_ENABLED (0)."
    default PRE-EMPTION_VULNERABILITY_ENABLED


; Type: Grouped AVP
; Name: AMBR
; Section: 7.3.41
; Page: 129
AMBR ::= < AVP header: 1435 10415 >
        { Max-Requested-Bandwidth-UL }
        { Max-Requested-Bandwidth-DL }
        [ Extended-Max-Requested-BW-UL ]
        [ Extended-Max-Requested-BW-DL ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#ambr-extended-max-requested-bw-ul)
; AVP: Extended-Max-Requested-BW-UL
; Within: AMBR
; Section: 7.3.41
; Page: 129
; Versions: 18.7.0..19.6.0
"When the maximum bandwidth value to be set for UL (or DL, respectively) traffic is lower than 4294967296 bits per second, the Max-Requested-Bandwidth-UL (or -DL, respectively) AVP shall be present, and set to the requested bandwidth value in bits per second, and the Extended-Max-Requested-BW-UL (or -DL, respectively) AVP shall be absent."
"When the maximum bandwidth value to be set for UL (or DL, respectively) traffic is higher than 4294967295 bits per second, the Max-Requested-Bandwidth-UL (or DL, respectively) AVP shall be present, and set to its upper limit 4294967295"
    requires Max-Requested-Bandwidth-UL = 4294967295


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#ambr-extended-max-requested-bw-dl)
; AVP: Extended-Max-Requested-BW-DL
; Within: AMBR
; Section: 7.3.41
; Page: 129
; Versions: 18.7.0..19.6.0
"When the maximum bandwidth value to be set for UL (or DL, respectively) traffic is lower than 4294967296 bits per second, the Max-Requested-Bandwidth-UL (or -DL, respectively) AVP shall be present, and set to the requested bandwidth value in bits per second, and the Extended-Max-Requested-BW-UL (or -DL, respectively) AVP shall be absent."
"When the maximum bandwidth value to be set for UL (or DL, respectively) traffic is higher than 4294967295 bits per second, the Max-Requested-Bandwidth-UL (or DL, respectively) AVP shall be present, and set to its upper limit 4294967295"
    requires Max-Requested-Bandwidth-DL = 4294967295


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#mip-home-agent-host-destination-host)
; AVP: Destination-Host
; Within: MIP-Home-Agent-Host
; Section: 7.3.43
; Page: 130
; Versions: 18.7.0..19.6.0
"Destination-Host shall contain the hostname of the PDN-GW, formatted as described in TS 29.303 [38], clause 4.3.2."
    encoding element TS29.303 4.3.2


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#mip-home-agent-host-destination-realm)
; AVP: Destination-Realm
; Within: MIP-Home-Agent-Host
; Section: 7.3.43
; Page: 130
; Versions: 18.7.0..19.6.0
"Destination-Realm shall be formatted as:"
"epc.mnc<MNC>.mcc<MCC>.3gppnetwork.org"
    encoding epc-plmn-domain


; Type: Enumerated AVP
; Name: PDN-GW-Allocation-Type
; Section: 7.3.44
; Page: 130
PDN-GW-Allocation-Type ::= < Enumerated AVP header: 1438 10415 >
        STATIC  = 0
        DYNAMIC = 1


; Type: Grouped AVP
; Name: MIP6-Agent-Info
; Section: 7.3.45
; Page: 130
MIP6-Agent-Info ::= < AVP header: 486 >
     *2 [ MIP-Home-Agent-Address ]
        [ MIP-Home-Agent-Host ]
        [ MIP6-Home-Link-Prefix ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#mip6-agent-info-fqdn-preferred)
; AVP: MIP-Home-Agent-Host
; Within: MIP6-Agent-Info
; Section: 7.3.45
; Page: 130
; Versions: 18.7.0..19.6.0
"FQDN shall be used if known to the MME/SGSN/HSS."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#mip6-agent-info-home-link-prefix)
; AVP: MIP6-Home-Link-Prefix
; Within: MIP6-Agent-Info
; Section: 7.3.45
; Page: 130
; Versions: 18.7.0..19.6.0
"The AVP MIP6-Home-Link-Prefix is not used in S6a/S6d, but it is included here to reflect the complete IETF definition of the grouped AVP."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#rat-frequency-selection-priority-id-range)
; AVP: RAT-Frequency-Selection-Priority-ID
; Section: 7.3.46
; Page: 131
; Versions: 18.7.0..19.6.0
"Values shall be in the range of 1 to 256."
    range 1..256


; Type: Value Table
; AVP: IDA-Flags
; Kind: bits
; Section: 7.3.47
; Table: 7.3.47/1
; Page: 131
"Network Node area restricted" = 0


; Type: Value Table
; AVP: PUA-Flags
; Kind: bits
; Section: 7.3.48
; Table: 7.3.48/1
; Page: 131
"Freeze M-TMSI" = 0
"Freeze P-TMSI" = 1


; Type: Value Table
; AVP: NOR-Flags
; Kind: bits
; Section: 7.3.49
; Table: 7.3.49/1
; Page: 131
Single-Registration-Indication                      = 0
"SGSN area restricted"                              = 1
"Ready for SM from SGSN"                            = 2
"UE Reachable from MME"                             = 3
Reserved                                            = 4
"UE Reachable from SGSN"                            = 5
"Ready for SM from MME"                             = 6
"Homogeneous Support of IMS Voice Over PS Sessions" = 7
"S6a/S6d-Indicator"                                 = 8
"Removal of MME Registration for SMS"               = 9


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#user-id-digits)
; AVP: User-Id
; Section: 7.3.50
; Page: 132
; Versions: 18.7.0..19.6.0
"It shall contain the leading digits of an IMSI (i.e. MCC, MNC, leading digits of MSIN, see TS 23.003 [3], clause 2.2) formatted as a character string."
    encoding digits


; Type: Enumerated AVP
; Name: Equipment-Status
; Section: 7.3.51
; Page: 132
Equipment-Status ::= < Enumerated AVP header: 1445 10415 >
        PERMITTEDLISTED  = 0
        PROHIBITEDLISTED = 1
        TRACKINGLISTED   = 2


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#regional-subscription-zone-code-element)
; AVP: Regional-Subscription-Zone-Code
; Section: 7.3.52
; Page: 133
; Versions: 18.7.0..19.6.0
"It shall contain a Zone Code (ZC) as defined in TS 23.003 [3], clause 4.4."
    encoding element TS23.003 4.4 "Zone Code"


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#rand-element)
; AVP: RAND
; Section: 7.3.53
; Page: 133
; Versions: 18.7.0..19.6.0
"This AVP shall contain the RAND. See TS 33.401 [5]."
    encoding element TS33.401 "RAND"


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#xres-element)
; AVP: XRES
; Section: 7.3.54
; Page: 133
; Versions: 18.7.0..19.6.0
"This AVP shall contain the XRES. See TS 33.401 [5]."
    encoding element TS33.401 "XRES"


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#autn-element)
; AVP: AUTN
; Section: 7.3.55
; Page: 133
; Versions: 18.7.0..19.6.0
"This AVP shall contain the AUTN. See TS 33.401 [5]."
    encoding element TS33.401 "AUTN"


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#kasme-element)
; AVP: KASME
; Section: 7.3.56
; Page: 133
; Versions: 18.7.0..19.6.0
"This AVP shall contain the K_ASME. See TS 33.401 [5]."
    encoding element TS33.401 "K_ASME"


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#sres-element)
; AVP: SRES
; Section: 7.3.60
; Page: 133
; Versions: 18.7.0..19.6.0
"This AVP shall contain the SRES. See TS 33.102 [18]."
    encoding element TS33.102 "SRES"


; Type: Enumerated AVP
; Name: PDN-Type
; Section: 7.3.62
; Page: 133
PDN-Type ::= < Enumerated AVP header: 1456 10415 >
        IPv4         = 0
        IPv6         = 1
        IPv4v6       = 2
        IPv4_OR_IPv6 = 3


; Type: Grouped AVP
; Name: Trace-Data
; Section: 7.3.63
; Page: 134
Trace-Data ::= < AVP header: 1458 10415 >
        { Trace-Reference }
        { Trace-Depth }
        { Trace-NE-Type-List }
        [ Trace-Interface-List ]
        { Trace-Event-List }
        [ OMC-Id ]
        { Trace-Collection-Entity }
        [ MDT-Configuration ]
        [ MDT-Configuration-NR ]
        [ Trace-Reporting-Consumer-Uri ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#trace-reference-layout)
; AVP: Trace-Reference
; Section: 7.3.64
; Page: 134
; Versions: 18.7.0..19.6.0
"This AVP shall contain the concatenation of MCC, MNC and Trace ID, where the Trace ID is a 3 byte Octet String."
"The content of this AVP shall be encoded as octet strings according to table 7.3.64/1."
"If MNC is 2 digits long, bits 5 to 8 of octet 2 are coded as \"1111\"."
    encoding plmn-id-prefix
    length 6 octets


; Type: Enumerated AVP
; Name: Trace-Depth
; Section: 7.3.67
; Page: 135
; Values: TS 32.422 [23] for Trace Depth
Trace-Depth ::= < Enumerated AVP header: 1462 10415 >


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#trace-ne-type-list-element)
; AVP: Trace-NE-Type-List
; Section: 7.3.68
; Page: 135
; Versions: 18.7.0..19.6.0
"Octets are coded according to TS 32.422 [23]."
    encoding element TS32.422


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#trace-interface-list-element)
; AVP: Trace-Interface-List
; Section: 7.3.69
; Page: 135
; Versions: 18.7.0..19.6.0
"Octets are coded according to TS 32.422 [23]."
    encoding element TS32.422


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#trace-event-list-element)
; AVP: Trace-Event-List
; Section: 7.3.70
; Page: 135
; Versions: 18.7.0..19.6.0
"Octets are coded according to TS 32.422 [23]."
    encoding element TS32.422


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#omc-id-element)
; AVP: OMC-Id
; Section: 7.3.71
; Page: 135
; Versions: 18.7.0..19.6.0
"Octets are coded according to TS 29.002 [24]."
    encoding element TS29.002


; Type: Grouped AVP
; Name: GPRS-Subscription-Data
; Section: 7.3.72
; Page: 135
GPRS-Subscription-Data ::= < AVP header: 1467 10415 >
        { Complete-Data-List-Included-Indicator }
   1*50 { PDP-Context }
      * [ AVP ]


; Type: Enumerated AVP
; Name: Complete-Data-List-Included-Indicator
; Section: 7.3.73
; Page: 136
Complete-Data-List-Included-Indicator ::= < Enumerated AVP header: 1468 10415 >
        All_PDP_CONTEXTS_INCLUDED            = 0
        MODIFIED_ADDED_PDP_CONTEXTS_INCLUDED = 1


; Type: Grouped AVP
; Name: PDP-Context
; Section: 7.3.74
; Page: 136
PDP-Context ::= < AVP header: 1469 10415 >
        { Context-Identifier }
        { PDP-Type }
        [ PDP-Address ]
        { QoS-Subscribed }
        [ VPLMN-Dynamic-Address-Allowed ]
        { Service-Selection }
        [ 3GPP-Charging-Characteristics ]
        [ Ext-PDP-Type ]
        [ Ext-PDP-Address ]
        [ AMBR ]
        [ APN-OI-Replacement ]
        [ SIPTO-Permission ]
        [ LIPA-Permission ]
        [ Restoration-Priority ]
        [ SIPTO-Local-Network-Permission ]
        [ Non-IP-Data-Delivery-Mechanism ]
        [ SCEF-ID ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#pdp-context-ext-pdp-address)
; AVP: Ext-PDP-Address
; Within: PDP-Context
; Section: 7.3.74
; Page: 136
; Versions: 18.7.0..19.6.0
"The Ext-PDP-Address AVP may be present only if the PDP-Address AVP is present."
    requires PDP-Address
"If the Ext-PDP-Address AVP is present, then it shall not contain the same address type (IPv4 or IPv6) as the PDP-Address AVP."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#pdp-context-ext-pdp-type)
; AVP: Ext-PDP-Type
; Within: PDP-Context
; Section: 7.3.74
; Page: 136
; Versions: 18.7.0..19.6.0
"When PDP-Type takes the value Non-IP (HEX 02), the Ext-PDP-Type AVP shall be absent."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#pdp-context-non-ip-delivery)
; AVP: Non-IP-Data-Delivery-Mechanism
; Within: PDP-Context
; Section: 7.3.74
; Page: 136
; Versions: 18.7.0..19.6.0
"The Non-IP-Data-Delivery-Mechanism shall only be present when PDP-Type takes the value Non-IP (HEX 02)."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#pdp-context-scef-id)
; AVP: SCEF-ID
; Within: PDP-Context
; Section: 7.3.74
; Page: 136
; Versions: 18.7.0..19.6.0
"The SCEF-ID shall only be present when Non-IP-Data-Delivery-Mechanism takes the value SCEF-BASED-DATA-DELIVERY (1)."
    requires Non-IP-Data-Delivery-Mechanism = 1


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#pdp-type-element)
; AVP: PDP-Type
; Section: 7.3.75
; Page: 137
; Versions: 18.7.0..19.6.0
"Octets are coded according to TS 29.002 [24]."
    encoding element TS29.002
"The allowed values are one of IPv4 encoded as HEX (21) or IPv6 encoded as HEX (57) or Non-IP encoded as HEX (02)."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#ext-pdp-type-value)
; AVP: Ext-PDP-Type
; Section: 7.3.75A
; Page: 137
; Versions: 18.7.0..19.6.0
"Octets are coded according to TS 29.002 [24] and TS 29.060 [39] and shall contain the value of IPv4v6."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#qos-subscribed-element)
; AVP: QoS-Subscribed
; Section: 7.3.77
; Page: 137
; Versions: 18.7.0..19.6.0
"Octets are coded according to TS 29.002 [24] (octets of QoS-Subscribed, Ext-QoS-Subscribed, Ext2-QoS-Subscribed, Ext3-QoS-Subscribed and Ext4-QoS-Subscribed values are concatenated)."
    encoding element TS29.002


; Type: Grouped AVP
; Name: CSG-Subscription-Data
; Section: 7.3.78
; Page: 137
CSG-Subscription-Data ::= < AVP header: 1436 10415 >
        { CSG-Id }
        [ Expiration-Date ]
      * [ Service-Selection ]
        [ Visited-PLMN-Id ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#csg-id-element)
; AVP: CSG-Id
; Section: 7.3.79
; Page: 137
; Versions: 18.7.0..19.6.0
"Values are coded according to TS 23.003 [3]."
    encoding element TS23.003
"Unused bits (least significant) shall be padded with zeros."
    text-only


; Type: Enumerated AVP
; Name: Roaming-Restricted-Due-To-Unsupported-Feature
; Section: 7.3.81
; Page: 137
Roaming-Restricted-Due-To-Unsupported-Feature ::= < Enumerated AVP header: 1457 10415 >
        Roaming-Restricted-Due-To-Unsupported-Feature = 0


; Type: Grouped AVP
; Name: Specific-APN-Info
; Section: 7.3.82
; Page: 138
Specific-APN-Info ::= < AVP header: 1472 10415 >
        { Service-Selection }
        { MIP6-Agent-Info }
        [ Visited-Network-Identifier ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#apn-configuration-specific-apn-info)
; AVP: Specific-APN-Info
; Within: APN-Configuration
; Section: 7.3.82
; Page: 138
; Versions: 18.7.0..19.6.0
"It shall only be present in the APN configuration when the APN is a wild card APN."
    text-only


; Type: Enumerated AVP
; Name: Alert-Reason
; Section: 7.3.83
; Page: 138
Alert-Reason ::= < Enumerated AVP header: 1434 10415 >
        UE_PRESENT          = 0
        UE_MEMORY_AVAILABLE = 1


; Type: Grouped AVP
; Name: LCS-Info
; Section: 7.3.84
; Page: 138
LCS-Info ::= < AVP header: 1473 10415 >
      * [ GMLC-Number ]
      * [ LCS-PrivacyException ]
      * [ MO-LR ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#gmlc-number-e164)
; AVP: GMLC-Number
; Section: 7.3.85
; Page: 138
; Versions: 18.7.0..19.6.0
"This AVP shall contain the ISDN number of the GMLC in international number format as described in ITU-T Rec E.164 [41] and shall be encoded as a TBCD-string."
"This AVP shall not include leading indicators for the nature of address and the numbering plan; it shall contain only the TBCD-encoded digits of the address."
    encoding e164-tbcd


; Type: Grouped AVP
; Name: LCS-PrivacyException
; Section: 7.3.86
; Page: 138
LCS-PrivacyException ::= < AVP header: 1475 10415 >
        { SS-Code }
        { SS-Status }
        [ Notification-To-UE-User ]
      * [ External-Client ]
      * [ PLMN-Client ]
      * [ Service-Type ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#ss-code-element)
; AVP: SS-Code
; Section: 7.3.87
; Page: 139
; Versions: 18.7.0..19.6.0
"Octets are coded according to TS 29.002 [24]."
    encoding element TS29.002


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#ss-status-element)
; AVP: SS-Status
; Section: 7.3.88
; Page: 139
; Versions: 18.7.0..19.6.0
"Octets are coded according to TS 29.002 [24]."
    encoding element TS29.002


; Type: Enumerated AVP
; Name: Notification-To-UE-User
; Section: 7.3.89
; Page: 139
Notification-To-UE-User ::= < Enumerated AVP header: 1478 10415 >
        NOTIFY_LOCATION_ALLOWED                             = 0
        NOTIFYANDVERIFY_LOCATION_ALLOWED_IF_NO_RESPONSE     = 1
        NOTIFYANDVERIFY_LOCATION_NOT_ALLOWED_IF_NO_RESPONSE = 2
        LOCATION_NOT_ALLOWED                                = 3


; Type: Grouped AVP
; Name: External-Client
; Section: 7.3.90
; Page: 139
External-Client ::= < AVP header: 1479 10415 >
        { Client-Identity }
        [ GMLC-Restriction ]
        [ Notification-To-UE-User ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#client-identity-e164)
; AVP: Client-Identity
; Section: 7.3.91
; Page: 139
; Versions: 18.7.0..19.6.0
"The Client-Identity AVP is of type OctetString and it shall contain the ISDN number of the external client in international number format as described in ITU-T Rec E.164 [41] and shall be encoded as a TBCD-string."
"This AVP shall not include leading indicators for the nature of address and the numbering plan; it shall contain only the TBCD-encoded digits of the address."
    encoding e164-tbcd


; Type: Enumerated AVP
; Name: GMLC-Restriction
; Section: 7.3.92
; Page: 140
GMLC-Restriction ::= < Enumerated AVP header: 1481 10415 >
        GMLC_LIST    = 0
        HOME_COUNTRY = 1


; Type: Enumerated AVP
; Name: PLMN-Client
; Section: 7.3.93
; Page: 140
PLMN-Client ::= < Enumerated AVP header: 1482 10415 >
        BROADCAST_SERVICE            = 0
        O_AND_M_HPLMN                = 1
        O_AND_M_VPLMN                = 2
        ANONYMOUS_LOCATION           = 3
        TARGET_UE_SUBSCRIBED_SERVICE = 4


; Type: Grouped AVP
; Name: Service-Type
; Section: 7.3.94
; Page: 140
Service-Type ::= < AVP header: 1483 10415 >
        { ServiceTypeIdentity }
        [ GMLC-Restriction ]
        [ Notification-To-UE-User ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#servicetypeidentity-element)
; AVP: ServiceTypeIdentity
; Section: 7.3.95
; Page: 140
; Versions: 18.7.0..19.6.0
"For details on the values of this AVP, see TS 29.002 [24]."
    encoding element TS29.002


; Type: Grouped AVP
; Name: MO-LR
; Section: 7.3.96
; Page: 140
MO-LR ::= < AVP header: 1485 10415 >
        { SS-Code }
        { SS-Status }
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#trace-collection-entity-ip)
; AVP: Trace-Collection-Entity
; Section: 7.3.98
; Page: 141
; Versions: 18.7.0..19.6.0
"The Trace-Collection-Entity AVP is of type Address and contains the IPv4 or IPv6 address of the Trace Collection Entity, as defined in TS 32.422 [23], clause 5.9."
    encoding ip-address


; Type: Grouped AVP
; Name: Teleservice-List
; Section: 7.3.99
; Page: 141
Teleservice-List ::= < AVP header: 1486 10415 >
     1* { TS-Code }
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#ts-code-element)
; AVP: TS-Code
; Section: 7.3.100
; Page: 141
; Versions: 18.7.0..19.6.0
"Octets are coded according to TS 29.002 [24]."
    encoding element TS29.002


; Type: Grouped AVP
; Name: Call-Barring-Info
; Section: 7.3.101
; Page: 141
Call-Barring-Info ::= < AVP header: 1488 10415 >
        { SS-Code }
        { SS-Status }
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#sgsn-number-e164)
; AVP: SGSN-Number
; Section: 7.3.102
; Page: 141
; Versions: 18.7.0..19.6.0
"This AVP contains an SGSN-Number in international number format as described in ITU-T Rec E.164 [41] and shall be encoded as a TBCD-string."
"This AVP shall not include leading indicators for the nature of address and the numbering plan; it shall contain only the TBCD-encoded digits of the address."
    encoding e164-tbcd


; Type: Value Table
; AVP: IDR-Flags
; Kind: bits
; Section: 7.3.103
; Table: 7.3.103/1
; Page: 141
"UE Reachability Request"          = 0
"T-ADS Data Request"               = 1
"EPS User State Request"           = 2
"EPS Location Information Request" = 3
"Current Location Request"         = 4
"Local Time Zone Request"          = 5
"Remove SMS Registration"          = 6
"RAT-Type Requested"               = 7
"P-CSCF Restoration Request"       = 8


; Type: Enumerated AVP
; Name: ICS-Indicator
; Section: 7.3.104
; Page: 142
ICS-Indicator ::= < Enumerated AVP header: 1491 10415 >
        FALSE = 0
        TRUE  = 1


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#visited-network-identifier-domain)
; AVP: Visited-Network-Identifier
; Section: 7.3.105
; Page: 142
; Versions: 18.7.0..19.6.0
"The AVP shall be encoded as:"
"mnc<MNC>.mcc<MCC>.3gppnetwork.org"
