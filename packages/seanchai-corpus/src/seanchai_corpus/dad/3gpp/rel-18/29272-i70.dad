        CONNECTED_NOT_REACHABLE_FOR_PAGING = 3
        CONNECTED_REACHABLE_FOR_PAGING     = 4
        RESERVED                           = 5


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#user-state-reserved)
