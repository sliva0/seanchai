        SMS_REGISTRATION_NOT_PREFERRED = 1
        NO_PREFERENCE                  = 2


; Type: Interpreted Constraints ;; interpreted: (TS29.272.py#time-zone-format)
; AVP: Time-Zone
; Section: 7.3.163
; Page: 154
; Versions: 18.7.0..19.6.0
"The contents of the Time-Zone AVP shall be formatted as a character string with the following format:"
"Basic format: ±n, with \"n\" being the number of units of 15 minutes from UTC."
    encoding time-zone


; Type: Enumerated AVP
; Name: Daylight-Saving-Time
; Section: 7.3.164
; Page: 154
Daylight-Saving-Time ::= < Enumerated AVP header: 1650 10415 >
        NO_ADJUSTMENT             = 0
        PLUS_ONE_HOUR_ADJUSTMENT  = 1
        PLUS_TWO_HOURS_ADJUSTMENT = 2


; Type: Value Table
; AVP: Subscription-Data-Flags
; Kind: bits
; Section: 7.3.165
; Table: 7.3.165/1
; Page: 154
PS-And-SMS-Only-Service-Provision-Indication         = 0
SMS-In-SGSN-Allowed-Indication                       = 1
"User Plane Integrity Protection"                    = 2
PDN-Connection-Restricted                            = 3
"Acknowledgement-Of-Downlink-NAS-Data PDUs disabled" = 4


; Type: Enumerated AVP
; Name: Measurement-Period-LTE
; Section: 7.3.166
; Page: 155
; Values: TS 32.422 [23] for Measurement period LTE
Measurement-Period-LTE ::= < Enumerated AVP header: 1655 10415 >


; Type: Enumerated AVP
; Name: Measurement-Period-UMTS
; Section: 7.3.167
; Page: 155
; Values: TS 32.422 [23] for Measurement period UMTS
Measurement-Period-UMTS ::= < Enumerated AVP header: 1656 10415 >


