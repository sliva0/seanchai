; Kind: bits
; Section: 8.2.3.21
; Table: 8.2.3.21/1
; Page: 154
"AAA Failure" = 0


; Type: Interpreted Constraints ;; interpreted: (TS29.273.dadx#aaa-failure-indication-undefined-bits)
; AVP: AAA-Failure-Indication
; Section: 8.2.3.21
; Table: 8.2.3.21/1
; Page: 154
; Versions: 18.6.0..19.2.0
