; Type: Message
; Name: Diameter-EAP-Request, DER
; Section: 4.2.2.1.1
; Page: 24
<Diameter-EAP-Request> ::= < Diameter Header: 268, REQ, PXY >
        < Session-Id >
        [ DRMP ]
        { Auth-Application-Id }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Auth-Request-Type }
        { EAP-Payload }
        [ User-Name ]
        [ Calling-Station-Id ]
        [ RAT-Type ]
;; …
        [ ANID ]
        [ Full-Network-Name ]
        [ Short-Network-Name ]
      * [ Supported-Features ]
        [ AAA-Failure-Indication ]
        [ Transport-Access-Type ]
        [ OC-Supported-Features ]
        [ Access-Network-Info ]
        [ User-Location-Info-Time ]
        [ High-Priority-Access-Info ]
;; …
      * [ AVP ]


; Type: Message
; Name: Diameter-EAP-Answer, DEA
; Section: 4.2.2.1.2
; Page: 25
<Diameter-EAP-Answer> ::= < Diameter Header: 268, PXY >
        < Session-Id >
        [ DRMP ]
        { Auth-Application-Id }
        { Result-Code }
        [ Experimental-Result ]    ; bold
        { Origin-Host }
        { Origin-Realm }
        { Auth-Request-Type }
        [ EAP-Payload ]
        [ User-Name ]
        [ Session-Timeout ]
        [ Acct-Interim-Interval ] ;; corrected: (TS29.273.py#accounting-interim-interval-rule-4-2-2-1-2-diameter-eap-answer)
        [ EAP-Master-Session-Key ]
      * [ Redirect-Host ]
        [ AN-Trusted ]
      * [ Supported-Features ]
        [ Mobile-Node-Identifier ]
        [ OC-Supported-Features ]
        [ OC-OLR ]
      * [ Load ]
        [ MPS-Priority ]
;; …
      * [ AVP ]


