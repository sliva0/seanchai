; Kind: bits
; Section: 8.2.3.20
; Table: 8.2.3.20/1
; Page: 154
EPC-Access-Authorization  = 0
NSWO-Access-Authorization = 1


; Type: Interpreted Constraints ;; interpreted: (TS29.273.dadx#access-authorization-flags-undefined-bits)
; AVP: Access-Authorization-Flags
; Section: 8.2.3.20
; Table: 8.2.3.20/1
; Page: 154
; Versions: 18.6.0..19.2.0
"NOTE: Bits not defined in this table shall be cleared by the sending HSS and discarded by the receiving 3GPP AAA Server."
    bits only 0 1


; Type: Value Table
