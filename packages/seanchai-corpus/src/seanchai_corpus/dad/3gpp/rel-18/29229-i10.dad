; Type: Grouped AVP
; Name: Server-Capabilities
; Section: 6.3.4
; Page: 25
Server-Capabilities ::= < AVP header: 603 10415 >
      * [ Mandatory-Capability ]
      * [ Optional-Capability ]
      * [ Server-Name ]
      * [ AVP ]


; Type: Grouped AVP
; Name: SIP-Auth-Data-Item
; Section: 6.3.13
; Page: 26
SIP-Auth-Data-Item ::= < AVP header: 612 10415 >
        [ SIP-Item-Number ]
        [ SIP-Authentication-Scheme ]
        [ SIP-Authenticate ]
        [ SIP-Authorization ]
        [ SIP-Authentication-Context ]
        [ Confidentiality-Key ]
        [ Integrity-Key ]
        [ SIP-Digest-Authenticate ]
        [ Framed-IP-Address ]
        [ Framed-IPv6-Prefix ]
        [ Framed-Interface-Id ]
      * [ Line-Identifier ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Server-Assignment-Type
; Section: 6.3.15
; Page: 27
Server-Assignment-Type ::= < Enumerated AVP header: 614 10415 >
        NO_ASSIGNMENT                            = 0
        REGISTRATION                             = 1
        RE_REGISTRATION                          = 2
        UNREGISTERED_USER                        = 3
        TIMEOUT_DEREGISTRATION                   = 4
        USER_DEREGISTRATION                      = 5
        TIMEOUT_DEREGISTRATION_STORE_SERVER_NAME = 6
        USER_DEREGISTRATION_STORE_SERVER_NAME    = 7
        ADMINISTRATIVE_DEREGISTRATION            = 8
        AUTHENTICATION_FAILURE                   = 9
        AUTHENTICATION_TIMEOUT                   = 10
        DEREGISTRATION_TOO_MUCH_DATA             = 11
        AAA_USER_DATA_REQUEST                    = 12
        PGW_UPDATE                               = 13
        RESTORATION                              = 14


; Type: Grouped AVP
; Name: Deregistration-Reason
; Section: 6.3.16
; Page: 28
Deregistration-Reason ::= < AVP header: 615 10415 >
        { Reason-Code }
        [ Reason-Info ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Reason-Code
; Section: 6.3.17
; Page: 28
Reason-Code ::= < Enumerated AVP header: 616 10415 >
        PERMANENT_TERMINATION = 0
        NEW_SERVER_ASSIGNED   = 1
        SERVER_CHANGE         = 2
        REMOVE_S-CSCF         = 3


; Type: Grouped AVP
; Name: Charging-Information
; Section: 6.3.19
; Page: 29
Charging-Information ::= < AVP header: 618 10415 >
