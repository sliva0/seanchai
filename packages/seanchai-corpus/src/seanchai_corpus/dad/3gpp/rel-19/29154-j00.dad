; Type: Grouped AVP
; Name: Access-Network-Reports
; Section: A.6.3.2
Access-Network-Reports ::= < AVP header: 4210 10415 > ;; corrected: (TS29.154.py#vendor-id-access-network-reports)
        [ MSISDN ]
        [ External-Identifier ]
        [ 3GPP-User-Location-Info ]
        [ User-Location-Info-Time ]
        [ 3GPP-SGSN-MCC-MNC ]
        [ 3GPP-MS-TimeZone ]
        [ UE-Local-IP-Address ]
        [ TCP-Source-Port ]
        [ UDP-Source-Port ]
        [ NetLoc-Access-Support ]
      * [ AVP ]


; Type: Grouped AVP
; Name: Event-Configuration
; Section: A.6.3.3
Event-Configuration ::= < AVP header: 4211 10415 > ;; corrected: (TS29.154.py#vendor-id-event-configuration)
        { Extended-SCEF-Reference-ID }
        { SCEF-ID }
        { Monitoring-Type }
        [ Location-Information-Configuration ]
      * [ AVP ]


; Type: Value Table
; AVP: Event-Configuration-State
; Kind: bits
; Section: A.6.3.4
; Table: A.6.3.4-1
"Final report" = 0


; Type: Grouped AVP
; Name: Event-Configuration-Status
; Section: A.6.3.5
Event-Configuration-Status ::= < AVP header: 4213 10415 > ;; corrected: (TS29.154.py#vendor-id-event-configuration-status)
        { Event-Configuration-State }
        { Extended-SCEF-Reference-ID }
      * [ AVP ]


; Type: Value Table
; AVP: Event-Reporting-Results
; Kind: bits
; Section: A.6.3.6
; Table: A.6.3.6-1
"Final report" = 0


; Type: Grouped AVP
; Name: Event-Reports
; Section: A.6.3.7
Event-Reports ::= < AVP header: 4215 10415 > ;; corrected: (TS29.154.py#vendor-id-event-reports)
        { Event-Reporting-Results }
        { Extended-SCEF-Reference-ID }
      * [ Access-Network-Reports ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.154.dadx#ecr-supported-features-vendor)
; AVP: Supported-Features
; Command: EC-Request
; Section: A.6.4.2
; Versions: 18.0.0..19.0.0
"On the all reference points as specified in this specification, the Supported-Features AVP is used to identify features that have been defined by 3GPP and hence, for features defined in this document, the Vendor-Id AVP shall contain the vendor ID of 3GPP (10415)."
    requires Supported-Features/Vendor-Id = 10415
"The Supported-Features AVP shall be included in every ECR and ECA commands if supported by the SCEF and PCRF respectively."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.154.dadx#eca-supported-features-vendor)
