; Type: Message
; Name: SL-Request, SLR
; Section: 5.6.2
; Page: 20
<SL-Request> ::= < Diameter Header: 8388635, REQ, PXY >
        < Session-Id >
        [ DRMP ]
        { Auth-Application-Id }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        [ Destination-Host ]
        [ Origin-State-Id ]
        [ OC-Supported-Features ]
      * [ Supported-Features ]
        { SL-Request-Type }
      * [ Subscription-Id ]
      * [ Policy-Counter-Identifier ]
        [ Logical-Access-ID ]
        [ Physical-Access-ID ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: SL-Answer, SLA
; Section: 5.6.3
; Page: 21
