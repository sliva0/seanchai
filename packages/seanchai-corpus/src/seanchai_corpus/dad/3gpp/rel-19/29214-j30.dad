; Type: Enumerated AVP
; Name: Abort-Cause
; Section: 5.3.1
; Page: 39
Abort-Cause ::= < Enumerated AVP header: 500 10415 >
        BEARER_RELEASED                        = 0
        INSUFFICIENT_SERVER_RESOURCES          = 1
        INSUFFICIENT_BEARER_RESOURCES          = 2
        PS_TO_CS_HANDOVER                      = 3
        SPONSORED_DATA_CONNECTIVITY_DISALLOWED = 4
        PCEF_FAILURE                           = 5


; Type: Grouped AVP
; Name: Access-Network-Charging-Identifier
; Section: 5.3.3
; Page: 40
Access-Network-Charging-Identifier ::= < AVP header: 502 10415 > ;; corrected: (TS29.214.py#vendor-id-access-network-charging-identifier)
        { Access-Network-Charging-Identifier-Value }
      * [ Flows ]


; Type: Grouped AVP
; Name: Flows
; Section: 5.3.10
; Page: 42
Flows ::= < AVP header: 510 10415 > ;; corrected: (TS29.214.py#vendor-id-flows)
        { Media-Component-Number }
      * [ Flow-Number ]
      * [ Content-Version ]
        [ Final-Unit-Action ]
        [ Media-Component-Status ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Flow-Status
; Section: 5.3.11
; Page: 42
Flow-Status ::= < Enumerated AVP header: 511 10415 >
        ENABLED-UPLINK   = 0
        ENABLED-DOWNLINK = 1
        ENABLED          = 2
        DISABLED         = 3
        REMOVED          = 4


; Type: Enumerated AVP
; Name: Flow-Usage
; Section: 5.3.12
; Page: 43
Flow-Usage ::= < Enumerated AVP header: 512 10415 >
        NO_INFORMATION = 0
        RTCP           = 1
        AF_SIGNALLING  = 2


; Type: Enumerated AVP
; Name: Specific-Action
; Section: 5.3.13
; Page: 43
