; Type: Message
; Name: Accounting-Request, ACR
; Section: 6.2.2
; Page: 58
<Accounting-Request> ::= < Diameter Header: 271, REQ, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Accounting-Record-Type }
        { Accounting-Record-Number }
        [ Acct-Application-Id ]
;;      [ Vendor-Specific-Application-Id ] ; strikethrough
        [ User-Name ]
        [ Destination-Host ]
;;      [ Accounting-Sub-Session-Id ]      ; strikethrough
;;      [ Acct-Session-Id ]                ; strikethrough
;;      [ Acct-Multi-Session-Id ]          ; strikethrough
        [ Acct-Interim-Interval ]
;;      [ Accounting-Realtime-Required ]   ; strikethrough
        [ Origin-State-Id ]
        [ Event-Timestamp ]
      * [ Proxy-Info ]
      * [ Route-Record ]
        [ Service-Context-Id ]
        [ Service-Information ]
      * [ AVP ]


; Type: Message
; Name: Accounting-Answer, ACA
; Section: 6.2.3
; Page: 60
<Accounting-Answer> ::= < Diameter Header: 271, PXY >
        < Session-Id >
        { Result-Code }
        [ Experimental-Result ]
        { Origin-Host }
        { Origin-Realm }
        { Accounting-Record-Type }
        { Accounting-Record-Number }
        [ Acct-Application-Id ]
;;      [ Vendor-Specific-Application-Id ] ; strikethrough
        [ User-Name ]
;;      [ Accounting-Sub-Session-Id ]      ; strikethrough
;;      [ Acct-Session-Id ]                ; strikethrough
;;      [ Acct-Multi-Session-Id ]          ; strikethrough
        [ Error-Message ]
        [ Error-Reporting-Host ]
        [ Acct-Interim-Interval ]
        [ Failed-AVP ]
;;      [ Accounting-Realtime-Required ]   ; strikethrough
        [ Origin-State-Id ]
        [ Event-Timestamp ]
      * [ Proxy-Info ]
      * [ AVP ]


; Type: Message
; Name: Credit-Control-Request, CCR
; Section: 6.4.2
; Page: 72
<Credit-Control-Request> ::= < Diameter Header: 272, REQ, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Auth-Application-Id }
        { Service-Context-Id }
        { CC-Request-Type }
        { CC-Request-Number }
        [ Destination-Host ]
        [ User-Name ]
;;      [ CC-Sub-Session-Id ]                ; strikethrough
;;      [ Acct-Multi-Session-Id ]            ; strikethrough
        [ Origin-State-Id ]
        [ Event-Timestamp ]
      * [ Subscription-Id ]
;;      [ Service-Identifier ]               ; strikethrough
        [ Termination-Cause ]
;;      [ Requested-Service-Unit ]           ; strikethrough
        [ Requested-Action ]
;;    * [ Used-Service-Unit ]                ; strikethrough
        [ AoC-Request-Type ]
        [ Multiple-Services-Indicator ]
      * [ Multiple-Services-Credit-Control ]
;;    * [ Service-Parameter-Info ]           ; strikethrough
        [ CC-Correlation-Id ]
        [ User-Equipment-Info ]
        [ OC-Supported-Features ]
      * [ Proxy-Info ]
      * [ Route-Record ]
        [ Service-Information ]
      * [ AVP ]


; Type: Message
; Name: Credit-Control-Answer, CCA
; Section: 6.4.3
; Page: 78
<Credit-Control-Answer> ::= < Diameter Header: 272, PXY >
        < Session-Id >
        { Result-Code }
        [ Experimental-Result ]
        { Origin-Host }
        { Origin-Realm }
        { Auth-Application-Id }
        { CC-Request-Type }
        { CC-Request-Number }
;;      [ User-Name ]                        ; strikethrough
        [ CC-Session-Failover ]
;;      [ CC-Sub-Session-Id ]                ; strikethrough
;;      [ Acct-Multi-Session-Id ]            ; strikethrough
;;      [ Origin-State-Id ]                  ; strikethrough
;;      [ Event-Timestamp ]                  ; strikethrough
;;      [ Granted-Service-Unit ]             ; strikethrough
      * [ Multiple-Services-Credit-Control ]
        [ Cost-Information ]
        [ Low-Balance-Indication ]
        [ Remaining-Balance ]
;;      [ Final-Unit-Indication ]            ; strikethrough
;;      [ Check-Balance-Result ]             ; strikethrough
        [ Credit-Control-Failure-Handling ]
        [ Direct-Debiting-Failure-Handling ]
;;      [ Validity-Time ]                    ; strikethrough
        [ OC-Supported-Features ]
        [ OC-OLR ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Proxy-Info ]
      * [ Route-Record ]
        [ Failed-AVP ]
        [ Service-Information ]
      * [ AVP ]


; Type: Message
; Name: Re-Auth-Request, RAR
; Section: 6.4.4
; Page: 83
<Re-Auth-Request> ::= < Diameter Header: 258, REQ, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Destination-Host }
        { Auth-Application-Id }
        { Re-Auth-Request-Type }
        [ User-Name ]
        [ Origin-State-Id ]
      * [ Proxy-Info ]
      * [ Route-Record ]
;;      [ CC-Sub-Session-Id ]     ; strikethrough
        [ G-S-U-Pool-Identifier ]
        [ Service-Identifier ]
        [ Rating-Group ]
      * [ AVP ]


; Type: Message
; Name: Re-Auth-Answer, RAA
; Section: 6.4.5
; Page: 84
<Re-Auth-Answer> ::= < Diameter Header: 258, PXY >
        < Session-Id >
        { Result-Code }
        { Origin-Host }
        { Origin-Realm }
        [ User-Name ]
        [ Origin-State-Id ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
        [ Failed-AVP ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ] ;; corrected: (TS32.299.py#raa-redirect-max-cache-time)
      * [ Proxy-Info ]
;;      [ CC-Sub-Session-Id ]        ; strikethrough
;;      [ G-S-U-Pool-Identifier ]    ; strikethrough
;;      [ Service-Identifier ]       ; strikethrough
;;      [ Rating-Group ]             ; strikethrough
      * [ AVP ]


