; Type: Grouped AVP
; Name: Monitoring-Event-Configuration
; Section: 8.4.2
; Page: 54
Monitoring-Event-Configuration ::= < AVP header: 3122 10415 >
        [ SCEF-Reference-ID ]
        [ SCEF-Reference-ID-Ext ]
        { SCEF-ID }
        { Monitoring-Type }
      * [ SCEF-Reference-ID-for-Deletion ]
      * [ SCEF-Reference-ID-for-Deletion-Ext ]
        [ Maximum-Number-of-Reports ]
        [ Monitoring-Duration ]
        [ Charged-Party ]
        [ Maximum-Detection-Time ]
        [ UE-Reachability-Configuration ]
        [ Location-Information-Configuration ]
        [ Association-Type ]
        [ DL-Buffering-Suggested-Packet-Count ]
        [ PLMN-ID-Requested ]
        [ MTC-Provider-Info ]
        [ PDN-Connectivity-Status-Configuration ]
        [ Exclude-Identifiers ]
        [ Include-Identifiers ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#monitoring-event-configuration-reference-ids)
; AVP: Monitoring-Event-Configuration
; Section: 8.4.2
; Page: 54
; Versions: 18.2.0..19.1.0
"At least SCEF-Reference-ID or one SCEF-Reference-ID-for-Deletion shall be present."
"At least one of the SCEF-Reference-ID or SCEF-Reference–ID-for-Deletion shall be present."
"When the \"Extended Reference IDs\" feature is supported by the HSS and SCEF, the SCEF-Reference-ID-Ext and SCEF-Reference-ID-for-Deletion-Ext AVPs shall be used insted of SCEF-Reference-ID and SCEF-Reference-ID-for-Deletion respectively."
    members at-least-one SCEF-Reference-ID SCEF-Reference-ID-Ext SCEF-Reference-ID-for-Deletion SCEF-Reference-ID-for-Deletion-Ext


; Type: Grouped AVP
; Name: Monitoring-Event-Report
; Section: 8.4.3
; Page: 55
Monitoring-Event-Report ::= < AVP header: 3123 10415 >
        { SCEF-Reference-ID }
        [ SCEF-Reference-ID-Ext ]
        [ SCEF-ID ]
        [ SCEF-Reference-ID-for-Deletion ]
        [ SCEF-Reference-ID-for-Deletion-Ext ]
        [ Visited-PLMN-Id ]
        [ Roaming-Information ]
        [ IMEI-Change ]
        [ Terminal-Information ]
        [ Reachability-Information ]
        [ Reachability-Cause ]
        [ Maximum-UE-Availability-Time ]
        [ EPS-Location-Information ]
        [ Monitoring-Type ]
        [ Event-Handling ]
      * [ Service-Report ]
        [ Loss-Of-Connectivity-Reason ]
        [ Idle-Status-Indication ]
      * [ PDN-Connectivity-Status-Report ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#cir-origin-host-scef-id)
; AVP: Origin-Host
; Command: Configuration-Information-Request
; Section: 8.4.5
; Page: 56
; Versions: 18.2.0..19.1.0
"The SCEF- ID AVP is of type DiameterIdentity and it shall contain the identity of the SCEF which has originated the service request towards the HSS, i.e. when sent within a Monitoring-Event-Configuration AVP in S6t-CIR, SCEF-ID AVP and Origin-Host AVP shall have the same value."
    equals Monitoring-Event-Configuration/SCEF-ID


; Type: Value Table
; AVP: Monitoring-Type
; Kind: values
; Section: 8.4.7
; Page: 56
LOSS_OF_CONNECTIVITY                                      = 0
UE_REACHABILITY                                           = 1
LOCATION_REPORTING                                        = 2
"CHANGE_OF_IMSI_IMEI(SV)_ASSOCIATION"                     = 3
ROAMING_STATUS                                            = 4
COMMUNICATION_FAILURE                                     = 5
AVAILABILITY_AFTER_DDN_FAILURE                            = 6
NUMBER_OF_UES_PRESENT_IN_A_GEOGRAPHICAL_AREA              = 7
UE_REACHABILITY_AND_IDLE_STATUS_INDICATION                = 8
AVAILABILITY_AFTER_DDN_FAILURE_AND_IDLE_STATUS_INDICATION = 9
PDN_CONNECTIVITY_STATUS                                   = 10
SAT_SF_OPERATION_INFO                                     = 11


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#monitoring-event-configuration-maximum-number-of-reports)
; AVP: Maximum-Number-of-Reports
; Within: Monitoring-Event-Configuration
; Section: 8.4.8
; Page: 56
; Versions: 18.2.0..19.1.0
"This AVP shall not be present when Monitoring-Type is AVAILABILITY_AFTER_DDN_FAILURE (6)."
    absent-if Monitoring-Type = AVAILABILITY_AFTER_DDN_FAILURE
"This AVP shall not be greater than one if:"
"- Monitoring-Type is UE_REACHABILITY (1) and Reachability-Type is \"Reachability for SMS\" or"
"- Monitoring-Type is LOCATION_REPORTING (2) and MONTE-Location-Type is LAST_KNOWN_LOCATION (1)."
    values 0, 1 if Monitoring-Type = UE_REACHABILITY and UE-Reachability-Configuration/Reachability-Type bit "Reachability for SMS" or Monitoring-Type = UE_REACHABILITY and not UE-Reachability-Configuration/Reachability-Type or Monitoring-Type = LOCATION_REPORTING and Location-Information-Configuration/MONTE-Location-Type = LAST_KNOWN_LOCATION or Monitoring-Type = LOCATION_REPORTING and not Location-Information-Configuration/MONTE-Location-Type


; Type: Grouped AVP
; Name: UE-Reachability-Configuration
; Section: 8.4.9
; Page: 57
UE-Reachability-Configuration ::= < AVP header: 3129 10415 >
        [ Reachability-Type ]
        [ Maximum-Latency ]
        [ Maximum-Response-Time ]
        [ DL-Buffering-Suggested-Packet-Count ]
      * [ AVP ]


; Type: Value Table
; AVP: Reachability-Type
; Kind: bits
; Section: 8.4.12
; Table: 8.4.12-1
; Page: 57
"Reachability for SMS"  = 0
"Reachability for Data" = 1


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#reachability-type-bits)
; AVP: Reachability-Type
; Section: 8.4.12
; Table: 8.4.12-1
; Page: 57
; Versions: 18.2.0..19.1.0
"The default value, when this AVP is not included, is Reachability for SMS (bit 0 set)."
    default 1
"NOTE 1: Bits not defined in this table shall be cleared by the sender and discarded by the receiver of the command. NOTE 2: Bit 0 and 1 shall not be set simultaneously."
    bits only 0 1
    bits at-most-one 0 1


; Type: Grouped AVP
; Name: Location-Information-Configuration
; Section: 8.4.15
; Page: 58
Location-Information-Configuration ::= < AVP header: 3135 10415 >
        [ MONTE-Location-Type ]
        [ Accuracy ]
        [ Periodic-Time ]
      * [ AVP ]


; Type: Value Table
; AVP: MONTE-Location-Type
; Kind: values
; Section: 8.4.16
; Page: 58
CURRENT_LOCATION    = 0
LAST_KNOWN_LOCATION = 1


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#monte-location-type-default)
; AVP: MONTE-Location-Type
; Section: 8.4.16
; Page: 58
; Versions: 18.2.0..19.1.0
"The default value, when this AVP is not included, is LAST_KNOWN_LOCATION (1)."
    default LAST_KNOWN_LOCATION


; Type: Value Table
; AVP: Accuracy
; Kind: values
; Section: 8.4.17
; Page: 58
CGI-ECGI = 0
eNB      = 1
LA-TA-RA = 2
PRA      = 3
PLMN-ID  = 4


; Type: Value Table
; AVP: Association-Type
; Kind: values
; Section: 8.4.18
; Page: 58
IMEI-CHANGE   = 0
IMEISV-CHANGE = 1


; Type: Value Table
; AVP: Roaming-Information
; Kind: values
; Section: 8.4.19
; Page: 58
SUBSCRIBER_ROAMING     = 0
SUBSCRIBER_NOT_ROAMING = 1


; Type: Value Table
; AVP: Reachability-Information
; Kind: values
; Section: 8.4.20
; Page: 59
REACHABLE_FOR_SMS  = 0
REACHABLE_FOR_DATA = 1


; Type: Grouped AVP
; Name: EPS-Location-Information
; Section: 8.4.21
; Page: 59
EPS-Location-Information ::= < AVP header: 1496 10415 >
        [ MME-Location-Information ]
        [ SGSN-Location-Information ]
      * [ AVP ]


; Type: Value Table
; AVP: IMEI-Change
; Kind: bits
; Section: 8.4.22
; Table: 8.4.22-1
; Page: 59
IMEI   = 0
IMEISV = 1


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#imei-change-bits)
; AVP: IMEI-Change
; Section: 8.4.22
; Table: 8.4.22-1
; Page: 59
; Versions: 18.2.0..19.1.0
"NOTE 1: Bits not defined in this table shall be cleared by the sender and discarded by the receiver of the command. NOTE 2: Bits 0 and 1 shall not be set simultaneously."
    bits only 0 1
    bits at-most-one 0 1


; Type: Value Table
; AVP: Feature-List
; Kind: features
; Application: S6t
; Section: 8.4.23.1
; Table: 8.4.23-1
; Page: 59
MONTE                                 = 0  ; O
AESE-Communication-Pattern            = 1  ; O
NIDD-Authorization                    = 2  ; O
Enhanced-Coverage-Restriction-Control = 3  ; O
"NIDD Authorization Update"           = 4  ; O
Report-Eff-MONTE                      = 5  ; O
"Event Cancellation Report"           = 6  ; O
Config-Eff-CP                         = 7  ; O
Config-Eff-NP                         = 8  ; O
"Extended Reference IDs"              = 9  ; O
Dynamic-Group-Event-Monitoring        = 10


; Type: Grouped AVP
; Name: Monitoring-Event-Config-Status
; Section: 8.4.24
; Page: 62
Monitoring-Event-Config-Status ::= < AVP header: 3142 10415 >
      * [ Service-Report ]
        { SCEF-Reference-ID }
        [ SCEF-Reference-ID-Ext ]
        [ SCEF-ID ]
      * [ AVP ]


; Type: Grouped AVP
; Name: AESE-Communication-Pattern
; Section: 8.4.25
; Page: 62
AESE-Communication-Pattern ::= < AVP header: 3113 10415 >
        [ SCEF-Reference-ID ]
        [ SCEF-Reference-ID-Ext ]
        { SCEF-ID }
      * [ SCEF-Reference-ID-for-Deletion ]
      * [ SCEF-Reference-ID-for-Deletion-Ext ]
      * [ Communication-Pattern-Set ]
        [ MTC-Provider-Info ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#aese-communication-pattern-reference-ids)
; AVP: AESE-Communication-Pattern
; Section: 8.4.25
; Page: 62
; Versions: 18.2.0..19.1.0
"At least one reference ID (either in SCEF-Reference-ID or in SCEF-Reference-ID-Ext) or a reference ID for deletion (either in SCEF-Reference-ID-for-Deletion or in SCEF-Reference-ID-for-Deletion-Ext) shall be present."
    members at-least-one SCEF-Reference-ID SCEF-Reference-ID-Ext SCEF-Reference-ID-for-Deletion SCEF-Reference-ID-for-Deletion-Ext


; Type: Grouped AVP
; Name: Communication-Pattern-Set
; Section: 8.4.26
; Page: 63
Communication-Pattern-Set ::= < AVP header: 3114 10415 >
        [ Periodic-Communication-Indicator ]
        [ Communication-Duration-Time ]
        [ Periodic-Time ]
      * [ Scheduled-Communication-Time ]
        [ Stationary-Indication ]
        [ Reference-ID-Validity-Time ]
        [ Traffic-Profile ]
        [ Battery-Indicator ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#communication-pattern-set-duration)
; AVP: Communication-Duration-Time
; Within: Communication-Pattern-Set
; Section: 8.4.26
; Page: 63
; Versions: 18.2.0..19.1.0
"Communication-duration-time and Periodic-Time shall be only provided when the Periodic-Communication-Indicator is set to PERIODICALLY."
    requires Periodic-Communication-Indicator = PERIODICALLY


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#communication-pattern-set-periodic-time)
; AVP: Periodic-Time
; Within: Communication-Pattern-Set
; Section: 8.4.26
; Page: 63
; Versions: 18.2.0..19.1.0
"Communication-duration-time and Periodic-Time shall be only provided when the Periodic-Communication-Indicator is set to PERIODICALLY."
    requires Periodic-Communication-Indicator = PERIODICALLY


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#communication-pattern-set-validity)
; AVP: Reference-ID-Validity-Time
; Within: Communication-Pattern-Set
; Section: 8.4.26
; Page: 63
; Versions: 18.2.0..19.1.0
"If the Reference-ID-Validity-Time AVP is absent, it indicates that there is no expiration time defined for the Communication-Pattern-Set."
    text-only


; Type: Value Table
; AVP: Periodic-Communication-Indicator
; Kind: values
; Section: 8.4.27
; Page: 63
PERIODICALLY = 0
ON_DEMAND    = 1


; Type: Grouped AVP
; Name: Scheduled-Communication-Time
; Section: 8.4.30
; Page: 64
Scheduled-Communication-Time ::= < AVP header: 3118 10415 > ;; corrected: (TS29.336.py#scheduled-communication-time-case)
        [ Day-Of-Week-Mask ]
        [ Time-Of-Day-Start ]
        [ Time-Of-Day-End ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#scheduled-communication-time-days)
; AVP: Day-Of-Week-Mask
; Within: Scheduled-Communication-Time
; Section: 8.4.30
; Page: 64
; Versions: 18.2.0..19.1.0
"If Day-Of-Week-Mask is not provided this shall be interpreted as every day of the week."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#scheduled-communication-time-start)
; AVP: Time-Of-Day-Start
; Within: Scheduled-Communication-Time
; Section: 8.4.30
; Page: 64
; Versions: 18.2.0..19.1.0
"If Time-Of-Day-Start is not provided, starting time shall be set to start of the day(s) indicated by Day-Of-Week-Mask."
    default 0


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#scheduled-communication-time-end)
; AVP: Time-Of-Day-End
; Within: Scheduled-Communication-Time
; Section: 8.4.30
; Page: 64
; Versions: 18.2.0..19.1.0
"If Time-Of-Day-End is not provided, ending time is end of the day(s) indicated by Day-Of-Week-Mask."
    text-only


; Type: Grouped AVP
; Name: AESE-Communication-Pattern-Config-Status
; Section: 8.4.32
; Page: 64
AESE-Communication-Pattern-Config-Status ::= < AVP header: 3120 10415 >
        { SCEF-Reference-ID }
        [ SCEF-Reference-ID-Ext ]
        [ SCEF-ID ]
        [ AESE-Error-Report ]
      * [ AVP ]


; Type: Grouped AVP
; Name: AESE-Error-Report
; Section: 8.4.33
; Page: 64
AESE-Error-Report ::= < AVP header: 3121 10415 >
        [ Service-Result ]
      * [ AVP ]


; Type: Grouped AVP
; Name: MME-Location-Information
; Section: 8.4.34
; Page: 65
MME-Location-Information ::= < AVP header: 1600 10415 >
        [ E-UTRAN-Cell-Global-Identity ]
        [ Tracking-Area-Identity ]
        [ Current-Location-Retrieved ]
        [ Age-Of-Location-Information ]
        [ User-CSG-Information ]
        [ eNodeB-Id ] ;; corrected: (TS29.336.py#enodeb-id-in-mme-location-information)
        [ Extended-eNodeB-Id ] ;; corrected: (TS29.336.py#extended-enodeb-id-in-mme-location-information)
      * [ AVP ]


; Type: Grouped AVP
