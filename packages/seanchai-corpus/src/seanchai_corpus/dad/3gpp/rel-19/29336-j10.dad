; Type: Value Table
; AVP: Experimental-Result-Code
; Kind: result-codes
; Section: 8.3
; Page: 47
DIAMETER_ERROR_USER_UNKNOWN                               = 5001 ; 8.3.3.1 from TS29.229
DIAMETER_ERROR_UNAUTHORIZED_REQUESTING_ENTITY             = 5510 ; 8.3.3.2
DIAMETER_ERROR_UNAUTHORIZED_SERVICE                       = 5511 ; 8.3.3.3
"DIAMETER_ERROR_REQUESTED_RANGE_IS_NOT ALLOWED"           = 5512 ; 8.3.3.4
DIAMETER_ERROR_CONFIGURATION_EVENT_STORAGE_NOT_SUCCESSFUL = 5513 ; 8.3.3.5 ;; corrected: (TS29.336.py#configuration-event-storage-result-spelling)
DIAMETER_ERROR_CONFIGURATION_EVENT_NON_EXISTANT           = 5514 ; 8.3.3.6
DIAMETER_ERROR_USER_NO_APN_SUBSCRIPTION                   = 5451 ; 8.3.3.7
DIAMETER_ERROR_UNAUTHORIZED_MTC_PROVIDER                  = 5516 ; 8.3.3.8


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#cia-result-code-absent-with-experimental-result)
; AVP: Result-Code
; Command: Configuration-Information-Answer
; Section: 8.3.3
; Page: 47
; Versions: 18.2.0..19.1.0
"When one of the result codes defined here is included in a response, it shall be inside an Experimental-Result AVP and the Result-Code AVP shall be absent."
    absent-if Experimental-Result/Experimental-Result-Code in DIAMETER_ERROR_USER_UNKNOWN,
        DIAMETER_ERROR_UNAUTHORIZED_REQUESTING_ENTITY,
        DIAMETER_ERROR_UNAUTHORIZED_SERVICE,
        "DIAMETER_ERROR_REQUESTED_RANGE_IS_NOT ALLOWED",
        DIAMETER_ERROR_CONFIGURATION_EVENT_STORAGE_NOT_SUCCESSFUL,
        DIAMETER_ERROR_CONFIGURATION_EVENT_NON_EXISTANT,
        DIAMETER_ERROR_USER_NO_APN_SUBSCRIPTION,
        DIAMETER_ERROR_UNAUTHORIZED_MTC_PROVIDER


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#ria-result-code-absent-with-experimental-result)
; AVP: Result-Code
; Command: Reporting-Information-Answer
; Section: 8.3.3
; Page: 47
; Versions: 18.2.0..19.1.0
"When one of the result codes defined here is included in a response, it shall be inside an Experimental-Result AVP and the Result-Code AVP shall be absent."
    absent-if Experimental-Result/Experimental-Result-Code in DIAMETER_ERROR_USER_UNKNOWN,
        DIAMETER_ERROR_UNAUTHORIZED_REQUESTING_ENTITY,
        DIAMETER_ERROR_UNAUTHORIZED_SERVICE,
        "DIAMETER_ERROR_REQUESTED_RANGE_IS_NOT ALLOWED",
        DIAMETER_ERROR_CONFIGURATION_EVENT_STORAGE_NOT_SUCCESSFUL,
        DIAMETER_ERROR_CONFIGURATION_EVENT_NON_EXISTANT,
        DIAMETER_ERROR_USER_NO_APN_SUBSCRIPTION,
        DIAMETER_ERROR_UNAUTHORIZED_MTC_PROVIDER


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#nia-result-code-absent-with-experimental-result)
