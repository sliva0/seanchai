        [ Result-Code ]
        [ Experimental-Result ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ OC-Supported-Features ]
        [ OC-OLR ]
      * [ Load ]
      * [ Supported-Features ]
        [ User-Identifier ]
        [ Number-Of-UEs ] ;; corrected: (TS29.336.py#cia-number-of-ues-spelling)
      * [ Monitoring-Event-Report ]
      * [ Monitoring-Event-Config-Status ]
      * [ AESE-Communication-Pattern-Config-Status ]
      * [ Supported-Services ]
        [ S6t-HSS-Cause ]
        [ Enhanced-Coverage-Restriction-Data ]
        [ CIA-Flags ]
      * [ IMSI-Group-Id ]
        [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]
        [ Suggested-Network-Configuration ]
      * [ AVP ]


