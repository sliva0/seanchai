APN-Validity-Time ::= < AVP header: 3169 10415 >
        { Granted-Validity-Time }
        [ Service-Selection ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#nidd-authorization-update-all-apns)
; AVP: APN-Validity-Time
; Within: NIDD-Authorization-Update
; Section: 8.4.65
; Page: 74
; Versions: 18.2.0..19.1.0
"Absence of Service-Selection AVP indicates that the Granted-Validity-Time applies to all granted NIDD Authorizations for the user. In this case only one APN-Validity-Time AVP shall be present within the NIDD-Authorization-Update AVP."
    text-only


; Type: Grouped AVP
; Name: Suggested-Network-Configuration
; Section: 8.4.66
; Page: 74
Suggested-Network-Configuration ::= < AVP header: 3170 10415 >
        { SCEF-Reference-ID }
        [ SCEF-Reference-ID-Ext ]
        { SCEF-ID }
        [ Subscribed-Periodic-RAU-TAU-Timer ]
        [ Active-Time ]
        [ DL-Buffering-Suggested-Packet-Count ]
        [ MTC-Provider-Info ]
      * [ SCEF-Reference-ID-for-Deletion ]
      * [ SCEF-Reference-ID-for-Deletion-Ext ]
        [ MPS-Priority ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#suggested-network-configuration-deletion)
; AVP: Suggested-Network-Configuration
; Section: 8.4.66
; Page: 74
; Versions: 18.2.0..19.1.0
"If the values of SCEF-Reference-ID and SCEF-Reference-ID-for-Deletion are the same, no Network Parameter Configurations AVP(s) shall be present, that is, SCEF-Reference-ID-for-Deletion takes precedence."
    text-only


; Type: Grouped AVP
; Name: Monitoring-Event-Report-Status
; Section: 8.4.67
; Page: 75
Monitoring-Event-Report-Status ::= < AVP header: 3171 10415 >
        { SCEF-Reference-ID }
        [ SCEF-Reference-ID-Ext ]
        { SCEF-ID }
        [ Result-Code ]
        [ Experimental-Result-Code ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: PLMN-ID-Requested
; Section: 8.4.68
; Page: 75
PLMN-ID-Requested ::= < Enumerated AVP header: 3172 10415 >
        TRUE  = 0
        FALSE = 1


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#plmn-id-requested-default)
; AVP: PLMN-ID-Requested
; Section: 8.4.68
; Page: 75
; Versions: 18.2.0..19.1.0
"The default value, when this AVP is not included, is TRUE (0)."
    default TRUE


; Type: Grouped AVP
; Name: AdditionalIdentifiers
; Section: 8.4.69
; Page: 75
AdditionalIdentifiers ::= < AVP header: 3173 10415 >
      * [ External-Identifier ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#additional-identifiers-not-empty)
; AVP: AdditionalIdentifiers
; Section: 8.4.69
; Page: 75
; Versions: 18.2.0..19.1.0
"The AdditionalIdentifiers AVP is of type Grouped, and it shall contain External Group Identifiers."
    members at-least-one External-Identifier


; Type: Value Table
; AVP: NIR-Flags
; Kind: bits
; Section: 8.4.70
; Table: 8.4.70-1
; Page: 75
"Incomplete Group-User-Identifier-List" = 0


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#nir-flags-undefined-bits)
; AVP: NIR-Flags
; Section: 8.4.70
; Table: 8.4.70-1
; Page: 75
; Versions: 18.2.0..19.1.0
"NOTE: Bits not defined in this table shall be cleared by the sender and discarded by the receiver of the command."
    bits only 0


; Type: Value Table
; AVP: NIA-Flags
; Kind: bits
; Section: 8.4.72
; Table: 8.4.72-1
; Page: 76
"Incomplete Group-User-Identifier-List" = 0


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#nia-flags-undefined-bits)
; AVP: NIA-Flags
; Section: 8.4.72
; Table: 8.4.72-1
; Page: 76
; Versions: 18.2.0..19.1.0
"NOTE: Bits not defined in this table shall be cleared by the sender and discarded by the receiver of the command."
    bits only 0


; Type: Grouped AVP
; Name: Group-User-Identifier
; Section: 8.4.73
; Page: 76
Group-User-Identifier ::= < AVP header: 3177 10415 >
        [ User-Name ]
        [ MSISDN ]
        [ External-Identifier ]
      * [ AVP ]


; Type: Grouped AVP
; Name: MTC-Provider-Info
; Section: 8.4.74
; Page: 76
MTC-Provider-Info ::= < AVP header: 3178 10415 >
        [ MTC-Provider-ID ]
      * [ AVP ]


; Type: Grouped AVP
; Name: PDN-Connectivity-Status-Configuration
; Section: 8.4.76
; Page: 77
PDN-Connectivity-Status-Configuration ::= < AVP header: 3180 10415 >
        [ Service-Selection ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#pdn-connectivity-status-configuration-all-apns)
; AVP: Service-Selection
; Within: PDN-Connectivity-Status-Configuration
; Section: 8.4.76
; Page: 77
; Versions: 18.2.0..19.1.0
"If the Service-Selection AVP is included, then the monitoring applies to that specific APN; if the Service-Selection is absent, the monitoring request applies to all APNs."
    text-only


; Type: Grouped AVP
; Name: PDN-Connectivity-Status-Report
; Section: 8.4.77
; Page: 77
PDN-Connectivity-Status-Report ::= < AVP header: 3181 10415 >
        { Service-Selection }
        { PDN-Connectivity-Status-Type }
        [ PDN-Type ]
        [ Non-IP-PDN-Type-Indicator ]
        [ Non-IP-Data-Delivery-Mechanism ]
     *2 [ Served-Party-IP-Address ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#rir-pdn-connectivity-status-report)
; AVP: Monitoring-Event-Report
; Command: Reporting-Information-Request
; Section: 8.4.77
; Page: 77
; Versions: 18.2.0..19.1.0
"The AVP shall always be present in RIR command if Monitoring-Event-Report AVP includes Monitoring-Type AVP with value PDN_CONNECTIVITY_STATUS (10)."
    requires not Monitoring-Event-Report/Monitoring-Type = PDN_CONNECTIVITY_STATUS or Monitoring-Event-Report/PDN-Connectivity-Status-Report


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#pdn-connectivity-status-report-pdn-type)
; AVP: PDN-Type
; Within: PDN-Connectivity-Status-Report
; Section: 8.4.77
; Page: 77
; Versions: 18.2.0..19.1.0
"The PDN-Type AVP is defined in 3GPP TS 29.272 [14] and it shall be present when the PDN Connection is an IP connection, and it may contain the value IPv4, IPv6 or IPv4v6."
"The Non-IP-PDN-Type-Indicator AVP is defined in 3GPP TS 29.272 [14] and it indicates whether the PDN Connection is of type \"Non-IP\"."
    present-if not Non-IP-PDN-Type-Indicator
"The value IPv4_OR_IPv6 shall not be used for this event reporting."
    exclude 3
"If PDN-Type AVP is present, then the Non-IP-PDN-Type-Indicator and Non-IP-Data-Delivery-Mechanism AVPs shall be absent."
    excludes Non-IP-PDN-Type-Indicator or Non-IP-Data-Delivery-Mechanism


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#pdn-connectivity-status-report-non-ip)
; AVP: Non-IP-PDN-Type-Indicator
; Within: PDN-Connectivity-Status-Report
; Section: 8.4.77
; Page: 77
; Versions: 18.2.0..19.1.0
"If this AVP is present, it shall be set to TRUE and the PDN-Type AVP shall be absent."
    range 1
    excludes PDN-Type


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#pdn-connectivity-status-report-delivery)
; AVP: Non-IP-Data-Delivery-Mechanism
; Within: PDN-Connectivity-Status-Report
; Section: 8.4.77
; Page: 77
; Versions: 18.2.0..19.1.0
"The Non-IP-Data-Delivery-Mechanism AVP is defined in 3GPP TS 29.272 [14] and it shall be present if the Non-IP-PDN-Type-Indicator AVP is present and set to TRUE."
    present-if Non-IP-PDN-Type-Indicator = TRUE


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#pdn-connectivity-status-report-address)
; AVP: Served-Party-IP-Address
; Within: PDN-Connectivity-Status-Report
; Section: 8.4.77
; Page: 77
; Versions: 18.2.0..19.1.0
"- an IPv4 address, or"
"- an IPv6 address/prefix, or"
"- both, an IPv4 address and an IPv6 address/prefix (for dual-stack UEs with PDN-Type set to \"IPv4v6\")."
    encoding ip-address
"For the IPv6 prefix, the lower 64 bits of the address shall be set to zero."
    text-only


; Type: Value Table
; AVP: PDN-Connectivity-Status-Type
; Kind: values
; Section: 8.4.78
; Page: 78
CREATED = 0
DELETED = 1


; Type: Value Table
; AVP: Traffic-Profile
; Kind: values
; Section: 8.4.79
; Page: 78
SINGLE_TRANSMISSION_UL                  = 0
SINGLE_TRANSMISSION_DL                  = 1
DUAL_TRANSMISSION_UL_WITH_SUBSEQUENT_DL = 2
DUAL_TRANSMISSION_DL_WITH_SUBSEQUENT_UL = 3
MULTI_TRANSMISSION                      = 4


; Type: Grouped AVP
; Name: Updated-Network-Configuration
; Section: 8.4.80
; Page: 78
Updated-Network-Configuration ::= < AVP header: 3184 10415 >
        { SCEF-ID }
        [ SCEF-Reference-ID ]
        [ SCEF-Reference-ID-Ext ]
      * [ SCEF-Reference-ID-for-Deletion ]
      * [ SCEF-Reference-ID-for-Deletion-Ext ]
        [ Subscribed-Periodic-RAU-TAU-Timer ]
        [ Active-Time ]
        [ DL-Buffering-Suggested-Packet-Count ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#updated-network-configuration-reference-ids)
; AVP: Updated-Network-Configuration
; Section: 8.4.80
; Page: 78
; Versions: 18.2.0..19.1.0
"At least one reference ID (either in SCEF-Reference-ID or in SCEF-Reference-ID-Ext) or a reference ID for deletion (either in SCEF-Reference-ID-for-Deletion or in SCEF-Reference-ID-for-Deletion-Ext) shall be present."
    members at-least-one SCEF-Reference-ID SCEF-Reference-ID-Ext SCEF-Reference-ID-for-Deletion SCEF-Reference-ID-for-Deletion-Ext
"If not included inside Group-Report-Item AVP, it shall contain only the Network Parameter Configurations which were received in a previous CIR command and have been updated due to a new CIR command."
    text-only


; Type: Value Table
; AVP: Battery-Indicator
; Kind: bits
; Section: 8.4.81
; Table: 8.4.81-1
; Page: 79
NO_BATTERY                      = 0
BATTERY_REPLACEABLE_INDICATION  = 1
BATTERY_RECHARGEABLE_INDICATION = 2


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#battery-indicator-bits)
; AVP: Battery-Indicator
; Section: 8.4.81
; Table: 8.4.81-1
; Page: 79
; Versions: 18.2.0..19.1.0
"NOTE1: Bits not defined in this table shall be cleared by the sender and discarded by the receiver of the command. NOTE2: If bit 0 is set, bit 1 and bit 2 shall be cleared."
    bits only 0 1 2
    bits at-most-one 0 1
    bits at-most-one 0 2


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#scef-reference-id-ext-feature)
; AVP: SCEF-Reference-ID-Ext
; Section: 8.4.82
; Page: 79
; Versions: 18.2.0..19.1.0
"The SCEF-Reference-ID-Ext AVP is of type Unsigned64 and it shall contain a 64-bit identifier provided by the SCEF, which shall be used instead of the 32-bit identifier SCEF-Reference-ID, when supported by both SCEF and HSS."
    text-only


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#scef-reference-id-for-deletion-ext-feature)
; AVP: SCEF-Reference-ID-for-Deletion-Ext
; Section: 8.4.83
; Page: 79
; Versions: 18.2.0..19.1.0
"The SCEF-Reference-ID-for-Deletion-Ext AVP is of type Unsigned64 and it shall contain a 64-bit identifier provided by the SCEF, which shall be used instead of the 32-bit identifier SCEF-Reference-ID-for-Deletion, when supported by both SCEF and HSS."
    text-only


; Type: Grouped AVP
; Name: Exclude-Identifiers
; Section: 8.4.84
; Page: 80
Exclude-Identifiers ::= < AVP header: 3188 10415 >
      * [ External-Identifier ]
      * [ MSISDN ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#exclude-identifiers-not-empty)
; AVP: Exclude-Identifiers
; Section: 8.4.84
; Page: 80
; Versions: 18.2.0..19.1.0
"The Exclude-Identifiers AVP is of type Grouped, and it shall contain External Group Identifiers or MSISDNs."
    members at-least-one External-Identifier MSISDN


; Type: Grouped AVP
; Name: Include-Identifiers
; Section: 8.4.85
; Page: 80
Include-Identifiers ::= < AVP header: 3189 10415 >
      * [ External-Identifier ]
      * [ MSISDN ]
      * [ AVP ]


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#include-identifiers-not-empty)
; AVP: Include-Identifiers
; Section: 8.4.85
; Page: 80
; Versions: 18.2.0..19.1.0
"The Include-Identifiers AVP is of type Grouped, and it shall contain External Group Identifiers or MSISDNs."
    members at-least-one External-Identifier MSISDN
