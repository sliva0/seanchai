; Type: Message
; Name: Subscriber-Information-Request, SIR
; Section: 6.2.3
; Page: 20
<Subscriber-Information-Request> ::= < Diameter Header: 8388641, REQ, PXY, 16777310 >
        < Session-Id >
        [ DRMP ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ Destination-Host ]
        { Destination-Realm }
        { User-Identifier }
        [ Service-ID ]
        [ SCS-Identity ]
        [ Service-Parameters ]
        { SIR-Flags }
        [ OC-Supported-Features ]
      * [ Supported-Features ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: Subscriber-Information-Answer, SIA
; Section: 6.2.4
; Page: 21
<Subscriber-Information-Answer> ::= < Diameter Header: 8388641, PXY, 16777310 >
        < Session-Id >
        [ DRMP ]
        [ Result-Code ]
        [ Experimental-Result ]
        { Auth-Session-State }
        { Origin-Host }
        { Origin-Realm }
        [ OC-Supported-Features ]
        [ OC-OLR ]
      * [ Load ]
      * [ Supported-Features ]
      * [ User-Identifier ]
        [ Service-Data ]
        [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: Configuration-Information-Request, CIR
; Section: 8.2.3
; Page: 44
