Group-Configuration-In-Progress               = 0
All-Monitoring-Events-Cancelled               = 1
Change-Of-Authorized-Monitoring-Events        = 2
All-Communication-Pattern-Cancelled           = 3
All-Suggested-Network-Configuration-Cancelled = 4


; Type: Interpreted Constraints ;; interpreted: (TS29.336.dadx#rir-flags-undefined-bits)
; AVP: RIR-Flags
; Section: 8.4.63
; Table: 8.4.63-1
; Page: 73
; Versions: 18.2.0..19.1.0
"NOTE: Bits not defined in this table shall be cleared by the sender and discarded by the receiver of the command."
    bits only 0 1 2 3 4


