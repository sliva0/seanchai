; Type: Message
; Name: Accounting-Request, ACR
; Section: 6.2.2
; Page: 50
<Accounting-Request> ::= < Diameter Header: 271, REQ, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Accounting-Record-Type }
        { Accounting-Record-Number }
        [ Acct-Application-Id ]
;;      [ Vendor-Specific-Application-Id ] ; strikethrough
        [ User-Name ]
        [ Destination-Host ]
;;      [ Accounting-Sub-Session-Id ]      ; strikethrough
;;      [ Acct-Session-Id ]                ; strikethrough
;;      [ Acct-Multi-Session-Id ]          ; strikethrough
        [ Acct-Interim-Interval ]
;;      [ Accounting-Realtime-Required ]   ; strikethrough
        [ Origin-State-Id ]
        [ Event-Timestamp ]
      * [ Proxy-Info ]
      * [ Route-Record ]
        [ Service-Context-Id ]
        [ Service-Information ]
      * [ AVP ]


; Type: Message
; Name: Accounting-Answer, ACA
; Section: 6.2.3
; Page: 52
<Accounting-Answer> ::= < Diameter Header: 271, PXY >
        < Session-Id >
        { Result-Code }
        { Origin-Host }
        { Origin-Realm }
        { Accounting-Record-Type }
        { Accounting-Record-Number }
        [ Acct-Application-Id ]
;;      [ Vendor-Specific-Application-Id ] ; strikethrough
        [ User-Name ]
;;      [ Accounting-Sub-Session-Id ]      ; strikethrough
;;      [ Acct-Session-Id ]                ; strikethrough
;;      [ Acct-Multi-Session-Id ]          ; strikethrough
        [ Error-Reporting-Host ]
        [ Acct-Interim-Interval ]
;;      [ Accounting-Realtime-Required ]   ; strikethrough
        [ Origin-State-Id ]
        [ Event-Timestamp ]
      * [ Proxy-Info ]
      * [ AVP ]


; Type: Message
; Name: Credit-Control-Request, CCR
; Section: 6.4.2
; Page: 65
<Credit-Control-Request> ::= < Diameter Header: 272, REQ, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Auth-Application-Id }
        { Service-Context-Id }
        { CC-Request-Type }
        { CC-Request-Number }
        [ Destination-Host ]
        [ User-Name ]
;;      [ CC-Sub-Session-Id ]                ; strikethrough
;;      [ Acct-Multi-Session-Id ]            ; strikethrough
        [ Origin-State-Id ]
        [ Event-Timestamp ]
      * [ Subscription-Id ]
;;      [ Service-Identifier ]               ; strikethrough
        [ Termination-Cause ]
;;      [ Requested-Service-Unit ]           ; strikethrough
        [ Requested-Action ]
;;    * [ Used-Service-Unit ]                ; strikethrough
        [ AoC-Request-Type ]
        [ Multiple-Services-Indicator ]
      * [ Multiple-Services-Credit-Control ]
;;    * [ Service-Parameter-Info ]           ; strikethrough
        [ CC-Correlation-Id ]
        [ User-Equipment-Info ]
      * [ Proxy-Info ]
      * [ Route-Record ]
        [ Service-Information ]
      * [ AVP ]


; Type: Message
; Name: Credit-Control-Answer, CCA
; Section: 6.4.3
; Page: 70
<Credit-Control-Answer> ::= < Diameter Header: 272, PXY >
        < Session-Id >
        { Result-Code }
        { Origin-Host }
        { Origin-Realm }
        { Auth-Application-Id }
        { CC-Request-Type }
        { CC-Request-Number }
;;      [ User-Name ]                        ; strikethrough
        [ CC-Session-Failover ]
;;      [ CC-Sub-Session-Id ]                ; strikethrough
;;      [ Acct-Multi-Session-Id ]            ; strikethrough
;;      [ Origin-State-Id ]                  ; strikethrough
;;      [ Event-Timestamp ]                  ; strikethrough
;;      [ Granted-Service-Unit ]             ; strikethrough
      * [ Multiple-Services-Credit-Control ]
        [ Cost-Information ]
        [ Low-Balance-Indication ]
        [ Remaining-Balance ]
;;      [ Final-Unit-Indication ]            ; strikethrough
;;      [ Check-Balance-Result ]             ; strikethrough
        [ Credit-Control-Failure-Handling ]
        [ Direct-Debiting-Failure-Handling ]
;;      [ Validity-Time ]                    ; strikethrough
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ Failed-AVP ]
        [ Service-Information ]
      * [ AVP ]


; Type: Message
; Name: Re-Auth-Request, RAR
; Section: 6.4.4
; Page: 74
<Re-Auth-Request> ::= < Diameter Header: 258, REQ, PXY >
;; patched: the table prints no Diameter header, see TS32.299.toml
        < Session-Id > ;; corrected: (TS32.299.py#rel11-rar-session-id-position)
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Destination-Host }
        { Auth-Application-Id }
        { Re-Auth-Request-Type }
        [ User-Name ]
        [ Origin-State-Id ]
      * [ Proxy-Info ] ;; corrected: (TS32.299.py#rel11-rar-repeats-proxy-info-min) ;; corrected: (TS32.299.py#rel11-rar-repeats-proxy-info-max)
;;      { Proxy-Host }
;;      { Proxy-State }
      * [ Route-Record ] ;; corrected: (TS32.299.py#rel11-rar-repeats-route-record-min) ;; corrected: (TS32.299.py#rel11-rar-repeats-route-record-max)
;;      [ CC-Sub-Session-Id ]     ; strikethrough
        [ G-S-U-Pool-Identifier ]
        [ Service-Identifier ]
        [ Rating-Group ]
      * [ AVP ] ;; corrected: (TS32.299.py#rel11-rar-repeats-avp-min) ;; corrected: (TS32.299.py#rel11-rar-repeats-avp-max)


; Type: Message
; Name: Re-Auth-Answer, RAA
; Section: 6.4.5
; Page: 75
<Re-Auth-Answer> ::= < Diameter Header: 258, PXY >
        < Session-Id >
        { Result-Code }
        { Origin-Host }
        { Origin-Realm }
        [ User-Name ]
        [ Origin-State-Id ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
      * [ Failed-AVP ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
;;    * [ Proxy-Info ]              ; strikethrough
;;      { Proxy-Host }              ; strikethrough
;;      { Proxy-State }             ; strikethrough
      * [ AVP ]


