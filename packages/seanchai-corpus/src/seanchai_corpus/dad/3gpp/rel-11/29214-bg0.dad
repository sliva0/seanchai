; Type: Application Scope
; Name: Rx
; Section: 5.1
; Page: 22
; Application-ID: 16777236
; Applies-To: 5.*


; Type: Message
; Name: AA-Request, AAR
; Section: 5.6.1
; Page: 39
<AA-Request> ::= < Diameter Header: 265, REQ, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        [ Destination-Host ]
        [ IP-Domain-Id ]
        [ AF-Application-Identifier ]   ; bold
      * [ Media-Component-Description ] ; bold
        [ Service-Info-Status ]         ; bold
        [ AF-Charging-Identifier ]      ; bold
        [ SIP-Forking-Indication ]      ; bold
      * [ Specific-Action ]             ; bold
      * [ Subscription-Id ]             ; bold
      * [ Supported-Features ]          ; bold
        [ Reservation-Priority ]        ; bold
        [ Framed-IP-Address ]           ; bold
        [ Framed-IPv6-Prefix ]          ; bold ;; corrected: (TS29.214.py#rel11-aar-framed-ipv6-prefix-case)
        [ Called-Station-Id ]           ; bold
        [ Service-URN ]                 ; bold
        [ Sponsored-Connectivity-Data ] ; bold
        [ MPS-Identifier ]              ; bold
        [ Rx-Request-Type ]             ; bold
      * [ Required-Access-Info ]        ; bold
        [ Origin-State-Id ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: AA-Answer, AAA
; Section: 5.6.2
; Page: 40
<AA-Answer> ::= < Diameter Header: 265, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Origin-Host }
        { Origin-Realm }
        [ Result-Code ]
        [ Experimental-Result ]
      * [ Access-Network-Charging-Identifier ] ; bold
        [ Access-Network-Charging-Address ]    ; bold
        [ Acceptable-Service-Info ]            ; bold
        [ IP-CAN-Type ]                        ; bold
        [ NetLoc-Access-Support ]              ; bold
        [ RAT-Type ]
      * [ Flows ]                              ; bold
      * [ Supported-Features ]
      * [ Class ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
      * [ Failed-AVP ]
        [ Origin-State-Id ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Proxy-Info ]
      * [ AVP ]


; Type: Message
; Name: RA-Request, RAR
; Section: 5.6.3
; Page: 40
<RA-Request> ::= < Diameter Header: 258, REQ, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Destination-Host }
        { Auth-Application-Id }
      * { Specific-Action }
      * [ Access-Network-Charging-Identifier ] ; bold
        [ Access-Network-Charging-Address ]    ; bold
      * [ Flows ]                              ; bold
      * [ Subscription-Id ]                    ; bold
        [ Abort-Cause ]                        ; bold
        [ IP-CAN-Type ]                        ; bold
        [ NetLoc-Access-Support ]              ; bold
        [ RAT-Type ]                           ; bold
        [ Sponsored-Connectivity-Data ]        ; bold
        [ 3GPP-User-Location-Info ]            ; bold
        [ User-Location-Info-Time ]            ; bold
        [ 3GPP-MS-TimeZone ]                   ; bold
        [ 3GPP-SGSN-MCC-MNC ]                  ; bold
        [ Origin-State-Id ]
      * [ Class ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: RA-Answer, RAA
; Section: 5.6.4
; Page: 41
<RA-Answer> ::= < Diameter Header: 258, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        [ Result-Code ]
        [ Experimental-Result ]
      * [ Media-Component-Description ] ; bold
        [ Service-URN ]                 ; bold
        [ Origin-State-Id ]
      * [ Class ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ AVP ]


; Type: Message
; Name: ST-Request, STR
; Section: 5.6.5
; Page: 41
<ST-Request> ::= < Diameter Header: 275, REQ, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Auth-Application-Id }
        { Termination-Cause }
        [ Destination-Host ]
      * [ Required-Access-Info ] ; bold
      * [ Class ]
        [ Origin-State-Id ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: ST-Answer, STA
; Section: 5.6.6
; Page: 41
<ST-Answer> ::= < Diameter Header: 275, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        [ Result-Code ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
      * [ Failed-AVP ]
        [ Sponsored-Connectivity-Data ] ; bold
        [ Origin-State-Id ]
        [ 3GPP-User-Location-Info ]     ; bold
        [ User-Location-Info-Time ]     ; bold
        [ 3GPP-MS-TimeZone ]            ; bold
        [ 3GPP-SGSN-MCC-MNC ]           ; bold
        [ NetLoc-Access-Support ]
      * [ Class ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Proxy-Info ]
      * [ AVP ]


; Type: Message
; Name: AS-Request, ASR
; Section: 5.6.7
; Page: 42
<AS-Request> ::= < Diameter Header: 274, REQ, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Destination-Host }
        { Auth-Application-Id }
        { Abort-Cause }         ; bold
        [ Origin-State-Id ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: AS-Answer, ASA
; Section: 5.6.8
; Page: 42
<AS-Answer> ::= < Diameter Header: 274, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        [ Result-Code ]
        [ Origin-State-Id ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
      * [ Failed-AVP ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Proxy-Info ]
      * [ AVP ]


