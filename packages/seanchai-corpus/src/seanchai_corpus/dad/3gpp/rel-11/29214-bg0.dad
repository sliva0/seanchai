; Type: Enumerated AVP
; Name: Abort-Cause
; Section: 5.3.1
; Page: 23
Abort-Cause ::= < Enumerated AVP header: 500 10415 >
        BEARER_RELEASED                        = 0
        INSUFFICIENT_SERVER_RESOURCES          = 1
        INSUFFICIENT_BEARER_RESOURCES          = 2
        PS_TO_CS_HANDOVER                      = 3
        SPONSORED_DATA_CONNECTIVITY_DISALLOWED = 4


; Type: Grouped AVP
; Name: Access-Network-Charging-Identifier
; Section: 5.3.3
; Page: 24
Access-Network-Charging-Identifier ::= < AVP header: 502 10415 > ;; corrected: (TS29.214.py#rel11-vendor-id-access-network-charging-identifier)
        { Access-Network-Charging-Identifier-Value }
      * [ Flows ]


; Type: Grouped AVP
; Name: Flows
; Section: 5.3.10
; Page: 26
Flows ::= < AVP header: 510 10415 > ;; corrected: (TS29.214.py#rel11-vendor-id-flows)
        { Media-Component-Number }
      * [ Flow-Number ]
        [ Final-Unit-Action ]


; Type: Enumerated AVP
; Name: Flow-Status
; Section: 5.3.11
; Page: 26
Flow-Status ::= < Enumerated AVP header: 511 10415 >
        ENABLED-UPLINK   = 0
        ENABLED-DOWNLINK = 1
        ENABLED          = 2
        DISABLED         = 3
        REMOVED          = 4


; Type: Enumerated AVP
; Name: Flow-Usage
; Section: 5.3.12
; Page: 26
Flow-Usage ::= < Enumerated AVP header: 512 10415 >
        NO_INFORMATION = 0
        RTCP           = 1
        AF_SIGNALLING  = 2


; Type: Enumerated AVP
; Name: Specific-Action
; Section: 5.3.13
; Page: 27
Specific-Action ::= < Enumerated AVP header: 513 10415 >
        ;; deleted: value 'Void' (= 0) (TS29.214.py#rel11-specific-action-void-0)
        CHARGING_CORRELATION_EXCHANGE                       = 1
        INDICATION_OF_LOSS_OF_BEARER                        = 2
        INDICATION_OF_RECOVERY_OF_BEARER                    = 3
        INDICATION_OF_RELEASE_OF_BEARER                     = 4
        ;; deleted: value 'Void' (= 5) (TS29.214.py#rel11-specific-action-void-5)
        IP-CAN_CHANGE                                       = 6
        INDICATION_OF_OUT_OF_CREDIT                         = 7
        INDICATION_OF_SUCCESSFUL_RESOURCES_ALLOCATION       = 8
        INDICATION_OF_FAILED_RESOURCES_ALLOCATION           = 9
        INDICATION_OF_LIMITED_PCC_DEPLOYMENT                = 10
        USAGE_REPORT                                        = 11
        ACCESS_NETWORK_INFO_REPORT                          = 12
        INDICATION_OF_RECOVERY_FROM_LIMITED_PCC_DEPLOYMENT  = 13
        INDICATION_OF_ACCESS_NETWORK_INFO_REPORTING_FAILURE = 14


; Type: Grouped AVP
; Name: Media-Component-Description
; Section: 5.3.16
; Page: 29
Media-Component-Description ::= < AVP header: 517 10415 > ;; corrected: (TS29.214.py#rel11-vendor-id-media-component-description)
        { Media-Component-Number }
      * [ Media-Sub-Component ]
        [ AF-Application-Identifier ]
        [ Media-Type ]
        [ Max-Requested-Bandwidth-UL ]
        [ Max-Requested-Bandwidth-DL ]
        [ Min-Requested-Bandwidth-UL ]
        [ Min-Requested-Bandwidth-DL ]
        [ Flow-Status ]
        [ Reservation-Priority ]
        [ RS-Bandwidth ]
        [ RR-Bandwidth ]
      * [ Codec-Data ]


; Type: Grouped AVP
; Name: Media-Sub-Component
; Section: 5.3.18
; Page: 31
Media-Sub-Component ::= < AVP header: 519 10415 > ;; corrected: (TS29.214.py#rel11-vendor-id-media-sub-component)
        { Flow-Number }
     *2 [ Flow-Description ]
        [ Flow-Status ]
        [ Flow-Usage ]
        [ Max-Requested-Bandwidth-UL ]
        [ Max-Requested-Bandwidth-DL ]
        [ AF-Signalling-Protocol ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Media-Type
; Section: 5.3.19
; Page: 31
Media-Type ::= < Enumerated AVP header: 520 10415 >
        AUDIO       = 0
        VIDEO       = 1
        DATA        = 2
        APPLICATION = 3
        CONTROL     = 4
        TEXT        = 5
        MESSAGE     = 6
        OTHER       = 4294967295


; Type: Enumerated AVP
; Name: SIP-Forking-Indication
; Section: 5.3.22
; Page: 32
SIP-Forking-Indication ::= < Enumerated AVP header: 523 10415 >
        SINGLE_DIALOGUE   = 0
        SEVERAL_DIALOGUES = 1


; Type: Grouped AVP
; Name: Acceptable-Service-Info
; Section: 5.3.24
; Page: 32
Acceptable-Service-Info ::= < AVP header: 526 10415 > ;; corrected: (TS29.214.py#rel11-vendor-id-acceptable-service-info)
      * [ Media-Component-Description ]
        [ Max-Requested-Bandwidth-DL ]
        [ Max-Requested-Bandwidth-UL ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Service-Info-Status
; Section: 5.3.25
; Page: 33
Service-Info-Status ::= < Enumerated AVP header: 527 10415 >
        "FINAL SERVICE INFORMATION"       = 0
        "PRELIMINARY SERVICE INFORMATION" = 1


; Type: Enumerated AVP
; Name: AF-Signalling-Protocol
; Section: 5.3.26
; Page: 33
AF-Signalling-Protocol ::= < Enumerated AVP header: 529 10415 >
        NO_INFORMATION = 0
        SIP            = 1


; Type: Grouped AVP
; Name: Sponsored-Connectivity-Data
; Section: 5.3.27
; Page: 33
Sponsored-Connectivity-Data ::= < AVP header: 530 10415 > ;; corrected: (TS29.214.py#rel11-vendor-id-sponsored-connectivity-data)
        [ Sponsor-Identity ]
        [ Application-Service-Provider-Identity ]
        [ Granted-Service-Unit ]
        [ Used-Service-Unit ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Rx-Request-Type
; Section: 5.3.31
; Page: 34
Rx-Request-Type ::= < Enumerated AVP header: 533 10415 >
        INITIAL_REQUEST = 0
        UPDATE_REQUEST  = 1


; Type: Enumerated AVP
; Name: Required-Access-Info
; Section: 5.3.34
; Page: 34
Required-Access-Info ::= < Enumerated AVP header: 536 10415 >
        USER_LOCATION = 0
        MS_TIME_ZONE  = 1


