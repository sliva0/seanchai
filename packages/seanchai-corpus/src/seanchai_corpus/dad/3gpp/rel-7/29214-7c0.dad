; Type: Reused AVPs
; Section: 5.4
; Table: 5.4.1
; Page: 25
; Columns: Name        From
Subscription-Id        RFC4006
Reservation-Priority   ETSI-TS183.017
Framed-IP-Address      RFC4005
Framed-IPv6-Prefix     RFC4005
3GPP-RAT-Type          TS29.061
IP-CAN-Type            TS29.212


; Type: Enumerated AVP
; Name: Abort-Cause
; Section: 5.3.1
; Page: 17
Abort-Cause ::= < Enumerated AVP header: 500 10415 >
        BEARER_RELEASED               = 0
        INSUFFICIENT_SERVER_RESOURCES = 1
        INSUFFICIENT_BEARER_RESOURCES = 2


; Type: Grouped AVP
; Name: Access-Network-Charging-Identifier
; Section: 5.3.3
; Page: 18
Access-Network-Charging-Identifier ::= < AVP header: 502 10415 > ;; corrected: (TS29.214.py#rel7-vendor-id-access-network-charging-identifier)
        { Access-Network-Charging-Identifier-Value }
      * [ Flows ]


; Type: Grouped AVP
; Name: Flows
; Section: 5.3.10
; Page: 19
Flows ::= < AVP header: 510 10415 > ;; corrected: (TS29.214.py#rel7-vendor-id-flows)
        { Media-Component-Number }
      * [ Flow-Number ]


; Type: Enumerated AVP
; Name: Flow-Status
; Section: 5.3.11
; Page: 20
Flow-Status ::= < Enumerated AVP header: 511 10415 >
        ENABLED-UPLINK   = 0
        ENABLED-DOWNLINK = 1
        ENABLED          = 2
        DISABLED         = 3
        REMOVED          = 4


; Type: Enumerated AVP
; Name: Flow-Usage
; Section: 5.3.12
; Page: 20
Flow-Usage ::= < Enumerated AVP header: 512 10415 >
        NO_INFORMATION = 0
        RTCP           = 1
        AF_SIGNALLING  = 2


; Type: Enumerated AVP
; Name: Specific-Action
; Section: 5.3.13
; Page: 20
Specific-Action ::= < Enumerated AVP header: 513 10415 >
      ; VOID                                  = 0
        CHARGING_CORRELATION_EXCHANGE         = 1
        INDICATION_OF_LOSS_OF_BEARER          = 2
        INDICATION_OF_RECOVERY_OF_BEARER      = 3
        INDICATION_OF_RELEASE_OF_BEARER       = 4
        INDICATION_OF_ESTABLISHMENT_OF_BEARER = 5
        IP-CAN_CHANGE                         = 6


; Type: Grouped AVP
; Name: Media-Component-Description
; Section: 5.3.16
; Page: 22
Media-Component-Description ::= < AVP header: 517 10415 > ;; corrected: (TS29.214.py#rel7-vendor-id-media-component-description)
        { Media-Component-Number }
      * [ Media-Sub-Component ]
        [ AF-Application-Identifier ]
        [ Media-Type ]
        [ Max-Requested-Bandwidth-UL ]
        [ Max-Requested-Bandwidth-DL ]
        [ Flow-Status ]
        [ Reservation-Priority ]
        [ RS-Bandwidth ]
        [ RR-Bandwidth ]
      * [ Codec-Data ]


; Type: Grouped AVP
; Name: Media-Sub-Component
; Section: 5.3.18
; Page: 23
Media-Sub-Component ::= < AVP header: 519 10415 > ;; corrected: (TS29.214.py#rel7-vendor-id-media-sub-component)
        { Flow-Number }
     *2 [ Flow-Description ]
        [ Flow-Status ]
        [ Flow-Usage ]
        [ Max-Requested-Bandwidth-UL ]
        [ Max-Requested-Bandwidth-DL ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Media-Type
; Section: 5.3.19
; Page: 23
Media-Type ::= < Enumerated AVP header: 520 10415 >
        AUDIO       = 0
        VIDEO       = 1
        DATA        = 2
        APPLICATION = 3
        CONTROL     = 4
        TEXT        = 5
        MESSAGE     = 6
        OTHER       = 4294967295


; Type: Enumerated AVP
; Name: SIP-Forking-Indication
; Section: 5.3.22
; Page: 24
SIP-Forking-Indication ::= < Enumerated AVP header: 523 10415 >
        SINGLE_DIALOGUE   = 0
        SEVERAL_DIALOGUES = 1


; Type: Grouped AVP
; Name: Acceptable-Service-Info
; Section: 5.3.24
; Page: 24
Acceptable-Service-Info ::= < AVP header: 526 10415 > ;; corrected: (TS29.214.py#rel7-vendor-id-acceptable-service-info)
      * [ Media-Component-Description ]
        [ Max-Requested-Bandwidth-DL ]
        [ Max-Requested-Bandwidth-UL ]
      * [ AVP ]


; Type: Enumerated AVP
; Name: Service-Info-Status
; Section: 5.3.25
; Page: 25
Service-Info-Status ::= < Enumerated AVP header: 527 10415 >
        "FINAL SERVICE INFORMATION"       = 0
        "PRELIMINARY SERVICE INFORMATION" = 1


; Type: Value Table
; AVP: Experimental-Result-Code
; Kind: result-codes
; Section: 5.5
; Page: 26
INVALID_SERVICE_INFORMATION      = 5061
FILTER_RESTRICTIONS              = 5062
REQUESTED_SERVICE_NOT_AUTHORIZED = 5063
DUPLICATED_AF_SESSION            = 5064
IP-CAN_SESSION_NOT_AVAILABLE     = 5065
