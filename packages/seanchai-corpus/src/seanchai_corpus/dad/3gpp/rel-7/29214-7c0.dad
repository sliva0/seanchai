; Specification: 3GPP TS 29.214
; Version: 7.12.0
; Vendor-ID: 10415
; Bases: RFC6733
; Link: https://www.etsi.org/deliver/etsi_ts/129200_129299/129214/07.12.00_60/ts_129214v071200p.pdf


; Type: Application Scope
; Name: Rx
; Section: 5.1
; Page: 15
; Application-ID: 16777236
; Applies-To: 5.*


; Type: Message
; Name: AA-Request, AAR
; Section: 5.6.1
; Page: 26
<AA-Request> ::= < Diameter Header: 265, REQ, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        [ Destination-Host ]
        [ AF-Application-Identifier ]   ; bold
      * [ Media-Component-Description ] ; bold
        [ Service-Info-Status ]         ; bold
        [ AF-Charging-Identifier ]      ; bold
        [ SIP-Forking-Indication ]      ; bold
      * [ Specific-Action ]             ; bold
      * [ Subscription-Id ]             ; bold
        [ Reservation-Priority ]        ; bold
        [ Framed-IP-Address ]           ; bold
        [ Framed-IPv6-Prefix ]          ; bold
        [ Service-URN ]                 ; bold
        [ Origin-State-Id ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: AA-Answer, AAA
; Section: 5.6.2
; Page: 27
<AA-Answer> ::= < Diameter Header: 265, PXY >
        < Session-Id >
        { Auth-Application-Id }
        { Origin-Host }
        { Origin-Realm }
        [ Result-Code ]
        [ Experimental-Result ]
      * [ Access-Network-Charging-Identifier ] ; bold
        [ Access-Network-Charging-Address ]    ; bold
        [ Acceptable-Service-Info ]            ; bold
        [ IP-CAN-Type ]                        ; bold
        [ 3GPP-RAT-Type ]                      ; bold
        [ Error-Message ]
        [ Error-Reporting-Host ]
      * [ Failed-AVP ]
        [ Origin-State-Id ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Proxy-Info ]
      * [ AVP ]


; Type: Message
; Name: RA-Request, RAR
; Section: 5.6.3
; Page: 27
<RA-Request> ::= < Diameter Header: 258, REQ, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Destination-Host }
        { Auth-Application-Id }
        { Specific-Action }                    ; bold
      * [ Access-Network-Charging-Identifier ] ; bold
        [ Access-Network-Charging-Address ]    ; bold
      * [ Flows ]                              ; bold
      * [ Subscription-Id ]                    ; bold
        [ Abort-Cause ]
        [ IP-CAN-Type ]                        ; bold
        [ 3GPP-RAT-Type ]                      ; bold
        [ Origin-State-Id ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: RA-Answer, RAA
; Section: 5.6.4
; Page: 27
<RA-Answer> ::= < Diameter Header: 258, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        [ Result-Code ]
        [ Experimental-Result ]
      * [ Media-Component-Description ] ; bold
        [ Service-URN ]                 ; bold
        [ Origin-State-Id ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
      * [ Failed-AVP ]
      * [ Proxy-Info ]
      * [ AVP ]


; Type: Message
; Name: ST-Request, STR
; Section: 5.6.5
; Page: 28
<ST-Request> ::= < Diameter Header: 275, REQ, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Auth-Application-Id }
        { Termination-Cause }
        [ Destination-Host ]
      * [ Class ]
        [ Origin-State-Id ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: ST-Answer, STA
; Section: 5.6.6
; Page: 28
<ST-Answer> ::= < Diameter Header: 275, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        [ Result-Code ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
      * [ Failed-AVP ]
        [ Origin-State-Id ]
      * [ Redirect-Host ]
        [ Redirect-Host-Usage ]
        [ Redirect-Max-Cache-Time ]
      * [ Proxy-Info ]
      * [ AVP ]


; Type: Message
; Name: AS-Request, ASR
; Section: 5.6.7
; Page: 28
<AS-Request> ::= < Diameter Header: 274, REQ, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        { Destination-Realm }
        { Destination-Host }
        { Auth-Application-Id }
        { Abort-Cause }         ; bold
        [ Origin-State-Id ]
      * [ Proxy-Info ]
      * [ Route-Record ]
      * [ AVP ]


; Type: Message
; Name: AS-Answer, ASA
; Section: 5.6.8
; Page: 29
<AS-Answer> ::= < Diameter Header: 274, PXY >
        < Session-Id >
        { Origin-Host }
        { Origin-Realm }
        [ Result-Code ]
        [ Origin-State-Id ]
        [ Error-Message ]
        [ Error-Reporting-Host ]
      * [ Failed-AVP ]
      * [ Redirect-Host ] ;; corrected: (TS29.214.py#rel7-asa-redirect-host)
        [ Redirect-Host-Usage ] ;; corrected: (TS29.214.py#rel7-asa-redirect-host-usage)
        [ Redirect-Max-Cache-Time ] ;; corrected: (TS29.214.py#rel7-asa-redirect-max-cache-time)
      * [ Proxy-Info ]
      * [ AVP ]


