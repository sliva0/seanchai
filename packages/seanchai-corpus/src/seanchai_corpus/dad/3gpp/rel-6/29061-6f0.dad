; Type: Enumerated AVP
; Name: MBMS-StartStop-Indication
; Section: 17.7.5
; Page: 89
MBMS-StartStop-Indication ::= < Enumerated AVP header: 902 10415 >
        START = 0
        STOP  = 1


; Type: Enumerated AVP
; Name: MBMS-Service-Type
; Section: 17.7.9
; Page: 90
MBMS-Service-Type ::= < Enumerated AVP header: 906 10415 >
        MULTICAST = 0
        BROADCAST = 1


; Type: Enumerated AVP
; Name: MBMS-2G-3G-Indicator
; Section: 17.7.10
; Page: 91
MBMS-2G-3G-Indicator ::= < Enumerated AVP header: 907 10415 >
        2G        = 0
        3G        = 1
        2G-AND-3G = 2


; Type: Enumerated AVP
; Name: MBMS-Counting-Information
; Section: 17.7.17
; Page: 92
MBMS-Counting-Information ::= < Enumerated AVP header: 914 10415 >
        COUNTING-NOT-APPLICABLE = 0
        COUNTING-APPLICABLE     = 1


; Type: Value Table
; AVP: Experimental-Result-Code
; Kind: result-codes
; Section: 17.8
; Page: 92
DIAMETER_ERROR_START_INDICATION            = 5120 ; 17.8.2
DIAMETER_ERROR_STOP_INDICATION             = 5121 ; 17.8.2
DIAMETER_ERROR_UNKNOWN_MBMS_BEARER_SERVICE = 5122 ; 17.8.2
DIAMETER_ERROR_SERVICE_AREA                = 5123 ; 17.8.2
DIAMETER_ERROR_OUT_OF_RESOURCES            = 4121 ; 17.8.3
