From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sliva0 <sliva0mk@gmail.com>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Diameter: Add 12 AVPs from 3GPP TS 29.217
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

3GPP TS 29.217 V18.0.0 defines these AVPs in vendor 10415, which the
dictionary has no entry for at their codes:

  Aggregated-Congestion-Info (4000): Grouped, 2 members, clause 5.3.2
  Aggregated-RUCI-Report (4001): Grouped, 4 members, clause 5.3.3
  Congestion-Level-Definition (4002): Grouped, 2 members, clause 5.3.4
  Congestion-Level-Range (4003): Unsigned32, clause 5.3.5
  Congestion-Level-Set-Id (4004): Unsigned32, clause 5.3.6
  Congestion-Level-Value (4005): Unsigned32, clause 5.3.7
  Congestion-Location-Id (4006): Grouped, 3 members, clause 5.3.8
  Conditional-Restriction (4007): Unsigned32, clause 5.3.9
  IMSI-List (4009): OctetString, clause 5.3.11
  RCAF-Id (4010): DiameterIdentity, clause 5.3.12
  Reporting-Restriction (4011): Unsigned32, clause 5.3.13
  RUCI-Action (4012): Unsigned32, clause 5.3.14

Each entry's type, enumerated values and grouped members are the
document's, from its clauses and AVP tables, and so are its M and V bits
where the document states them.

Generated by Seanchaí (integrations/wireshark/additions.py).
---
 resources/protocols/diameter/dictionary.xml | 51 +++++++++++++++++++++
 1 file changed, 51 insertions(+)

diff --git a/resources/protocols/diameter/dictionary.xml b/resources/protocols/diameter/dictionary.xml
index 56a8586..8aa21ce 100644
--- a/resources/protocols/diameter/dictionary.xml
+++ b/resources/protocols/diameter/dictionary.xml
@@ -8861,6 +8861,57 @@
 		<avp name="Rate-Control-Time-Unit" code="3939" mandatory="must" vendor-bit="must" may-encrypt="no" protected="may" vendor-id="TGPP">
 			<type type-name="Unsigned32"/>
 		</avp>
+		<avp name="Aggregated-Congestion-Info" code="4000" mandatory="must" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+			<grouped>
+				<gavp name="Congestion-Location-Id"/>
+				<gavp name="IMSI-List"/>
+			</grouped>
+		</avp>
+		<avp name="Aggregated-RUCI-Report" code="4001" mandatory="must" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+			<grouped>
+				<gavp name="Aggregated-Congestion-Info"/>
+				<gavp name="Called-Station-Id"/>
+				<gavp name="Congestion-Level-Value"/>
+				<gavp name="Congestion-Level-Set-Id"/>
+			</grouped>
+		</avp>
+		<avp name="Congestion-Level-Definition" code="4002" mandatory="mustnot" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+			<grouped>
+				<gavp name="Congestion-Level-Set-Id"/>
+				<gavp name="Congestion-Level-Range"/>
+			</grouped>
+		</avp>
+		<avp name="Congestion-Level-Range" code="4003" mandatory="mustnot" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+			<type type-name="Unsigned32"/>
+		</avp>
+		<avp name="Congestion-Level-Set-Id" code="4004" mandatory="mustnot" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+			<type type-name="Unsigned32"/>
+		</avp>
+		<avp name="Congestion-Level-Value" code="4005" mandatory="must" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+			<type type-name="Unsigned32"/>
+		</avp>
+		<avp name="Congestion-Location-Id" code="4006" mandatory="mustnot" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+			<grouped>
+				<gavp name="3GPP-User-Location-Info"/>
+				<gavp name="eNodeB-ID"/>
+				<gavp name="Extended-eNodeB-ID"/>
+			</grouped>
+		</avp>
+		<avp name="Conditional-Restriction" code="4007" mandatory="mustnot" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+			<type type-name="Unsigned32"/>
+		</avp>
+		<avp name="IMSI-List" code="4009" mandatory="must" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+			<type type-name="OctetString"/>
+		</avp>
+		<avp name="RCAF-Id" code="4010" mandatory="must" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+			<type type-name="DiameterIdentity"/>
+		</avp>
+		<avp name="Reporting-Restriction" code="4011" mandatory="mustnot" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+			<type type-name="Unsigned32"/>
+		</avp>
+		<avp name="RUCI-Action" code="4012" mandatory="mustnot" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+			<type type-name="Unsigned32"/>
+		</avp>
 		<avp name="SCS-AS-Address" code="3940" mandatory="must" vendor-bit="must" may-encrypt="no" protected="may" vendor-id="TGPP">
 			<grouped>
 				<gavp name="SCS-Realm"/>
