From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sliva0 <sliva0mk@gmail.com>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Diameter: Add 8 AVPs from 3GPP TS 29.229
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

3GPP TS 29.229 V18.1.0 defines these AVPs in vendor 10415, which the
dictionary has no entry for at their codes:

  RTR-Flags (659): Unsigned32, clause 6.3.69
  P-CSCF-Subscription-Info (660): Grouped, 4 members, clause 6.3.70
  Registration-Time-Out (661): Time, clause 6.3.71
  Alternate-Digest-Algorithm (662): UTF8String, clause 6.3.72
  Alternate-Digest-HA1 (663): UTF8String, clause 6.3.73
  Failed-PCSCF (664): Grouped, 2 members, clause 6.3.74
  PCSCF-FQDN (665): DiameterIdentity, clause 6.3.75
  PCSCF-IP-Address (666): Address, clause 6.3.76

Each entry's type, enumerated values and grouped members are the
document's, from its clauses and AVP tables, and so are its M and V bits
where the document states them.

Generated by Seanchaí (integrations/wireshark/additions.py).
---
 resources/protocols/diameter/TGPP.xml | 32 +++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/resources/protocols/diameter/TGPP.xml b/resources/protocols/diameter/TGPP.xml
index 65e5a13..43ca4b2 100644
--- a/resources/protocols/diameter/TGPP.xml
+++ b/resources/protocols/diameter/TGPP.xml
@@ -962,6 +962,38 @@
   <avp name="WebRTC-Web-Server-Function-Name" code="658" mandatory="must" vendor-bit="must" vendor-id="TGPP" may-encrypt="no">
     <type type-name="UTF8String"/>
   </avp>
+  <avp name="RTR-Flags" code="659" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="Unsigned32"/>
+  </avp>
+  <avp name="P-CSCF-Subscription-Info" code="660" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <grouped>
+      <gavp name="Call-ID-SIP-Header"/>
+      <gavp name="From-SIP-Header"/>
+      <gavp name="To-SIP-Header"/>
+      <gavp name="Contact"/>
+    </grouped>
+  </avp>
+  <avp name="Registration-Time-Out" code="661" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="Time"/>
+  </avp>
+  <avp name="Alternate-Digest-Algorithm" code="662" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="UTF8String"/>
+  </avp>
+  <avp name="Alternate-Digest-HA1" code="663" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="UTF8String"/>
+  </avp>
+  <avp name="Failed-PCSCF" code="664" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <grouped>
+      <gavp name="PCSCF-FQDN"/>
+      <gavp name="PCSCF-IP-Address"/>
+    </grouped>
+  </avp>
+  <avp name="PCSCF-FQDN" code="665" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="DiameterIdentity"/>
+  </avp>
+  <avp name="PCSCF-IP-Address" code="666" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="IPAddress"/>
+  </avp>
 </application>
 
 
