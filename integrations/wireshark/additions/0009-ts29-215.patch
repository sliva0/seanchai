From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sliva0 <sliva0mk@gmail.com>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Diameter: Add 4 AVPs from 3GPP TS 29.215
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

3GPP TS 29.215 V18.0.0 defines these AVPs in vendor 10415, which the
dictionary has no entry for at their codes:

  UE-Local-IPv6-Prefix (2205): OctetString, clause A.8.3.1
  DRA-Deployment (2206): Enumerated, 1 value, clause 5.3.7
  PCRF-Address (2207): DiameterIdentity, clause A.7.3.1.1
  DRA-Binding (2208): Enumerated, 1 value, clause 5.3.8

Each entry's type, enumerated values and grouped members are the
document's, from its clauses and AVP tables, and so are its M and V bits
where the document states them.

Generated by Seanchaí (integrations/wireshark/additions.py).
---
 resources/protocols/diameter/TGPP.xml | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/resources/protocols/diameter/TGPP.xml b/resources/protocols/diameter/TGPP.xml
index 65e5a13..1152081 100644
--- a/resources/protocols/diameter/TGPP.xml
+++ b/resources/protocols/diameter/TGPP.xml
@@ -1412,6 +1412,20 @@
     <enum name="ESTABLISHMENT" code="0"/>
     <enum name="TERMINATION"   code="1"/>
   </avp>
+  <avp name="UE-Local-IPv6-Prefix" code="2205" mandatory="must" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+    <type type-name="OctetString"/>
+  </avp>
+  <avp name="DRA-Deployment" code="2206" mandatory="mustnot" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+    <type type-name="Enumerated"/>
+    <enum name="DRA_Deployed" code="0"/>
+  </avp>
+  <avp name="PCRF-Address" code="2207" mandatory="must" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+    <type type-name="DiameterIdentity"/>
+  </avp>
+  <avp name="DRA-Binding" code="2208" mandatory="mustnot" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+    <type type-name="Enumerated"/>
+    <enum name="DRA_BINDING_DELETION" code="0"/>
+  </avp>
 </application>	<!-- 3GPP S9 -->
 
