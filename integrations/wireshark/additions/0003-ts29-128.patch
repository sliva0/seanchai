From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sliva0 <sliva0mk@gmail.com>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Diameter: Add 10 AVPs from 3GPP TS 29.128
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

3GPP TS 29.128 V19.2.0 defines these AVPs in vendor 10415, which the
dictionary has no entry for at their codes:

  Uplink-Number-Of-Packets-Allowed (4327): Unsigned32, clause 6.4.37
  Number-Of-Additional-Exception-Reports (4328): Unsigned32, clause 6.4.38
  Downlink-Number-Of-Packets-Allowed (4329): Unsigned32, clause 6.4.39
  APN-Rate-Control-Status-Validity-Time (4330): Unsigned64, clause 6.4.40
  SF-Operation-Status (4331): Unsigned32, clause 6.4.41
  DL-Estimated-Delivery-Time (4332): Unsigned32, clause 6.4.42
  SAT-SF-Operation-Info (4333): Grouped, 3 members, clause 6.4.43
  Feeder-Link-Availability-Period (4334): Grouped, 2 members, clause 6.4.44
  Availability-Start-Time (4335): Time, clause 6.4.45
  Availability-End-Time (4336): Time, clause 6.4.46

Each entry's type, enumerated values and grouped members are the
document's, from its clauses and AVP tables, and so are its M and V bits
where the document states them.

Not added here: APN-Rate-Control-Status, grouped, with no members stated
here.

Generated by Seanchaí (integrations/wireshark/additions.py).
---
 resources/protocols/diameter/TGPP.xml | 37 +++++++++++++++++++++++++++
 1 file changed, 37 insertions(+)

diff --git a/resources/protocols/diameter/TGPP.xml b/resources/protocols/diameter/TGPP.xml
index 65e5a13..c2ce16e 100644
--- a/resources/protocols/diameter/TGPP.xml
+++ b/resources/protocols/diameter/TGPP.xml
@@ -1863,6 +1863,43 @@
   <avp name="Reachability-Cause" code="4325" mandatory="must" vendor-bit="must" may-encrypt="no" protected="may" vendor-id="TGPP">
     <type type-name="Unsigned32"/>
   </avp>
+  <avp name="Uplink-Number-Of-Packets-Allowed" code="4327" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="Unsigned32"/>
+  </avp>
+  <avp name="Number-Of-Additional-Exception-Reports" code="4328" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="Unsigned32"/>
+  </avp>
+  <avp name="Downlink-Number-Of-Packets-Allowed" code="4329" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="Unsigned32"/>
+  </avp>
+  <avp name="APN-Rate-Control-Status-Validity-Time" code="4330" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="Unsigned64"/>
+  </avp>
+  <avp name="SF-Operation-Status" code="4331" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="Unsigned32"/>
+  </avp>
+  <avp name="DL-Estimated-Delivery-Time" code="4332" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="Unsigned32"/>
+  </avp>
+  <avp name="SAT-SF-Operation-Info" code="4333" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <grouped>
+      <gavp name="SF-Operation-Status"/>
+      <gavp name="DL-Estimated-Delivery-Time"/>
+      <gavp name="Feeder-Link-Availability-Period"/>
+    </grouped>
+  </avp>
+  <avp name="Feeder-Link-Availability-Period" code="4334" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <grouped>
+      <gavp name="Availability-Start-Time"/>
+      <gavp name="Availability-End-Time"/>
+    </grouped>
+  </avp>
+  <avp name="Availability-Start-Time" code="4335" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="Time"/>
+  </avp>
+  <avp name="Availability-End-Time" code="4336" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+    <type type-name="Time"/>
+  </avp>
   <!--
   Note: The AVP codes from 4300 to 4399 are reserved for TS 29.128
   -->
