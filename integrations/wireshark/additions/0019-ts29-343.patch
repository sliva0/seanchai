From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sliva0 <sliva0mk@gmail.com>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Diameter: Add 13 AVPs from 3GPP TS 29.343
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

3GPP TS 29.343 V19.0.0 defines these AVPs in vendor 10415, which the
dictionary has no entry for at their codes:

  Origin-App-Layer-User-Id (3600): UTF8String, clause 6.4.2
  Target-App-Layer-User-Id (3601): UTF8String, clause 6.4.3
  ProSe-Function-ID (3602): OctetString, clause 6.4.4
  ProSe-Request-Type (3603): Unsigned32, clause 6.4.5
  PDUID (3604): OctetString, clause 6.4.6
  Application-Data (3605): UTF8String, clause 6.4.7
  Allowed-Suffixes-Number (3606): Unsigned32, clause 6.4.8
  Monitor-Target (3607): Grouped, 4 members, clause 6.4.9
  ProSe-Code-Suffix-Mask (3608): Grouped, 2 members, clause 6.4.10
  Suffix-Code (3609): OctetString, clause 6.4.11
  Suffix-Mask (3610): OctetString, clause 6.4.12
  Banned-User-Target (3611): Grouped, 2 members, clause 6.4.17
  Metadata-Indicator (3612): Unsigned32, clause 6.4.18

Each entry's type, enumerated values and grouped members are the
document's, from its clauses and AVP tables, and so are its M and V bits
where the document states them.

Generated by Seanchaí (integrations/wireshark/additions.py).
---
 resources/protocols/diameter/TGPP.xml | 50 +++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/resources/protocols/diameter/TGPP.xml b/resources/protocols/diameter/TGPP.xml
index 65e5a13..626b2cf 100644
--- a/resources/protocols/diameter/TGPP.xml
+++ b/resources/protocols/diameter/TGPP.xml
@@ -1703,6 +1703,56 @@
   <avp name="MB2U-Security" code="3517" mandatory="must" vendor-bit="must" vendor-id="TGPP" may-encrypt="yes">
     <type type-name="Unsigned32"/>
   </avp>
+  <avp name="Origin-App-Layer-User-Id" code="3600" mandatory="must" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="UTF8String"/>
+  </avp>
+  <avp name="Target-App-Layer-User-Id" code="3601" mandatory="must" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="UTF8String"/>
+  </avp>
+  <avp name="ProSe-Function-ID" code="3602" mandatory="must" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="OctetString"/>
+  </avp>
+  <avp name="ProSe-Request-Type" code="3603" mandatory="must" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="Unsigned32"/>
+  </avp>
+  <avp name="PDUID" code="3604" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="OctetString"/>
+  </avp>
+  <avp name="Application-Data" code="3605" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="UTF8String"/>
+  </avp>
+  <avp name="Allowed-Suffixes-Number" code="3606" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="Unsigned32"/>
+  </avp>
+  <avp name="Monitor-Target" code="3607" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <grouped>
+      <gavp name="Target-RPAUID"/>
+      <gavp name="PDUID"/>
+      <gavp name="Metadata-Indicator"/>
+      <gavp name="ProSe-Code-Suffix-Mask"/>
+    </grouped>
+  </avp>
+  <avp name="ProSe-Code-Suffix-Mask" code="3608" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <grouped>
+      <gavp name="Suffix-Code"/>
+      <gavp name="Suffix-Mask"/>
+    </grouped>
+  </avp>
+  <avp name="Suffix-Code" code="3609" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="OctetString"/>
+  </avp>
+  <avp name="Suffix-Mask" code="3610" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="OctetString"/>
+  </avp>
+  <avp name="Banned-User-Target" code="3611" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <grouped>
+      <gavp name="Target-RPAUID"/>
+      <gavp name="Target-PDUID"/>
+    </grouped>
+  </avp>
+  <avp name="Metadata-Indicator" code="3612" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="Unsigned32"/>
+  </avp>
 </application>	<!-- 3GPP MB2c -->
 
 <application id="16777336" name="3GPP PC4a" uri="http://www.3gpp.org/ftp/Specs/html-info/29344.htm">
