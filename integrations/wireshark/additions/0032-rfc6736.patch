From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sliva0 <sliva0mk@gmail.com>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Diameter: Add 13 AVPs from RFC 6736
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

RFC 6736 defines these AVPs in the IETF space, which the dictionary has
no entry for at their codes:

  NC-Request-Type (595): Enumerated, 3 values, section 8.7.1
  NAT-Control-Install (596): Grouped, 4 members, section 8.7.2
  NAT-Control-Remove (597): Grouped, 2 members, section 8.7.3
  NAT-Control-Definition (598): Grouped, 5 members, section 8.7.4
  NAT-Internal-Address (599): Grouped, 3 members, section 8.7.5
  NAT-External-Address (600): Grouped, 2 members, section 8.7.6
  Max-NAT-Bindings (601): Unsigned32, section 8.7.7
  NAT-Control-Binding-Template (602): OctetString, section 8.7.8
  Duplicate-Session-Id (603): UTF8String, section 8.7.9
  NAT-External-Port-Style (604): Enumerated, 1 value, section 8.7.10
  NAT-Control-Record (605): Grouped, 3 members, section 9.2.1
  NAT-Control-Binding-Status (606): Enumerated, 3 values, section 9.2.2
  Current-NAT-Bindings (607): Unsigned32, section 9.2.3

Each entry's type, enumerated values and grouped members are the
document's, from its clauses and AVP tables, and so are its M and V bits
where the document states them.

Generated by Seanchaí (integrations/wireshark/additions.py).
---
 resources/protocols/diameter/dictionary.xml | 71 +++++++++++++++++++++
 1 file changed, 71 insertions(+)

diff --git a/resources/protocols/diameter/dictionary.xml b/resources/protocols/diameter/dictionary.xml
index 56a8586..7470b66 100644
--- a/resources/protocols/diameter/dictionary.xml
+++ b/resources/protocols/diameter/dictionary.xml
@@ -2718,6 +2718,77 @@
 				<gavp name="QoS-Profile-Id"/>
 			</grouped>
 		</avp>
+		<avp name="NC-Request-Type" code="595" mandatory="must" vendor-bit="mustnot" may-encrypt="yes">
+			<type type-name="Enumerated"/>
+			<enum name="INITIAL_REQUEST" code="1"/>
+			<enum name="UPDATE_REQUEST" code="2"/>
+			<enum name="QUERY_REQUEST" code="3"/>
+		</avp>
+		<avp name="NAT-Control-Install" code="596" mandatory="must" vendor-bit="mustnot" may-encrypt="yes">
+			<grouped>
+				<gavp name="NAT-Control-Definition"/>
+				<gavp name="NAT-Control-Binding-Template"/>
+				<gavp name="Max-NAT-Bindings"/>
+				<gavp name="NAT-External-Port-Style"/>
+			</grouped>
+		</avp>
+		<avp name="NAT-Control-Remove" code="597" mandatory="must" vendor-bit="mustnot" may-encrypt="yes">
+			<grouped>
+				<gavp name="NAT-Control-Definition"/>
+				<gavp name="NAT-Control-Binding-Template"/>
+			</grouped>
+		</avp>
+		<avp name="NAT-Control-Definition" code="598" mandatory="must" vendor-bit="mustnot" may-encrypt="yes">
+			<grouped>
+				<gavp name="NAT-Internal-Address"/>
+				<gavp name="Protocol"/>
+				<gavp name="Direction"/>
+				<gavp name="NAT-External-Address"/>
+				<gavp name="Session-Id"/>
+			</grouped>
+		</avp>
+		<avp name="NAT-Internal-Address" code="599" mandatory="must" vendor-bit="mustnot" may-encrypt="yes">
+			<grouped>
+				<gavp name="Framed-IP-Address"/>
+				<gavp name="Framed-IPv6-Prefix"/>
+				<gavp name="Port"/>
+			</grouped>
+		</avp>
+		<avp name="NAT-External-Address" code="600" mandatory="must" vendor-bit="mustnot" may-encrypt="yes">
+			<grouped>
+				<gavp name="Framed-IP-Address"/>
+				<gavp name="Port"/>
+			</grouped>
+		</avp>
+		<avp name="Max-NAT-Bindings" code="601" mandatory="must" vendor-bit="mustnot" may-encrypt="yes">
+			<type type-name="Unsigned32"/>
+		</avp>
+		<avp name="NAT-Control-Binding-Template" code="602" mandatory="must" vendor-bit="mustnot" may-encrypt="yes">
+			<type type-name="OctetString"/>
+		</avp>
+		<avp name="Duplicate-Session-Id" code="603" mandatory="must" vendor-bit="mustnot" may-encrypt="yes">
+			<type type-name="UTF8String"/>
+		</avp>
+		<avp name="NAT-External-Port-Style" code="604" mandatory="must" vendor-bit="mustnot" may-encrypt="yes">
+			<type type-name="Enumerated"/>
+			<enum name="FOLLOW_INTERNAL_PORT_STYLE" code="1"/>
+		</avp>
+		<avp name="NAT-Control-Record" code="605" mandatory="must" vendor-bit="mustnot" may-encrypt="yes">
+			<grouped>
+				<gavp name="NAT-Control-Definition"/>
+				<gavp name="NAT-Control-Binding-Status"/>
+				<gavp name="Event-Timestamp"/>
+			</grouped>
+		</avp>
+		<avp name="NAT-Control-Binding-Status" code="606" mandatory="must" vendor-bit="mustnot" may-encrypt="yes">
+			<type type-name="Enumerated"/>
+			<enum name="Created" code="1"/>
+			<enum name="Active" code="2"/>
+			<enum name="Removed" code="3"/>
+		</avp>
+		<avp name="Current-NAT-Bindings" code="607" mandatory="must" vendor-bit="mustnot" may-encrypt="yes">
+			<type type-name="Unsigned32"/>
+		</avp>
 		<avp name="QoS-Semantics" code="575" mandatory="may">
 			<type type-name="Enumerated"/>
 			<enum name="QoS-Desired" code="0"/>
