From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sliva0 <sliva0mk@gmail.com>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Diameter: Add 5 AVPs from 3GPP TS 29.388
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

3GPP TS 29.388 V18.1.0 defines these AVPs in vendor 10415, which the
dictionary has no entry for at their codes:

  V2X-PC5-Allowed-PLMN (4600): Grouped, 2 members, clause 6.3.3
  V2X-Update-Flags (4601): Unsigned32, clause 6.3.4
  V2X-Notify-Flags (4602): Unsigned32, clause 6.3.5
  PLMN-Allowed-PC5-RATs (4603): Grouped, 2 members, clause 6.3.10
  PC5-RAT-Type (4604): Enumerated, 2 values, clause 6.3.11

Each entry's type, enumerated values and grouped members are the
document's, from its clauses and AVP tables, and so are its M and V bits
where the document states them.

Generated by Seanchaí (integrations/wireshark/additions.py).
---
 resources/protocols/diameter/dictionary.xml | 23 +++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/resources/protocols/diameter/dictionary.xml b/resources/protocols/diameter/dictionary.xml
index 56a8586..2882710 100644
--- a/resources/protocols/diameter/dictionary.xml
+++ b/resources/protocols/diameter/dictionary.xml
@@ -6306,6 +6306,29 @@
 				<gavp name="UE-PC5-AMBR"/>
 			</grouped>
 		</avp>
+		<avp name="V2X-PC5-Allowed-PLMN" code="4600" mandatory="must" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+			<grouped>
+				<gavp name="Visited-PLMN-Id"/>
+				<gavp name="PLMN-Allowed-PC5-RATs"/>
+			</grouped>
+		</avp>
+		<avp name="V2X-Update-Flags" code="4601" mandatory="must" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+			<type type-name="Unsigned32"/>
+		</avp>
+		<avp name="V2X-Notify-Flags" code="4602" mandatory="must" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+			<type type-name="Unsigned32"/>
+		</avp>
+		<avp name="PLMN-Allowed-PC5-RATs" code="4603" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+			<grouped>
+				<gavp name="Visited-PLMN-Id"/>
+				<gavp name="PC5-RAT-Type"/>
+			</grouped>
+		</avp>
+		<avp name="PC5-RAT-Type" code="4604" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+			<type type-name="Enumerated"/>
+			<enum name="LTE" code="0"/>
+			<enum name="NR" code="1"/>
+		</avp>
 		<avp name="V2X-Permission" code="1689" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
 			<type type-name="Unsigned32"/>
 		</avp>
