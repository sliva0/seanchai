From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sliva0 <sliva0mk@gmail.com>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Diameter: Add 8 AVPs from 3GPP TS 29.272
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

3GPP TS 29.272 V18.7.0 defines these AVPs in vendor 10415, which the
dictionary has no entry for at their codes:

  MDT-Configuration-NR (1720): Grouped, 15 members, clause 7.3.245
  Event-Threshold-SINR (1721): Unsigned32, clause 7.3.246
  Collection-Period-RRM-NR (1722): Enumerated, clause 7.3.247
  Collection-Period-M6-NR (1723): Enumerated, clause 7.3.248
  Collection-Period-M7-NR (1724): Unsigned32, clause 7.3.249
  Sensor-Measurement (1725): Enumerated, 3 values, clause 7.3.250
  NR-Cell-Global-Identity (1726): OctetString, clause 7.3.251
  Trace-Reporting-Consumer-Uri (1727): DiameterURI, clause 7.3.252

Each entry's type, enumerated values and grouped members are the
document's, from its clauses and AVP tables, and so are its M and V bits
where the document states them.

Generated by Seanchaí (integrations/wireshark/additions.py).
---
 resources/protocols/diameter/dictionary.xml | 43 +++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/resources/protocols/diameter/dictionary.xml b/resources/protocols/diameter/dictionary.xml
index 56a8586..58082bf 100644
--- a/resources/protocols/diameter/dictionary.xml
+++ b/resources/protocols/diameter/dictionary.xml
@@ -6439,6 +6439,49 @@
 		<avp name="Third-Context-Identifier" code="1719" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
 			<type type-name="Unsigned32"/>
 		</avp>
+		<avp name="MDT-Configuration-NR" code="1720" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+			<grouped>
+				<gavp name="Job-Type"/>
+				<gavp name="Area-Scope"/>
+				<gavp name="List-Of-Measurements"/>
+				<gavp name="Reporting-Trigger"/>
+				<gavp name="Report-Interval"/>
+				<gavp name="Report-Amount"/>
+				<gavp name="Event-Threshold-RSRP"/>
+				<gavp name="Event-Threshold-RSRQ"/>
+				<gavp name="Event-Threshold-SINR"/>
+				<gavp name="Collection-Period-RRM-NR"/>
+				<gavp name="Collection-Period-M6-NR"/>
+				<gavp name="Collection-Period-M7-NR"/>
+				<gavp name="Positioning-Method"/>
+				<gavp name="Sensor-Measurement"/>
+				<gavp name="MDT-Allowed-PLMN-Id"/>
+			</grouped>
+		</avp>
+		<avp name="Event-Threshold-SINR" code="1721" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+			<type type-name="Unsigned32"/>
+		</avp>
+		<avp name="Collection-Period-RRM-NR" code="1722" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+			<type type-name="Enumerated"/>
+		</avp>
+		<avp name="Collection-Period-M6-NR" code="1723" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+			<type type-name="Enumerated"/>
+		</avp>
+		<avp name="Collection-Period-M7-NR" code="1724" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+			<type type-name="Unsigned32"/>
+		</avp>
+		<avp name="Sensor-Measurement" code="1725" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+			<type type-name="Enumerated"/>
+			<enum name="BAROMETRIC_PRESSURE" code="0"/>
+			<enum name="UE_SPEED" code="1"/>
+			<enum name="UE_ORIENTATION" code="2"/>
+		</avp>
+		<avp name="NR-Cell-Global-Identity" code="1726" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+			<type type-name="OctetString"/>
+		</avp>
+		<avp name="Trace-Reporting-Consumer-Uri" code="1727" mandatory="mustnot" vendor-bit="must" may-encrypt="no" vendor-id="TGPP">
+			<type type-name="DiameterURI"/>
+		</avp>
 
 		<avp name="SMS-Information" code="2000" vendor-bit="must" vendor-id="TGPP">
 			<grouped>
