From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sliva0 <sliva0mk@gmail.com>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Diameter: Add 11 AVPs from RFC 8506
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

RFC 8506 defines these AVPs in the IETF space, which the dictionary has
no entry for at their codes:

  Subscription-Id-Extension (659): Grouped, 5 members, section 8.58
  Subscription-Id-E164 (660): UTF8String, section 8.59
  Subscription-Id-IMSI (661): UTF8String, section 8.60
  Subscription-Id-SIP-URI (662): UTF8String, section 8.61
  Subscription-Id-NAI (663): UTF8String, section 8.62
  Subscription-Id-Private (664): UTF8String, section 8.63
  Redirect-Server-Extension (665): Grouped, 3 members, section 8.64
  Redirect-Address-IPAddress (666): Address, section 8.65
  Redirect-Address-URL (667): UTF8String, section 8.66
  Redirect-Address-SIP-URI (668): UTF8String, section 8.67
  QoS-Final-Unit-Indication (669): Grouped, 4 members, section 8.68

Each entry's type, enumerated values and grouped members are the
document's, from its clauses and AVP tables, and so are its M and V bits
where the document states them.

Generated by Seanchaí (integrations/wireshark/additions.py).
---
 resources/protocols/diameter/dictionary.xml | 48 +++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/resources/protocols/diameter/dictionary.xml b/resources/protocols/diameter/dictionary.xml
index 56a8586..5285848 100644
--- a/resources/protocols/diameter/dictionary.xml
+++ b/resources/protocols/diameter/dictionary.xml
@@ -2891,6 +2891,54 @@
     <avp name="User-Equipment-Info-IMEI" code="658" mandatory="may">
       <type type-name="OctetString"/>
     </avp>
+    <avp name="Subscription-Id-Extension" code="659" mandatory="may" vendor-bit="mustnot">
+      <grouped>
+        <gavp name="Subscription-Id-E164"/>
+        <gavp name="Subscription-Id-IMSI"/>
+        <gavp name="Subscription-Id-SIP-URI"/>
+        <gavp name="Subscription-Id-NAI"/>
+        <gavp name="Subscription-Id-Private"/>
+      </grouped>
+    </avp>
+    <avp name="Subscription-Id-E164" code="660" mandatory="may" vendor-bit="mustnot">
+      <type type-name="UTF8String"/>
+    </avp>
+    <avp name="Subscription-Id-IMSI" code="661" mandatory="may" vendor-bit="mustnot">
+      <type type-name="UTF8String"/>
+    </avp>
+    <avp name="Subscription-Id-SIP-URI" code="662" mandatory="may" vendor-bit="mustnot">
+      <type type-name="UTF8String"/>
+    </avp>
+    <avp name="Subscription-Id-NAI" code="663" mandatory="may" vendor-bit="mustnot">
+      <type type-name="UTF8String"/>
+    </avp>
+    <avp name="Subscription-Id-Private" code="664" mandatory="may" vendor-bit="mustnot">
+      <type type-name="UTF8String"/>
+    </avp>
+    <avp name="Redirect-Server-Extension" code="665" mandatory="may" vendor-bit="mustnot">
+      <grouped>
+        <gavp name="Redirect-Address-IPAddress"/>
+        <gavp name="Redirect-Address-URL"/>
+        <gavp name="Redirect-Address-SIP-URI"/>
+      </grouped>
+    </avp>
+    <avp name="Redirect-Address-IPAddress" code="666" mandatory="may" vendor-bit="mustnot">
+      <type type-name="IPAddress"/>
+    </avp>
+    <avp name="Redirect-Address-URL" code="667" mandatory="may" vendor-bit="mustnot">
+      <type type-name="UTF8String"/>
+    </avp>
+    <avp name="Redirect-Address-SIP-URI" code="668" mandatory="may" vendor-bit="mustnot">
+      <type type-name="UTF8String"/>
+    </avp>
+    <avp name="QoS-Final-Unit-Indication" code="669" mandatory="may" vendor-bit="mustnot">
+      <grouped>
+        <gavp name="Final-Unit-Action"/>
+        <gavp name="Filter-Rule"/>
+        <gavp name="Filter-Id"/>
+        <gavp name="Redirect-Server-Extension"/>
+      </grouped>
+    </avp>
 
