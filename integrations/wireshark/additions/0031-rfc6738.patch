From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sliva0 <sliva0mk@gmail.com>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Diameter: Add 8 AVPs from RFC 6738
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

RFC 6738 defines these AVPs in the IETF space, which the dictionary has
no entry for at their codes:

  IKEv2-Nonces (587): Grouped, 2 members, section 6.1
  Ni (588): OctetString, section 6.1.1
  Nr (589): OctetString, section 6.1.2
  IKEv2-Identity (590): Grouped, 2 members, section 6.2
  Initiator-Identity (591): Grouped, 2 members, section 6.2.1
  ID-Type (592): Enumerated, section 6.2.1.1
  Identification-Data (593): OctetString, section 6.2.1.2
  Responder-Identity (594): Grouped, 2 members, section 6.2.2

Each entry's type, enumerated values and grouped members are the
document's, from its clauses and AVP tables, and so are its M and V bits
where the document states them.

Generated by Seanchaí (integrations/wireshark/additions.py).
---
 resources/protocols/diameter/dictionary.xml | 36 +++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/resources/protocols/diameter/dictionary.xml b/resources/protocols/diameter/dictionary.xml
index 56a8586..ae87b24 100644
--- a/resources/protocols/diameter/dictionary.xml
+++ b/resources/protocols/diameter/dictionary.xml
@@ -2712,6 +2712,42 @@
 		<avp name="QoS-Profile-Id" code="573" mandatory="may">
 			<type type-name="Unsigned32"/>
 		</avp>
+		<avp name="IKEv2-Nonces" code="587" mandatory="must" vendor-bit="mustnot">
+			<grouped>
+				<gavp name="Ni"/>
+				<gavp name="Nr"/>
+			</grouped>
+		</avp>
+		<avp name="Ni" code="588" mandatory="must" vendor-bit="mustnot">
+			<type type-name="OctetString"/>
+		</avp>
+		<avp name="Nr" code="589" mandatory="must" vendor-bit="mustnot">
+			<type type-name="OctetString"/>
+		</avp>
+		<avp name="IKEv2-Identity" code="590" mandatory="must" vendor-bit="mustnot">
+			<grouped>
+				<gavp name="Initiator-Identity"/>
+				<gavp name="Responder-Identity"/>
+			</grouped>
+		</avp>
+		<avp name="Initiator-Identity" code="591" mandatory="must" vendor-bit="mustnot">
+			<grouped>
+				<gavp name="ID-Type"/>
+				<gavp name="Identification-Data"/>
+			</grouped>
+		</avp>
+		<avp name="ID-Type" code="592" mandatory="must" vendor-bit="mustnot">
+			<type type-name="Enumerated"/>
+		</avp>
+		<avp name="Identification-Data" code="593" mandatory="must" vendor-bit="mustnot">
+			<type type-name="OctetString"/>
+		</avp>
+		<avp name="Responder-Identity" code="594" mandatory="must" vendor-bit="mustnot">
+			<grouped>
+				<gavp name="ID-Type"/>
+				<gavp name="Identification-Data"/>
+			</grouped>
+		</avp>
 		<avp name="QoS-Profile-Template" code="574" mandatory="must" may-encrypt="no" protected="mustnot" vendor-bit="mustnot">
 			<grouped>
 				<gavp name="Vendor-Id"/>
