From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sliva0 <sliva0mk@gmail.com>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Diameter: Add 14 AVPs from 3GPP TS 29.468
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

3GPP TS 29.468 V18.0.0 defines these AVPs in vendor 10415, which the
dictionary has no entry for at their codes:

  Local-M1-Information (3518): Grouped, 5 members, clause 6.4.20
  Local-MB2-U-Information (3519): Grouped, 2 members, clause 6.4.21
  MBMS-eNB-IP-Multicast-Address (3520): Address, clause 6.4.22
  MBMS-eNB-IPv6-Multicast-Address (3521): Address, clause 6.4.23
  Common-Tunnel-Endpoint-Identifier (3524): OctetString, clause 6.4.26
  FEC-Request (3525): OctetString, clause 6.4.27
  ROHC-Request (3526): Grouped, 3 members, clause 6.4.28
  ROHC-Full-Header-Periodicity (3527): Float32, clause 6.4.29
  ROHC-Profile (3528): Unsigned32, clause 6.4.30
  Userplane-Protocol-Result (3529): Grouped, 3 members, clause 6.4.31
  ROHC-Result (3530): Unsigned32, clause 6.4.32
  FEC-Result (3531): Unsigned32, clause 6.4.33
  ROHC-Max-CID (3532): Unsigned32, clause 6.4.34
  MBMS-Bearer-Event-Diagnostic-Info (3533): Enumerated, 7 values, clause 6.4.35

Each entry's type, enumerated values and grouped members are the
document's, from its clauses and AVP tables, and so are its M and V bits
where the document states them.

Not added here: MBMS-GW-SSM-IP-Address, code 3522, named like the
dictionary's code 924 of vendor 10415; MBMS-GW-SSM-IPv6-Address, code
3523, named like the dictionary's code 925 of vendor 10415. Wireshark
names each display filter field after its AVP, so two entries named
alike need one renamed, as Cx-User-Data and Sh-User-Data are.

Generated by Seanchaí (integrations/wireshark/additions.py).
---
 resources/protocols/diameter/TGPP.xml | 66 +++++++++++++++++++++++++++
 1 file changed, 66 insertions(+)

diff --git a/resources/protocols/diameter/TGPP.xml b/resources/protocols/diameter/TGPP.xml
index 65e5a13..999ad5f 100644
--- a/resources/protocols/diameter/TGPP.xml
+++ b/resources/protocols/diameter/TGPP.xml
@@ -1699,6 +1699,72 @@
   <avp name="TMGI-Number" code="3516" mandatory="must" vendor-bit="must" vendor-id="TGPP" may-encrypt="yes">
     <type type-name="Unsigned32"/>
   </avp>
+  <avp name="Local-M1-Information" code="3518" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <grouped>
+      <gavp name="MBMS-eNB-IP-Multicast-Address"/>
+      <gavp name="MBMS-eNB-IPv6-Multicast-Address"/>
+      <gavp name="MBMS-GW-SSM-IP-Address"/>
+      <gavp name="MBMS-GW-SSM-IPv6-Address"/>
+      <gavp name="Common-Tunnel-Endpoint-Identifier"/>
+    </grouped>
+  </avp>
+  <avp name="Local-MB2-U-Information" code="3519" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <grouped>
+      <gavp name="BMSC-Address"/>
+      <gavp name="BMSC-Port"/>
+    </grouped>
+  </avp>
+  <avp name="MBMS-eNB-IP-Multicast-Address" code="3520" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="IPAddress"/>
+  </avp>
+  <avp name="MBMS-eNB-IPv6-Multicast-Address" code="3521" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="IPAddress"/>
+  </avp>
+  <avp name="Common-Tunnel-Endpoint-Identifier" code="3524" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="OctetString"/>
+  </avp>
+  <avp name="FEC-Request" code="3525" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="OctetString"/>
+  </avp>
+  <avp name="ROHC-Request" code="3526" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <grouped>
+      <gavp name="Flow-Description"/>
+      <gavp name="ROHC-Full-Header-Periodicity"/>
+      <gavp name="ROHC-Profile"/>
+    </grouped>
+  </avp>
+  <avp name="ROHC-Full-Header-Periodicity" code="3527" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="Float32"/>
+  </avp>
+  <avp name="ROHC-Profile" code="3528" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="Unsigned32"/>
+  </avp>
+  <avp name="Userplane-Protocol-Result" code="3529" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <grouped>
+      <gavp name="Flow-Description"/>
+      <gavp name="ROHC-Result"/>
+      <gavp name="FEC-Result"/>
+    </grouped>
+  </avp>
+  <avp name="ROHC-Result" code="3530" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="Unsigned32"/>
+  </avp>
+  <avp name="FEC-Result" code="3531" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="Unsigned32"/>
+  </avp>
+  <avp name="ROHC-Max-CID" code="3532" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="Unsigned32"/>
+  </avp>
+  <avp name="MBMS-Bearer-Event-Diagnostic-Info" code="3533" mandatory="mustnot" vendor-bit="must" vendor-id="TGPP">
+    <type type-name="Enumerated"/>
+    <enum name="TMGI-Expiry" code="0"/>
+    <enum name="MBMS-GW-Not-Establishment" code="1"/>
+    <enum name="SGmb-Transient-Path-Failure" code="2"/>
+    <enum name="SGmb-Non-Transient-Path-Failure" code="3"/>
+    <enum name="MBMS-GW-User-Plane-Failure" code="4"/>
+    <enum name="MBMS-GW-Permanent-Error" code="5"/>
+    <enum name="MBMS-GW-Transient-Error" code="6"/>
+  </avp>
 
   <avp name="MB2U-Security" code="3517" mandatory="must" vendor-bit="must" vendor-id="TGPP" may-encrypt="yes">
     <type type-name="Unsigned32"/>
