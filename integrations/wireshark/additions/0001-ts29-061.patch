From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sliva0 <sliva0mk@gmail.com>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH] Diameter: Add 4 AVPs from 3GPP TS 29.061
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

3GPP TS 29.061 V19.1.0 defines these AVPs in vendor 10415, which the
dictionary has no entry for at their codes:

  3GPP-User-Location-Info-Time (30): OctetString, clause 16.4.7
  3GPP-Secondary-RAT-Usage (31): OctetString, clause 16.4.7
  3GPP-UE-Local-IP-Address (32): OctetString, clause 16.4.7
  3GPP-UE-Source-Port (33): OctetString, clause 16.4.7

Each entry's type, enumerated values and grouped members are the
document's, from its clauses and AVP tables, and so are its M and V bits
where the document states them.

Generated by Seanchaí (integrations/wireshark/additions.py).
---
 resources/protocols/diameter/TGPP.xml | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/resources/protocols/diameter/TGPP.xml b/resources/protocols/diameter/TGPP.xml
index 65e5a13..bdda78a 100644
--- a/resources/protocols/diameter/TGPP.xml
+++ b/resources/protocols/diameter/TGPP.xml
@@ -94,6 +94,18 @@
   <avp name="3GPP-Allocate-IP-Type" code="27" mandatory="must" may-encrypt="yes" protected="may" vendor-bit="must" vendor-id="TGPP">
     <type type-name="OctetString"/>
   </avp>
+  <avp name="3GPP-User-Location-Info-Time" code="30" mandatory="mustnot" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+    <type type-name="OctetString"/>
+  </avp>
+  <avp name="3GPP-Secondary-RAT-Usage" code="31" mandatory="mustnot" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+    <type type-name="OctetString"/>
+  </avp>
+  <avp name="3GPP-UE-Local-IP-Address" code="32" mandatory="mustnot" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+    <type type-name="OctetString"/>
+  </avp>
+  <avp name="3GPP-UE-Source-Port" code="33" mandatory="mustnot" vendor-bit="must" may-encrypt="yes" vendor-id="TGPP">
+    <type type-name="OctetString"/>
+  </avp>
 
   <!-- Note: The AVP codes from 1 to 255 are reserved for backwards compatibility with 3GPP RADIUS Vendor Specific
        Attributes (See TS 29.061 [13]) -->
