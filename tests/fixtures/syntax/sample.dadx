; Interprets: Private ACME-HSS
;; What the ACME-HSS document's prose says, in its clause order.


;; Read from the clause's first paragraph.
; Type: Interpreted Constraints
; Id: id-length
; AVP: ACME-Id
; Within: ACME-Data
; Section: 7.3.5
; Versions: *..1.2.0
"The ACME-Id shall be 1 to 15 characters long."
    length 1..15 characters ;; the characters, not the octets


; Type: Interpreted Constraints
; Id: flags-request
; AVP: ACME-Flags
; Command: ACME-Request
; Application-ID: 16777999
; Command-Section: 6.1.1
; Section: 7.3.6
; Table: 7.3.6/1
; Versions: 1.0.0..1.2.0 ;; widened by --expand-ranges
"It shall be present only if the Withdraw Data bit is set."
    present-if ACME-Flags bit "Withdraw Data"


; Type: Interpreted Constraints
; Id: kind-codes
; AVP: ACME-Kind
; Command: ACME-Request
; Section: 7.3.7
; Versions: 1.2.0
"It is absent with one of the ACME codes or a 5xxx one."
    absent-if ACME-Code in DIAMETER_ERROR_ACME, "ACME odd code", 3GPP_ACME_CODE,
        5000..5999 or not ACME-Flags in 1, 2


; Type: Interpreted Constraints
; Id: answer-trace-echo
; AVP: ACME-Trace
; Messages: answers
; Section: 7.3.8
; Versions: 1.2.0
"Every answer carries the request's ACME-Trace."
    present-if request/ACME-Trace
